# Identifier le seuil de bascule sur le type 3
sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3)
R  = sub3["R"].to_numpy()
NB = sub3["NB_MATURITE_IRBA"].to_numpy()

# Pour chaque ligne, est-ce que NB == R (bascule) ou NB suit la formule progressive ?
# Critère : |NB - R| < 0.01 -> bascule
mask_bascule = np.abs(NB - R) < 0.01

# Distribution de R selon que ça bascule ou pas
print("Lignes où NB ≈ R (bascule) :")
R_bascule = R[mask_bascule]
print(f"  n = {len(R_bascule)}")
print(f"  R min = {R_bascule.min():.4f}")
print(f"  R max = {R_bascule.max():.4f}")
print(f"  R médian = {np.median(R_bascule):.4f}")
print(f"  R 95e pct = {np.percentile(R_bascule, 95):.4f}")
print(f"  R 99e pct = {np.percentile(R_bascule, 99):.4f}")

print("\nLignes où NB ≠ R (formule progressive) :")
R_prog = R[~mask_bascule]
print(f"  n = {len(R_prog)}")
print(f"  R min = {R_prog.min():.4f}")
print(f"  R max = {R_prog.max():.4f}")
print(f"  R 5e pct = {np.percentile(R_prog, 5):.4f}")
print(f"  R 1er pct = {np.percentile(R_prog, 1):.4f}")

# Histogramme de R par bin pour voir la transition
print("\nDistribution par bin de R (bascule oui/non) :")
print(f"{'bin R':<15} {'n_total':>8} {'n_bascule':>10} {'%_bascule':>10}")
bins = [0, 0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 5.0]
for lo, hi in zip(bins[:-1], bins[1:]):
    m = (R >= lo) & (R < hi)
    if m.sum() == 0: continue
    pct = mask_bascule[m].sum() / m.sum() * 100
    print(f"[{lo:>5.2f}, {hi:>5.2f}[ {m.sum():>8} {mask_bascule[m].sum():>10} {pct:>9.1f}%")
