# ============================================================
#  CLUSTERING HIERARCHIQUE DE WARD — bloc complet v2
#  Requiert : df_base charge (Polars DataFrame)
#             colonnes : CHR_model (i64), lgd_obligor (f64)
# ============================================================

import numpy as np
import polars as pl
import matplotlib.pyplot as plt
from scipy.stats import spearmanr

# ================================================================
#  FONCTION SCORES
# ================================================================

def compute_scores(df: pl.DataFrame, class_col: str, target_col: str) -> dict:
    """
    R2        : variance inter / variance totale
    std_intra : ecart-type intra-classe moyen pondere
    mae_pred  : MAE si on predit la moyenne de classe
    gini      : Spearman(lgd_realisee, moyenne_classe_predite)
    """
    y          = df[target_col].to_numpy().astype(float)
    grand_mean = y.mean()
    ss_total   = ((y - grand_mean) ** 2).sum()

    cs = (
        df.group_by(class_col)
        .agg([
            pl.col(target_col).mean().alias("mean_cls"),
            pl.col(target_col).std().alias("std_cls"),
            pl.col(target_col).count().alias("n_cls"),
        ])
        .sort("mean_cls")
    )

    means_cls = cs["mean_cls"].to_numpy().astype(float)
    stds_cls  = cs["std_cls"].to_numpy().astype(float)
    ns_cls    = cs["n_cls"].to_numpy().astype(float)

    # R2
    ss_inter  = float(((means_cls - grand_mean) ** 2 * ns_cls).sum())
    r2        = ss_inter / ss_total if ss_total > 0 else 0.0

    # Std intra ponderee
    std_intra = float((stds_cls * ns_cls).sum() / ns_cls.sum())

    # MAE
    df_joined = df.join(cs.select([class_col, "mean_cls"]), on=class_col, how="left")
    y_pred    = df_joined["mean_cls"].to_numpy().astype(float)
    mae_pred  = float(np.abs(y - y_pred).mean())

    # Gini (Spearman sur sous-echantillon 50k)
    rng = np.random.default_rng(42)
    if len(y) > 50_000:
        idx   = rng.choice(len(y), size=50_000, replace=False)
        y_s   = y[idx]
        yp_s  = y_pred[idx]
    else:
        y_s, yp_s = y, y_pred
    rho, _ = spearmanr(yp_s, y_s)

    return {
        "n_classes" : int(cs.height),
        "r2"        : round(float(r2),        6),
        "std_intra" : round(float(std_intra), 6),
        "mae_pred"  : round(float(mae_pred),  6),
        "gini"      : round(float(rho),       6),
    }


# ================================================================
#  PARTIE 1 — Stats de base + algorithme de Ward
# ================================================================

class_stats_base = (
    df_base
    .group_by("CHR_model")
    .agg([
        pl.col("lgd_obligor").mean().alias("mean_lgd"),
        pl.col("lgd_obligor").count().alias("n"),
    ])
    .sort("mean_lgd")
)

# Conversion en str pour uniformite interne (le cast i64 se fait au join)
classes = [str(c) for c in class_stats_base["CHR_model"].to_list()]
means   = np.array(class_stats_base["mean_lgd"].to_list(), dtype=float)
ns      = np.array(class_stats_base["n"].to_list(),        dtype=float)
K       = len(classes)

print(f"{K} classes | LGD [{means.min():.3f} – {means.max():.3f}]\n")

# Etat initial : un groupe par classe
groups = [
    {
        "label"  : c,
        "mean"   : float(m),
        "n"      : float(n),
        "members": [c],
    }
    for c, m, n in zip(classes, means, ns)
]

fusion_history = []  # liste de dicts — un par fusion

while len(groups) > 1:
    best_delta = np.inf
    best_idx   = -1

    for i in range(len(groups) - 1):
        a, b  = groups[i], groups[i + 1]
        delta = (a["n"] * b["n"]) / (a["n"] + b["n"]) * (a["mean"] - b["mean"]) ** 2
        if delta < best_delta:
            best_delta = delta
            best_idx   = i

    a     = groups[best_idx]
    b     = groups[best_idx + 1]
    n_new = a["n"] + b["n"]

    new_grp = {
        "label"  : f"{a['label']}|{b['label']}",
        "mean"   : (a["mean"] * a["n"] + b["mean"] * b["n"]) / n_new,
        "n"      : n_new,
        "members": a["members"] + b["members"],
    }

    fusion_history.append({
        "n_classes"  : len(groups) - 1,
        "label_a"    : a["label"],
        "label_b"    : b["label"],
        "mean_a"     : round(a["mean"], 4),
        "mean_b"     : round(b["mean"], 4),
        "n_a"        : int(a["n"]),
        "n_b"        : int(b["n"]),
        "delta_ward" : round(best_delta, 6),
    })

    groups = groups[:best_idx] + [new_grp] + groups[best_idx + 2:]

fh = pl.DataFrame(fusion_history)
print("=== HISTORIQUE DES FUSIONS (Ward) ===")
display(fh)


# ================================================================
#  PARTIE 2 — Detection du saut maximal + graphes
# ================================================================

deltas    = np.array([r["delta_ward"] for r in fusion_history])
n_classes = np.array([r["n_classes"]  for r in fusion_history])
sauts     = np.diff(deltas)
idx_saut  = int(np.argmax(sauts))

k_naturel   = int(n_classes[idx_saut + 1])
delta_avant = deltas[idx_saut]
delta_apres = deltas[idx_saut + 1]

print(f"\nSaut maximal : {delta_avant:.6f} → {delta_apres:.6f} "
      f"(x{delta_apres/delta_avant:.1f})")
print(f"Coupure naturelle : K = {k_naturel} classes\n")

fig, axes = plt.subplots(1, 2, figsize=(14, 4))

axes[0].plot(n_classes, deltas, marker="o", markersize=3, color="steelblue")
axes[0].axvline(k_naturel, color="red", linestyle="--", lw=1.5,
                label=f"coupure K={k_naturel}")
axes[0].set_xlabel("Nombre de classes")
axes[0].set_ylabel("Δ Ward")
axes[0].set_title("Distance de fusion Ward")
axes[0].invert_xaxis()
axes[0].legend()

axes[1].plot(n_classes[1:], sauts, marker="o", markersize=3, color="darkorange")
axes[1].axvline(k_naturel, color="red", linestyle="--", lw=1.5,
                label=f"saut max → K={k_naturel}")
axes[1].set_xlabel("Nombre de classes")
axes[1].set_ylabel("Δ(Δ Ward)")
axes[1].set_title("Sauts entre distances consecutives")
axes[1].invert_xaxis()
axes[1].legend()

plt.tight_layout()
plt.show()

top_sauts = (
    pl.DataFrame({
        "n_classes_apres": n_classes[1:].tolist(),
        "saut"           : sauts.tolist(),
        "delta_avant"    : deltas[:-1].tolist(),
        "delta_apres"    : deltas[1:].tolist(),
    })
    .sort("saut", descending=True)
    .head(10)
)
print("=== TOP 10 SAUTS ===")
display(top_sauts)


# ================================================================
#  PARTIE 3 — Partitionnement final + mapping + validation
# ================================================================

K_FINAL = k_naturel   # <- modifier ici si besoin, ex: K_FINAL = 20

print(f"\nReconstruction du partitionnement a K={K_FINAL} classes...")

# Rejouer les fusions depuis l'etat initial jusqu'a K_FINAL
groups_final = [
    {
        "label"  : c,
        "mean"   : float(m),
        "n"      : float(n),
        "members": [c],
    }
    for c, m, n in zip(classes, means, ns)
]

for row in fusion_history:
    if row["n_classes"] < K_FINAL:
        break

    # Recherche par label exact — robuste aux labels composes
    idx_a = next(
        (i for i, g in enumerate(groups_final) if g["label"] == row["label_a"]),
        None
    )
    idx_b = next(
        (i for i, g in enumerate(groups_final) if g["label"] == row["label_b"]),
        None
    )

    if idx_a is None or idx_b is None:
        print(f"  ⚠️  labels non trouves : {row['label_a']} / {row['label_b']}")
        continue

    a, b  = groups_final[idx_a], groups_final[idx_b]
    n_new = a["n"] + b["n"]
    new_grp = {
        "label"  : f"{a['label']}|{b['label']}",
        "mean"   : (a["mean"] * a["n"] + b["mean"] * b["n"]) / n_new,
        "n"      : n_new,
        "members": a["members"] + b["members"],
    }
    keep         = [g for i, g in enumerate(groups_final)
                    if i not in (idx_a, idx_b)]
    groups_final = sorted(keep + [new_grp], key=lambda g: g["mean"])

print(f"Groupes reconstruits : {len(groups_final)}")

# --- Mapping membres -> classe finale ---
mapping_rows = []
for rank, grp in enumerate(groups_final, start=1):
    label_court = f"G{rank:02d}_lgd{round(grp['mean'], 1)}"
    for membre in grp["members"]:
        mapping_rows.append({
            "CHR_model_str" : membre,
            "CHR_model"     : int(membre),   # cast i64 pour le join
            "classe_finale" : label_court,
            "mean_groupe"   : round(grp["mean"], 4),
            "n_groupe"      : int(grp["n"]),
            "n_membres"     : len(grp["members"]),
        })

mapping_df = pl.DataFrame(mapping_rows).sort("mean_groupe")

print(f"\n=== MAPPING CHR_model → classe finale (K={K_FINAL}) ===")
display(
    mapping_df
    .select(["CHR_model", "classe_finale", "mean_groupe", "n_groupe", "n_membres"])
)

# --- Appliquer le mapping sur df_base ---
df_final = (
    df_base
    .join(
        mapping_df.select(["CHR_model", "classe_finale"]),
        on="CHR_model",
        how="left",
    )
)

# Verification : pas de null dans classe_finale
n_null = df_final.filter(pl.col("classe_finale").is_null()).height
if n_null > 0:
    print(f"⚠️  {n_null} lignes sans mapping — verifier CHR_model")
else:
    print(f"✅ Mapping complet — aucune valeur manquante")

# --- Scores de validation ---
scores_orig = compute_scores(df_base,  "CHR_model",    "lgd_obligor")
scores_ward = compute_scores(df_final, "classe_finale", "lgd_obligor")

def pct_change(ref, new, higher_is_better=True):
    delta = (new - ref) / abs(ref) * 100 if ref != 0 else 0
    return delta if higher_is_better else -delta

print(f"\n{'='*70}")
print(f"  {'CRITERE':<18} {'ORIGINAL':>12} {'WARD K={}'.format(K_FINAL):>14} {'DELTA':>10}")
print(f"  {'-'*66}")
print(f"  {'n_classes':<18} {scores_orig['n_classes']:>12} {scores_ward['n_classes']:>14}")
print(f"  {'R2':<18} {scores_orig['r2']:>12.6f} {scores_ward['r2']:>14.6f} "
      f"{pct_change(scores_orig['r2'], scores_ward['r2']):>+9.3f}%")
print(f"  {'std_intra':<18} {scores_orig['std_intra']:>12.6f} {scores_ward['std_intra']:>14.6f} "
      f"{pct_change(scores_orig['std_intra'], scores_ward['std_intra'], False):>+9.3f}%")
print(f"  {'mae_pred':<18} {scores_orig['mae_pred']:>12.6f} {scores_ward['mae_pred']:>14.6f} "
      f"{pct_change(scores_orig['mae_pred'], scores_ward['mae_pred'], False):>+9.3f}%")
print(f"  {'gini':<18} {scores_orig['gini']:>12.6f} {scores_ward['gini']:>14.6f} "
      f"{pct_change(scores_orig['gini'], scores_ward['gini']):>+9.3f}%")
print(f"{'='*70}")

# --- Resume des groupes finaux ---
print(f"\n=== TAILLES DES {K_FINAL} GROUPES ===")
display(
    mapping_df
    .unique("classe_finale", keep="first")
    .select(["classe_finale", "mean_groupe", "n_groupe", "n_membres"])
    .sort("mean_groupe")
)
