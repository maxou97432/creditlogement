# Cellule 4 - visualiser la courbe ARI (lecture du pic non-trivial)
import matplotlib.pyplot as plt

s = df_stab["seuil_ovl"].to_numpy()
ari = df_stab["ari_moyen"].to_numpy()
std = df_stab["ari_std"].to_numpy()

fig, ax1 = plt.subplots(figsize=(8, 5))
ax1.errorbar(s, ari, yerr=std, fmt="o-", color="black", lw=2,
             capsize=3, label="ARI moyen ± écart-type")
ax1.axvline(seuil_optimal, color="green", ls=":", lw=2,
            label=f"seuil retenu = {seuil_optimal}")
ax1.set_xlabel("seuil OVL")
ax1.set_ylabel("ARI (stabilité du partitionnement)")
ax1.set_ylim(0, 1.05)
ax1.legend(fontsize=9)
ax1.set_title("Stabilité bootstrap du partitionnement (Hubert & Arabie 1985)")

ax2 = ax1.twinx()
ax2.plot(s, df_stab["n_classes_median"].to_numpy(), "d--", color="grey", alpha=0.4)
ax2.set_ylabel("n classes (médiane)", color="grey")
plt.tight_layout()
plt.show()
