# Affiche toutes les colonnes contenant au moins 10% de zéros/nulls mais avec des montants (pour la Valeur Résiduelle)
for col in capret.columns:
    if capret[col].dtype in [pl.Float32, pl.Float64, pl.Int32, pl.Int64]:
        non_nulls = capret[col].drop_nulls()
        if len(non_nulls) > 0:
            max_val = non_nulls.max()
            min_val = non_nulls.min()
            # Cherche un comportement de "montant" (0 à grand montant)
            if min_val == 0 and max_val > 5000:
                print(f"{col} - Min: {min_val}, Max: {max_val}, Moy: {non_nulls.mean():.1f}")
