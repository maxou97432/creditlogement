import statsmodels.api as sm
import pandas as pd
import numpy as np

# Liste pour stocker les résultats de l'analyse
analyse_volume = []

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("Analyse de l'impact de la Volumétrie sur l'Écart...")

for name, group in grouped:
    zone, type_bien = name
    
    # Nettoyage
    df_reg = group.dropna(subset=['Dif', 'NB_BIENS']).copy()
    
    if len(df_reg) > 12:
        try:
            # 1. Transformation du volume (Log pour normaliser)
            # On utilise le Log car la relation prix/volume est souvent non-linéaire
            df_reg['Log_Volume'] = np.log(df_reg['NB_BIENS'])
            
            # 2. Définition des variables
            Y = df_reg['Dif']           # Ce qu'on veut expliquer (L'écart)
            X = df_reg[['Log_Volume']]  # La cause potentielle
            X = sm.add_constant(X)      # Ajout de la constante
            
            # 3. Régression OLS
            model = sm.OLS(Y, X).fit()
            
            # 4. Récupération des résultats clés
            beta_volume = model.params['Log_Volume']
            p_value = model.pvalues['Log_Volume']
            r_squared = model.rsquared
            
            # 5. Interprétation automatique
            significatif = "OUI" if p_value < 0.05 else "NON"
            
            analyse_volume.append({
                "Zone": zone,
                "Type": type_bien,
                "Corrélation (Pearson)": df_reg['Dif'].corr(df_reg['NB_BIENS']).round(2),
                "Impact Volume (Beta)": round(beta_volume, 4),
                "P-value": round(p_value, 4),
                "Significatif à 5%": significatif,
                "R2 (Pouvoir Explicatif)": round(r_squared, 3)
            })
            
        except Exception as e:
            pass

# Création du tableau de synthèse
df_analyse_vol = pd.DataFrame(analyse_volume)

# Affichage des résultats significatifs uniquement
print("\n--- Segments où le Volume explique l'Écart (Significatif) ---")
print(df_analyse_vol[df_analyse_vol["Significatif à 5%"] == "OUI"])

