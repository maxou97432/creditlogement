import pandas as pd
import numpy as np
import plotly.graph_objects as go
from statsmodels.tsa.holtwinters import ExponentialSmoothing
import plotly.io as pio
import warnings

warnings.filterwarnings("ignore")
pio.renderers.default = "notebook" 

n_forecast = 2 
corrected_data = []
future_adjustments = []

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("🚀 Démarrage de la modélisation TES (Holt-Winters)...")

for name, group in grouped:
    zone, type_bien = name
    
    # 1. Préparation : On s'assure d'avoir un DatetimeIndex propre
    group = group.sort_values("Periode")
    group = group.set_index("Periode") # Index est Timestamp
    
    group['Indice de prix (CL) - Corrigé TES'] = np.nan
    
    # Série de l'écart
    ts_ecart = group['Dif'].dropna()
    
    if len(ts_ecart) > 12:
        try:
            # Pour statsmodels, on crée une copie avec un PeriodIndex
            ts_modeling = ts_ecart.copy()
            ts_modeling.index = pd.PeriodIndex(ts_modeling.index, freq='Q')
            
            # 2. Modélisation TES
            model = ExponentialSmoothing(
                ts_modeling, 
                trend='add', 
                seasonal='add', 
                seasonal_periods=4, 
                damped_trend=True, 
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # --- A. Correction Historique (LE FIX EST ICI) ---
            
            # 1. Récupérer les valeurs lissées (fittedvalues)
            fitted_series = model_fit.fittedvalues
            
            # 2. Convertir l'index Period (2015Q1) en Timestamp (2015-01-01)
            # pour qu'il matche l'index du groupe original
            fitted_series.index = fitted_series.index.to_timestamp()
            
            # 3. Réinjecter dans le DataFrame original (Alignement automatique sur les dates)
            # On utilise une série temporaire pour gérer les trous éventuels
            group['Biais_Modelise'] = fitted_series
            
            # 4. Calcul de la correction (Si Biais_Modelise est NaN, le résultat sera NaN)
            group['Indice de prix (CL) - Corrigé TES'] = group['Indice de prix (CL)'] - group['Biais_Modelise']
            
            # --- B. Prévision Future ---
            forecast_bias = model_fit.forecast(steps=n_forecast)
            
            sigma = np.std(model_fit.resid)
            margin_error = 1.96 * sigma
            
            future_adjustments.append({
                "Zone": zone,
                "Type": type_bien,
                "Ajustement T+1": round(forecast_bias.iloc[0], 2),
                "Ajustement T+2": round(forecast_bias.iloc[1], 2),
                "Marge Erreur T+1": round(margin_error, 2)
            })

            # =================================================================
            # 3. Visualisation
            # =================================================================
            
            # Vérification qu'on a des données à tracer
            if group['Indice de prix (CL) - Corrigé TES'].notna().sum() > 0:
                
                fig = go.Figure()

                # Historique INSEE (Noir)
                fig.add_trace(go.Scatter(
                    x=group.index, y=group['Indice de prix (INSEE) - Base 2020'],
                    mode='lines', name='INSEE (Réalité)',
                    line=dict(color='black', width=3)
                ))

                # Historique CL Brut (Rouge)
                fig.add_trace(go.Scatter(
                    x=group.index, y=group['Indice de prix (CL)'],
                    mode='lines', name='CL (Brut)',
                    line=dict(color='red', width=1, dash='dot')
                ))

                # Historique CL Corrigé TES (Bleu) - CELLE QUI MANQUAIT
                fig.add_trace(go.Scatter(
                    x=group.index, y=group['Indice de prix (CL) - Corrigé TES'],
                    mode='lines', name='CL Corrigé (TES)',
                    line=dict(color='blue', width=2)
                ))

                fig.update_layout(
                    title=f"<b>{zone} - {type_bien}</b> : Validation de la Correction Holt-Winters",
                    yaxis_title="Indice (Base 2020 = 100)",
                    template="plotly_white",
                    height=500,
                    legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
                )
                
                fig.show()
            else:
                print(f"⚠️ Pas de données corrigées générées pour {zone}-{type_bien} (Problème de calcul)")
            
        except Exception as e:
            print(f"⚠️ Echec TES pour {name} : {e}")
            
    corrected_data.append(group.reset_index())

# Reconstitution
merge_corrected = pd.concat(corrected_data, ignore_index=True)

# Affichage Tableau
if future_adjustments:
    df_previsions = pd.DataFrame(future_adjustments)
    print("\n" + "="*80)
    print("📊 TABLEAU DE BORD : VALEURS D'AJUSTEMENT PRÉVUES (TES Holt-Winters)")
    print("="*80)
    pd.set_option('display.max_rows', None)
    display(df_previsions)
