def extrapolate_on_dtm_lazy(
    dtm: pl.LazyFrame,
    extr_marg: Union[pl.LazyFrame, pl.DataFrame, pd.DataFrame],
    cum_field: str,
    TTW: int,
    final_value_col: str,
    date_fin: str = "date_fin",
    datdef: str = "datdef_ap_mdef",
) -> pl.LazyFrame:
    """
    Reconstruit les cumuls extrapolés, à l'identique du pandas extrapolate_on_dtm :
      - traitement SÉQUENTIEL des horizons (cum_h utilise cum_{h-1} DÉJÀ mis à jour) ;
      - seules les générations sub.index[:-2] sont remplies ;
      - seule la cellule non-observée (generation + h > sub_max) est remplie ;
      - ouvert -> cum_prev + marge ; fermé -> cum_prev ; sinon -> cum_cur d'origine.
    """
    # 0) Normalisation de l'entrée marginale (reset_index pour garder 'generation')
    if isinstance(extr_marg, pd.DataFrame):
        extr_marg = pl.from_pandas(extr_marg.reset_index())
    if isinstance(extr_marg, pl.DataFrame):
        extr_marg = extr_marg.lazy()

    # 1) Générations cibles (Horizon TTW non nul)
    sub = extr_marg.filter(pl.col(f"Horizon {TTW}").is_not_null())
    if "generation" not in sub.collect_schema().names():
        sub = sub.with_row_index("generation")

    # 2) Renommer Horizon -> M_* (garder generation + marges)
    rename_exprs = [pl.col(f"Horizon {h}").alias(f"M_{h}") for h in range(1, TTW + 1)]
    sub = sub.select(pl.col("generation"), *rename_exprs)

    # 3) Padding côté gauche + jointure
    dtm = _pad_missing_horizons(dtm, target_TTW=TTW)
    joined = dtm.join(sub, on="generation", how="left")

    # 4) Sécuriser les dates
    joined = joined.with_columns([
        pl.col(date_fin).cast(pl.Date).alias(date_fin),
        pl.col(datdef).cast(pl.Date).alias(datdef),
    ])

    # 5) Bornes (équivalent pandas)
    #    sub_max = max génération ayant une marge (== sub.index.max())
    sub_max = pl.col("generation").filter(pl.col(f"M_{TTW}").is_not_null()).max()
    #    sub.index[:-2] : on exclut les 2 dernières générations de sub
    fillable_gen = pl.col("generation") <= (sub_max - 2)

    # 6) Reconstruction SÉQUENTIELLE horizon par horizon
    for h in range(2, TTW + 1):
        cum_prev = f"{cum_field}1an" if h == 2 else f"{cum_field}{h-1}ans"
        cum_cur = f"{cum_field}{h}ans"
        margin_col = f"M_{h}"

        unobserved = (pl.col("generation") + h) > sub_max
        target = fillable_gen & unobserved & pl.col(margin_col).is_not_null()
        open_cond = (
            (pl.col(date_fin) - pl.col(datdef)).dt.total_days() > 365 * (h - 1)
        )

        new_cum = (
            pl.when(target & open_cond).then(pl.col(cum_prev) + pl.col(margin_col))  # ouvert
            .when(target).then(pl.col(cum_prev))                                     # fermé
            .otherwise(pl.col(cum_cur))                                              # garder
            .alias(cum_cur)
        )
        # SÉQUENTIEL : un with_columns par horizon -> cum_prev voit la maj précédente
        joined = joined.with_columns(new_cum)

    # 7) Colonne finale
    joined = joined.with_columns(pl.col(f"{cum_field}{TTW}ans").alias(final_value_col))
    return joined
