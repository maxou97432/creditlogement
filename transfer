    # Agrégation par Univers Élémentaire
    dims = ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
    
    structure = df.groupby(dims, dropna=False).size().reset_index(name="volume_ref")
    
