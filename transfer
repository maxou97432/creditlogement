pio.renderers.default = "png"  
# Dossier de sortie
output_dir = os.path.join(os.path.dirname(__file__), "base_demandes_results")
os.makedirs(output_dir, exist_ok=True)


co = Connector()

################ Importation de la base ################
start_time = time.time()
df = pd.read_parquet(r"Z:\data\cl_estim\cleaned_data\df_demandes_clean.parquet")
end_time = time.time()
print(f"Temps d'importation : {end_time - start_time:.2f} secondes")


################ Fusion avec la base BAN_ENRICHI contenant les codes IRIS ################
df_ban = co.read_sql(
            f"SELECT CLE_INTEROP_ADR, code_iris FROM {params.BAN_ENRICHIE}")
cl_data = pd.merge(df, df_ban, how='left', on='CLE_INTEROP_ADR')
cl_data = cl_data.copy()

# Note : le chronomètre end_time / start_time correspond ici au chargement du parquet
# (la détection d'anomalies n'est pas appliquée sur la base de demandes)
print(f"Temps de fusion avec BAN_ENRICHIE : {end_time - start_time:.2f} secondes")

# periode_reference: paramètre permettant de choisir le mois de référence 
cl_data["DATE"] = pd.to_datetime(cl_data["DATE"], errors="coerce")
periode_reference = None # à changer en fonction de la plage de temps souhaitée
ref_date = periode_reference or cl_data["DATE"].max()

date_max = ref_date
date_min = pd.Timestamp("2014-01-01") ##### à réadapter en fonction

base_ml = cl_data[(cl_data["DATE"] >= date_min) & (cl_data["DATE"] < date_max)]
df_bat = co.read_sql(f"SELECT CLE_INTEROP_ADR, annee_construction FROM {params.BAT_ENRICHIE}")
start_time = time.time()

################ Fusion avec la base BAT_ENRICHI contenant les années de construction ################
base_ml = pd.merge(base_ml, df_bat, how="left", on="CLE_INTEROP_ADR", suffixes=("", "_bat"))
end_time = time.time()
print(f"Temps de fusion avec BAT_ENRICHIE : {end_time - start_time:.2f} secondes")


start_time = time.time()

# Définition de la variable BIEN_NEUF
base_ml.loc[
    base_ml["NATURE_MUTATION"] == "Vente en l'état futur d'achèvement",
    "annee_construction"
] = base_ml["DATE"].dt.year


base_ml["BIEN_NEUF"] = np.where(
        (base_ml["NATURE_MUTATION"]  == "Vente en l'état futur d'achèvement")
        | (base_ml["CD_NATUR_OP"] == "AQN")
        | (abs(base_ml["YEAR"].astype("float") - base_ml["annee_construction"]) <= 2),
        "NEUF",
        "ANCIEN",
    )

end_time = time.time()
print(f"Temps de traitement variable BIEN_NEUF : {end_time - start_time:.2f} secondes")

base_ml = base_ml.copy()
base_ml["NB_PIECES"] = pd.to_numeric(base_ml["NB_PIECES"], errors="coerce")


bins_apt   = [0, 2, 4, np.inf]
labels_apt = ["APT: 1-2 pièces", "APT : 3-4 pièces", "APT: 5 pièces et plus"] # on regroupe les pièces

bins_mai   = [0, 4, np.inf]
labels_mai = ["MAI: 4 pièces et moins", "MAI: 5 pièces et plus"]



mask_apt = base_ml["TYPE_BIEN"].eq("APT")
mask_mai = base_ml["TYPE_BIEN"].eq("MAI")

base_ml.loc[mask_apt, "NB_PIECES_RANGE"] = pd.cut(
    base_ml.loc[mask_apt, "NB_PIECES"],
    bins=bins_apt, labels=labels_apt, right=True, include_lowest=True
).astype(str)

base_ml.loc[mask_mai, "NB_PIECES_RANGE"] = pd.cut(
    base_ml.loc[mask_mai, "NB_PIECES"],
    bins=bins_mai, labels=labels_mai, right=True, include_lowest=True
).astype(str)

base_ml["NB_PIECES_RANGE"] = base_ml["NB_PIECES_RANGE"].astype("object")

base_ml.loc[mask_apt & base_ml["NB_PIECES_RANGE"].isna(), "NB_PIECES_RANGE"] = "APT: Non renseigné"
base_ml.loc[mask_mai & base_ml["NB_PIECES_RANGE"].isna(), "NB_PIECES_RANGE"] = "MAI: Non renseigné"

# Sous-ensemble des colonnes numériques utiles pour les statistiques univariées
analyse = base_ml[["DATE","Prix_m2","NB_SURF_HAB","NB_PIECES_RANGE","annee_construction"]]
# Statistiques globales sur colonnes numériques
print("STATISTIQUES NUMÉRIQUES")
print("-" * 80)
print(analyse.describe())

# Médiane et quartiles
print("\nMédianes et quartiles :")
for col in ["Prix_m2", "NB_SURF_HAB", "NB_PIECES"]:
    if col in analyse.columns:
        print(f"\n{col}:")
        print(f"  Médiane     : {analyse[col].median():,.0f}")
        print(f"  Q1 (25%)    : {analyse[col].quantile(0.25):,.0f}")
        print(f"  Q3 (75%)    : {analyse[col].quantile(0.75):,.0f}")
        print(f"  Écart-type  : {analyse[col].std():,.0f}")

# Répartition par année de construction
print("\nRÉPARTITION PAR ANNÉE DE CONSTRUCTION")
print("-" * 80)
print(analyse["annee_construction"].value_counts().sort_index())

# Répartition par nombre de pièces
print("\nRÉPARTITION PAR NOMBRE DE PIÈCES")
print("-" * 80)
print(analyse["NB_PIECES_RANGE"].value_counts().sort_index())

def analyse_geo(data_class):
    """
    Affiche la répartition géographique des transactions.

    Parameters
    ----------
    data_class : pd.DataFrame
        Base de transactions contenant les colonnes `LIBELLE_DEPT` et `ville_`.
    """
    print("RÉPARTITION GÉOGRAPHIQUE")
    print("-" * 80)
    
    print("\nTop 10 départements avec le plus de transactions :")
    top_dept = data_class['LIBELLE_DEPT'].value_counts().head(10)
    for dept, count in top_dept.items():
        pct = count / len(data_class) * 100
        print(f"  {dept:30s} : {count:5d} ({pct:5.2f}%)")
    print()
    
    print("Top 10 villes avec le plus de transactions :")
    top_ville = data_class['ville_'].value_counts().head(10)
    for ville, count in top_ville.items():
        pct = count / len(data_class) * 100
        print(f"  {ville:30s} : {count:5d} ({pct:5.2f}%)")
    print()

geo = analyse_geo(base_ml)
print(geo)


by_year = base_ml.groupby("YEAR")["ID"].count().reset_index(name="Nombre de transactions")

# Évolution annuelle du nombre de transactions
total_tx = by_year["Nombre de transactions"].sum()

fig = px.bar(
