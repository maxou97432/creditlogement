    print(fin.to_pandas().to_string(index=False))

    # contrôles de cohérence
    n_nan  = out.select(pl.col(FINAL_COL).is_null().sum()).item()
    n_neg  = out.select((pl.col(FINAL_COL) < 0).sum()).item()
    croiss = out.select((pl.col(FINAL_COL) >= pl.col("CRR_1an")).all()).item()
    print(f"\nNaN dans {FINAL_COL}      : {n_nan}")
    print(f"Valeurs négatives        : {n_neg}")
    print(f"final >= CRR_1an (cumul) : {croiss}")
