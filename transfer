        CONFIG = {'output_dir': os.path.join(current_dir, 'outputs')} 

# Chemins des données (ADAPTEZ SI NÉCESSAIRE)
PATH_RESULTATS_V1 = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\bdd_univ_elem_zone_insee"
PATH_RESULTATS_V2 = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\correction base_demande"
PATH_LPI = r"N:\uflumth\indicateur_marche\LPI-IAD donnees (v2).xlsx"

# Chemins Géo
PATH_GEOJSON = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\metropole-version-simplifiee.geojson" 
