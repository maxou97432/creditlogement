df_plot = merge.melt(
    id_vars=["Periode", "VAL_MAILLE_GEO", "CD_TYPE_BIEN"],
    value_vars=["Indice de prix (CL)", "Indice de prix (INSEE) - Base 2020"],
    var_name="Source",
    value_name="Indice_Valeur"
)
df_plot['Segment'] = df_plot['VAL_MAILLE_GEO'] + ' - ' + df_plot['CD_TYPE_BIEN']

# --- Création du Graphique Plotly ---

fig = px.line(
    df_plot,
    x="Periode",
    y="Indice_Valeur",
    color="Source",
    line_group="Segment",
    
    facet_col="Segment", 
    facet_col_wrap=4, # <--- CORRECTION ICI : 4 graphiques par ligne
    
    title="Évolution Comparée des Indices de Prix Immobiliers (Base 2020)",
    labels={
        "Indice_Valeur": "Indice de Prix (Base 2020 = 100)",
        "Periode": "Date (Trimestre)",
        "Source": "Source de l'Indice"
    },
    # Augmenter la hauteur pour accommoder plus de lignes de graphiques
    height=1200 
)

# Ajouter une ligne horizontale à y=100 pour chaque sous-graphique (Base 2020)
fig.update_yaxes(rangemode="tozero")
fig.add_hline(y=100, line_dash="dash", line_color="gray", 
              annotation_text="Base 2020 = 100", annotation_position="top left", row="all", col="all")

# Ajuster l'affichage
fig.update_layout(
    legend_title_text='Légende',
    font=dict(size=10),
    title_x=0.5
)

# Afficher le graphique
fig.show()
