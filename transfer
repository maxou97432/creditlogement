from prophet import Prophet
import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error

# Préparation au format Prophet (ds = date, y = valeur)
df_prophet = pd.DataFrame({
    'ds': train.index.to_timestamp(), # Prophet veut des vraies dates
    'y': train.values
})

# Configuration
# yearly_seasonality=True si on pense qu'il y a un cycle annuel (4 trimestres)
# changepoint_prior_scale : flexibilité de la tendance (0.05 par défaut)
model_prophet = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False)
model_prophet.fit(df_prophet)

# Création du futur
future = model_prophet.make_future_dataframe(periods=n_test, freq='Q')
forecast = model_prophet.predict(future)

# Récupération des prévisions sur la partie Test
pred_prophet = forecast['yhat'].iloc[-n_test:].values
rmse_prophet = np.sqrt(mean_squared_error(test, pred_prophet))

print(f"RMSE Prophet : {rmse_prophet:.4f}")

from xgboost import XGBRegressor

# 1. Feature Engineering : Créer les "Lags" (retards)
df_ml = pd.DataFrame(ts_ecart.copy())
df_ml.columns = ['y']

# On crée des variables explicatives : l'écart d'avant, d'il y a 2 trimestres, et d'il y a un an
df_ml['lag_1'] = df_ml['y'].shift(1)
df_ml['lag_2'] = df_ml['y'].shift(2)
df_ml['lag_4'] = df_ml['y'].shift(4) # Pour capturer la saisonnalité éventuelle

df_ml = df_ml.dropna()

# 2. Split Train/Test respectant la chronologie
X = df_ml[['lag_1', 'lag_2', 'lag_4']]
y = df_ml['y']

X_train = X.iloc[:-n_test]
y_train = y.iloc[:-n_test]
X_test = X.iloc[-n_test:]
y_test = y.iloc[-n_test:]

# 3. Modélisation
model_xgb = XGBRegressor(n_estimators=100, learning_rate=0.1, max_depth=3, objective='reg:squarederror')
model_xgb.fit(X_train, y_train)

# 4. Prévision (Attention : en récursif pour aller loin dans le futur, ici on fait du one-step pour simplifier le test)
pred_xgb = model_xgb.predict(X_test)
rmse_xgb = np.sqrt(mean_squared_error(y_test, pred_xgb))

print(f"RMSE XGBoost : {rmse_xgb:.4f}")
