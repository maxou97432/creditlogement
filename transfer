# LGD pondérée par EAD, 1 ligne par (obligor, date_défaut, classe).
# Si la classe varie entre facilités d'un même obligor, il est scindé par classe (voulu).
df_obligor = (
    lf_LGD
    .group_by([config['Obligor'], config['Date_defaut'], "Jenks_Submodel"])
    .agg(
        (pl.col('LGD') * pl.col(config['EAD'])).sum().alias("_num"),
        pl.col(config['EAD']).sum().alias("_den"),
        pl.len().alias("nb_facilites"),
    )
    .with_columns(
        pl.when(pl.col("_den") != 0)              # garde-fou : pas de division par 0 exact
          .then(pl.col("_num") / pl.col("_den"))
          .otherwise(None)
          .alias("lgd_obligor")
    )
)
