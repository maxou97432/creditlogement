def ajouter_pivot_combine(workbook, df_stats_quali, df_stats_quanti,
                            sheet_name="Pivot_target_annee",
                            nom_feuille_quali="Stats_quali",
                            nom_feuille_quanti="Stats_quanti",
                            variable_defaut=None):
    """
    Onglet unique avec sélecteur de variable (quali + quanti confondues) et
    graphique dynamique de target_moyenne par modalité x année.

    Colonnes réelles dans Stats_quali / Stats_quanti (startcol=1, index=False) :
    B=variable, C=type_variable, D=modalite, E=annee, F=effectif,
    G=pct_effectif, H=target_moyenne.
    """
    variables_quali = sorted(df_stats_quali["variable"].unique())
    variables_quanti = sorted(df_stats_quanti["variable"].unique())
    toutes_variables = variables_quali + variables_quanti
    var_defaut = variable_defaut or (toutes_variables[0] if toutes_variables else "")

    annees = sorted(
        set(df_stats_quali["annee"].dropna().unique())
        | set(df_stats_quanti["annee"].dropna().unique())
    )

    modalites_par_var = {
        v: sorted(df_stats_quali.loc[df_stats_quali["variable"] == v, "modalite"].unique())
        for v in variables_quali
    }
    modalites_par_var.update({
        v: sorted(df_stats_quanti.loc[df_stats_quanti["variable"] == v, "modalite"].unique())
        for v in variables_quanti
    })
    nb_modalites_max = max((len(m) for m in modalites_par_var.values()), default=0)

    ws = workbook.add_worksheet(sheet_name)
    ws.hide_gridlines(2)

    # --- Table de correspondance cachée : variable -> nom de feuille source ---
    ligne_mapping = 100
    ws.write(ligne_mapping, 0, "variable")
    ws.write(ligne_mapping, 1, "feuille_source")
    for i, v in enumerate(variables_quali):
        ws.write(ligne_mapping + 1 + i, 0, v)
        ws.write(ligne_mapping + 1 + i, 1, nom_feuille_quali)
    offset = len(variables_quali)
    for i, v in enumerate(variables_quanti):
        ws.write(ligne_mapping + 1 + offset + i, 0, v)
        ws.write(ligne_mapping + 1 + offset + i, 1, nom_feuille_quanti)

    # --- Sélecteur de variable ---
    ws.write("B2", "Variable :")
    ws.write("C2", var_defaut)
    ws.data_validation("C2", {"validate": "list", "source": toutes_variables})

    ws.write("B3", "Feuille source (debug) :")
    ws.write_formula(
        "C3",
        f'=VLOOKUP($C$2,$A${ligne_mapping+1}:$B${ligne_mapping+len(toutes_variables)},2,FALSE)'
    )

    # --- Table calculée : modalités (colonne D des feuilles sources) x années (E) ---
    startrow = 4
    ws.write(startrow, 1, "Modalité")
    for j, annee in enumerate(annees):
        ws.write(startrow, 2 + j, annee)

    for i in range(nb_modalites_max):
        row = startrow + 1 + i

        formule_modalite = (
            f'=IFERROR(INDEX(SORT(UNIQUE('
            f'FILTER(INDIRECT($C$3&"!D:D"),INDIRECT($C$3&"!B:B")=$C$2))),{i+1}),"")'
        )
        ws.write_formula(row, 1, formule_modalite)

        for j in range(len(annees)):
            col = 2 + j
            col_lettre_annee = col_lettre(col)
            formule_moyenne = (
                f'=IFERROR(AVERAGEIFS(INDIRECT($C$3&"!H:H"),'
                f'INDIRECT($C$3&"!B:B"),$C$2,'
                f'INDIRECT($C$3&"!D:D"),$B{row+1},'
                f'INDIRECT($C$3&"!E:E"),{col_lettre_annee}${startrow+1}),"")'
            )
            ws.write_formula(row, col, formule_moyenne)

    # --- Graphique ---
    chart = workbook.add_chart({"type": "line"})
    for j, annee in enumerate(annees):
        col = 2 + j
        chart.add_series({
            "name": [sheet_name, startrow, col],
            "categories": [sheet_name, startrow + 1, 1, startrow + nb_modalites_max, 1],
            "values": [sheet_name, startrow + 1, col, startrow + nb_modalites_max, col],
        })
    chart.set_title({"name": "Target moyenne par modalité et par année"})
    chart.set_x_axis({"name": "Modalité"})
    chart.set_y_axis({"name": "Target moyenne"})
    ws.insert_chart(f"B{startrow + nb_modalites_max + 4}", chart, {"x_scale": 1.5, "y_scale": 1.3})

    return ws


def col_lettre(col_idx_0based):
    """Convertit un index de colonne 0-based en lettre Excel (0 -> A, 1 -> B...)."""
    lettre = ""
    col_idx_0based += 1
    while col_idx_0based > 0:
        col_idx_0based, reste = divmod(col_idx_0based - 1, 26)
        lettre = chr(65 + reste) + lettre
    return lettre

def colorer_matrice_correlation(worksheet, df, startcol=1, startrow=1):
    """Dégradé 3 couleurs sur la matrice V de Cramér (0 à 1)."""
    nb_lignes, nb_cols = df.shape
    worksheet.conditional_format(
        startrow, startcol, startrow + nb_lignes - 1, startcol + nb_cols - 1,
        {
            "type": "3_color_scale",
            "min_type": "num", "min_value": 0, "min_color": "#FFFFFF",
            "mid_type": "num", "mid_value": 0.5, "mid_color": "#FDBE85",
            "max_type": "num", "max_value": 1, "max_color": "#D7301F",
        },
    )


def exporter_stat_desc_excel(chemin, correlation=None, stats_quali=None,
                             stats_quanti=None, seuils_cart=None, export_brut=None):
    chemin = Path(chemin)
    chemin.parent.mkdir(parents=True, exist_ok=True)

    with pd.ExcelWriter(chemin, engine="xlsxwriter") as writer:
        onglets = [
            ("Full_correlation", correlation, "#8E44AD", True),
            ("Stats_quali",      stats_quali, "#006C44", False),
            ("Stats_quanti",     stats_quanti, "#006C44", False),
            ("Seuils_CART",      seuils_cart, "#B7950B", False),
            ("Export_brut",      export_brut, "#5D6D7E", False),
        ]
        ecrits = []
        for nom, df, couleur, index in onglets:
            if df is not None and len(df) > 0:
                ws = write_formatted_sheet(writer, df, nom, tab_color=couleur, index=index)
                if nom == "Full_correlation":
                    # startrow=1 (header en ligne 0), startcol dépend de index=True
                    # (colonne des labels de lignes en plus)
                    colorer_matrice_correlation(ws, df, startcol=2, startrow=1)
                ecrits.append(nom)

        if stats_quali is not None and stats_quanti is not None \
           and len(stats_quali) > 0 and len(stats_quanti) > 0:
            df_quali_pd = stats_quali.to_pandas() if isinstance(stats_quali, pl.DataFrame) else stats_quali
            df_quanti_pd = stats_quanti.to_pandas() if isinstance(stats_quanti, pl.DataFrame) else stats_quanti
            ajouter_pivot_combine(writer.book, df_quali_pd, df_quanti_pd)
            ecrits.append("Pivot_target_annee")

    print(f"Fichier stat desc écrit : {chemin}")
    print(f"   Onglets : {', '.join(ecrits)}")
    return chemin
