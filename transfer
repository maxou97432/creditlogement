import polars as pl
import openpyxl
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import io
from openpyxl.styles import PatternFill, Font, Alignment, Border, Side
from openpyxl.utils import get_column_letter
from openpyxl.drawing.image import Image as XLImage

def carto_chr_excel(
    df,
    output_path,
    chr_col       = "CHR_apres_fusion",
    jenks_col     = "Jenks_Submodel",
    lgd_col       = "lgd_obligor",
    obligor_col   = "ID_CLIENT",
    year_col      = "year",
    title         = "Carto CHR",
):
    """
    4 feuilles :
      1. Tableau_Simple    : mean_lgd simple par (CHR, year) + LRA
      2. Graphique_Simple  : courbe par CHR, LGD simple
      3. Tableau_Pondere   : mean_lgd pondérée par n_obligors Jenks par (CHR, year) + LRA
      4. Graphique_Pondere : courbe par CHR, LGD pondérée
    Classes triées par LGD moyenne croissante.
    """
    # ---- Styles ----
    BLUE_DARK  = PatternFill("solid", fgColor="1F4E79")
    BLUE_LIGHT = PatternFill("solid", fgColor="BDD7EE")
    WHITE      = PatternFill("solid", fgColor="FFFFFF")
    GREY       = PatternFill("solid", fgColor="F2F2F2")
    FONT_WHITE  = Font(color="FFFFFF", bold=True, size=10)
    FONT_BOLD   = Font(bold=True, size=10)
    FONT_NORMAL = Font(size=10)
    CENTER = Alignment(horizontal="center", vertical="center")
    LEFT   = Alignment(horizontal="left",   vertical="center")
    thin   = Side(style="thin", color="BFBFBF")
    BORDER = Border(left=thin, right=thin, top=thin, bottom=thin)

    def sc(cell, value, fill=WHITE, font=FONT_NORMAL, align=CENTER):
        cell.value = value; cell.fill = fill
        cell.font  = font;  cell.alignment = align; cell.border = BORDER

    def auto_width(ws):
        for col in ws.columns:
            max_len = max(len(str(c.value)) if c.value is not None else 0 for c in col)
            ws.column_dimensions[get_column_letter(col[0].column)].width = min(max_len+4, 30)

    def classes_by_lgd(data, col, lgd):
        return (
            data.group_by(col)
            .agg(pl.col(lgd).mean().alias("_m"))
            .sort("_m")
            .get_column(col)
            .to_list()
        )

    all_years   = sorted(df[year_col].drop_nulls().unique().to_list())
    all_classes = classes_by_lgd(df, chr_col, lgd_col)

    # ================================================================
    # CALCUL 1 : LGD simple par (CHR, year)
    # ================================================================
    t_simple = (
        df.group_by([chr_col, year_col])
        .agg([
            pl.col(lgd_col).mean().round(4).alias("mean_lgd"),
            pl.col(lgd_col).std(ddof=1).round(4).alias("std_lgd"),
            pl.col(obligor_col).n_unique().alias("n_obligors"),
        ])
    )
    t_simple_dict = {
        (r[chr_col], r[year_col]): r
        for r in t_simple.iter_rows(named=True)
    }

    # LRA simple : moyenne des moyennes annuelles
    lra_simple = (
        t_simple
        .group_by(chr_col)
        .agg([
            pl.col("mean_lgd").mean().round(4).alias("LRA"),
            pl.col("n_obligors").sum().alias("n_obligors_total"),
        ])
    )
    lra_simple_dict = {r[chr_col]: r for r in lra_simple.iter_rows(named=True)}

    # ================================================================
    # CALCUL 2 : LGD pondérée par n_obligors Jenks par (CHR, year)
    # ================================================================
    # Étape 1 : stats par (Jenks, CHR, year)
    t_jenks = (
        df.group_by([jenks_col, chr_col, year_col])
        .agg([
            pl.col(lgd_col).mean().round(4).alias("mean_lgd_jenks"),
            pl.col(obligor_col).n_unique().alias("n_obligors_jenks"),
        ])
    )

    # Étape 2 : moyenne pondérée par n_obligors_jenks -> (CHR, year)
    t_pondere = (
        t_jenks
        .with_columns(
            (pl.col("mean_lgd_jenks") * pl.col("n_obligors_jenks")).alias("_weighted")
        )
        .group_by([chr_col, year_col])
        .agg([
            (pl.col("_weighted").sum() / pl.col("n_obligors_jenks").sum())
            .round(4).alias("mean_lgd_pond"),
            pl.col("n_obligors_jenks").sum().alias("n_obligors"),
        ])
    )
    t_pondere_dict = {
        (r[chr_col], r[year_col]): r
        for r in t_pondere.iter_rows(named=True)
    }

    # LRA pondérée : moyenne des moyennes pondérées annuelles
    lra_pondere = (
        t_pondere
        .group_by(chr_col)
        .agg([
            pl.col("mean_lgd_pond").mean().round(4).alias("LRA_pond"),
            pl.col("n_obligors").sum().alias("n_obligors_total"),
        ])
    )
    lra_pondere_dict = {r[chr_col]: r for r in lra_pondere.iter_rows(named=True)}

    # ================================================================
    # FONCTIONS D'ÉCRITURE
    # ================================================================
    def write_tableau(ws, t_dict, lgd_key, lra_key, classes, years,
                      r_start, section_title, lra_dict):
        r = r_start
        n_cols = 1 + len(years) * 2 + 1  # classe + (mean, n) par année + LRA

        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=n_cols)
        sc(ws.cell(r, 1), section_title,
           fill=BLUE_DARK, font=Font(color="FFFFFF", bold=True, size=12))
        r += 1

        # Header années
        sc(ws.cell(r, 1), chr_col, fill=BLUE_DARK, font=FONT_WHITE)
        for i, yr in enumerate(years):
            cs = 2 + i * 2
            ws.merge_cells(start_row=r, start_column=cs, end_row=r, end_column=cs+1)
            sc(ws.cell(r, cs), str(yr), fill=BLUE_DARK, font=FONT_WHITE)
        sc(ws.cell(r, 2 + len(years)*2), "LRA", fill=BLUE_DARK, font=FONT_WHITE)
        r += 1

        # Sous-header
        sc(ws.cell(r, 1), "", fill=BLUE_LIGHT, font=FONT_BOLD)
        for i in range(len(years)):
            cs = 2 + i * 2
            sc(ws.cell(r, cs),   "mean_lgd",   fill=BLUE_LIGHT, font=FONT_BOLD)
            sc(ws.cell(r, cs+1), "n_obligors",  fill=BLUE_LIGHT, font=FONT_BOLD)
        sc(ws.cell(r, 2 + len(years)*2), "mean", fill=BLUE_LIGHT, font=FONT_BOLD)
        r += 1

        # Données
        for idx, cls in enumerate(classes):
            fill = WHITE if idx % 2 == 0 else GREY
            sc(ws.cell(r, 1), cls, fill=fill, font=FONT_NORMAL, align=LEFT)
            for i, yr in enumerate(years):
                cs = 2 + i * 2
                d = t_dict.get((cls, yr), {})
                sc(ws.cell(r, cs),   d.get(lgd_key,      ""), fill=fill)
                sc(ws.cell(r, cs+1), d.get("n_obligors",  ""), fill=fill)
            lra_val = lra_dict.get(cls, {}).get(lra_key, "")
            sc(ws.cell(r, 2 + len(years)*2), lra_val,
               fill=fill, font=Font(bold=True, size=10))
            r += 1

        return r + 2

    def write_graphique(ws, t_dict, lgd_key, classes, years, r_start, graph_title):
        ws.merge_cells(start_row=r_start, start_column=1,
                       end_row=r_start, end_column=10)
        sc(ws.cell(r_start, 1), graph_title,
           fill=BLUE_DARK, font=Font(color="FFFFFF", bold=True, size=12))

        n_classes = len(classes)
        fig_h = max(5, n_classes * 0.25)
        fig, ax = plt.subplots(figsize=(14, fig_h))
        colors = plt.cm.tab20.colors

        for i, cls in enumerate(classes):
            means, yrs_plot = [], []
            for yr in years:
                val = t_dict.get((cls, yr), {}).get(lgd_key)
                if val is not None:
                    means.append(val)
                    yrs_plot.append(yr)
            if means:
                ax.plot(yrs_plot, means, marker="o", label=cls,
                        color=colors[i % len(colors)],
                        linewidth=1.5, alpha=0.85)

        ax.set_title(graph_title, fontsize=13)
        ax.set_xlabel("Année")
        ax.set_ylabel(f"{lgd_col}")
        ax.legend(loc="upper left", bbox_to_anchor=(1, 1),
                  fontsize=6, ncol=max(1, n_classes // 20))
        ax.grid(True, alpha=0.3)
        plt.tight_layout()

        buf = io.BytesIO()
        fig.savefig(buf, format="png", dpi=120, bbox_inches="tight")
        plt.close(fig)
        buf.seek(0)

        img = XLImage(buf)
        img.anchor = f"A{r_start + 1}"
        ws.add_image(img)

    # ================================================================
    # CONSTRUCTION DU WORKBOOK
    # ================================================================
    wb = openpyxl.Workbook()
    wb.remove(wb.active)

    # Feuille 1 : Tableau simple
    ws1 = wb.create_sheet(title="Tableau_Simple")
    write_tableau(
        ws1, t_simple_dict, "mean_lgd", "LRA",
        all_classes, all_years, r_start=1,
        section_title=f"{title} — LGD moyenne simple par classe × année",
        lra_dict=lra_simple_dict,
    )
    auto_width(ws1)

    # Feuille 2 : Graphique simple
    ws2 = wb.create_sheet(title="Graphique_Simple")
    write_graphique(
        ws2, t_simple_dict, "mean_lgd",
        all_classes, all_years, r_start=1,
        graph_title=f"{title} — LGD moyenne simple par classe fusionnée",
    )
    auto_width(ws2)

    # Feuille 3 : Tableau pondéré
    ws3 = wb.create_sheet(title="Tableau_Pondere")
    write_tableau(
        ws3, t_pondere_dict, "mean_lgd_pond", "LRA_pond",
        all_classes, all_years, r_start=1,
        section_title=f"{title} — LGD pondérée par n_obligors Jenks × année",
        lra_dict=lra_pondere_dict,
    )
    auto_width(ws3)

    # Feuille 4 : Graphique pondéré
    ws4 = wb.create_sheet(title="Graphique_Pondere")
    write_graphique(
        ws4, t_pondere_dict, "mean_lgd_pond",
        all_classes, all_years, r_start=1,
        graph_title=f"{title} — LGD pondérée par n_obligors Jenks",
    )
    auto_width(ws4)

    wb.save(output_path)
    print(f"Sauvegardé : {output_path}")
    return wb


