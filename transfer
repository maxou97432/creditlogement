from prophet import Prophet
from prophet.diagnostics import cross_validation, performance_metrics
import itertools
import pandas as pd
import logging

# On coupe les logs de Prophet qui sont très verbeux
logging.getLogger('cmdstanpy').setLevel(logging.WARNING)

# 1. Préparation des données (Format Prophet)
# ATTENTION : Pour la CV, on lui donne TOUTE la série disponible (pas de split manuel ici)
# Prophet fera les coupes lui-même.
df_prophet_full = pd.DataFrame({
    'ds': ts_ecart.index.to_timestamp(), 
    'y': ts_ecart.values
})

# 2. Grille de paramètres
param_grid = {  
    'changepoint_prior_scale': [0.01, 0.05, 0.1, 0.5], # Souplesse de la tendance
    'seasonality_prior_scale': [0.1, 1.0, 10.0],       # Force de la saisonnalité
    'seasonality_mode': ['additive']                   # Additif car l'écart est stable en amplitude
}

all_params = [dict(zip(param_grid.keys(), v)) for v in itertools.product(*param_grid.values())]

best_rmse = float('inf')
best_params = {}

print(f"Démarrage de la Cross-Validation sur {len(all_params)} combinaisons...")
print("Cela peut être long (Prophet entraîne 3 à 5 modèles par combinaison)...")

# 3. Boucle d'Optimisation par Cross-Validation
for params in all_params:
    try:
        m = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False, **params)
        m.fit(df_prophet_full)
        
        # --- LA MAGIE DE LA CROSS-VALIDATION PROPHET ---
        # initial : Taille de l'historique minimum pour commencer à apprendre (ex: '5 years')
        # period  : On avance de combien à chaque test ? (ex: '180 days' = 2 trimestres)
        # horizon : On prédit combien de temps ? (ex: '730 days' = 2 ans, comme ton n_test)
        
        df_cv = cross_validation(
            m, 
            initial='1825 days',  # ~5 ans d'historique pour commencer
            period='180 days',    # On re-teste tous les 6 mois
            horizon='730 days',   # On teste la prévision sur 2 ans
            parallel="processes"  # Accélère le calcul si possible
        )
        
        # Calcul des métriques moyennes sur toutes les coupes
        df_p = performance_metrics(df_cv, rolling_window=1)
        rmse_cv = df_p['rmse'].values[0] # RMSE moyen de la CV
        
        if rmse_cv < best_rmse:
            best_rmse = rmse_cv
            best_params = params
            print(f"-> Nouveau meilleur RMSE (CV) : {best_rmse:.4f} avec {params}")
            
    except Exception as e:
        continue

print("-" * 50)
print(f"🏆 MEILLEURS PARAMÈTRES (Validés par CV) : {best_params}")
print(f"RMSE Moyen sur les différentes périodes : {best_rmse:.4f}")
print("-" * 50)

# 4. Entraînement Final & Prévision (Pour comparaison avec Holt/XGBoost)
# On ré-entraîne le meilleur modèle sur le TRAIN SET MANUEL pour comparer équitablement
final_prophet = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False, **best_params)

