# Test des colonnes candidates trouvées pour la Règle 2
colonnes_candidates = [c for c in srs.columns if 'DURATION' in c.upper() or 'MOY' in c.upper() or 'AUTO' in c.upper()]

for col_name in colonnes_candidates:
    print(f"\n--- Test de la colonne {col_name} ---")
    
    # Exclure les dates de début (on ne veut que des dates de maturité)
    if 'DEB' in col_name.upper():
        print("Ignorée (c'est une date de début).")
        continue

    # Transformation de la date candidate
    test_r2 = srs.with_columns(
        pl.when(pl.col(col_name) > 300000) # Format YYYYMMDD
        .then(pl.col(col_name).cast(pl.Utf8).str.to_date('%Y%m%d'))
        .otherwise(pl.lit(date(1960, 1, 1)) + pl.duration(days=pl.col(col_name).cast(pl.Int64)))
        .alias('Candidate_Date')
    ).filter(pl.col('Candidate_Date').is_not_null())

    if test_r2.height == 0:
        print(f"La colonne {col_name} est vide.")
        continue
        
    # Appliquer la Règle 2 de ton document : D = (Duration date - As of date) / 365.25
    test_r2 = test_r2.with_columns(
        ((pl.col('Candidate_Date') - pl.lit(date(2025, 6, 30))).dt.total_days() / 365.25).alias('D_Rule2')
    ).with_columns(
        (pl.col('D_Rule2') - pl.col('NB_MATURITE_IRBA')).abs().alias('Ecart')
    )
    
    # Vérifier le Match exact !
    matches = test_r2.filter(pl.col('Ecart') < 0.001).height
    print(f"Match avec NB_MATURITE_IRBA : {matches} / {test_r2.height} ({matches/test_r2.height:.1%})")
