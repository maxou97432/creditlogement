
def analyser_par_critere(outliers_df):
    """Analyse la répartition des outliers par critère d'élimination"""
    print("\n" + "="*80)
    print("ANALYSE PAR CRITÈRE D'ÉLIMINATION")
    print("="*80)
    
    # Séparer les critères multiples (séparés par |)
    criteres_list = []
    for idx, row in outliers_df.iterrows():
        reasons = str(row["OUTLIER_REASON"]).split("|") if pd.notna(row["OUTLIER_REASON"]) else ["Non spécifié"]
        for reason in reasons:
            criteres_list.append(reason.strip())
    
    criteres_counts = pd.Series(criteres_list).value_counts()
    
    print(f"\nNombre total d'outliers : {len(outliers_df):,}")
    print(f"\nRépartition par critère (un outlier peut avoir plusieurs critères) :")
    print("-" * 80)
    for critere, count in criteres_counts.items():
        pct = count / len(outliers_df) * 100
        print(f"  {critere:35s} : {count:6,} ({pct:5.2f}%)")
    
    # Outliers avec critères multiples
    outliers_multi = outliers_df[outliers_df["OUTLIER_REASON"].str.contains("|", na=False)]
    pct_multi = len(outliers_multi) / len(outliers_df) * 100
    print(f"\nOutliers avec critères multiples : {len(outliers_multi):,} ({pct_multi:.2f}%)")
    print()
    
    return criteres_counts


def analyse_geo_par_critere(outliers_df):
    """Analyse géographique des outliers par critère"""
    print("\n" + "="*80)
    print("RÉPARTITION GÉOGRAPHIQUE PAR CRITÈRE D'ÉLIMINATION")
    print("="*80)
    
    # Obtenir les critères uniques
    all_criteres = set()
    for reasons in outliers_df["OUTLIER_REASON"].dropna():
        for reason in str(reasons).split("|"):
            all_criteres.add(reason.strip())
    
    for critere in sorted(all_criteres):
        if critere == "Non spécifié":
            continue
            
        # Filtrer les outliers pour ce critère
        mask = outliers_df["OUTLIER_REASON"].str.contains(critere, na=False, regex=False)
        subset = outliers_df[mask]
        
        if len(subset) == 0:
            continue
            
        print(f"\n📍 Critère : {critere}")
        print("-" * 80)
        
        # Top 5 départements
        if "LIBELLE_DEPT" in subset.columns:
            print(f"\nTop 5 départements ({len(subset):,} outliers) :")
            top_dept = subset["LIBELLE_DEPT"].value_counts().head(5)
            for dept, count in top_dept.items():
                pct = count / len(subset) * 100
                print(f"  {dept:35s} : {count:5,} ({pct:5.2f}%)")
        
        # Top 5 villes
        if "ville_" in subset.columns:
            print(f"\nTop 5 villes :")
            top_ville = subset["ville_"].value_counts().head(5)
            for ville, count in top_ville.items():
                pct = count / len(subset) * 100
                print(f"  {ville:35s} : {count:5,} ({pct:5.2f}%)")
    print()


def analyse_temporelle_par_critere(outliers_df):
    """Analyse temporelle des outliers par critère"""
    print("\n" + "="*80)
    print("ÉVOLUTION TEMPORELLE PAR CRITÈRE D'ÉLIMINATION")
    print("="*80)
    
    # Obtenir les critères uniques
    all_criteres = set()
    for reasons in outliers_df["OUTLIER_REASON"].dropna():
        for reason in str(reasons).split("|"):
            all_criteres.add(reason.strip())
    
    for critere in sorted(all_criteres):
        if critere == "Non spécifié":
            continue
            
        # Filtrer les outliers pour ce critère
        mask = outliers_df["OUTLIER_REASON"].str.contains(critere, na=False, regex=False)
        subset = outliers_df[mask]
        
        if len(subset) == 0 or "YEAR" not in subset.columns:
            continue
            
        print(f"\n📅 Critère : {critere}")
        print("-" * 80)
        
        # Répartition par année
        year_counts = subset["YEAR"].value_counts().sort_index()
        print(f"\nÉvolution par année ({len(subset):,} outliers au total) :")
        for year, count in year_counts.items():
            pct = count / len(subset) * 100
            bar_length = int(pct / 2)  # Barre visuelle
            bar = "█" * bar_length
            print(f"  {year} : {count:5,} ({pct:5.2f}%) {bar}")
    print()


