def fusion_glouton(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = None,
    log: bool = False,
    obligor_col: str = 'ID_CLIENT',
) -> Tuple[pl.LazyFrame, Optional[Dict[str, str]]]:
    """
    Applique itérativement la fusion des classes tant qu'une paire violante existe.
    Retourne le DataFrame final et le dictionnaire `{ancienne_classe: nouvelle_classe}`.
    L'argument `log` est propagé à `meilleur_candidat_fusion`.
    
    La réagrégation après fusion utilise une moyenne pondérée par n_obligors distincts
    (grain obligor) pour calculer la LGD de la classe fusionnée, conformément à la
    formule : LGD_[k->m],t = Σ(LGD_l,t * E_l,t) / Σ(E_l,t)
    """
    mapping: Dict[str, str] = {}

    while True:
        paire, debug_df = meilleur_candidat_fusion(
            df,
            nb_croisements_max=nb_croisements_max,
            ans_strict=ans_strict,
            lgd_col=lgd_col,
            jenks_col=jenks_col,
            log=log,
        )

        if not paire:                               # plus rien à fusionner
            nb_final = df.collect().select(jenks_col).n_unique()
            print(f"SUCCES : {nb_final} classes finales.")
            break

        c1, c2 = paire
        nouveau_nom = f"{c1}_{c2}"
        print(f"Fusion de {c1} et de {c2} (sévérité = {debug_df['severite_totale'][0]})")

        # ----------------------------------------------------------------
        # Mise à jour du dictionnaire de mapping (chaînes déjà fusionnées)
        # ----------------------------------------------------------------
        for ancien, actuel in list(mapping.items()):
            if actuel in (c1, c2):
                mapping[ancien] = nouveau_nom

        for elem in (c1, c2):
            if elem not in mapping:
                mapping[elem] = nouveau_nom

        replace_tmp = {c1: nouveau_nom, c2: nouveau_nom}
        mapping.update(replace_tmp)

        # ----------------------------------------------------------------
        # Application de la fusion sur le DataFrame
        # On reste au GRAIN CONTRAT — on renomme juste la classe
        # ----------------------------------------------------------------
        df = df.with_columns(
            pl.col(jenks_col)
              .cast(pl.Utf8)
              .replace(replace_tmp)
              .alias(jenks_col)
        )

        # ----------------------------------------------------------------
        # Réagrégation pour meilleur_candidat_fusion à l'itération suivante
        # On calcule la LGD pondérée par n_obligors SANS toucher à df
        # Étape 1 : grain contrat -> grain (classe, year, obligor)
        # Étape 2 : grain (classe, year, obligor) -> grain (classe, year)
        #           avec moyenne pondérée par n_obligors
        # ----------------------------------------------------------------
        df_pond = (
            df
            # Étape 1 : LGD moyenne par obligor (toutes ses facilités dans la classe)
            .group_by([jenks_col, "year", obligor_col])
            .agg(
                pl.col(lgd_col).mean().alias("_lgd_obligor")
            )
            # Étape 2 : stats par (classe, year)
            .group_by([jenks_col, "year"])
            .agg([
                pl.col("_lgd_obligor").mean().alias("_lgd_mean"),
                pl.col(obligor_col).n_unique().alias("_n_obligors"),
            ])
            # Moyenne pondérée par n_obligors
            .with_columns(
                (pl.col("_lgd_mean") * pl.col("_n_obligors")).alias("_num")
            )
            .group_by(jenks_col)
            .agg(
                (pl.col("_num").sum() / pl.col("_n_obligors").sum())
                .alias(lgd_col)
            )
        )

        # Left join sur df pour ramener la lgd pondérée sans perdre le grain contrat
        df = (
            df
            .drop(lgd_col)                          # retire l'ancienne lgd
            .join(
                df_pond.select([jenks_col, lgd_col]),
                on=jenks_col,
                how="left"
            )
        )

    return df, mapping
