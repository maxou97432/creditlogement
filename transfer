r_annees = (pl.col('DT_ECHEANCE_FEM') - 23922) / 365.25

srs_fusion = srs_fusion.with_columns(
    pl.when(
        # Règle de sécurité : Si le taux est nul OU que c'est un code "sans amortissement"
        (pl.col('T_INTRT').cast(pl.Float64) == 0.0) | 
        (pl.col('CD_ENGAGEMENT').is_in(exclusif_099)) |
        (r_annees <= 1.0)
    )
    .then(r_annees) # On renvoie la maturité brute
    .otherwise(
        # Sinon, on applique la formule actuarielle avec le taux !
        Formule_Amortissement_Groupe_1_ou_3
    )
    .alias('NB_MATURITE_IRBA_CALCULE')
)
