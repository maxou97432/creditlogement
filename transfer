    try:
        raw_v2 = pd.read_parquet(PATH_BASE_V2)
    except:
        sys.exit(f"Erreur chargement V2: {PATH_BASE_V2}")

    # Nettoyage et Filtres
    df_v1 = clean_base(raw_v1, TOP15)
    
    df_v2 = clean_base(raw_v2, TOP15)
    df_v2 = df_v2[df_v2["DEMANDE"] == 0] # Filtre spécifique V2
    
    print(f"V1 Clean: {len(df_v1)} lignes | V2 Clean: {len(df_v2)} lignes")

    # -------------------------------------------------------------------------
    # B. CALCUL DES INDICES (STANDARD & HYBRIDE)
    # -------------------------------------------------------------------------
    
    # 1. Extraction Structure V1
    structure_v1 = get_structure_reference_city(df_v1)
    
    # 2. Calcul V1 (Standard : Poids V1 sur Prix V1)
    res_v1 = process_dataset_hybrid(df_v1, "V1", df_structure=None)
    
    # 3. Calcul V2 (Hybride : Poids V1 sur Prix V2)
    res_v2 = process_dataset_hybrid(df_v2, "V2", df_structure=structure_v1)
    
    # 4. Fusion
    merge_cl = pd.merge(res_v1, res_v2, on=["Ville", "Periode"], how="outer")
    
    # -------------------------------------------------------------------------
    # C. CHARGEMENT LPI ET ANALYSE
    # -------------------------------------------------------------------------
    print("\n--- Chargement LPI/IAD ---")
    try:
        lpi = pd.read_excel(PATH_LPI_V2, sheet_name="V2", skiprows=2)
        lpi = lpi.iloc[:, :3] # Garde Date, Ville, Prix
        lpi.columns = ["Periode", "Ville", "Prix_LPI"]
        
        lpi["Periode"] = pd.to_datetime(lpi["Periode"], errors='coerce')
        lpi["Ville"] = lpi["Ville"].astype(str).str.strip().str.upper()
        lpi["Prix_LPI"] = pd.to_numeric(lpi["Prix_LPI"], errors='coerce')
        
        # Filtre LPI sur Top 15
        lpi = lpi[lpi["Ville"].isin(TOP15)]
    except Exception as e:
        print(f"Erreur LPI: {e}. Continuation sans.")
        lpi = pd.DataFrame(columns=["Periode", "Ville", "Prix_LPI"])

    # Fusion Finale
    merge_cl = merge_cl.rename(columns={"Periode": "DATE"}) # Pour coller à ton code Prophet
    merge_cl["DATE"] = pd.to_datetime(merge_cl["DATE"])
    
    final_fusion = pd.merge(lpi, merge_cl, left_on=["Ville", "Periode"], right_on=["Ville", "DATE"], how="right")
    # Si LPI est vide, on garde quand même les données CL
    if "DATE" in final_fusion.columns:
        final_fusion["DATE"] = final_fusion["DATE"].combine_first(final_fusion["Periode"])
    
    # Renommage final pour les graphs
    final_fusion = final_fusion.rename(columns={
        "prix_mm_12m (V1)": "Prix moyen glissant 12 mois - Univ Elem (V1)",
        "prix_mm_12m (V2)": "Prix moyen glissant 12 mois - Univ Elem (V2)",
        "Prix_LPI": "Prix moyen glissant 12 mois - LPI/IAD"
    })
    
    # Filtre Date
    final_fusion = final_fusion[final_fusion["DATE"] < "2025-09-01"]

    # -------------------------------------------------------------------------
    # D. GRAPHIQUES PROPHET & STATS (Ton Code)
    # -------------------------------------------------------------------------
    print("\n--- Génération Graphiques ---")
    
    cols_to_plot = [
        "Prix moyen glissant 12 mois - Univ Elem (V1)",
        "Prix moyen glissant 12 mois - Univ Elem (V2)",
        "Prix moyen glissant 12 mois - LPI/IAD"
    ]
    colors = ["#4C72B0", "#FF0000", "#DD8452"]

    score_v1_total = 0
    score_v2_total = 0
    nb_villes_lpi = 0

    for ville in final_fusion["Ville"].dropna().unique():
        df_ville = final_fusion[final_fusion["Ville"] == ville].sort_values("DATE").copy()
        if df_ville.empty: continue

        # --- Prophet ---
        fig = go.Figure()
        # Interpolation pour boucher les trous (requis par Prophet/Plot)
        df_interp = df_ville.set_index("DATE")[cols_to_plot].resample("MS").interpolate(method="linear").reset_index()

        for i, col in enumerate(cols_to_plot):
            if col not in df_interp.columns or df_interp[col].isna().all(): continue
            
            # Préparation Prophet
            df_p = df_interp[["DATE", col]].rename(columns={"DATE": "ds", col: "y"}).dropna()
            if len(df_p) < 10: continue

            m = Prophet(changepoint_prior_scale=0.5)
            m.fit(df_p)
            future = m.make_future_dataframe(periods=12, freq="MS")
            forecast = m.predict(future)

            # Historique
            fig.add_trace(go.Scatter(x=df_p["ds"], y=df_p["y"], mode="lines+markers", name=col, line=dict(color=colors[i], width=2)))
            
            # Prévision
            last_date = df_p["ds"].max()
            forecast_fut = forecast[forecast["ds"] > last_date]
            if not forecast_fut.empty:
                # Lien visuel
                chain = pd.concat([pd.DataFrame({'ds': [last_date], 'yhat': [df_p.iloc[-1]['y']]}), forecast_fut[['ds', 'yhat']]])
                fig.add_trace(go.Scatter(x=chain["ds"], y=chain["yhat"], mode="lines", name=f"Prev {col}", line=dict(color=colors[i], dash="dot"), showlegend=False))

        fig.update_layout(title=f"Comparaison V1 vs V2 vs LPI – {ville}", template="plotly_white")
        # fig.show() # Décommenter pour afficher
        fig.write_html(os.path.join(params.CONFIG['output_dir'], f"Graph_Prix_{ville}.html"))

        # --- Stats IC & Match LPI ---
        lpi_col = "Prix moyen glissant 12 mois - LPI/IAD"
        if lpi_col in df_interp.columns and not df_interp[lpi_col].isna().all():
            nb_villes_lpi += 1
            # Calcul IC
            for v in ["V1", "V2"]:
                col = f"Prix moyen glissant 12 mois - Univ Elem ({v})"
                std = df_interp[col].rolling(12).std()
                df_interp[f"IC_inf_{v}"] = df_interp[col] - 1.96 * std
                df_interp[f"IC_sup_{v}"] = df_interp[col] + 1.96 * std
            
            # Match
            match_v1 = ((df_interp[lpi_col] >= df_interp["IC_inf_V1"]) & (df_interp[lpi_col] <= df_interp["IC_sup_V1"])).mean()
            match_v2 = ((df_interp[lpi_col] >= df_interp["IC_inf_V2"]) & (df_interp[lpi_col] <= df_interp["IC_sup_V2"])).mean()
            
            score_v1_total += match_v1 if pd.notna(match_v1) else 0
            score_v2_total += match_v2 if pd.notna(match_v2) else 0

    # --- Synthèse Stats ---
    print("\n" + "="*50)
    if nb_villes_lpi > 0:
        print(f"Match LPI Moyen (V1 Standard) : {score_v1_total/nb_villes_lpi:.1%}")
        print(f"Match LPI Moyen (V2 Hybride)  : {score_v2_total/nb_villes_lpi:.1%}")
    
    # Calcul RMSE Global
    def calc_rmse(g, col):
        return np.sqrt(((g[col] - g["Prix moyen glissant 12 mois - LPI/IAD"])**2).mean())

    stats = final_fusion.groupby("Ville").apply(lambda x: pd.Series({
        "RMSE_V1": calc_rmse(x, "Prix moyen glissant 12 mois - Univ Elem (V1)"),
        "RMSE_V2": calc_rmse(x, "Prix moyen glissant 12 mois - Univ Elem (V2)")
    })).reset_index()
    
    stats["Gain"] = stats["RMSE_V1"] - stats["RMSE_V2"]
    print("\nTOP AMÉLIORATIONS (V2 meilleure que V1) :")
    print(stats.sort_values("Gain", ascending=False).head(10))
    
    stats.to_csv(os.path.join(params.CONFIG['output_dir'], "Comparatif_LPI_Global.csv"), index=False)
