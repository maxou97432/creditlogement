# Scanner toutes les colonnes string pour trouver 
# celle qui a des modalités "Trade Finance" ou "LEQ"
mots_cles = ['trade', 'leq', 'finance', 'court', 'cav', 'uncommit', 'confirme', 'hors', 'TF']

print("=== RECHERCHE DE LA VARIABLE EXCEPTION ===")
for col in srs_X_capret.columns:
    try:
        if srs_X_capret[col].dtype == pl.Utf8:
            valeurs = srs_X_capret[col].drop_nulls().unique().to_list()
            # Cherche si une modalité contient un des mots-clés
            match = [v for v in valeurs 
                     if any(kw.lower() in str(v).lower() for kw in mots_cles)]
            if match:
                print(f"\n✅ {col} : {valeurs[:10]}")  # Max 10 modalités
    except:
        pass
