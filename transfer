# Constantes - valeurs par défaut (à surcharger à l'import ou via args)
# ----------------------------------------------------------------------
DEFAULT_CLASS_COL = CLASS_COL
DEFAULT_TIME_COL = YEAR_COL
DEFAULT_EAD_COL = EAD_COL
DEFAULT_OBLIGOR_COL = "ID_CLIENT"
DEFAULT_DEFAULT_DATE_COL = "datdef_ap_mdef"


# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------
def _pct_str(series: pl.Series) -> pl.Series:
    """Format 0-100% avec deux décimales et virgule."""
    return (series * 100).round(2).cast(pl.Utf8).str.replace(".", ",") + "%"


def _calc_normalized_hhi(shares: np.ndarray) -> float:
    """
    HHI normalisé, selon le guide officiel (EBA) :
        H* = 1 + ln(H) / ln(n),  avec H = sum(shares^2)
    Retourne une valeur bornée dans [0, 1].
    """
    n = len(shares)
    if n <= 1:
        return 0.0
    sigma2 = ((shares - 1.0 / n) ** 2).sum()
    hhi = 1.0 + math.log((1.0 + n * sigma2) / n) / math.log(n)
    return max(0.0, min(1.0, hhi))


def _hhi_color(pct: float) -> str:
    """
    Palette couleur (Table 49) — appliquée au HHI en échelle 0-100.
    Seuils : GREEN < 15%, AMBER <= 25%, RED > 25%.
    """
    if pct < 15.0:
        return "GREEN"
    if pct <= 25.0:
        return "AMBER"
    return "RED"


def _hhi_color_legacy(hhi_01: float) -> str:
    """
    Palette couleur pour le tableau HHI 'detail' (legacy), échelle 0-1.
    Seuils : GREEN < 0.20, AMBER < 0.40, RED sinon.
    ⚠️ Seuils différents de _hhi_color — vérifie que c'est intentionnel
    (deux tables réglementaires distinctes) avant de les harmoniser.
    """
    if hhi_01 < 0.20:
        return "GREEN"
    if hhi_01 < 0.40:
        return "AMBER"
    return "RED"


def _psi_color(psi_val: float) -> str:
    """
    Palette couleur PSI (doc interne BNP) :
        GREEN <= 0.10, AMBER (0.10, 0.25], RED > 0.25
    """
    if psi_val <= 0.10:
        return "GREEN"
    if psi_val <= 0.25:
        return "AMBER"
    return "RED"


# ----------------------------------------------------------------------
# 0.a) Réduction au grain obligor-défaut (une ligne par (obligor, date_def))
# ----------------------------------------------------------------------
def _reduce_to_obligor_grain(
    lf: pl.LazyFrame,
    class_col: str,
    time_col: str,
    ead_col: str,
    obligor_col: str,
    default_date_col: str,
) -> pl.LazyFrame:
    """
    Réduit une table au grain contrat/facilité à une table au grain
    obligor-défaut : une ligne par couple (obligor_col, default_date_col).

    - ``class_col`` / ``time_col`` : on prend la première valeur rencontrée
      pour le groupe (elles sont supposées identiques pour toutes les
      facilités d'un même obligor-défaut ; sinon c'est un problème de
      données amont, pas de cette fonction).
    - ``ead_col`` : sommé sur toutes les facilités de l'obligor-défaut
      (l'EAD s'additionne naturellement au niveau obligor).
    """
    return (
        lf.group_by([obligor_col, default_date_col])
          .agg(
              pl.col(class_col).first().alias(class_col),
              pl.col(time_col).first().alias(time_col),
              pl.sum(ead_col).alias(ead_col),
          )
    )


# ----------------------------------------------------------------------
# 0.b) Agrégation : volume = nb d'obligors-défauts uniques par classe ;
#      exposure = somme des EAD obligor (déjà dédoublonnées) par classe
# ----------------------------------------------------------------------
def aggregate_volume_exposure(
    lf: pl.LazyFrame,
    class_col: str = DEFAULT_CLASS_COL,
    time_col: str = DEFAULT_TIME_COL,
    ead_col: str = DEFAULT_EAD_COL,
    obligor_col: str = DEFAULT_OBLIGOR_COL,
    default_date_col: str = DEFAULT_DEFAULT_DATE_COL,
) -> pl.LazyFrame:
    """
    Retourne un LazyFrame contenant : class, time, volume, exposure —
    calculés au grain OBLIGOR (couple obligor_col + default_date_col),
    et non plus au grain contrat/facilité.

    - volume   : nombre d'obligors-défauts uniques dans la classe/période.
    - exposure : somme des EAD obligor (chaque obligor-défaut ne contribue
                 qu'une fois, avec son EAD totale agrégée sur ses facilités).
    """
    obligor_grain = _reduce_to_obligor_grain(
        lf, class_col, time_col, ead_col, obligor_col, default_date_col
    )

    return (
        obligor_grain.group_by([class_col, time_col])
                      .agg(
                          pl.len().alias("volume"),        # 1 ligne = 1 obligor-défaut
                          pl.sum(ead_col).alias("exposure"),
                      )
    )  # ← déjà lazy, pas de .lazy() supplémentaire


# ----------------------------------------------------------------------
# 1) HHI - volume (global, toutes périodes) - lazy
# ----------------------------------------------------------------------
def _compute_hhi_volume_lazy(
    lf: pl.LazyFrame,
    class_col: str = DEFAULT_CLASS_COL,
    weight_col: str = "volume",
    time_col: str = DEFAULT_TIME_COL,
) -> Tuple[float, str]:
    """
    HHI de volume = moyenne pondérée des HHI annuels.
    Prend en entrée un LazyFrame déjà agrégé au niveau obligor
    (typiquement la sortie de ``aggregate_volume_exposure``).
    """
    per = (
        lf.group_by([time_col, class_col])
          .agg(pl.sum(weight_col).alias("w"))
    ).collect()

    per = per.with_columns(
        (pl.col("w") / pl.sum("w").over(time_col)).alias("share")
    )

    period_data: List[Tuple[float, float]] = []
    for period, sub in per.group_by(time_col):
        w_tot = sub["w"].sum()
        if w_tot == 0:
            continue
        shares = sub["share"].to_numpy()
        period_hhi = _calc_normalized_hhi(shares) * 100.0
        period_data.append((w_tot, period_hhi))

    if not period_data:
        return 0.0, "GREEN"

    weights, hhi_vals = zip(*period_data)
    weighted_hhi = round(np.average(hhi_vals, weights=weights), 2)
    return weighted_hhi, _hhi_color(weighted_hhi)


# ----------------------------------------------------------------------
# 2) HHI - exposure (global, toutes périodes) - lazy
# ----------------------------------------------------------------------
def _compute_hhi_exposure_lazy(
    lf: pl.LazyFrame,
    class_col: str = DEFAULT_CLASS_COL,
    weight_col: str = "exposure",
    time_col: str = DEFAULT_TIME_COL,
) -> Tuple[float, str]:
    """
    HHI d'exposition = moyenne pondérée des HHI annuels.
    Prend en entrée un LazyFrame déjà agrégé au niveau obligor
    (typiquement la sortie de ``aggregate_volume_exposure``).
    """
    per = (
        lf.group_by([time_col, class_col])
          .agg(pl.sum(weight_col).alias("w"))
    )
    df = per.collect()
    df = df.with_columns(
        (pl.col("w") / pl.sum("w").over(time_col)).alias("share")
    )

    period_data: List[Tuple[float, float]] = []
    for period, sub in df.group_by(time_col):
        w_tot = sub["w"].sum()
        if w_tot == 0:
            continue
        shares = sub["share"].to_numpy()
        period_hhi = _calc_normalized_hhi(shares) * 100.0
        period_data.append((w_tot, period_hhi))

    if not period_data:
        return 0.0, "GREEN"

    weights, hhi_vals = zip(*period_data)
    weighted_hhi = round(np.average(hhi_vals, weights=weights), 2)
    return weighted_hhi, _hhi_color(weighted_hhi)


# ----------------------------------------------------------------------
# 3) PSI - lazy (comptage au niveau obligor)
# ----------------------------------------------------------------------
def _compute_psi_lazy(
    lf: pl.LazyFrame,
    class_col: str = DEFAULT_CLASS_COL,
    time_col: str = DEFAULT_TIME_COL,
    obligor_col: str = DEFAULT_OBLIGOR_COL,
    default_date_col: str = DEFAULT_DEFAULT_DATE_COL,
) -> pl.DataFrame:
    """
    ``lf`` est ici la table BRUTE au grain contrat/facilité — cette
    fonction fait elle-même la réduction au grain obligor-défaut
    (contrairement aux fonctions HHI qui reçoivent un ``df_agg`` déjà
    réduit en amont).
    """
    # Réduction au grain obligor-défaut : ead_col n'est pas utilisé ici,
    # mais la fonction de réduction l'exige — on passe le nom générique
    # DEFAULT_EAD_COL, sans impact sur le résultat du PSI (Freq/Percent
    # ne dépendent que du comptage d'obligors, pas de l'EAD).
    obligor_grain = _reduce_to_obligor_grain(
        lf, class_col, time_col, DEFAULT_EAD_COL, obligor_col, default_date_col
    )

    # Référence : tous les obligors-défauts uniques (toutes périodes confondues)
    ref = (
        obligor_grain.group_by(class_col)
                      .agg(pl.len().alias("Freq_ref"))
                      .with_columns(
                          (pl.col("Freq_ref") / pl.sum("Freq_ref")).alias("Percent_ref")
                      )
    )

    # Dernière période
    t_max = obligor_grain.select(pl.max(time_col).alias("t_max")).collect()["t_max"][0]

    # Période évaluée (dernière année)
    asses = (
        obligor_grain.filter(pl.col(time_col) == t_max)
                      .group_by(class_col)
                      .agg(pl.len().alias("Freq_asses"))
                      .with_columns(
                          pl.lit(t_max).alias(time_col),
                          (pl.col("Freq_asses") / pl.sum("Freq_asses")).alias("Percent_asses"),
                      )
    )

    psi = (
        ref.join(asses, on=class_col, how="left")
           .with_columns([
               pl.col("Freq_asses").fill_null(0),
               pl.col("Percent_asses").fill_null(1e-12),
           ])
           .with_columns(
               (
                   (pl.col("Percent_asses") - pl.col("Percent_ref"))
                   * (pl.col("Percent_asses") / pl.col("Percent_ref")).log()
               ).cast(pl.Float64).alias("PSI_HEC")
           )
           .with_columns(pl.col("PSI_HEC").sum().alias("PSI_total"))
           .with_columns(
               # Seuils doc interne : GREEN <= 0.10, AMBER (0.10, 0.25], RED > 0.25
               # Appliqué sur PSI_total (score global de dérive).
               pl.when(pl.col("PSI_total") <= 0.10)
                 .then(pl.lit("GREEN"))
                 .when(pl.col("PSI_total") <= 0.25)
                 .then(pl.lit("AMBER"))
                 .otherwise(pl.lit("RED"))
                 .alias("Color")
           )
           .rename({class_col: "HEC"})
           .collect()
    )

    return psi.select([
        "HEC",
        "Freq_ref",
        "Percent_ref",
        time_col,
        "Freq_asses",
        "Percent_asses",
        "PSI_HEC",
        "PSI_total",
        "Color",
    ])


# ----------------------------------------------------------------------
# 4) Construction du tableau résumé HHI (format demandé)
# ----------------------------------------------------------------------
def build_hhi_summary_polars(
    df_agg: pl.LazyFrame,
    class_col: str = DEFAULT_CLASS_COL,
    time_col: str = DEFAULT_TIME_COL,
    global_vol: Union[float, None] = None,
    global_exp: Union[float, None] = None,
) -> pl.DataFrame:
    """
    ``df_agg`` doit être la sortie de ``aggregate_volume_exposure``
    (déjà agrégée au niveau obligor par classe/période).
    """
    # ------------------------------------------------------------------
    # 1) HHI par année - volume
    # ------------------------------------------------------------------
    per_vol = (
        df_agg.group_by([time_col, class_col])
              .agg(pl.sum("volume").alias("w"))
    ).collect()

    per_vol = per_vol.with_columns(
        (pl.col("w") / pl.sum("w").over(time_col)).alias("share")
    )

    volume_hhi: dict[int, float] = {}
    for year_key, sub in per_vol.group_by(time_col):
        year = year_key[0] if isinstance(year_key, tuple) else year_key
        shares = sub["share"].to_numpy()
        volume_hhi[int(year)] = round(_calc_normalized_hhi(shares) * 100, 2)

    # ------------------------------------------------------------------
    # 2) HHI par année - exposure
    # ------------------------------------------------------------------
    per_exp = (
        df_agg.group_by([time_col, class_col])
              .agg(pl.sum("exposure").alias("w"))
    ).collect()

    per_exp = per_exp.with_columns(
        (pl.col("w") / pl.sum("w").over(time_col)).alias("share")
    )

    exposure_hhi: dict[int, float] = {}
    for year_key, sub in per_exp.group_by(time_col):
        year = year_key[0] if isinstance(year_key, tuple) else year_key
        shares = sub["share"].to_numpy()
        exposure_hhi[int(year)] = round(_calc_normalized_hhi(shares) * 100, 2)

    # ------------------------------------------------------------------
    # 3) Construction du tableau final
    # ------------------------------------------------------------------
    years = sorted(volume_hhi.keys())
    rows = {
        "Year": [f"HHI{y}" for y in years],
        "Herfindahl_volume": [volume_hhi[y] for y in years],
        "Herfindahl_expo": [exposure_hhi[y] for y in years],
    }
    df_out = pl.DataFrame(rows)

    # ------------------------------------------------------------------
    # 4) Valeurs globales (moyenne simple) si non fournies
    # ------------------------------------------------------------------
    if global_vol is None:
        global_vol = float(df_out["Herfindahl_volume"].mean())
    if global_exp is None:
        global_exp = float(df_out["Herfindahl_expo"].mean())

    # ------------------------------------------------------------------
    # 5) Ajout ligne "Global Year"
    # ------------------------------------------------------------------
    df_out = df_out.vstack(
        pl.DataFrame({
            "Year": ["Global Year"],
            "Herfindahl_volume": [global_vol],
            "Herfindahl_expo": [global_exp],
        })
    )

    # ------------------------------------------------------------------
    # 6) Formatage 0,00 %
    # ------------------------------------------------------------------
    # pl.format("{:.2f}%", ...) n'est pas un format Python valide en Polars
    # (le {} attend un nom de colonne, pas une spec de format) —
    # on utilise map_elements avec le f-string Python classique à la place.
    df_out = df_out.with_columns([
        pl.col("Herfindahl_volume").map_elements(
            lambda x: f"{x:.2f}%".replace(".", ","), return_dtype=pl.Utf8
        ).alias("Herfindahl_volume"),
        pl.col("Herfindahl_expo").map_elements(
            lambda x: f"{x:.2f}%".replace(".", ","), return_dtype=pl.Utf8
        ).alias("Herfindahl_expo"),
    ])

    return df_out


# ----------------------------------------------------------------------
# 5) Détail HHI par période (legacy)
# ----------------------------------------------------------------------
def _build_hhi_detail(
    df_agg: pl.LazyFrame,
    class_col: str,
    time_col: str,
    vol_pct: float,
) -> pl.DataFrame:
    """
    ``df_agg`` doit être la sortie de ``aggregate_volume_exposure``
    (déjà agrégée au niveau obligor par classe/période).
    """
    per = (
        df_agg.group_by([time_col, class_col])
              .agg(pl.sum("volume").alias("w"))
    ).collect()

    period_hhi: List[Tuple[str, float]] = []
    for period, sub in per.group_by(time_col):
        nb_cls = sub[class_col].n_unique()
        if nb_cls <= 1:
            hhi_val = 0.0
        else:
            shares = (sub["w"] / sub["w"].sum()).to_numpy()
            hhi_val = _calc_normalized_hhi(shares)  # échelle 0-1
        period_hhi.append((str(period), round(hhi_val, 4)))

    rows = [("Reference", ".", round(vol_pct / 100, 4))]
    rows.extend([("Period", p, h) for p, h in period_hhi])
    if period_hhi:
        rows.append(("Assessed", period_hhi[-1][0], period_hhi[-1][1]))

    hhi_detail = pl.DataFrame(
        rows,
        schema=[("Type", pl.Utf8), (time_col, pl.Utf8), ("HHI", pl.Float64)],
        orient="row",
    ).with_columns(
        pl.when(pl.col("HHI") < 0.20)
          .then(pl.lit("GREEN"))
          .when(pl.col("HHI") < 0.40)
          .then(pl.lit("AMBER"))
          .otherwise(pl.lit("RED"))
          .alias("Color")
    )
    return hhi_detail


# ----------------------------------------------------------------------
# 6) Fonction publique globale (lazy) - renvoie tout le nécessaire
# ----------------------------------------------------------------------
def compute_hhi_and_psi_lazy(
    lf: Union[pl.LazyFrame, pl.DataFrame, pd.DataFrame],
    class_col: str = DEFAULT_CLASS_COL,
    weight_col: str = "volume",           # par défaut on travaille sur le volume
    exposure_col: str = "exposure",
    time_col: str = DEFAULT_TIME_COL,
    obligor_col: str = DEFAULT_OBLIGOR_COL,
    default_date_col: str = DEFAULT_DEFAULT_DATE_COL,
    config_name: str = "Current configuration",
) -> Tuple[pl.DataFrame, pl.DataFrame, pl.DataFrame, pl.DataFrame]:
    """
    Retourne :
        1) summary     — Table 48 (global HHI volume & exposure)
        2) psi         — Table 51 (PSI)
        3) hhi_detail  — Détail HHI par période (legacy)
        4) hhi_summary — Tableau au format demandé (HHI2008 … Global Year)

    Tous les comptages (volume, PSI) sont faits au niveau OBLIGOR
    (couple obligor_col + default_date_col), pas au niveau contrat/facilité.
    L'exposition (EAD) est agrégée par obligor avant d'être sommée par classe,
    de sorte qu'un même client avec plusieurs facilités ne contribue son
    exposition qu'une seule fois par classe.
    """
    # ------------------------------------------------------------------
    # Normalisation de l'entrée
    # ------------------------------------------------------------------
    if isinstance(lf, pd.DataFrame):
        lf_polars = pl.from_pandas(lf)
    else:
        lf_polars = lf

    lf_lazy = lf_polars.lazy() if isinstance(lf_polars, pl.DataFrame) else lf_polars

    # ------------------------------------------------------------------
    # 0) Agrégations volume & exposure (grain obligor)
    # ------------------------------------------------------------------
    df_agg = aggregate_volume_exposure(
        lf_lazy,
        class_col=class_col,
        time_col=time_col,
        ead_col=exposure_col,
        obligor_col=obligor_col,
        default_date_col=default_date_col,
    )

    # ------------------------------------------------------------------
    # 1) HHI global (volume & exposure)
    # ------------------------------------------------------------------
    vol_pct, vol_color = _compute_hhi_volume_lazy(df_agg, class_col, "volume", time_col)
    exp_pct, exp_color = _compute_hhi_exposure_lazy(df_agg, class_col, "exposure", time_col)

    # ------------------------------------------------------------------
    # 2) Summary (Table 48)
    # ------------------------------------------------------------------
    summary = pl.DataFrame({
        "HLC_configuration": [config_name],
        "Global_HHI_volume_%": [f"{vol_pct:.2f}%"],
        "Color_volume": [vol_color],
        "Global_HHI_exposure_%": [f"{exp_pct:.2f}%"],
        "Color_exposure": [exp_color],
    })

    # ------------------------------------------------------------------
    # 3) PSI (Table 51) — réduction au grain obligor faite en interne
    # ------------------------------------------------------------------
    psi = _compute_psi_lazy(
        lf_lazy, class_col, time_col,
        obligor_col=obligor_col,
        default_date_col=default_date_col,
    )

    # ------------------------------------------------------------------
    # 4) Détail HHI (legacy)
    # ------------------------------------------------------------------
    hhi_detail = _build_hhi_detail(df_agg, class_col, time_col, vol_pct)

    # ------------------------------------------------------------------
    # 5) Tableau résumé au format demandé (HHI2008 … Global Year)
    # ------------------------------------------------------------------
    hhi_summary = build_hhi_summary_polars(
        df_agg,
        class_col=class_col,
        time_col=time_col,
        global_vol=vol_pct,   # déjà en % : la fonction les formate à nouveau
        global_exp=exp_pct,
    )

    return summary, psi, hhi_detail, hhi_summary
