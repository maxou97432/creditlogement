def fusion_glouton(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = None,
    log: bool = False,
    obligor_col: str = 'ID_CLIENT',
) -> Tuple[pl.LazyFrame, Optional[Dict[str, str]]]:
    """
    Applique itérativement la fusion des classes tant qu'une paire violante existe.
    Retourne le DataFrame final et le dictionnaire `{ancienne_classe: nouvelle_classe}`.
    L'argument `log` est propagé à `meilleur_candidat_fusion`.

    La réagrégation après fusion utilise une moyenne pondérée par nb_obligor
    conformément à : LGD_[k->m],t = Σ(LGD_l,t * E_l,t) / Σ(E_l,t)
    """
    mapping: Dict[str, str] = {}

    while True:
        paire, debug_df = meilleur_candidat_fusion(
            df,
            nb_croisements_max=nb_croisements_max,
            ans_strict=ans_strict,
            lgd_col=lgd_col,
            jenks_col=jenks_col,
            log=log,
        )

        if not paire:                               # plus rien à fusionner
            nb_final = df.collect().select(jenks_col).n_unique()
            print(f"SUCCES : {nb_final} classes finales.")
            break

        c1, c2 = paire
        nouveau_nom = f"{c1}_{c2}"
        print(f"Fusion de {c1} et de {c2} (sévérité = {debug_df['severite_totale'][0]})")

        # ----------------------------------------------------------------
        # Mise à jour du dictionnaire de mapping (chaînes déjà fusionnées)
        # ----------------------------------------------------------------
        for ancien, actuel in list(mapping.items()):
            if actuel in (c1, c2):
                mapping[ancien] = nouveau_nom

        for elem in (c1, c2):
            if elem not in mapping:
                mapping[elem] = nouveau_nom

        replace_tmp = {c1: nouveau_nom, c2: nouveau_nom}
        mapping.update(replace_tmp)

        # ----------------------------------------------------------------
        # Application de la fusion sur le DataFrame
        # ----------------------------------------------------------------
        df = (
            df.with_columns(
                pl.col(jenks_col)
                  .cast(pl.Utf8)
                  .replace(replace_tmp)
                  .alias(jenks_col)         # on écrase la colonne d'origine
            )
            # Moyenne pondérée par nb_obligor :
            # LGD_[k->m],t = Σ(LGD_l,t * nb_obligor_l,t) / Σ(nb_obligor_l,t)
            .group_by([jenks_col, "year"])
            .agg([
                (pl.col(lgd_col) * pl.col("nb_obligor")).sum().alias("_num"),
                pl.col("nb_obligor").sum().alias("nb_obligor"),
            ])
            .with_columns(
                (pl.col("_num") / pl.col("nb_obligor")).alias(lgd_col)
            )
            .drop("_num")
        )

    return df, mapping
