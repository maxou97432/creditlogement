# Phase A — niveau sous-modèle : diagnostic toutes paires
cmp_A = FusionComparator(df_sousmodele, class_col="HLC", obligor_col=OBLIGOR_COL,
                         pairs="all").run()
cmp_A.flags()          # matrice GREEN/ORANGE/RED 2-à-2
cmp_A.plot_flags()     # carte couleur

# Phase B — niveau modèle : fusion sur paires consécutives
cmp_B = FusionComparator(df_modele, class_col="HLC", obligor_col=OBLIGOR_COL,
                         pairs="adjacent").run()
cmp_B.calibrate(seuils=[round(s,2) for s in np.arange(0.53, 0.63, 0.01)])  # grille NON vide
sol = cmp_B.solve(criterion="ovl", orange_policy="keep")      # conservateur (défaut)
