    print("\n" + "="*80)
    print("EXTRACTION ET SAUVEGARDE DES STRUCTURES DE MARCHÉ")
    print("="*80)

    all_results = []  # Contiendra tous les segments de toutes les mailles

    # ==========================================================================
    # 2. Maille PROVINCE (France hors Île-de-France)
    # ==========================================================================
    df_province_input = base_ml.copy()
    mask_province = ~df_province_input["DEPT"].isin(params.CONFIG['idf_depts'])
    df_province_input.loc[mask_province, "Ville"] = "PROVINCE"
    df_province_input = df_province_input[df_province_input["Ville"] == "PROVINCE"]

    structure_province = extract_and_save_structure(
        df_province_input, "Ville", "PROVINCE", resultats_dir
    )
    res_province = process_maille_wrapper(
        df_province_input, "Ville", "PROVINCE", df_structure=structure_province
    )
    if res_province is not None:
        all_results.append(res_province)

    # ==========================================================================
    # 3. Maille CITY (Top villes avec correction Paris/Lyon/Marseille)
    # ==========================================================================
    df_villes = apply_nice_correction(base_ml.copy())
    df_villes = df_villes[df_villes["Ville"].isin(params.CONFIG['top_cities'])]

    print("\n   Extraction structure CITY (avec arrondissements)...")
    structure_villes, structure_arr = get_structure_reference_city(base_ml)

    path_structure_villes = os.path.join(resultats_dir, "structure_poids_CITY.csv")
    structure_villes.to_csv(path_structure_villes, index=False, encoding='utf-8-sig')
    print(f"      -> structure_poids_CITY.csv")
    print(f"         {len(structure_villes)} univers, {structure_villes['Ville'].nunique()} villes")

    path_structure_arr = os.path.join(resultats_dir, "structure_poids_arrondissements.csv")
    structure_arr.to_csv(path_structure_arr, index=False, encoding='utf-8-sig')
    print(f"      -> structure_poids_arrondissements.csv")
    print(f"         {len(structure_arr)} arrondissements")
    if 'Ville_source' in structure_arr.columns:
        print(f"         Villes: {', '.join(structure_arr['Ville_source'].unique())}")

    res_villes = process_maille_wrapper(
        df_villes, "Ville", "CITY",
        df_structure=structure_villes, df_arr=structure_arr
    )
    if res_villes is not None:
        all_results.append(res_villes)

    # ==========================================================================
    # 4. Maille DEPARTEMENT
    # ==========================================================================
    structure_dept = extract_and_save_structure(base_ml, "DEPT", "DEPT", resultats_dir)
    res_dept = process_maille_wrapper(base_ml, "DEPT", "DEPT", df_structure=structure_dept)
    if res_dept is not None:
        all_results.append(res_dept)

    # ==========================================================================
    # 5. Maille REGION
    # ==========================================================================
    structure_region = extract_and_save_structure(base_ml, "REGION", "REGION", resultats_dir)
    res_region = process_maille_wrapper(
        base_ml, "REGION", "REGION", df_structure=structure_region
    )
    if res_region is not None:
        all_results.append(res_region)

    # ==========================================================================
    # 6. Maille NATIONAL
    # ==========================================================================
    df_national = base_ml.copy()
    df_national["PAYS"] = "FRANCE"
    structure_national = extract_and_save_structure(
        df_national, "PAYS", "NATIONAL", resultats_dir
    )
    res_national = process_maille_wrapper(
        df_national, "PAYS", "NATIONAL", df_structure=structure_national
    )
    if res_national is not None:
        all_results.append(res_national)

    # ==========================================================================
    # 7. Consolidation et sauvegarde d'un seul fichier
    # ==========================================================================
    print("\n" + "="*80)
    print("CONSOLIDATION DES RÉSULTATS")
    print("="*80)

    if not all_results:
        print("ERREUR : aucun résultat à sauvegarder.")
    else:
        df_all = pd.concat(all_results, ignore_index=True)

        # Ordre des colonnes final
        col_order = [
            "VAL_MAILLE_GEO", "TYPE_MAILLE", "TYPE_BIEN", "ANCIENNETE", "Periode",
            "prix_mm_3m", "prix_mm_12m",
            "surface_mm_3m", "surface_mm_12m",
            "VF_mm_3m", "VF_mm_12m",
            "nb_observations_3m", "nb_observations_12m",
            "nb_univers_3m", "nb_univers_12m",
            "TAUX_INFL_3M", "TAUX_INFL_12M"
        ]
        col_order = [c for c in col_order if c in df_all.columns]
        df_all = df_all[col_order]

        df_all = df_all.sort_values(
            ["TYPE_MAILLE", "VAL_MAILLE_GEO", "TYPE_BIEN", "ANCIENNETE", "Periode"]
        )

        # Fichier complet (toutes périodes)
        path_all = os.path.join(resultats_dir, "prix_m2_univ_elem_ALL.csv")
        df_all.to_csv(path_all, index=False, encoding='utf-8-sig')
        print(f"\n-> Fichier complet : prix_m2_univ_elem_ALL.csv")
        print(f"   {len(df_all)} lignes | "
              f"{df_all['TYPE_MAILLE'].nunique()} mailles | "
              f"{df_all['VAL_MAILLE_GEO'].nunique()} zones | "
              f"{df_all['Periode'].nunique()} périodes")

        # Fichier mise à jour (dernière période par maille × segment)
        key_cols = ["VAL_MAILLE_GEO", "TYPE_MAILLE", "TYPE_BIEN", "ANCIENNETE"]
        df_maj = df_all.loc[df_all.groupby(key_cols)["Periode"].idxmax()].reset_index(drop=True)
        path_maj = os.path.join(resultats_dir, "prix_m2_univ_elem_MAJ_ALL.csv")
        df_maj.to_csv(path_maj, index=False, encoding='utf-8-sig')
        print(f"\n-> Fichier mise à jour : prix_m2_univ_elem_MAJ_ALL.csv")
        print(f"   {len(df_maj)} lignes (une par maille × zone × TYPE_BIEN × ANCIENNETE)")

    print("\n" + "="*80)
    print(f"Traitement global terminé en {datetime.now() - start_global}")
    print("="*80)
