import numpy as np

# Maturité originelle en jours
pop["MATURITE_ORIG_J"] = pop["DT_ECHEANCE_FEM"] - pop["DT_DEBUT_AUTO"]

# Règle candidate V2
mask_no_floor = (
    # FA2 → exemption quasi-systématique
    (pop["CD_OBJ_FIN"] == "FA2")
    |
    # GA5 → exemption si maturité originelle < 1 an
    ((pop["CD_OBJ_FIN"] == "GA5") & (pop["MATURITE_ORIG_J"] < 365))
)

pop["NB_DURATION_SIMULE_V2"] = np.where(
    mask_no_floor,
    pop["NB_MATURITE_IRBA"],
    pop["NB_MATURITE_IRBA"].clip(lower=1.0, upper=5.0),
)

match = ((pop["NB_DURATION_SIMULE_V2"] - pop["NB_DURATION_IRBA"]).abs() < 1e-6).sum()
print(f"V2 : {match:,} / {len(pop):,}  ({100*match/len(pop):.3f}%)")

# Analyse des résidus
residus = pop[(pop["NB_DURATION_SIMULE_V2"] - pop["NB_DURATION_IRBA"]).abs() >= 1e-6]
print(f"\nRésidus : {len(residus):,}")
print("\n>>> Résidus par CD_OBJ_FIN × SEGMENT")
print(residus.groupby(["CD_OBJ_FIN", "SEGMENT"]).size())

# Sur les résidus GA5, voir la distribution de maturité originelle
if "GA5" in residus["CD_OBJ_FIN"].values:
    ga5_res = residus[residus["CD_OBJ_FIN"] == "GA5"]
    print("\n>>> Résidus GA5 — maturité originelle (jours)")
    print(ga5_res["MATURITE_ORIG_J"].describe())

# Pour FA2 : quelle condition fait basculer les 138 normales ?
print("\n>>> FA2 ANOMALIE vs NORMAL — maturité originelle")
print(pop[pop["CD_OBJ_FIN"] == "FA2"].groupby("SEGMENT")["MATURITE_ORIG_J"].describe())
