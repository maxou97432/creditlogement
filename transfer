import polars as pl

# =====================================================================
# 1. PARAMÉTRAGE DES COLONNES (À ADAPTER SELON TA BASE)
# =====================================================================
# Colonnes issues de ton pipeline Polars/Capret
COL_PD_CAPRET  = "tx_edf"              # ou PD_new_ndod_moc selon le cas
COL_LGD_CAPRET = "tx_lgd"              # ou LGD_new_ndod_moc
COL_EAD_CAPRET = "MT_EAD_FLOOR"        # ou ead_calcule

# Colonnes historiques issues de SRS (legacy)
COL_PD_SRS  = "PD_IRBA"                # Remplacer par le vrai nom
COL_LGD_SRS = "LGD_IRBA"               # Remplacer par le vrai nom
COL_EAD_SRS = "EAD_IRBA"               # Remplacer par le vrai nom

SEUIL_TOLERANCE = 0.0001               # Tolérance pour les arrondis (10^-4)

# =====================================================================
# 2. CALCUL DES ÉCARTS ABSOLUS
# =====================================================================
diag_df = srs_X_capret.with_columns([
    (pl.col(COL_PD_CAPRET) - pl.col(COL_PD_SRS)).abs().alias("Ecart_PD"),
    (pl.col(COL_LGD_CAPRET) - pl.col(COL_LGD_SRS)).abs().alias("Ecart_LGD"),
    (pl.col(COL_EAD_CAPRET) - pl.col(COL_EAD_SRS)).abs().alias("Ecart_EAD")
]).with_columns([
    (pl.col("Ecart_PD") > SEUIL_TOLERANCE).alias("Alerte_PD"),
    (pl.col("Ecart_LGD") > SEUIL_TOLERANCE).alias("Alerte_LGD"),
    (pl.col("Ecart_EAD") > 1.0).alias("Alerte_EAD")  # Tolérance de 1€ pour l'EAD
])

# =====================================================================
# 3. SYNTHÈSE DES ANOMALIES
# =====================================================================
print("=== BILAN DE LA PARITÉ PD / LGD / EAD ===")
total_lignes = diag_df.height
print(f"Nombre total de lignes : {total_lignes:,}")

pd_diff = diag_df.filter(pl.col("Alerte_PD")).height
lgd_diff = diag_df.filter(pl.col("Alerte_LGD")).height
ead_diff = diag_df.filter(pl.col("Alerte_EAD")).height

print(f"❌ Écarts sur la PD  : {pd_diff:,} lignes ({(pd_diff/total_lignes)*100:.2f}%)")
print(f"❌ Écarts sur la LGD : {lgd_diff:,} lignes ({(lgd_diff/total_lignes)*100:.2f}%)")
print(f"❌ Écarts sur l'EAD  : {ead_diff:,} lignes ({(ead_diff/total_lignes)*100:.2f}%)")

# =====================================================================
# 4. ZOOM SUR LE PREMIER PROBLÈME TROUVÉ (EXEMPLE : LGD)
# =====================================================================
if lgd_diff > 0:
    print("\n--- Zoom sur les écarts LGD ---")
    print(
        diag_df.filter(pl.col("Alerte_LGD"))
        .select(["I_AUTRS_UNIQ", "cd_portfolio", COL_LGD_CAPRET, COL_LGD_SRS, "Ecart_LGD"])
        .sort("Ecart_LGD", descending=True)
        .head(5)
    )

if pd_diff > 0:
    print("\n--- Zoom sur les écarts PD ---")
    print(
        diag_df.filter(pl.col("Alerte_PD"))
        .select(["I_AUTRS_UNIQ", "segment_pd", "modele_pd", COL_PD_CAPRET, COL_PD_SRS, "Ecart_PD"])
        .sort("Ecart_PD", descending=True)
        .head(5)
    )
    
if ead_diff > 0:
    print("\n--- Zoom sur les écarts EAD ---")
    print(
        diag_df.filter(pl.col("Alerte_EAD"))
        .select(["I_AUTRS_UNIQ", COL_EAD_CAPRET, COL_EAD_SRS, "Ecart_EAD"])
        .sort("Ecart_EAD", descending=True)
        .head(5)
    )
