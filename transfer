# Cellule 5.9e — Graphique : profil LGD par critère
# Un subplot par critère : LGD moyenne par classe finale (ordre croissant)

import matplotlib.pyplot as plt
import numpy as np

solutions = comparaison["solutions"]
n = len(solutions)
ncols = 2
nrows = (n + 1) // ncols

fig, axes = plt.subplots(nrows, ncols, figsize=(7 * ncols, 4 * nrows))
axes = np.atleast_1d(axes).flatten()

for idx, (label, sol) in enumerate(solutions.items()):
    if sol is None:
        continue
    ax = axes[idx]

    # LGD moyenne par classe finale
    df_m = df_brut.with_columns(
        pl.col(CLASS_COL).cast(pl.Utf8)
        .replace(sol["mapping"])
        .alias("_classe_finale")
    )
    if OBLIGOR_COL:
        df_m = (
            df_m.group_by(["_classe_finale", OBLIGOR_COL])
            .agg(pl.col(LGD_COL).mean())
        )
    lgd_par_classe = (
        df_m.group_by("_classe_finale")
        .agg(pl.col(LGD_COL).mean().alias("lgd_mean"),
             pl.len().alias("n"))
        .sort("lgd_mean")
    )
    x = range(len(lgd_par_classe))
    lgd = lgd_par_classe["lgd_mean"].to_numpy()
    nobs = lgd_par_classe["n"].to_numpy()

    ax.bar(x, lgd, color="#4c72b0", alpha=0.7)
    ax.errorbar(x, lgd, fmt="none", color="black", capsize=3)
    ax.set_xticks(x)
    ax.set_xticklabels(
        lgd_par_classe["_classe_finale"].to_list(),
        rotation=45, ha="right", fontsize=7
    )
    for xi, li, ni in zip(x, lgd, nobs):
        ax.text(xi, li + 0.5, f"n={ni}", ha="center", fontsize=6, color="grey")
    ax.set_title(f"{label}  ({sol['n_final']} classes)", fontsize=10)
    ax.set_ylabel("LGD moyenne (%)")
    ax.set_ylim(0, max(lgd) * 1.15)

for j in range(len(solutions), len(axes)):
    axes[j].axis("off")

fig.suptitle("Profil LGD des classes finales par critère", fontsize=13)
plt.tight_layout(rect=[0, 0, 1, 0.97])
plt.show()


