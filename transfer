# ============================================================
#  FOREST PLOT — moyennes LGD par classe
#  4 classes par figure, distinction fusionnées / originales
#  Requiert : class_stats_base, groups_state, df_base
# ============================================================

import numpy as np
import polars as pl
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches

# ================================================================
#  PREPARATION DES DONNEES
# ================================================================

# Mapping CHR_model_orig -> classe_finale
mapping_rows = []
for label, grp in groups_state.items():
    for membre in grp["members"]:
        mapping_rows.append({
            "CHR_model"  : int(membre),
            "classe_finale": label,
            "n_membres"  : len(grp["members"]),
        })
mapping_df = pl.DataFrame(mapping_rows)

# Stats par classe originale avec info fusion + IC95%
stats_plot = (
    class_stats_base
    .join(mapping_df, on="CHR_model", how="left")
    .with_columns([
        (pl.col("n_membres") > 1).alias("est_fusionne"),
        (pl.col("mean_lgd") - 1.96 *
         (pl.col("var_lgd").sqrt() / pl.col("n").sqrt()))
        .alias("ic_low"),
        (pl.col("mean_lgd") + 1.96 *
         (pl.col("var_lgd").sqrt() / pl.col("n").sqrt()))
        .alias("ic_high"),
    ])
    .sort("mean_lgd")
)

classes_plot  = stats_plot["CHR_model"].to_list()
means_plot    = stats_plot["mean_lgd"].to_list()
ic_low_plot   = stats_plot["ic_low"].to_list()
ic_high_plot  = stats_plot["ic_high"].to_list()
fusionne_plot = stats_plot["est_fusionne"].to_list()
n_plot        = stats_plot["n"].to_list()
cls_finale    = stats_plot["classe_finale"].to_list()

# Moyenne globale ponderee
grand_mean = float(
    sum(m * n for m, n in zip(means_plot, n_plot)) /
    sum(n_plot)
)

# Plage Y globale pour tous les graphes
y_min = min(ic_low_plot)  * 0.97
y_max = max(ic_high_plot) * 1.03

N_CLASSES = len(classes_plot)
PAR_PAGE  = 4
N_PAGES   = int(np.ceil(N_CLASSES / PAR_PAGE))

print(f"{N_CLASSES} classes | {N_PAGES} pages\n")
print(f"Moyenne globale portefeuille : {grand_mean:.3f}\n")


# ================================================================
#  FOREST PLOTS
# ================================================================

for page in range(N_PAGES):
    debut   = page * PAR_PAGE
    fin     = min(debut + PAR_PAGE, N_CLASSES)
    batch   = list(range(debut, fin))
    n_plots = len(batch)

    fig, axes = plt.subplots(
        1, n_plots,
        figsize=(4 * n_plots, 6),
        sharey=True,
    )
    if n_plots == 1:
        axes = [axes]

    fig.suptitle(
        f"Forest plot LGD — page {page+1}/{N_PAGES}  "
        f"(seuil g={G_MODERE}, {len(groups_state)} classes finales)",
        fontsize=11, fontweight="bold"
    )

    for col, idx in enumerate(batch):
        ax     = axes[col]
        cls    = classes_plot[idx]
        mu     = means_plot[idx]
        lo     = ic_low_plot[idx]
        hi     = ic_high_plot[idx]
        fus    = fusionne_plot[idx]
        n      = n_plot[idx]
        cf     = cls_finale[idx]

        couleur = "#E05A2B" if fus else "#2B7BB9"

        # Ligne de reference globale
        ax.axhline(grand_mean, color="gray", linestyle="--",
                   lw=1.0, alpha=0.5, zorder=1)

        # Barre IC95%
        ax.plot([0, 0], [lo, hi],
                color=couleur, lw=3, zorder=3, solid_capstyle="round")

        # Caps
        cap_w = 0.12
        ax.plot([-cap_w, cap_w], [lo, lo], color=couleur, lw=2, zorder=4)
        ax.plot([-cap_w, cap_w], [hi, hi], color=couleur, lw=2, zorder=4)

        # Point estimate (moyenne)
        ax.scatter(0, mu, s=100, color=couleur,
                   zorder=5, edgecolors="white", linewidths=1.5)

        # Axe Y
        ax.set_ylim(y_min, y_max)
        ax.set_xlim(-0.5, 0.5)
        ax.set_xticks([])
        ax.yaxis.set_tick_params(labelsize=8)
        if col == 0:
            ax.set_ylabel("LGD (%)", fontsize=9)

        # Titre
        statut = "fusionné" if fus else "intact"
        ax.set_title(
            f"CHR {cls}\n[{statut}]",
            fontsize=9,
            color=couleur,
            pad=5,
        )

        # Cartouche stats
        ax.text(
            0.97, 0.97,
            f"μ = {mu:.3f}\n"
            f"IC = [{lo:.3f},\n"
            f"       {hi:.3f}]\n"
            f"n = {n:,}",
            transform=ax.transAxes,
            ha="right", va="top", fontsize=7,
            family="monospace",
            bbox=dict(boxstyle="round,pad=0.4",
                      fc="white", ec=couleur, alpha=0.9),
        )

        # Groupe final (si fusionné)
        if fus:
            membres_str = cf.replace("|", ", ")
            if len(membres_str) > 25:
                membres_str = membres_str[:25] + "…"
            ax.text(
                0.03, 0.03,
                f"→ {membres_str}",
                transform=ax.transAxes,
                ha="left", va="bottom", fontsize=6,
                color="#E05A2B",
                bbox=dict(boxstyle="round,pad=0.2",
                          fc="white", ec="#E05A2B", alpha=0.8),
            )

        # Grille legere
        ax.yaxis.grid(True, linestyle=":", alpha=0.4, zorder=0)
        ax.set_axisbelow(True)

    # Legende commune
    patch_intact = mpatches.Patch(color="#2B7BB9", label="Classe intacte")
    patch_fus    = mpatches.Patch(color="#E05A2B", label="Classe fusionnée")
    line_gm      = plt.Line2D([0], [0], color="gray", linestyle="--",
                               lw=1, label=f"Moy. globale ({grand_mean:.2f})")
    fig.legend(
        handles=[patch_intact, patch_fus, line_gm],
        loc="lower center", ncol=3,
        fontsize=8, framealpha=0.9,
        bbox_to_anchor=(0.5, -0.04),
    )

    plt.tight_layout(rect=[0, 0.06, 1, 0.97])
    plt.show()
    print(f"  — page {page+1}/{N_PAGES} —\n")
