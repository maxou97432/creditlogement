def label_intervalle(bins: list, i: int, decimales: int = 2) -> str:
    """
    Construit le label textuel de la tranche i à partir de la liste `bins`
    (bornes, avec None aux extrémités pour -inf/+inf), telle que stockée
    dans dict_seuils[col]["bins"].
    """
    lower, upper = bins[i], bins[i + 1]
    lower_str = "-∞" if lower is None else f"{lower:.{decimales}f}"
    upper_str = "+∞" if upper is None else f"{upper:.{decimales}f}"
    return f"]{lower_str} ; {upper_str}]"


def construire_labels_bornes(dict_seuils: dict, decimales: int = 2) -> dict:
    """
    À partir de dict_seuils (retourné par appliquer_decoupage_cart), construit
    {colonne_binee: {indice_tranche: label_borne}} pour remapper les indices
    CART en intervalles lisibles.
    """
    labels = {}
    for info in dict_seuils.values():
        bins = info["bins"]
        col_binee = info["colonne_binee"]
        labels[col_binee] = {
            i: label_intervalle(bins, i, decimales) for i in range(len(bins) - 1)
        }
    return labels
