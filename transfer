# On convertit les listes de valeurs uniques en "ensembles" (sets) mathématiques
eng_099 = set(df_099['CD_ENGAGEMENT'].drop_nulls().unique().to_list())
eng_054 = set(df_054['CD_ENGAGEMENT'].drop_nulls().unique().to_list())

# On cherche ce qui est exclusif et ce qui se chevauche
exclusif_099 = eng_099 - eng_054
exclusif_054 = eng_054 - eng_099
mixtes = eng_099.intersection(eng_054)

