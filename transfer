    df_national["PAYS"] = "FRANCE"
    structure_national = extract_and_save_structure(df_national, "PAYS", "NATIONAL", resultats_dir)
    res_national = process_maille_wrapper(df_national, "PAYS", "NATIONAL")
    save_results(res_national, "NATIONAL")

    print("\n" + "="*80)
    print(f"Traitement global terminé en {datetime.now() - start_global}")
    print("="*80)
