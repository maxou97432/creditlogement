def write_formatted_sheet(writer, df, sheet_name, tab_color="#006C44",
                          startcol=1, index=False, largeur=20):
    """
    Écrit un DataFrame dans un onglet en reprenant le formatage standard du pack.
    Accepte un DataFrame pandas ou Polars.
    """
    if isinstance(df, pl.DataFrame):
        df = df.to_pandas()

    df.to_excel(writer, sheet_name=sheet_name, startcol=startcol, index=index)

    workbook = writer.book
    worksheet = writer.sheets[sheet_name]
    worksheet.hide_gridlines(2)
    worksheet.set_tab_color(tab_color)

    header_format = workbook.add_format({
        "bold": True, "text_wrap": True, "align": "center", "valign": "vcenter",
        "bg_color": "#00915A", "font_color": "#FFFFFF",
        "border": 1, "border_color": "#999999",
    })
    row_format = workbook.add_format({
        "bold": False, "border": 1, "border_color": "#999999",
        "bg_color": "#FFFFFF", "text_wrap": True,
    })

    max_row, max_col = df.shape
    derniere_col = startcol + max_col

    worksheet.conditional_format(
        0, startcol, 0, derniere_col,
        {"type": "formula", "criteria": "=ROW()=1", "format": header_format},
    )
    worksheet.conditional_format(
        1, startcol, max_row, derniere_col,
        {"type": "formula",
         "criteria": f'=${chr(65 + derniere_col)}2<>""',
         "format": row_format},
    )
    worksheet.set_column(0, derniere_col, largeur)
    return worksheet


def exporter_stat_desc_excel(chemin, correlation=None, stats_quali=None,
                             stats_quanti=None, seuils_cart=None, export_brut=None):
    """
    Fichier Excel autonome du notebook stat desc (option B).
    """
    chemin = Path(chemin)
    chemin.parent.mkdir(parents=True, exist_ok=True)

    with pd.ExcelWriter(chemin, engine="xlsxwriter") as writer:
        onglets = [
            ("Full_correlation", correlation, "#8E44AD", True),
            ("Stats_quali",      stats_quali, "#006C44", False),
            ("Stats_quanti",     stats_quanti, "#006C44", False),
            ("Seuils_CART",      seuils_cart, "#B7950B", False),
            ("Export_brut",      export_brut, "#5D6D7E", False),
        ]
        ecrits = []
        for nom, df, couleur, index in onglets:
            if df is not None and len(df) > 0:
                write_formatted_sheet(writer, df, nom, tab_color=couleur, index=index)
                ecrits.append(nom)

    print(f"Fichier stat desc écrit : {chemin}")
    print(f"   Onglets : {', '.join(ecrits)}")
    return chemin
