    print("\n--- Génération des graphiques ---")
    
    cols_to_plot = [
        "Prix moyen glissant 3 mois - Univ Elem (V1)",
        "Prix moyen glissant 3 mois - Univ Elem (V2_STRUCT)",
        "Prix moyen glissant 12 mois - LPI/IAD"
    ]
    colors = ["#4C72B0", "#28A745", "#DD8452"]  # Blue (V1), Green (V2_STRUCT), Orange (LPI)

    score_v1_total = 0
    score_v2_struct_total = 0
    nb_villes = len(final_fusion["Ville"].dropna().unique())

    for ville in final_fusion["Ville"].dropna().unique():
        df_ville = final_fusion[final_fusion["Ville"] == ville].sort_values("DATE").copy()
        if df_ville.empty: continue

        # --- Prophet & Visualisation ---
        fig = go.Figure()
        df_interp = df_ville.set_index("DATE")[cols_to_plot].resample("MS").interpolate(method="linear").reset_index()

        for i, col in enumerate(cols_to_plot):
            if col not in df_interp.columns or df_interp[col].isna().all(): continue
            
            df_p = df_interp[["DATE", col]].rename(columns={"DATE": "ds", col: "y"}).dropna()
            if len(df_p) < 10: continue

            m = Prophet(changepoint_prior_scale=0.5)
            m.fit(df_p)
            future = m.make_future_dataframe(periods=12, freq="MS")
            forecast = m.predict(future)

            fig.add_trace(go.Scatter(x=df_p["ds"], y=df_p["y"], mode="lines+markers", name=col, line=dict(color=colors[i], width=2)))
            
            last_date = df_p["ds"].max()
            forecast_fut = forecast[forecast["ds"] > last_date]
            if not forecast_fut.empty:
                chain = pd.concat([pd.DataFrame({'ds': [last_date], 'yhat': [df_p.iloc[-1]['y']]}), forecast_fut[['ds', 'yhat']]])
                fig.add_trace(go.Scatter(x=chain["ds"], y=chain["yhat"], mode="lines", name=f"Prev {col}", line=dict(color=colors[i], dash="dot"), showlegend=False))

        # --- Stats IC ---
        lpi_col = "Prix moyen glissant 12 mois - LPI/IAD"
        if lpi_col in df_interp.columns and not df_interp[lpi_col].isna().all():
            # Calcul IC
            for v, suffix in [("v1", "V1"), ("v2_struct", "V2_STRUCT")]:
                col_name = f"Prix moyen glissant 3 mois - Univ Elem ({suffix})"
                if col_name in df_interp.columns:
                    std = df_interp[col_name].rolling(12, min_periods=3).std()
                    df_interp[f"IC_inf_{v}"] = df_interp[col_name] - 1.96 * std
                    df_interp[f"IC_sup_{v}"] = df_interp[col_name] + 1.96 * std
            
            # Match V1
            match_v1 = ((df_interp[lpi_col] >= df_interp["IC_inf_v1"]) & (df_interp[lpi_col] <= df_interp["IC_sup_v1"])).mean()
            score_v1_total += match_v1 if pd.notna(match_v1) else 0
            
            # Match V2_STRUCT
            match_v2_struct = ((df_interp[lpi_col] >= df_interp["IC_inf_v2_struct"]) & (df_interp[lpi_col] <= df_interp["IC_sup_v2_struct"])).mean()
            score_v2_struct_total += match_v2_struct if pd.notna(match_v2_struct) else 0

            # --- Graphique IC ---
            fig_ic = go.Figure()
            
            fig_ic.add_trace(go.Scatter(
                x=pd.concat([df_interp["DATE"], df_interp["DATE"][::-1]]),
                y=pd.concat([df_interp["IC_sup_v1"], df_interp["IC_inf_v1"][::-1]]),
                fill="toself", fillcolor="rgba(76,114,176,0.2)", line=dict(color="rgba(0,0,0,0)"),
                name="IC 95% (V1)"
            ))
            
            fig_ic.add_trace(go.Scatter(
                x=pd.concat([df_interp["DATE"], df_interp["DATE"][::-1]]),
                y=pd.concat([df_interp["IC_sup_v2_struct"], df_interp["IC_inf_v2_struct"][::-1]]),
                fill="toself", fillcolor="rgba(40,167,69,0.2)", line=dict(color="rgba(0,0,0,0)"),
                name="IC 95% (V2_STRUCT)"
            ))
            
            fig_ic.add_trace(go.Scatter(x=df_interp["DATE"], y=df_interp["Prix moyen glissant 3 mois - Univ Elem (V1)"], 
                                        mode='lines', name='V1', line=dict(color=colors[0])))
            fig_ic.add_trace(go.Scatter(x=df_interp["DATE"], y=df_interp["Prix moyen glissant 3 mois - Univ Elem (V2_STRUCT)"], 
                                        mode='lines', name='V2_STRUCT', line=dict(color=colors[1])))
            fig_ic.add_trace(go.Scatter(x=df_interp["DATE"], y=df_interp[lpi_col], 
                                        mode='lines+markers', name='LPI/IAD', line=dict(color=colors[2], dash='dot')))

            fig_ic.add_annotation(xref="paper", yref="paper", x=0.01, y=0.99, text=f"Match LPI (V1): {match_v1:.1%}", showarrow=False, bgcolor="white")
            fig_ic.add_annotation(xref="paper", yref="paper", x=0.01, y=0.94, text=f"Match LPI (V2_STRUCT): {match_v2_struct:.1%}", showarrow=False, bgcolor="white")

            fig_ic.update_layout(title=f"Validité Statistique V1 vs V2_STRUCT - {ville}", height=500, template="plotly_white")
            fig_ic.write_html(os.path.join(params.CONFIG['output_dir'], f"Validite_V1_V2STRUCT_{ville}.html"))

    # -------------------------------------------------------------------------
    # B.6 SYNTHÈSE STATS
    # -------------------------------------------------------------------------
    print("\n" + "="*80)
    print(" RÉSULTATS GLOBAUX COMPARATIFS")
    print("="*80)
    if nb_villes > 0:
        print(f"Correspondance moyenne LPI (V1)        : {score_v1_total/nb_villes:.1%}")
        print(f"Correspondance moyenne LPI (V2_STRUCT) : {score_v2_struct_total/nb_villes:.1%}")
    
    # Fonctions de calcul des métriques
    def calc_rmse(g, col):
        """RMSE absolu en €/m²"""
        lpi = "Prix moyen glissant 12 mois - LPI/IAD"
        if col in g.columns and lpi in g.columns:
            valid = g[[col, lpi]].dropna()
            if len(valid) > 0:
                return np.sqrt(((valid[col] - valid[lpi])**2).mean())
        return np.nan
    
    def calc_rmse_relative(g, col):
        """RMSE relatif en % du prix moyen (pour comparaison entre villes)"""
        lpi = "Prix moyen glissant 12 mois - LPI/IAD"
        if col in g.columns and lpi in g.columns:
            valid = g[[col, lpi]].dropna()
            if len(valid) > 0:
                rmse = np.sqrt(((valid[col] - valid[lpi])**2).mean())
                mean_price = valid[lpi].mean()
                if mean_price > 0:
                    return (rmse / mean_price) * 100  
        return np.nan
    
    def calc_correlation(g, col):
        """Corrélation avec LPI"""
        lpi = "Prix moyen glissant 12 mois - LPI/IAD"
        if col in g.columns and lpi in g.columns:
            valid = g[[col, lpi]].dropna()
            if len(valid) > 5:
                return valid[col].corr(valid[lpi])
        return np.nan

    # Calcul des statistiques par ville
    stats = final_fusion.groupby("Ville").apply(lambda x: pd.Series({
        # RMSE Absolu (€/m²)
        "RMSE_V1": calc_rmse(x, "Prix moyen glissant 3 mois - Univ Elem (V1)"),
        "RMSE_V2_STRUCT": calc_rmse(x, "Prix moyen glissant 3 mois - Univ Elem (V2_STRUCT)"),
        # RMSE Relatif (%)
        "RMSE_REL_V1": calc_rmse_relative(x, "Prix moyen glissant 3 mois - Univ Elem (V1)"),
        "RMSE_REL_V2_STRUCT": calc_rmse_relative(x, "Prix moyen glissant 3 mois - Univ Elem (V2_STRUCT)"),
        # Corrélation
        "CORR_V1": calc_correlation(x, "Prix moyen glissant 3 mois - Univ Elem (V1)"),
        "CORR_V2_STRUCT": calc_correlation(x, "Prix moyen glissant 3 mois - Univ Elem (V2_STRUCT)"),
        # Prix moyen LPI (pour contexte)
        "Prix_Moyen_LPI": x["Prix moyen glissant 12 mois - LPI/IAD"].mean()
    })).reset_index()
    
    # Calcul des gains (positif = V2_STRUCT meilleur)
    stats["Gain_RMSE"] = stats["RMSE_V1"] - stats["RMSE_V2_STRUCT"]
    stats["Gain_RMSE_REL"] = stats["RMSE_REL_V1"] - stats["RMSE_REL_V2_STRUCT"]
    stats["Gain_CORR"] = stats["CORR_V2_STRUCT"] - stats["CORR_V1"]
    
    # Affichage des résultats
    print("\n" + "="*80)
    print(" RÉSULTATS COMPARATIFS : V1 vs V2_STRUCT")
    print("="*80)
    
    print("\n📊 RMSE ABSOLU (€/m²) :")
    print(f"   V1        : {stats['RMSE_V1'].mean():.2f} €/m²")
    print(f"   V2_STRUCT : {stats['RMSE_V2_STRUCT'].mean():.2f} €/m²")
    print(f"   Gain      : {stats['Gain_RMSE'].mean():.2f} €/m² {'Améliorations des résultats' if stats['Gain_RMSE'].mean() > 0 else 'Dégradation des résultats'}")
    
    print("\n📊 RMSE RELATIF (% du prix moyen) - Comparable entre villes :")
    print(f"   V1        : {stats['RMSE_REL_V1'].mean():.2f} %")
    print(f"   V2_STRUCT : {stats['RMSE_REL_V2_STRUCT'].mean():.2f} %")
    print(f"   Gain      : {stats['Gain_RMSE_REL'].mean():.2f} pts {'Améliorations des résultats' if stats['Gain_RMSE_REL'].mean() > 0 else 'Dégradation des résultats'}")
    
    print("\n📊 CORRÉLATION avec LPI :")
    print(f"   V1        : {stats['CORR_V1'].mean():.4f}")
    print(f"   V2_STRUCT : {stats['CORR_V2_STRUCT'].mean():.4f}")
    print(f"   Gain      : {stats['Gain_CORR'].mean():.4f} {'Améliorations des résultats' if stats['Gain_CORR'].mean() > 0 else 'Dégradation des résultats'}")
    
    print("\n" + "-" * 80)
    print("\nDétail par ville (trié par Gain RMSE Relatif) :")
    cols_display = ["Ville", "Prix_Moyen_LPI", "RMSE_V1", "RMSE_V2_STRUCT", "Gain_RMSE", 
                    "RMSE_REL_V1", "RMSE_REL_V2_STRUCT", "Gain_RMSE_REL", "CORR_V1", "CORR_V2_STRUCT"]
    print(stats[cols_display].sort_values("Gain_RMSE_REL", ascending=False).to_string(index=False))
    
    # Sauvegarde
    output_path = os.path.join(params.CONFIG['output_dir'], "Comparaison_V1_V2STRUCT_LPI.csv")
    stats.to_csv(output_path, index=False)
    print(f"\n✓ Résultats sauvegardés dans : {output_path}")

    print("\n=== ANALYSE TERMINÉE ===")
