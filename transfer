# --- 4. CALCUL DES STATS COMPARATIVES ---

def calculate_metrics(df, col_cl, col_insee, label):
    """Calcule RMSE et Corrélation pour un dataframe fusionné"""
    df['Dif'] = df[col_cl] - df[col_insee]
    
    # RMSE
    rmse = np.sqrt(np.mean(df['Dif']**2))
    
    # Corrélation
    corr = df[col_cl].corr(df[col_insee])
    
    # Biais Moyen (Absolu pour voir l'ampleur de l'erreur)
    biais_moyen = df['Dif'].abs().mean()
    
    return pd.Series({
        f'RMSE_{label}': rmse,
        f'Corr_{label}': corr,
        f'Biais_Abs_{label}': biais_moyen
    })

