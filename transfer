import numpy as np
from scipy.optimize import minimize_scalar

# ============================================================
# Population : type 3 progressif "pur"
#   - R > 1
#   - has_171 = False
#   - seg_special = False
# (donc on exclut les bascules)
# ============================================================
sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    has_171     = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
    seg_special = pl.col("segment_trg").is_in([44, 73, 74]),
)
sub_pur = sub3.filter(
    (pl.col("R") > 1.0)
    & (~pl.col("has_171"))
    & (~pl.col("seg_special"))
)
R_arr  = sub_pur["R"].to_numpy()
NB_arr = sub_pur["NB_MATURITE_IRBA"].to_numpy()
print(f"Population calibration : n = {len(R_arr)}")

# ============================================================
# Formule M Bâle mensuel — vectorisée pour aller vite sur 158k lignes
# ============================================================
def predict_all(R_arr, y, freq=12):
    """Calcule M Bâle mensuel pour tout un tableau de R en une passe vectorisée."""
    r = y / freq
    n_arr = np.maximum(1, np.round(R_arr * freq).astype(int))
    preds = np.empty_like(R_arr)
    # On groupe par n pour éviter les boucles inutiles
    for n_unique in np.unique(n_arr):
        mask = n_arr == n_unique
        if abs(y) < 1e-12:
            preds[mask] = (n_unique + 1) / 2 / freq
        else:
            k = np.arange(1, n_unique + 1)
            w = (1 + r) ** (k - 1)
            preds[mask] = np.sum(k * w) / np.sum(w) / freq
    return preds

def loss(y):
    preds = predict_all(R_arr, y)
    return np.mean((preds - NB_arr) ** 2)

# ============================================================
# Optimisation fine du yield
# ============================================================
print("\nCalibration en cours...")
res = minimize_scalar(loss, bounds=(0.001, 0.20), method='bounded',
                      options={'xatol': 1e-8})
y_opt = res.x
rmse_opt = np.sqrt(res.fun)
print(f"Yield optimal global : {y_opt*100:.6f} %")
print(f"RMSE à l'optimum     : {rmse_opt:.6f} ans = {rmse_opt*365.25:.2f} jours")

# ============================================================
# Comparer aux valeurs candidates
# ============================================================
print(f"\n{'yield testé':<15} {'RMSE':>10} {'jours':>10} {'%<0.05':>10}")
print("=" * 50)
for y in [0.0490, 0.0494, 0.04944356, 0.0495, 0.0497, 0.0500, y_opt]:
    preds = predict_all(R_arr, y)
    err = preds - NB_arr
    rmse = np.sqrt(np.mean(err**2))
    pct_match = (np.abs(err) < 0.05).mean() * 100
    tag = "  <-- optimum" if abs(y - y_opt) < 1e-7 else ""
    print(f"{y*100:>10.5f}%   {rmse:>10.5f} {rmse*365.25:>10.2f} "
          f"{pct_match:>9.2f}%{tag}")

# ============================================================
# Stratification par tranche de R pour vérifier la stabilité
# ============================================================
print(f"\n--- Stabilité du yield par tranche de R (à y_opt={y_opt*100:.4f}%) ---")
print(f"{'tranche':<14} {'n':>8} {'RMSE':>10} {'jours':>10}")
preds_opt = predict_all(R_arr, y_opt)
for lo, hi in [(1,3), (3,5), (5,10), (10,15), (15,20), (20,30), (30,60)]:
    mask = (R_arr >= lo) & (R_arr < hi)
    if mask.sum() < 50: continue
    err = preds_opt[mask] - NB_arr[mask]
    rmse = np.sqrt(np.mean(err**2))
    print(f"[{lo:>2}, {hi:>2}[      {mask.sum():>8} {rmse:>10.5f} {rmse*365.25:>10.2f}")

# ============================================================
# Recherche d'un yield optimal PAR tranche
# (si le yield bouge selon R, c'est qu'il y a une autre logique)
# ============================================================
print(f"\n--- Yield optimal par tranche ---")
print(f"{'tranche':<14} {'n':>8} {'y_opt':>10} {'RMSE':>10}")
for lo, hi in [(1,3), (3,5), (5,10), (10,15), (15,20), (20,30), (30,60)]:
    mask = (R_arr >= lo) & (R_arr < hi)
    if mask.sum() < 50: continue
    R_s, NB_s = R_arr[mask], NB_arr[mask]
    def loss_local(y):
        return np.mean((predict_all(R_s, y) - NB_s)**2)
    res_l = minimize_scalar(loss_local, bounds=(0.001, 0.20),
                             method='bounded', options={'xatol': 1e-7})
    print(f"[{lo:>2}, {hi:>2}[      {mask.sum():>8} {res_l.x*100:>9.4f}% "
          f"{np.sqrt(res_l.fun):>10.5f}")
