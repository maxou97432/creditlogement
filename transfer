def consensus_avec_solve(
    self,
    label_style: str = "glouton",
    k_min: int = 1,
    lgd_gap_threshold: Optional[float] = None,
) -> pl.DataFrame:
    """Consensus étendu : lance solve() pour chaque test et retourne
    le nombre de classes finales + la composition par test.

    Retourne un DataFrame avec une ligne par test :
        test, n_paires_fusionnables, n_classes_finales, composition

    composition : dict {label_final: [classes_origine]} après fusion
                  transitive — reflète la vraie structure du modèle
                  final pour ce critère.

    Note : les tests documentaires (Welch/KS/ANOVA) ne suggèrent aucune
    fusion à grand n (saturation) -> n_classes_finales = n_initial.
    Les tests effet (OVL, Cohen, Hedges) produisent des fusions réelles.
    """
    self._ensure_run()
    names = self.test_names

    rows = []
    for name in names:
        # n_paires_fusionnables depuis le cache (pas de recalcul)
        n_paires = sum(
            1 for _, per_test in self._runs
            if per_test[name]["fusion_suggeree"]
        )

        # solve() pour ce test
        try:
            sol = self.solve(
                criterion=name,
                label_style=label_style,
                k_min=k_min,
                lgd_gap_threshold=lgd_gap_threshold,
            )
            n_final = sol["n_final"]
            composition = sol["composition"]
        except Exception as e:
            n_final = None
            composition = {"erreur": str(e)}

        rows.append({
            "test": name,
            "n_paires_fusionnables": int(n_paires),
            "n_classes_finales": n_final,
            "composition": str(composition),
        })

    return pl.DataFrame(rows, schema_overrides={
        "n_classes_finales": pl.Int64,
    })
