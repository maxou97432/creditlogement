# ============================================================
#  TEST D'HOMOGENEITE I² (Cochran Q) — fusion gloutonne
#  Référence : Higgins & Thompson (2002), Cochrane Handbook
#  Seuil : I² < 25% = homogène (convention universelle)
# ============================================================

import numpy as np
import polars as pl
import matplotlib.pyplot as plt
from scipy import stats

# ================================================================
#  PARAMETRES
# ================================================================

I2_SEUIL      = 0.25   # seuil homogeneite : 25% convention Cochrane
I2_MODERE     = 0.50   # zone moderee
MAX_ITER      = 200
CODES_FUSIONNABLES = {0, 1}


# ================================================================
#  FONCTIONS CORE
# ================================================================

def compute_Q_I2(groups: list[dict]) -> tuple[float, float, float]:
    """
    Calcule Q de Cochran et I² sur un ensemble de groupes.

    Chaque groupe = {"mean": float, "var": float, "n": int}
    où var = variance intra-groupe (variance de la LGD dans la classe).

    Q = Σ w_i * (y_i - y_pooled)²
    où w_i = 1 / v_i  et  v_i = var_i / n_i  (variance de la moyenne)

    I² = max(0, (Q - df) / Q)  avec df = k - 1

    Retourne (Q, I2, y_pooled)
    """
    k = len(groups)
    if k < 2:
        return 0.0, 0.0, float(groups[0]["mean"]) if groups else 0.0

    # Variance de la moyenne estimee pour chaque groupe
    vi     = np.array([g["var"] / g["n"] for g in groups])
    wi     = 1.0 / vi
    yi     = np.array([g["mean"] for g in groups])

    # Moyenne poolee (weighted)
    y_pool = float((wi * yi).sum() / wi.sum())

    # Statistique Q
    Q  = float((wi * (yi - y_pool) ** 2).sum())
    df = k - 1

    # I²
    I2 = max(0.0, (Q - df) / Q) if Q > 0 else 0.0

    return Q, I2, y_pool


def i2_fusion_test(a: np.ndarray, b: np.ndarray) -> tuple[int, str, dict]:
    """
    Teste si fusionner a et b produit un groupe homogene au sens I².

    Logique :
      - Calculer I² sur le groupe fusionne {a, b}
      - Si I² < I2_SEUIL (25%) : homogene -> code 0
      - Si I² < I2_MODERE (50%) : moderement homogene -> code 1
      - Sinon : heterogene -> code 99

    Retourne (code, raison, diag)
    """
    groups = [
        {"mean": float(a.mean()), "var": float(a.var(ddof=1)), "n": len(a)},
        {"mean": float(b.mean()), "var": float(b.var(ddof=1)), "n": len(b)},
    ]

    Q, I2, y_pool = compute_Q_I2(groups)

    # P-value du test Q (chi2 avec df=1)
    df   = len(groups) - 1
    pval = float(1 - stats.chi2.cdf(Q, df))

    diag = {
        "Q"       : round(Q,     4),
        "I2"      : round(I2,    4),
        "I2_pct"  : round(I2 * 100, 1),
        "pval_Q"  : round(pval,  4),
        "mean_a"  : round(float(a.mean()), 4),
        "mean_b"  : round(float(b.mean()), 4),
        "gap"     : round(abs(float(a.mean()) - float(b.mean())), 4),
        "n_a"     : len(a),
        "n_b"     : len(b),
    }

    if I2 < I2_SEUIL:
        return 0, f"[I²={I2*100:.1f}%] < {I2_SEUIL*100:.0f}% (homogène)", diag
    elif I2 < I2_MODERE:
        return 1, f"[I²={I2*100:.1f}%] < {I2_MODERE*100:.0f}% (modéré)", diag
    else:
        return 99, f"[I²={I2*100:.1f}%] >= {I2_MODERE*100:.0f}% (hétérogène)", diag


