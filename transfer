### 💻 Fonctions de résolution (inchangées)

```python
def resoudre_entree_effective(index, catalogue, selection, config):
    nb = catalogue[index]
    entree_declaree = nb.get("input_file")

    if entree_declaree is None:
        return None

    if isinstance(entree_declaree, dict):
        return {k: config["intermediate_dir"] / config[v] for k, v in entree_declaree.items()}

    producteur_normal = next(
        (n for n in catalogue[:index] if n.get("output_file") == entree_declaree), None
    )
    if producteur_normal and producteur_normal["name"] in selection:
        return config["intermediate_dir"] / config[entree_declaree]

    for n in reversed(catalogue[:index]):
        if n["name"] in selection and isinstance(n.get("output_file"), str):
            print(f"    [repli] {nb['name']} lira la sortie de {n['name']} "
                  f"({n['output_file']}) au lieu de {entree_declaree}")
            return config["intermediate_dir"] / config[n["output_file"]]

    raise ValueError(f"{nb['name']} : aucune entrée disponible (attendait '{entree_declaree}')")


def resoudre_sortie(nb, config):
    sortie = nb.get("output_file")
    if sortie is None:
        return None
    if isinstance(sortie, dict):
        return {k: config["intermediate_dir"] / config[v] for k, v in sortie.items()}
    return config["intermediate_dir"] / config[sortie]


def serialiser(valeur):
    if valeur is None:
        return None
    if isinstance(valeur, dict):
        return {k: str(v) for k, v in valeur.items()}
    return str(valeur)


def chemins_a_plat(valeur):
    if valeur is None:
        return []
    if isinstance(valeur, dict):
        return list(valeur.values())
    return [valeur]


def noms_a_plat(valeur):
    if valeur is None:
        return "— (sources)"
    if isinstance(valeur, dict):
        return ", ".join(p.name for p in valeur.values())
    return valeur.name
```

