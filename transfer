try:
    prix_m2_univ_elem_complet_CITY = pd.read_csv(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\bdd_univ_elem_zone_insee\prix_m2_univ_elem_complet_CITY.csv")
    prix_m2_univ_elem_complet_DEPT = pd.read_csv(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\bdd_univ_elem_zone_insee\prix_m2_univ_elem_complet_DEPT.csv")
    prix_m2_univ_elem_complet_REGION = pd.read_csv(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\bdd_univ_elem_zone_insee\prix_m2_univ_elem_complet_REGION.csv")
except FileNotFoundError as e:
    print(f"Erreur de lecture de fichier : {e}")
    sys.exit(1)


dfs_to_concat = [
    prix_m2_univ_elem_complet_CITY,
    prix_m2_univ_elem_complet_DEPT,
    prix_m2_univ_elem_complet_REGION
]

df_final = pd.concat(dfs_to_concat, ignore_index = True)
df_final = df_final[df_final['DIC_NAME'] != "prix_m2_3m"]
df_final = df_final.drop(columns=["TYPE_MAILLE","TAUX_INFL_12M","TAUX_INFL_3M", "DIC_NAME"], errors='ignore') # Ajout d'errors='ignore'

# --- Calcul de l'indice CL ---
mask_2019 = df_final["Periode"].astype(str).str[:4] == "2019"
if not df_final.loc[mask_2019, "prix_mm_value"].empty:
    mean_2019 = df_final.loc[mask_2019, "prix_mm_value"].mean()
    df_final["Indice de prix (CL)"] = ((df_final["prix_mm_value"] /mean_2019 ) * 100).round(2)
else:
    print("Attention: Aucune donnée trouvée pour 2019. L'Indice de prix (CL) ne peut pas être calculé.")
    df_final["Indice de prix (CL)"] = np.nan

# --- Préparation des données INSEE ---
types_biens = ['APT', 'MAI']
perimetre_insee= ['92', '93', '94', '95', '91', '78', '77', "MARSEILLE", "LYON", "LILLE",'NORD-PAS-DE-CALAIS','PACA','RHONE-ALPES','PROVINCE','AUVERGNE']
insee_to_concat = []

for perimetre in perimetre_insee:
    for type in types_biens:
        try:
            # NOTE: Changement du séparateur par défaut de read_csv si ce n'est pas ';', ou confirmation qu'il l'est
            valeurs_trimestrielles = pd.read_csv(rf"TI\table_rapport (2025)\valeurs_trimestrielles_{perimetre}_{type}.csv", sep = ';')
        except FileNotFoundError:
            continue
        except Exception as e:
            print(f"Erreur de lecture pour {perimetre}_{type}: {e}")
            continue

        valeurs_trimestrielles = valeurs_trimestrielles[4:]
        # La colonne 'Indice de prix (INSEE)' est la deuxième colonne (index 1) après le slicing
        valeurs_trimestrielles = valeurs_trimestrielles.rename(columns={valeurs_trimestrielles.columns[1]: 'Indice de prix (INSEE)'})
        
        # S'assurer que la colonne est numérique
        valeurs_trimestrielles['Indice de prix (INSEE)'] = pd.to_numeric(valeurs_trimestrielles['Indice de prix (INSEE)'], errors='coerce')
        
        # Création de la colonne de Période cohérente (premier jour du trimestre)
        valeurs_trimestrielles['Year'] = valeurs_trimestrielles['Libellé'].apply(lambda x: int(x.split('-')[0]))
        valeurs_trimestrielles['Quarter'] = valeurs_trimestrielles['Libellé'].apply(lambda x: int(x.split('T')[-1]))
        valeurs_trimestrielles["Date code"] = (valeurs_trimestrielles['Year'].astype(str) + 'Q' + valeurs_trimestrielles["Quarter"].astype(str))
        
        # *** ÉTAPE CRUCIALE POUR LA COHÉRENCE ***
        # Création de la colonne de fusion sur base du début de trimestre
        valeurs_trimestrielles["Periode"] = pd.PeriodIndex(valeurs_trimestrielles["Date code"],freq = "Q").to_timestamp(how="start")
        
        valeurs_trimestrielles["VAL_MAILLE_GEO"] = perimetre
        valeurs_trimestrielles["CD_TYPE_BIEN"] = type
        valeurs_trimestrielles = valeurs_trimestrielles.drop(columns=["Libellé","Year","Quarter","Date code"])
        insee_to_concat.append(valeurs_trimestrielles)

if insee_to_concat:
    insee_final = pd.concat(insee_to_concat, ignore_index = True)
    insee_final = insee_final.drop(columns=["Codes"], errors='ignore')
    colonnes = ['VAL_MAILLE_GEO',"CD_TYPE_BIEN",'Periode','Indice de prix (INSEE)']
    insee_final = insee_final[colonnes]
else:
    print("Attention: Aucun fichier INSEE n'a pu être chargé.")
    sys.exit(1)


# --- Préparation finale avant fusion et normalisation des dates ---

# Convertir la colonne 'Periode' en datetime pour les deux DFs
df_final["Periode"] = pd.to_datetime(df_final["Periode"])
insee_final["Periode"] = pd.to_datetime(insee_final["Periode"])

# Nettoyage des colonnes de fusion
for df in (df_final, insee_final):
    df["VAL_MAILLE_GEO"] = df["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
    df["CD_TYPE_BIEN"] = df["CD_TYPE_BIEN"].astype(str).str.strip().str.upper()


# *** CORRECTION CLÉ : Normaliser les dates au premier jour du trimestre ***
# Cela garantit que les périodes correspondent exactement (ex: 2020-01-01 == 2020-01-01)
df_final['Periode_Merge'] = df_final['Periode'].dt.to_period('Q').dt.start_time
insee_final['Periode_Merge'] = insee_final['Periode'].dt.to_period('Q').dt.start_time


# --- Debugging Intermédiaire ---
print("--- Vérification des données avant fusion ---")
print(f"VAL_MAILLE_GEO (CL) : {df_final['VAL_MAILLE_GEO'].unique()}")
print(f"VAL_MAILLE_GEO (INSEE) : {insee_final['VAL_MAILLE_GEO'].unique()}")
print(f"Périodes (CL) - Exemples : {df_final['Periode_Merge'].head().tolist()}")
print(f"Périodes (INSEE) - Exemples : {insee_final['Periode_Merge'].head().tolist()}")
print(f"Taille de df_final : {len(df_final)}")
print(f"Taille de insee_final : {len(insee_final)}")
print("------------------------------------------")


# --- Fusion (Merge) en utilisant la nouvelle colonne de période normalisée ---
merge = pd.merge(df_final, 
                 insee_final.drop(columns=['Periode']), # On enlève l'ancienne colonne de période INSEE
                 how = "inner",
                 left_on = ["VAL_MAILLE_GEO","CD_TYPE_BIEN","Periode_Merge"],
                 right_on = ["VAL_MAILLE_GEO","CD_TYPE_BIEN","Periode_Merge"])

# Renommer la colonne 'Periode_Merge' pour qu'elle s'appelle 'Periode'
merge = merge.rename(columns={'Periode_Merge': 'Periode'})
merge = merge.drop(columns=['Periode_x', 'Periode_y'], errors='ignore')

print("\n--- Résultat de la fusion (20 premières lignes) ---")
