def build_pipeline(
    cap_pret_lf: pl.LazyFrame,
    *,
    # Toujours requis
    cd_portfolio: str = "cd_portfolio",
    ead:          str = "MT_EAD_FLOOR",
    tx_edf:       str = "tx_edf",
    tx_lgd:       str = "tx_lgd",
    # Requis si DURATION_MODE=None
    duration:     str | None = "duration",
    # Requis si DURATION_MODE="recomputed"
    dt_echeance:   str | None = None,
    dt_arrt:       str | None = None,
    cd_type_amort: str | None = None,
    # Mode
    DURATION_MODE: str | None = None,   # None ou "NEW"
    drop_tmp:      bool = True,
) -> pl.LazyFrame:
    """
    Pipeline RWA_init.

    DURATION_MODE :
      - None  → utilise la colonne `duration` (kwarg `duration`)
      - "NEW" → recalcule depuis dt_echeance, dt_arrt, cd_type_amort
                (les 3 kwargs deviennent obligatoires)
    """
    if DURATION_MODE == "NEW":
        if not all([dt_echeance, dt_arrt, cd_type_amort]):
            raise ValueError(
                "DURATION_MODE='NEW' nécessite dt_echeance, dt_arrt, cd_type_amort"
            )
        # 1) Normalisation (duration ignorée dans ce mode)
        lf = _normalize(
            cap_pret_lf,
            cd_portfolio=cd_portfolio,
            ead=ead,
            tx_edf=tx_edf,
            tx_lgd=tx_lgd,
            dt_echeance=dt_echeance,
            dt_arrt=dt_arrt,
            cd_type_amort=cd_type_amort,
        )
        # 2) Recalcul de maturité
        lf = add_recomputed_maturity(lf)
        # 3) Préparation base (utilise NB_DURATION_RECALCULE comme source)
        lf = build_base(lf, duration_source="NB_DURATION_RECALCULE")
    else:
        if duration is None:
            raise ValueError("`duration` est requis quand DURATION_MODE est None")
        lf = _normalize(
            cap_pret_lf,
            cd_portfolio=cd_portfolio,
            ead=ead,
            tx_edf=tx_edf,
            tx_lgd=tx_lgd,
            duration=duration,
        )
        lf = build_base(lf, duration_source="duration")

    # 4) Calcul RWA_init
    lf = add_rwa_init_scenario(lf)

    # 5) Nettoyage
    if drop_tmp:
        lf = drop_tmp_cols(lf)

    return lf
