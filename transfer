def process_maille_wrapper(df, maille_col, maille_name, df_structure=None):
    """
    Calcule les prix glissants pour une maille géographique donnée.

    Wrapper au-dessus de `process_dataset_restreint` (fonctions.py) qui :
    - Renomme temporairement la colonne `maille_col` en ``"Ville"`` pour être
      compatible avec la fonction sous-jacente
    - Adapte également la structure de référence si fournie
    - Reconvertit la sortie au format tabulaire attendu par `save_results`

    Parameters
    ----------
    df : pd.DataFrame
        Base de données filtrée sur le périmètre voulu (ex. uniquement province).
    maille_col : str
        Nom de la colonne géographique dans `df` (ex. ``"DEPT"``, ``"REGION"``, ``"Ville"``).
    maille_name : str
        Libellé de la maille utilisé dans les logs et les colonnes de sortie
        (ex. ``"PROVINCE"``, ``"CITY"``, ``"NATIONAL"``).
    df_structure : pd.DataFrame, optionnel
        Structure de référence (poids par univers élémentaire) issue de
        `extract_and_save_structure` ou `get_structure_reference_city`.
        Si ``None``, la structure est calculée directement sur `df`.

    Returns
    -------
    pd.DataFrame or None
        DataFrame au format long avec les colonnes :
        ``VAL_MAILLE_GEO``, ``TYPE_MAILLE``, ``CD_TYPE_BIEN``, ``Periode``,
        ``DIC_NAME``, ``prix_mm_value``, ``nb_observations``, ``nb_univers``,
        ``TAUX_INFL_12M``, ``TAUX_INFL_3M``.
        Retourne ``None`` si aucune donnée disponible pour cette maille.
    """
    print(f"\n--- Traitement de la maille : {maille_name} ---")
    start_time = datetime.now()
    
    # Préparation : renommer la colonne maille en "Ville"
    df_work = df.copy()
    
    # Si la colonne n'est pas déjà "Ville", on la renomme temporairement
    if maille_col != "Ville":
        if "Ville" in df_work.columns:
            df_work = df_work.drop(columns=["Ville"])
        df_work = df_work.rename(columns={maille_col: "Ville"})
    
    # Nettoyage standard
    df_work["Ville"] = df_work["Ville"].astype(str).str.strip().str.upper()
    df_work = df_work.dropna(subset=["Ville", "TYPE_BIEN", "NB_PIECES_RANGE"])
    
    # Si on a une structure de référence, on doit aussi renommer sa colonne
    structure_adapted = None
    if df_structure is not None:
        structure_adapted = df_structure.copy()
        if maille_col in structure_adapted.columns and maille_col != "Ville":
            structure_adapted = structure_adapted.rename(columns={maille_col: "Ville"})
    
    # Appel de la fonction unifiée
    result = process_dataset_restreint(
        df_work, 
        label=maille_name,
        df_structure=structure_adapted,
        df_arr=None  # Pas de gestion d'arrondissements pour les mailles génériques
    )
    
    if result is None or result.empty:
        print(f"Aucune donnée pour la maille {maille_name}")
        return None
    
    # Conversion du format de sortie
    # process_dataset_restreint retourne : Ville, Periode, prix_mm_3m, prix_mm_12m, surface_mm_3m, surface_mm_12m, VF_mm_3m, VF_mm_12m
    # On veut : VAL_MAILLE_GEO, TYPE_MAILLE, CD_TYPE_BIEN, Periode, DIC_NAME, value
    
    # Mapping des colonnes source → DIC_NAME
    variables_mapping = [
        (f"prix_mm_3m ({maille_name})", "prix_m2_3m"),
        (f"prix_mm_12m ({maille_name})", "prix_m2_12m"),
        (f"surface_mm_3m ({maille_name})", "surface_3m"),
        (f"surface_mm_12m ({maille_name})", "surface_12m"),
        (f"VF_mm_3m ({maille_name})", "valeur_3m"),
        (f"VF_mm_12m ({maille_name})", "valeur_12m")
    ]
    
    # Vérification de la présence des colonnes de statistiques de volumique
    # (utile pour diagnostiquer si process_dataset_restreint retourne bien les stats attendues)
    print(f"\n  Colonnes de statistiques :")
    for col in ["nb_observations_3m", "nb_observations_12m", "nb_univers_3m", "nb_univers_12m"]:
        if col in result.columns:
            print(f"    ✓ {col}: min={result[col].min()}, max={result[col].max()}, mean={result[col].mean():.1f}")
        else:
            print(f"    ✗ {col}: MANQUANTE")
    
    final_rows = []
    
    for _, row in result.iterrows():
        ville = row["Ville"]
        periode = row["Periode"]
        
        # Boucle sur toutes les variables
        for col_source, dic_name in variables_mapping:
            if col_source in result.columns and pd.notna(row[col_source]):
                # Déterminer si c'est 3m ou 12m pour extraire les bonnes stats
                if "_3m" in dic_name:
                    nb_obs = row.get("nb_observations_3m", 0)
                    nb_univ = row.get("nb_univers_3m", 0)
                elif "_12m" in dic_name:
                    nb_obs = row.get("nb_observations_12m", 0)
                    nb_univ = row.get("nb_univers_12m", 0)
                else:
                    nb_obs = 0
                    nb_univ = 0
                
                final_rows.append({
                    "VAL_MAILLE_GEO": ville,
                    "TYPE_MAILLE": maille_col,
                    # CD_TYPE_BIEN est fixé à "APT" car process_dataset_restreint agrège
                    # tous les types de bien (APT + MAI) dans un même indice composite.
                    # Ce champ est conservé pour compatibilité avec le format de sortie attendu.
                    "CD_TYPE_BIEN": "APT",
                    "Periode": periode,
                    "DIC_NAME": dic_name,
                    "prix_mm_value": row[col_source],
                    "nb_observations": int(nb_obs) if pd.notna(nb_obs) else 0,
                    "nb_univers": int(nb_univ) if pd.notna(nb_univ) else 0
                })
    
    if not final_rows:
        print(f"Aucune donnée après conversion pour {maille_name}")
        return None
    
    final_result = pd.DataFrame(final_rows)
    
    # Calcul des taux d'inflation
    final_result = final_result.sort_values(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "DIC_NAME"])
    # données mensuelles → 12 mois = 12 périodes, 3 mois = 3 périodes
    final_result["TAUX_INFL_12M"] = final_result.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "DIC_NAME"])["prix_mm_value"].pct_change(periods=12)
    final_result["TAUX_INFL_3M"]  = final_result.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "DIC_NAME"])["prix_mm_value"].pct_change(periods=3)
    
    print(f"Traitement {maille_name} terminé en {datetime.now() - start_time}")
    print(f"  → {len(final_result)} lignes générées")
    return final_result



def extract_and_save_structure(df, maille_col, maille_name, resultats_dir):
    """
    Calcule et sauvegarde la structure de marché (poids par univers élémentaire).

    Pour chaque univers (maille × ancienneté × type × gamme de pièces), calcule le
    volume de transactions et le poids relatif au sein de la maille géographique.
    Les combinaisons incohérentes TYPE_BIEN / NB_PIECES_RANGE sont filtrées via la
    variable temporaire ``PB``.

    Parameters
    ----------
    df : pd.DataFrame
        Base de transactions filtrée sur le périmètre voulu.
    maille_col : str
        Nom de la colonne géographique (ex. ``"DEPT"``, ``"REGION"``, ``"Ville"``).
    maille_name : str
        Libellé utilisé pour nommer le fichier de sortie.
    resultats_dir : str
        Chemin vers le répertoire de sortie.

    Returns
    -------
    pd.DataFrame
        Structure de marché avec colonnes :
        `[maille_col, BIEN_NEUF, TYPE_BIEN, NB_PIECES_RANGE, volume_ref, poids_ref]`.
    """
    print(f"\n   Extraction structure {maille_name}...")
    
    # Calcul de la structure (volume par univers élémentaire)
    dims = [maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
    structure = df.groupby(dims, dropna=False).size().reset_index(name="volume_ref")
    
    # Nettoyage
    structure["TYPE_BIEN"] = structure["TYPE_BIEN"].astype(str).str.upper().str.strip()
    structure["PB"] = structure["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
    mask_coherence = structure["TYPE_BIEN"] == structure["PB"]
    structure = structure[mask_coherence].drop(columns=["PB"])
    
    # Calcul des poids relatifs
    structure["poids_ref"] = structure.groupby(maille_col)["volume_ref"].transform(lambda x: x / x.sum())
    
    # Sauvegarde
    filename = f"structure_poids_{maille_name}.csv"
    path = os.path.join(resultats_dir, filename)
    structure.to_csv(path, index=False, encoding='utf-8-sig')
    
    print(f"      -> {filename}")
    print(f"         {len(structure)} univers, {structure[maille_col].nunique()} {maille_name}")
    
    return structure


