# ============================================================
# 5. Discrimination test: contractual rate vs pivot rate
# ============================================================
# This test demonstrates empirically that SRS does NOT use the
# per-line contractual rate T_INTRT to compute the maturity.
#
# Methodology:
#   - For each facility, compute M using its actual contractual rate T_INTRT
#   - For each facility, compute M using a single pivot yield y_pivot
#   - Compare both predictions to the SRS reference NB_MATURITE_IRBA
#   - The hypothesis with lower RMSE is the one SRS actually uses
#
# Expected outcome (documented finding):
#   - RMSE with pivot yield (~0.085 yrs / 31 days) is much lower than
#     RMSE with contractual rate (~0.337 yrs / 123 days), by a factor ~4x
#   - This proves SRS uses a single internal pivot rate, not the
#     facility-specific contractual rate
# ============================================================
def test_contractual_rate(df_calib: pl.DataFrame, y_pivot: float) -> dict:
    """
    Compare pivot yield performance against per-line contractual rate.

    If RMSE_pivot < RMSE_contractual, we confirm SRS does NOT use T_INTRT
    and instead uses a single hardcoded pivot rate.

    Also runs a stratified comparison by R band to show that the contractual
    rate underperforms across all maturity ranges (not just on average).
    """
    R_arr  = df_calib["R"].to_numpy()
    NB_arr = df_calib["NB_MATURITE_IRBA"].to_numpy()
    Y_arr  = df_calib["T_INTRT"].to_numpy()

    # Predictions under both hypotheses
    pred_pivot       = predict_m_bale_progressif(R_arr, y_pivot)
    pred_contractual = np.array([
        predict_m_bale_progressif(np.array([R]), y)[0]
        for R, y in zip(R_arr, Y_arr)
    ])

    err_pivot       = pred_pivot - NB_arr
    err_contractual = pred_contractual - NB_arr

    rmse_pivot       = np.sqrt(np.mean(err_pivot ** 2))
    rmse_contractual = np.sqrt(np.mean(err_contractual ** 2))

    print(f"\n--- Global comparison ---")
    print(f"  Hypothesis A (pivot yield {y_pivot*100:.4f}%):")
    print(f"    RMSE = {rmse_pivot:.5f} yrs ({rmse_pivot*365.25:.2f} days)")
    print(f"    MAE  = {np.mean(np.abs(err_pivot)):.5f} yrs")
    print(f"    max|err| = {np.max(np.abs(err_pivot)):.5f} yrs")
    print(f"    %|err|<0.05 = {(np.abs(err_pivot)<0.05).mean()*100:.2f}%")
    print(f"  Hypothesis B (per-line T_INTRT contractual rate):")
    print(f"    RMSE = {rmse_contractual:.5f} yrs ({rmse_contractual*365.25:.2f} days)")
    print(f"    MAE  = {np.mean(np.abs(err_contractual)):.5f} yrs")
    print(f"    max|err| = {np.max(np.abs(err_contractual)):.5f} yrs")
    print(f"    %|err|<0.05 = {(np.abs(err_contractual)<0.05).mean()*100:.2f}%")

    # Stratified comparison across R bands
    print(f"\n--- Stratified comparison by R band ---")
    print(f"  {'R band':<14} {'n':>8} {'RMSE pivot (j)':>16} "
          f"{'RMSE contract. (j)':>20} {'ratio':>8}")
    bands = [(1, 3), (3, 5), (5, 10), (10, 15), (15, 20), (20, 30), (30, 60)]
    stratified = []
    for lo, hi in bands:
        mask = (R_arr >= lo) & (R_arr < hi)
        if mask.sum() < 50:
            continue
        rmse_p = np.sqrt(np.mean(err_pivot[mask] ** 2)) * 365.25
        rmse_c = np.sqrt(np.mean(err_contractual[mask] ** 2)) * 365.25
        ratio  = rmse_c / rmse_p if rmse_p > 0 else float('nan')
        print(f"  [{lo:>2}, {hi:>2}[      {mask.sum():>8} "
              f"{rmse_p:>15.2f} {rmse_c:>19.2f} {ratio:>8.2f}x")
        stratified.append({
            "R_band": f"[{lo}, {hi}[", "n": int(mask.sum()),
            "rmse_pivot_days": rmse_p,
            "rmse_contractual_days": rmse_c,
            "ratio": ratio,
        })

    # Implied yield analysis: invert the formula per line and check whether
    # the implied yield correlates with T_INTRT. If not, T_INTRT is unused.
    from scipy.optimize import brentq
    print(f"\n--- Implied yield analysis (per-line inversion) ---")
    implied = []
    for R, NB in zip(R_arr[:5000], NB_arr[:5000]):  # sample for speed
        try:
            g = lambda y: predict_m_bale_progressif(np.array([R]), y)[0] - NB
            if g(-0.20) * g(0.50) > 0:
                continue
            y_impl = brentq(g, -0.20, 0.50, xtol=1e-7)
            implied.append(y_impl)
        except Exception:
            continue
    implied = np.array(implied)
    contractual_sample = Y_arr[:len(implied)]
    if len(implied) > 100:
        corr = np.corrcoef(implied, contractual_sample)[0, 1]
        print(f"  Implied yield median: {np.median(implied)*100:.4f}%")
        print(f"  Implied yield std   : {np.std(implied)*100:.4f}%")
        print(f"  Correlation(implied_yield, T_INTRT) = {corr:.4f}")
        if abs(corr) < 0.20:
            print(f"  ===> Correlation is near zero: T_INTRT is NOT used by SRS.")
        elif corr > 0.95:
            print(f"  ===> Strong correlation: SRS uses T_INTRT.")
        else:
            print(f"  ===> Partial correlation: another factor at play.")

    return {
        "rmse_pivot_yield_days"      : rmse_pivot * 365.25,
        "rmse_contractual_rate_days" : rmse_contractual * 365.25,
        "ratio"                      : rmse_contractual / rmse_pivot,
        "stratified"                 : stratified,
        "implied_yield_median_pct"   : float(np.median(implied) * 100) if len(implied) > 0 else None,
        "correlation_with_T_INTRT"   : float(corr) if len(implied) > 100 else None,
        "verdict"                    : ("Pivot yield beats contractual rate"
                                        if rmse_pivot < rmse_contractual
                                        else "Contractual rate is better"),
    }
