import pandas as pd
import numpy as np
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_squared_error
from statsmodels.tsa.arima.model import ARIMA
from statsmodels.tsa.holtwinters import ExponentialSmoothing
from prophet import Prophet
import warnings
import logging

# Configuration
warnings.filterwarnings("ignore")
logging.getLogger('cmdstanpy').setLevel(logging.WARNING) # Silence Prophet logs

# 1. PRÉPARATION DE LA SÉRIE
# On s'assure d'avoir la série complète de l'écart
df_analyse = merge.sort_values("Periode").set_index("Periode")
ts_ecart = df_analyse['Dif'].dropna()
ts_ecart.index = pd.PeriodIndex(ts_ecart.index, freq='Q') # Force trimestriel

# 2. CONFIGURATION DE LA CROSS-VALIDATION
# On va faire 5 tests différents en remontant dans le passé
# test_size=4 : Sur chaque pli, on essaie de prédire 1 an (4 trimestres)
n_splits = 5
test_horizon = 4 
tscv = TimeSeriesSplit(n_splits=n_splits, test_size=test_horizon)

# Dictionnaire pour stocker les scores RMSE de chaque passe
results_cv = {
    'ARIMA (4,1,3)': [],
    'DES (Holt)': [],
    'TES (Holt-Winters)': [],
    'Prophet': []
}

print(f"🚀 Démarrage du Tournoi Cross-Validation ({n_splits} rounds)...")

fold = 1
for train_index, test_index in tscv.split(ts_ecart):
    
    # Création des sous-échantillons Train/Test pour ce Round
    cv_train = ts_ecart.iloc[train_index]
    cv_test = ts_ecart.iloc[test_index]
    
    print(f"\n--- Round {fold}/{n_splits} ---")
    print(f"Train : {len(cv_train)} trimestres | Test : {cv_test.index[0]} à {cv_test.index[-1]}")
    
    # ---------------------------------------------------------
    # A. Modèle ARIMA (4,1,3)
    # ---------------------------------------------------------
    try:
        model_arima = ARIMA(cv_train, order=(4, 1, 3))
        fit_arima = model_arima.fit()
        pred_arima = fit_arima.forecast(steps=test_horizon)
        rmse_arima = np.sqrt(mean_squared_error(cv_test, pred_arima))
        results_cv['ARIMA (4,1,3)'].append(rmse_arima)
    except:
        results_cv['ARIMA (4,1,3)'].append(np.nan)

    # ---------------------------------------------------------
    # B. Modèle DES (Holt - Tendance amortie)
    # ---------------------------------------------------------
    try:
        model_des = ExponentialSmoothing(
            cv_train, 
            trend='add', 
            seasonal=None, 
            damped_trend=True,
            initialization_method="estimated"
        ).fit()
        pred_des = model_des.forecast(steps=test_horizon)
        rmse_des = np.sqrt(mean_squared_error(cv_test, pred_des))
        results_cv['DES (Holt)'].append(rmse_des)
    except:
        results_cv['DES (Holt)'].append(np.nan)

    # ---------------------------------------------------------
    # C. Modèle TES (Holt-Winters - Saisonnier)
    # ---------------------------------------------------------
    try:
        model_tes = ExponentialSmoothing(
            cv_train, 
            trend='add', 
            seasonal='add', 
            seasonal_periods=4,
            damped_trend=True,
            initialization_method="estimated"
        ).fit()
        pred_tes = model_tes.forecast(steps=test_horizon)
        rmse_tes = np.sqrt(mean_squared_error(cv_test, pred_tes))
        results_cv['TES (Holt-Winters)'].append(rmse_tes)
    except:
        results_cv['TES (Holt-Winters)'].append(np.nan)

    # ---------------------------------------------------------
    # D. Modèle PROPHET
    # ---------------------------------------------------------
    try:
        # Prophet a besoin d'un DataFrame ds/y et de timestamps
        df_prophet_cv = pd.DataFrame({
            'ds': cv_train.index.to_timestamp(),
            'y': cv_train.values
        })
        
        # On utilise les hyperparamètres "moyens" ou optimisés précédemment
        m = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False,
                    changepoint_prior_scale=0.05) 
        m.fit(df_prophet_cv)
        
        future = m.make_future_dataframe(periods=test_horizon, freq='Q')
        forecast = m.predict(future)
        pred_prophet = forecast['yhat'].iloc[-test_horizon:].values
        
        rmse_prophet = np.sqrt(mean_squared_error(cv_test, pred_prophet))
        results_cv['Prophet'].append(rmse_prophet)
    except:
        results_cv['Prophet'].append(np.nan)
        
    fold += 1

# ==============================================================================
# SYNTHÈSE DES RÉSULTATS
# ==============================================================================

# Création d'un tableau récapitulatif
df_results = pd.DataFrame(results_cv)

# Calcul de la moyenne et de l'écart-type (Stabilité)
summary = pd.DataFrame({
    'RMSE Moyen': df_results.mean(),
    'RMSE Std (Stabilité)': df_results.std(),
    'Min RMSE': df_results.min(),
    'Max RMSE': df_results.max()
})

print("\n" + "="*60)
print("🏆 RÉSULTATS FINAUX DU TOURNOI (Cross-Validation) 🏆")
print("="*60)
print(summary.sort_values("RMSE Moyen"))

best_model_name = summary['RMSE Moyen'].idxmin()
print(f"\n✅ Le grand vainqueur (plus faible erreur moyenne) est : {best_model_name}")
