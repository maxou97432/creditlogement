import numpy as np
import polars as pl
import matplotlib.pyplot as plt
from scipy.cluster.hierarchy import dendrogram, linkage, fcluster
from scipy.spatial.distance import squareform

# --- Stats par classe, triees par LGD moyenne croissante ---
class_stats = (
    df_base
    .group_by("CHR_model")
    .agg([
        pl.col("lgd_obligor").mean().alias("mean_lgd"),
        pl.col("lgd_obligor").var().alias("var_lgd"),
        pl.col("lgd_obligor").count().alias("n"),
    ])
    .sort("mean_lgd")
)

classes = class_stats["CHR_model"].to_list()
means   = np.array(class_stats["mean_lgd"].to_list())
ns      = np.array(class_stats["n"].to_list())
K       = len(classes)

print(f"{K} classes | LGD [{means.min():.3f} – {means.max():.3f}]\n")

# --- Algorithme de Ward avec contrainte d'adjacence ---
# Implémentation manuelle : à chaque étape on ne considère
# que les paires adjacentes dans l'ordre courant

# Etat courant : liste ordonnée de groupes
# Chaque groupe = {"label": str, "mean": float, "n": int, "members": list}
groups = [
    {"label": str(c), "mean": float(m), "n": int(n), "members": [str(c)]}
    for c, m, n in zip(classes, means, ns)
]

fusion_history = []   # (distance_ward, label_a, label_b, label_new, n_classes_apres)

while len(groups) > 1:
    best_delta = np.inf
    best_idx   = -1

    for i in range(len(groups) - 1):
        a, b = groups[i], groups[i + 1]
        # Critere de Ward : gain de variance intra si on fusionne a et b
        delta = (a["n"] * b["n"]) / (a["n"] + b["n"]) * (a["mean"] - b["mean"]) ** 2
        if delta < best_delta:
            best_delta = delta
            best_idx   = i

    a = groups[best_idx]
    b = groups[best_idx + 1]

    # Nouveau groupe fusionne
    n_new    = a["n"] + b["n"]
    mean_new = (a["mean"] * a["n"] + b["mean"] * b["n"]) / n_new
    new_grp  = {
        "label"  : f"{a['label']}|{b['label']}",
        "mean"   : mean_new,
        "n"      : n_new,
        "members": a["members"] + b["members"],
    }

    fusion_history.append({
        "n_classes"  : len(groups) - 1,
        "label_a"    : a["label"],
        "label_b"    : b["label"],
        "mean_a"     : round(a["mean"], 4),
        "mean_b"     : round(b["mean"], 4),
        "n_a"        : a["n"],
        "n_b"        : b["n"],
        "delta_ward" : round(best_delta, 6),
        "members"    : new_grp["members"],
    })

    groups = groups[:best_idx] + [new_grp] + groups[best_idx + 2:]

fh = pl.DataFrame([
    {k: v for k, v in row.items() if k != "members"}
    for row in fusion_history
])

print("=== HISTORIQUE DES FUSIONS (Ward) ===")
display(fh)
