import polars as pl

sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    has_171 = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
)

# Population avec et sans le flag
pop_171 = sub3.filter(pl.col("has_171"))
pop_no  = sub3.filter(~pl.col("has_171"))
print(f"has_171 = True  : n = {pop_171.height:,}")
print(f"has_171 = False : n = {pop_no.height:,}\n")

# Toutes les colonnes catégorielles avec faible cardinalité
print("=== Variables catégorielles : modalité dominante dans has_171 vs ailleurs ===\n")
print(f"{'Colonne':<32} {'top has_171':<25} {'top sans':<25} {'discriminant':>12}")
print("=" * 100)

cols_skip = {"FACTOR", "DT_DEBUT_AUTO", "DT_ECHEANCE_FEM", "NB_MATURITE_IRBA",
             "T_INTRT", "R", "T0", "has_171", "seg_special",
             "NB_DURATION_IRBA", "NB_MATURITE_RECALCULE", "NB_DURATION_RECALCULE"}

for c in sub3.columns:
    if c in cols_skip:
        continue
    dt = sub3.schema[c]
    if dt not in (pl.Utf8, pl.Categorical, pl.Int64, pl.Int32, pl.Boolean):
        continue
    try:
        nu = sub3[c].n_unique()
        if nu > 50 or nu < 2:
            continue
        if pop_171.height == 0 or pop_no.height == 0:
            continue
        # Top modalité dans has_171
        mode_171 = pop_171[c].mode()
        if mode_171.len() == 0:
            continue
        top_171 = mode_171[0]
        pct_171 = (pop_171[c] == top_171).mean() * 100
        # Même modalité dans la pop sans flag
        pct_no = (pop_no[c] == top_171).mean() * 100
        # Discriminant : à quel point cette modalité "vit dans has_171"
        discr = pct_171 - pct_no
        flag = " <<<" if discr > 50 and pct_171 > 80 else ""
        print(f"{c:<32} {str(top_171)[:22]:<25}({pct_171:>5.1f}%) "
              f"{str(top_171)[:22]:<10}({pct_no:>5.1f}%) {discr:>+11.1f}%{flag}")
    except Exception as e:
        print(f"{c:<32} [erreur: {e}]")

# Pour les colonnes qui ressortent fortement, on regarde les top modalités complètes
print("\n=== Variable la plus discriminante : analyse de toutes les modalités ===")
print("(à compléter avec le nom de la colonne qui ressort de l'analyse ci-dessus)\n")

# Exemple de drill-down sur cd_portfolio si on suspecte que ça contient l'info
for col_test in ["cd_portfolio", "Type_Credit", "CD_PORT_PRUDENTIEL",
                 "FLG_RETAIL_CORP", "CD_NOTE_TIERS", "top_Retail_MC_PD"]:
    if col_test not in sub3.columns:
        continue
    print(f"\n--- Drill-down sur {col_test} ---")
    breakdown = sub3.group_by(col_test).agg(
        n_total      = pl.len(),
        n_has_171    = pl.col("has_171").sum(),
        pct_has_171  = pl.col("has_171").mean() * 100,
    ).filter(pl.col("n_total") > 50).sort("pct_has_171", descending=True)
    print(breakdown.head(20))
