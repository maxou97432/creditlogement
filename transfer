# ============================================================
#  CALIBRATION DU SEUIL g — impact ΔMAE par seuil
#  Logique : pour chaque seuil g testé, on fusionne et on
#  mesure la dégradation de MAE vs référence 65 classes
# ============================================================

import numpy as np
import polars as pl

# Seuils a tester
G_SEUILS_TEST = [0.20, 0.50, 0.80, 1.20, 2.00]

# Seuil de materialite IRB (votre politique interne)
SEUIL_MAE_PCT = 5.0   # % de degradation MAE acceptable


# ================================================================
#  FONCTION MAE SUR STATS AGREGEES
# ================================================================

def mae_from_groups(groups_state: dict, df: pl.DataFrame) -> float:
    """
    MAE de substitution : erreur moyenne si on predit
    la moyenne de classe fusionnee pour chaque observation.
    Utilise lgd_obligor deja ponderee EAD.
    """
    # Construire le mapping membre -> moyenne groupe
    mapping_rows = []
    for grp in groups_state.values():
        for membre in grp["members"]:
            mapping_rows.append({
                "CHR_model"  : int(membre),
                "mean_groupe": grp["mean"],
            })

    mapping = pl.DataFrame(mapping_rows)

    mae = (
        df
        .join(mapping, on="CHR_model", how="left")
        .select(
            pl.col("lgd_obligor"),
            pl.col("mean_groupe"),
        )
        .select(
            (pl.col("lgd_obligor") - pl.col("mean_groupe"))
            .abs()
            .mean()
            .alias("mae")
        )
        .item()
    )
    return float(mae)


def run_fusion_for_seuil(g_seuil: float,
                          class_stats: pl.DataFrame) -> dict:
    """
    Lance la fusion gloutonne jusqu'a saturation pour un seuil g donne.
    Retourne les stats finales.
    """
    # Init groups_state
    groups = {
        str(r["CHR_model"]): {
            "mean"   : float(r["mean_lgd"]),
            "var"    : float(r["var_lgd"]),
            "n"      : int(r["n"]),
            "members": [str(r["CHR_model"])],
        }
        for r in class_stats.iter_rows(named=True)
    }

    n_fusions = 0
    for _ in range(500):
        ordre = sorted(groups.keys(), key=lambda c: groups[c]["mean"])
        if len(ordre) <= 1:
            break

        # Meilleure paire adjacente
        best_g, best_pair = np.inf, None
        for i in range(len(ordre) - 1):
            ca, cb = ordre[i], ordre[i + 1]
            ga, gb = groups[ca], groups[cb]
            df_   = ga["n"] + gb["n"] - 2
            if df_ <= 0:
                continue
            s_pooled = np.sqrt(
                ((ga["n"]-1)*ga["var"] + (gb["n"]-1)*gb["var"]) / df_
            )
            g_val = abs(ga["mean"]-gb["mean"]) / s_pooled if s_pooled > 0 else 0.0
            if g_val < best_g:
                best_g, best_pair = g_val, (ca, cb)

        # Arret si meilleure fusion depasse le seuil
        if best_g >= g_seuil:
            break

        # Fusion
        ca, cb = best_pair
        ga, gb = groups.pop(ca), groups.pop(cb)
        n_new    = ga["n"] + gb["n"]
        mean_new = (ga["mean"]*ga["n"] + gb["mean"]*gb["n"]) / n_new
        var_new  = (
            (ga["n"]-1)*ga["var"] +
            (gb["n"]-1)*gb["var"] +
            ga["n"]*gb["n"]/n_new * (ga["mean"]-gb["mean"])**2
        ) / (n_new - 1)

        groups[f"{ca}|{cb}"] = {
            "mean"   : mean_new,
            "var"    : var_new,
            "n"      : n_new,
            "members": ga["members"] + gb["members"],
        }
        n_fusions += 1

    return {
        "g_seuil"  : g_seuil,
        "n_classes": len(groups),
        "n_fusions": n_fusions,
        "groups"   : groups,
    }


