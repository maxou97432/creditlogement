def cohen_d(a1, a2):
    n1, n2 = len(a1), len(a2)
    s1, s2 = a1.std(ddof=1), a2.std(ddof=1)
    sp = np.sqrt(((n1 - 1) * s1**2 + (n2 - 1) * s2**2) / (n1 + n2 - 2))
    return (a2.mean() - a1.mean()) / sp if sp > 0 else 0.0

def overlap(a1, a2, n_bins=50):
    lo, hi = min(a1.min(), a2.min()), max(a1.max(), a2.max())
    if hi <= lo:
        return 1.0
    bins = np.linspace(lo, hi, n_bins)
    p, _ = np.histogram(a1, bins=bins); q, _ = np.histogram(a2, bins=bins)
    p, q = p / p.sum(), q / q.sum()
    return float(np.minimum(p, q).sum())

def diagnostics_tailles_effet_modele(
    df, class_col: str = CLASS_COL, lgd_col: str = LGD_COL,
) -> pl.DataFrame:
    lf = df.lazy() if isinstance(df, pl.DataFrame) else df
    ordre = (
        lf.group_by([class_col, "year"]).agg(pl.col(lgd_col).mean().alias("m"))
          .group_by([class_col]).agg(pl.col("m").mean().alias("mean_LGD_global"))
          .sort("mean_LGD_global")
          .collect()
    )
    obligors = {}
    base_col = lf.select([class_col, lgd_col]).collect()
    for cls in base_col.select(class_col).unique().to_series():
        obligors[cls] = base_col.filter(pl.col(class_col) == cls).get_column(lgd_col).to_numpy()
    rows = []
    classes = ordre.get_column(class_col).to_list()
    for i in range(len(classes) - 1):
        c1, c2 = classes[i], classes[i + 1]
        a1, a2 = obligors[c1], obligors[c2]
        rows.append({
            "class_1": c1, "class_2": c2,
            "n_1": len(a1), "n_2": len(a2),
            "gap": float(abs(a2.mean() - a1.mean())),
            "cohen_d": float(abs(cohen_d(a1, a2))),
            "ovl": overlap(a1, a2),
            "wasserstein": float(wasserstein_distance(a1, a2)),
        })
    return pl.DataFrame(rows)

