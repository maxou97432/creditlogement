import plotly.express as px
import pandas as pd
import plotly.io as pio

# Configuration du rendu JSON (pour la compatibilité)
pio.renderers.default = "notebook" 

# --- Préparation des données pour le tracé ---

# 1. Mise en format long (melt)
df_plot = merge.melt(
    id_vars=["Periode", "VAL_MAILLE_GEO", "CD_TYPE_BIEN"],
    value_vars=["Indice de prix (CL)", "Indice de prix (INSEE) - Base 2020"],
    var_name="Source",
    value_name="Indice_Valeur"
)

# 2. Création de la colonne de segmentation
df_plot['Segment'] = df_plot['VAL_MAILLE_GEO'] + ' - ' + df_plot['CD_TYPE_BIEN']

# --- Boucle sur chaque segment ---

segments_uniques = df_plot['Segment'].unique()

for segment in segments_uniques:
    # Filtre le DataFrame pour le segment actuel
    df_segment = df_plot[df_plot['Segment'] == segment]
    
    # Création du Graphique Plotly
    fig = px.line(
        df_segment,
        x="Periode",
        y="Indice_Valeur",
        color="Source",
        
        title=f"Évolution Comparée des Indices: {segment} (Base 2020)",
        labels={
            "Indice_Valeur": "Indice de Prix (Base 2020 = 100)",
            "Periode": "Date (Trimestre)",
            "Source": "Source de l'Indice"
        },
        height=450 
    )

    # Ajout de la ligne horizontale de référence (Base 2020 = 100)
    fig.update_yaxes(range=[60, df_segment["Indice_Valeur"].max() + 10])
    fig.add_hline(y=100, line_dash="dash", line_color="gray", 
                  annotation_text="Base 2020 = 100", annotation_position="top left")

    # Ajustement et affichage
    fig.update_layout(
        legend_title_text='Légende',
        title_x=0.5
    )

    # Affiche le graphique actuel (le résultat de fig.show() ou de la génération JSON/PNG)
    fig.show()
