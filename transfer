# ==============================================================
# Préparation base
# ==============================================================

def build_base(cap_pret_lf: pl.LazyFrame) -> pl.LazyFrame:
    base = cap_pret_lf

    # HLC = substr(modele_trg,3,2)*1
    # HRC = substr(modele_pd,3,2)*1
    base = base.with_columns(
        [
            pl.col("modele_trg").cast(pl.Utf8).str.slice(2, 2).cast(pl.Int64).alias("HLC"),
            pl.col("modele_pd").cast(pl.Utf8).str.slice(2, 2).cast(pl.Int64).alias("HRC"),
        ]
    )

    # PD calib PART (depuis la base prod, hors Défaut/Mid Corp)
    pd_calib_part = (
        base
        .filter(
            pl.col("segment_pd").is_in(["50", "55", "60", "65", "70"])
            & (~pl.col("top_Retail_MC_PD").is_in(["Défaut", "Mid Corp"]))
        )
        .select(["HRC", pl.col("tx_edf").alias("PD_calib")])
        .unique()
        .with_columns(pl.lit("PART").alias("PERIM_PD"))
    )

    pd_calib = pl.concat([pd_calib_part.lazy(), ref_pd_calib_pro()], how="vertical")

    base = base.with_columns(
        [
            # PERIM_PD
            pl.when(pl.col("segment_pd").is_in(["75", "85", "90", "80"]))
            .then(pl.lit("PRO"))
            .when(pl.col("segment_pd").is_in(["50", "55", "60", "65", "70"]))
            .then(pl.lit("PART"))
            .when(pl.col("segment_pd").is_in(["30", "35", "40", "45"]))
            .then(pl.lit("SME_CORP"))
            .otherwise(pl.lit("AUTR"))
            .alias("PERIM_PD"),

            # PERIM_LGD
            pl.when(pl.col("segment_trg").is_in(["70","71","72","73","74","75","76","77","78"]))
            .then(pl.lit("Retail"))
            .when(pl.col("segment_trg").is_in(["41","42","43","44","45","46","47"]))
            .then(pl.lit("SME_CORP"))
            .otherwise(pl.lit("Autr"))
            .alias("PERIM_LGD"),
        ]
    )

    base = (
        base.lazy()
        .join(ref_pd_ndod_moc_c(),  on=["HRC", "PERIM_PD"], how="left")
        .join(pd_calib,             on=["HRC", "PERIM_PD"], how="left")
        .join(ref_lgd_ndod_moc_c(), on="HLC",              how="left")
        .with_columns(
            [
                # Si PERIM_LGD != Retail => tx_lgd
                pl.when(pl.col("PERIM_LGD") != "Retail")
                .then(pl.col("tx_lgd"))
                .otherwise(pl.col("LGD_new_ndod_moc"))
                .alias("LGD_new_ndod_moc"),

                # SAS l.490 : if PERIM_LGD ne "Retail" then PD_new_ndod_moc = tx_edf
                pl.when(pl.col("PERIM_LGD") != "Retail")
                .then(pl.col("tx_edf"))
                .otherwise(pl.col("PD_new_ndod_moc"))
                .alias("PD_new_ndod_moc"),

                # Idem pour PD_calib (même périmètre)
                pl.when(pl.col("PERIM_LGD") != "Retail")
                .then(pl.col("tx_edf"))
                .otherwise(pl.col("PD_calib"))
                .alias("PD_calib"),
            ]
        )
        .with_columns(
            [
                # Floor PD à 0.0003
                pl.max_horizontal(pl.col("PD_new_ndod_moc"), pl.lit(0.0003)).alias("PD_new_ndod_moc"),
                pl.max_horizontal(pl.col("PD_calib"),        pl.lit(0.0003)).alias("PD_calib"),

                pl.col("cd_portfolio").alias("cd_port_prudentiel"),

                # perim = 0 pour CORP/SME_CORP
                pl.when(pl.col("cd_portfolio").is_in(["CORP", "SME_CORP"]))
                .then(pl.lit("0"))
                .otherwise(pl.lit("1"))
                .alias("perim"),

                # IND_FACTEUR_REDUCT = 1 pour SME_CORP
                pl.when(pl.col("cd_portfolio") == "SME_CORP")
                .then(pl.lit("1"))
                .otherwise(None)
                .alias("IND_FACTEUR_REDUCT"),

                _clip_duration("duration").alias("__tmp_maturity"),
                pl.col("MT_EAD_FLOOR").cast(pl.Float64).alias("__tmp_ead"),
            ]
        )
    )

    return base


# ==============================================================
# Pré-calcul corrélation R — partagé entre scénarios
# ==============================================================

def _add_pd_terms(lf: pl.LazyFrame, pd_col: str, tag: str) -> pl.LazyFrame:
    pd_expr = pl.col(pd_col).cast(pl.Float64)
    port    = pl.col("cd_portfolio")

    r_min = (
        pl.when(port.is_in(["MTGE_NON_S", "MTGE_S"])).then(0.15)
        .when(port.is_in(["OTHER_RET",   "SME_RET"])).then(0.03)
        .when(port == "QRE").then(0.04)
        .otherwise(0.12)
    )

    # BUG SAS (REPRODUIT) : À cause de la chaîne "else if", seule la condition "SL_HRE"
    # fonctionne. Toutes les autres (MTGE, OTHER_RET, QRE) n'atteignent jamais 
    # l'assignation de R_max et gardent R_max = 0.24.
    r_max = (
        pl.when(port.is_in(["SL_HRE", "SL_HRE_R2"])).then(0.30)
        # .when(port.is_in(["MTGE_NON_S", "MTGE_S"])).then(0.15)  # MASQUÉ PAR BUG SAS
        # .when(port.is_in(["OTHER_RET",  "SME_RET"])).then(0.16)   # MASQUÉ PAR BUG SAS
        # .when(port == "QRE").then(0.04)                         # MASQUÉ PAR BUG SAS
        .otherwise(0.24)
    )

    c = (
        pl.when(port.is_in(["MTGE_S", "OTHER_RET", "SME_RET"])).then(35.0)
        .otherwise(50.0)
    )

    x = (1 - (-c * pd_expr).exp()) / (1 - (-c).exp())
    r = r_min * x + r_max * (1 - x)
    r = pl.when(port.str.ends_with("R2")).then(r * 1.25).otherwise(r)

    # Facteur b maturity et PPF — pré-calculés et stockés comme colonnes tmp
    b    = (0.11852 - 0.05478 * pd_expr.log()) ** 2
    ppf_ = _ppf(pd_expr)

    return lf.with_columns(
        [
            pd_expr.alias(f"__tmp_pd_{tag}"),
            ppf_.alias(f"__tmp_ppf_{tag}"),
            b.alias(f"__tmp_b_{tag}"),
            r.alias(f"__tmp_r_{tag}"),
        ]
    )


# ==============================================================
# Expressions RWA par scénario
# ==============================================================

def _scenario_exprs(pd_tag: str, lgd_col: str, suff: str) -> list[pl.Expr]:
    # Colonnes pré-calculées par _add_pd_terms
    lgd      = pl.col(lgd_col).cast(pl.Float64)
    ppf_     = pl.col(f"__tmp_ppf_{pd_tag}")
    pd_      = pl.col(f"__tmp_pd_{pd_tag}")
    b        = pl.col(f"__tmp_b_{pd_tag}")
    r_       = pl.col(f"__tmp_r_{pd_tag}")
    port     = pl.col("cd_portfolio")
    perim    = pl.col("perim")
    ead      = pl.col("__tmp_ead")
    maturity = pl.col("__tmp_maturity")

    # Score z de Gordy (depuis colonnes pré-calculées)
    z = (1 - r_) ** (-0.5) * ppf_ + (r_ / (1 - r_)) ** 0.5 * PROBIT_999

    # RW de base (avant facteur 12.5 × 1.06)
    rw_base = lgd * _cdf(z) - lgd * pd_

    # RW Retail sans MA
    rw_retail_other = rw_base * pl.lit(12.5 * 1.06)

    # MA = (1 + (M-2.5)*b) / (1-1.5*b)  →  décomposé comme dans le SAS
    rw_retail_corp = rw_base * (1 - 1.5 * b) ** (-1) * (1 + (maturity - 2.5) * b) * pl.lit(1.25 * 1.06 * 10)
    rw_non_retail  = rw_base * (1 - 1.5 * b) ** (-1) * (1 + (maturity - 2.5) * b) * pl.lit(1.25 * 1.06 * 10)

    # Aplati pour compatibilité Polars (évite when/then imbriqué)
    rw = (
        pl.when((perim == "1") & port.is_in(["CORP", "SME_CORP"]))
        .then(rw_retail_corp)       # Retail + CORP/SME_CORP : avec MA
        .when(perim == "1")
        .then(rw_retail_other)      # Retail autres           : sans MA
        .otherwise(rw_non_retail)   # Non-Retail              : avec MA
    )

    # Facteur de réduction PME 0.7619 — aplati
    rw_final = (
        pl.when((perim == "1") & port.is_in(["MTGE_S", "SME_CORP", "SME_RET"]))
        .then(rw * 0.7619)
        .when(perim == "1")
        .then(rw)
        .when(pl.col("IND_FACTEUR_REDUCT") == "1")
        .then(rw * 0.7619)
        .otherwise(rw)
    )

    return [
        rw_final.alias(f"RW_{suff}"),
        pl.when(pd_ != 1).then(pd_ * lgd * ead).otherwise(None).alias(f"EL_{suff}"),
        pl.when(pd_ != 1).then(rw_final * ead).otherwise(None).alias(f"RWA_{suff}"),
    ]


# ==============================================================
# Pipeline RWA — 5 scénarios NDoD MoC
# ==============================================================

def add_all_rwa_scenarios(lf: pl.LazyFrame) -> pl.LazyFrame:
    # Pré-calcul colonnes tmp (pd, ppf, b, r) pour chaque scénario PD
    lf = _add_pd_terms(lf, "tx_edf",         "tx_edf")
    lf = _add_pd_terms(lf, "PD_calib",        "PD_calib")
    lf = _add_pd_terms(lf, "PD_new_ndod_moc", "pd_ndod")

    exprs = []
    exprs += _scenario_exprs("tx_edf",    "tx_lgd",           "init")
    exprs += _scenario_exprs("PD_calib",  "tx_lgd",           "wo_NDoD")
    exprs += _scenario_exprs("pd_ndod",   "tx_lgd",           "NDoD_PD_Seule_moc")
    exprs += _scenario_exprs("PD_calib",  "LGD_new_ndod_moc", "NDoD_LGD_seule_moc")
    exprs += _scenario_exprs("pd_ndod",   "LGD_new_ndod_moc", "NDoD_PD_LGD_moc")

    return lf.with_columns(exprs)


TMP_COLS = [
    "__tmp_maturity", "__tmp_ead",
    "__tmp_pd_tx_edf",   "__tmp_ppf_tx_edf",   "__tmp_b_tx_edf",   "__tmp_r_tx_edf",
    "__tmp_pd_PD_calib", "__tmp_ppf_PD_calib", "__tmp_b_PD_calib", "__tmp_r_PD_calib",
    "__tmp_pd_pd_ndod",  "__tmp_ppf_pd_ndod",  "__tmp_b_pd_ndod",  "__tmp_r_pd_ndod",
]


def drop_tmp_cols(lf: pl.LazyFrame) -> pl.LazyFrame:
    existing = [c for c in TMP_COLS if c in lf.collect_schema().names()]
    return lf.drop(existing)


# ==============================================================
# Estimation PGE
# ==============================================================

def add_estim_pge(lf: pl.LazyFrame) -> pl.LazyFrame:
    tx_edf = 0.0001
    tx_trg = 0.99
    tx_lgd = 0.01

    maturity = pl.col("__tmp_maturity")

    # Corrélation R — hors CORP (Retail + QRE + MTGE)
    rsq_non = (
        pl.when(pl.col("cd_portfolio") == "QRE").then(0.04)
        .when(pl.col("cd_portfolio").is_in(["MTGE_NON_S", "MTGE_S"])).then(0.15)
        .otherwise(
            0.03 * (1 - math.exp(-35 * tx_edf)) / DENOM_35
            + 0.16 * (1 - (1 - math.exp(-35 * tx_edf)) / DENOM_35)
        )
    )

    z_non  = ((1 - rsq_non) ** -0.5) * PROBIT_0001 + ((rsq_non / (1 - rsq_non)) ** 0.5) * PROBIT_999
    rw_non = (tx_lgd * _cdf(z_non) - tx_lgd * tx_edf) * pl.lit(12.5 * 1.06)

    # Corrélation R — CORP
    rsq_corp = (
        0.12 * (1 - math.exp(-50 * tx_edf)) / DENOM_50
        + 0.24 * (1 - (1 - math.exp(-50 * tx_edf)) / DENOM_50)
    )
    b_corp  = (0.11852 - 0.05478 * math.log(tx_edf)) ** 2
    z_corp  = ((1 - rsq_corp) ** -0.5) * PROBIT_0001 + ((rsq_corp / (1 - rsq_corp)) ** 0.5) * PROBIT_999
    ma_corp = (1 + (maturity - 2.5) * b_corp) / (1 - 1.5 * b_corp)
    
    # BUG SAS (REPRODUIT) : Le SAS omet complètement de multiplier par l'ajustement 
    # de maturité (ma_corp) pour ce périmètre Etat spécifique.
    rw_corp = (tx_lgd * _cdf(z_corp) - tx_lgd * tx_edf) * pl.lit(12.5 * 1.06)

    # Éligibilité PGE (segment_trg starts with "13" + N_SCO_CTR_025 = "3")
    eligible = (
        (pl.col("modele_trg").cast(pl.Utf8).str.slice(0, 2) == "13")
        & (pl.col("N_SCO_CTR_025") == "3")
    )

    use_non  = eligible & (~pl.col("cd_portfolio").is_in(["CORP", "SME_CORP"])) & (pl.col("modele_trg") != "1501")
    use_corp = eligible & (~use_non)

    est = lf.select(
        [
            "I_AUTRS_UNIQ",
            pl.when(use_non).then(rw_non).when(use_corp).then(rw_corp).otherwise(None).alias("RW_ETAT"),
            pl.lit(tx_edf).alias("tx_edf_etat"),
            pl.lit(tx_trg).alias("tx_trg"),
            pl.lit(tx_lgd).alias("tx_lgd_etat"),
        ]
    )

    return lf.join(est, on="I_AUTRS_UNIQ", how="left")


def add_pge_rwa(lf: pl.LazyFrame, suff: str = "NDoD_PD_LGD_moc") -> pl.LazyFrame:
    """
    RWA PGE = RW_ETAT * (0.9 * EAD) + RW_suff * (0.1 * EAD)
    pour les modeles_trg PGE (1302..1310).
    Correspond au SAS : RWA_PGE_&suff = RW_ETAT*(0.9*MT_EAD_FLOOR)
                                       + RW_&suff*(0.1*MT_EAD_FLOOR)
    """
    res = (
        pl.when(pl.col("modele_trg").is_in(["1302","1303","1304","1305","1306","1308","1309","1310"]))
        .then(
            pl.col("RW_ETAT") * (0.9 * pl.col("__tmp_ead"))
            + pl.col(f"RW_{suff}") * (0.1 * pl.col("__tmp_ead"))
        )
        .otherwise(pl.col(f"RWA_{suff}"))
    )

    pme_pge = (
        pl.when(pl.col("cd_portfolio").is_in(["MTGE_S", "SME_CORP", "SME_RET"]))
        .then(res * 0.7619)
        .otherwise(res)
    )

    return lf.with_columns(pme_pge.alias(f"RWA_PGE_{suff}"))


# ==============================================================
# Agrégation STAT_0
# ==============================================================

def build_stat_0(lf: pl.LazyFrame) -> pl.LazyFrame:
    return (
        lf
        .filter(pl.col("PERIM_PD").is_in(["PART", "PRO"]))
        .group_by("PERIM_PD")
        .agg(
            [
                pl.len().alias("NB_AUTR"),
                pl.col("MT_EAD_FLOOR").sum().alias("TOT_EAD_IRBA"),
                pl.col("RWA_init").sum().alias("RWA_init"),
                pl.col("RWA_wo_NDoD").sum().alias("RWA_wo_NDoD"),
                pl.col("RWA_NDoD_PD_Seule_moc").sum().alias("RWA_NDoD_PD_Seule_moc"),
                pl.col("RWA_NDoD_LGD_seule_moc").sum().alias("RWA_NDoD_LGD_seule_moc"),
                pl.col("RWA_NDoD_PD_LGD_moc").sum().alias("RWA_NDoD_PD_LGD_moc"),
            ]
        )
    )


# ==============================================================
# Pipeline complet
# ==============================================================

def build_pipeline(
    cap_pret_lf: pl.LazyFrame,
    add_pge: bool = False,
    pge_suff: str = "NDoD_PD_LGD_moc",
    drop_tmp: bool = True,
):
    lf = build_base(cap_pret_lf)
    lf = add_all_rwa_scenarios(lf)

    if add_pge:
        lf = add_estim_pge(lf)
        lf = add_pge_rwa(lf, suff=pge_suff)

    stat_0 = build_stat_0(lf)

    if drop_tmp:
        lf = drop_tmp_cols(lf)

    return lf, stat_0


# ==============================================================
# Écriture parquet
# ==============================================================

def sink_outputs(
    cap_pret_lf: pl.LazyFrame,
    base_path: str,
    stat_path: str,
    add_pge: bool = False,
    pge_suff: str = "NDoD_PD_LGD_moc",
    compression: str = "zstd",
    drop_tmp: bool = True,
):
    base_lf, stat_lf = build_pipeline(
        cap_pret_lf,
        add_pge=add_pge,
        pge_suff=pge_suff,
        drop_tmp=drop_tmp,
    )

    base_lf.sink_parquet(base_path, compression=compression, statistics=True)
    stat_lf.sink_parquet(stat_path, compression=compression, statistics=True)


