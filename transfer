import polars as pl
import numpy as np
from scipy.stats import norm

def implied_M(rwa, ead, pd_val, lgd):
    if ead <= 0 or pd_val <= 0 or pd_val >= 1 or lgd <= 0:
        return None
    K = rwa / (12.5 * ead)
    R = 0.12*(1-np.exp(-50*pd_val))/(1-np.exp(-50)) + \
        0.24*(1-(1-np.exp(-50*pd_val))/(1-np.exp(-50)))
    b = (0.11852 - 0.05478*np.log(pd_val))**2
    K_base = lgd * (norm.cdf((norm.ppf(pd_val) + np.sqrt(R)*norm.ppf(0.999))
                             / np.sqrt(1-R)) - pd_val)
    if K_base <= 0: return None
    ratio = K / K_base
    return 2.5 + (ratio*(1 - 1.5*b) - 1) / b

