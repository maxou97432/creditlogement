    df_top15_lpi = pd.DataFrame(columns=["Ville", "DATE", "Prix moyen glissant 12 mois - LPI/IAD"])

# Final Merge
merge_cl = merge_cl.rename(columns={"Periode": "DATE"})
merge_cl["DATE"] = pd.to_datetime(merge_cl["DATE"], errors="coerce")

final_fusion = pd.merge(df_top15_lpi, merge_cl, on=["Ville", "DATE"], how="right")

# Rename columns for clarity in plots
final_fusion = final_fusion.rename(columns={
    "prix_mm_12m (V1)": "Prix moyen glissant 12 mois - Univ Elem (V1)",
    "prix_mm_12m (V2)": "Prix moyen glissant 12 mois - Univ Elem (V2)"
})

# Filter date limit
final_fusion = final_fusion[final_fusion["DATE"] < "2025-09-01"]


# =============================================================================
# 4. PROPHET & VISUALIZATION (Comparison V1 vs V2 vs LPI)
# =============================================================================
print("\n--- Génération des graphiques et stats ---")

cols_to_plot = [
    "Prix moyen glissant 12 mois - Univ Elem (V1)",
    "Prix moyen glissant 12 mois - Univ Elem (V2)",
    "Prix moyen glissant 12 mois - LPI/IAD"
]
colors = ["#4C72B0", "#FF0000", "#DD8452"] # Blue (V1), Red (V2), Orange (LPI)

# Global stats counters
score_v1_total = 0
score_v2_total = 0
nb_villes = len(final_fusion["Ville"].dropna().unique())

for ville in final_fusion["Ville"].dropna().unique():
    df_ville = final_fusion[final_fusion["Ville"] == ville].sort_values("DATE").copy()
    
    if df_ville.empty: continue

    # --- A. Prophet Forecasting (Optional but kept from original) ---
    fig = go.Figure()
    
    # We interpolate to fill gaps for plotting/prophet
    df_ville_interp = df_ville.set_index("DATE")[cols_to_plot].resample("MS").interpolate(method="linear").reset_index()

    for i, col in enumerate(cols_to_plot):
        if col not in df_ville_interp.columns or df_ville_interp[col].isna().all():
            continue

        # Prepare for Prophet
        df_prophet = df_ville_interp[["DATE", col]].rename(columns={"DATE": "ds", col: "y"}).dropna()
        
        if len(df_prophet) < 5: continue # Skip if too few points

        m = Prophet(changepoint_prior_scale=0.5)
        m.fit(df_prophet)
        future = m.make_future_dataframe(periods=12, freq="MS")
        forecast = m.predict(future)

        # Plot Historical
        fig.add_trace(go.Scatter(
            x=df_prophet["ds"], y=df_prophet["y"],
            mode="lines+markers", name=col,
            line=dict(color=colors[i], width=2)
        ))
        
        # Plot Forecast (Future only)
        last_date = df_prophet["ds"].max()
        forecast_future = forecast[forecast["ds"] > last_date]
        if not forecast_future.empty:
            # Connect the lines
            first_pred = pd.DataFrame({'ds': [last_date], 'yhat': [df_prophet.iloc[-1]['y']]})
            forecast_chain = pd.concat([first_pred, forecast_future[['ds', 'yhat']]])
            
            fig.add_trace(go.Scatter(
                x=forecast_chain["ds"], y=forecast_chain["yhat"],
                mode="lines", name=f"Prévision - {col}",
                line=dict(color=colors[i], dash="dot", width=1.5),
                showlegend=False
            ))

    fig.update_layout(
        title=f"Comparaison V1 vs V2 vs LPI – {ville}",
        xaxis_title="Date", yaxis_title="Prix au m²",
        template="plotly_white", height=500,
        legend=dict(orientation="h", y=1.02, x=0.5, xanchor="center")
    )



    # --- B. Statistical Comparison (Confidence Intervals) ---
    
    # Rolling Std Dev for Confidence Intervals
    df_ville_interp["std_12m_v1"] = df_ville_interp["Prix moyen glissant 12 mois - Univ Elem (V1)"].rolling(12, min_periods=3).std()
    df_ville_interp["std_12m_v2"] = df_ville_interp["Prix moyen glissant 12 mois - Univ Elem (V2)"].rolling(12, min_periods=3).std()
    
    # Calculate ICs (95%)
    for v in ["v1", "v2"]:
        col_name = f"Prix moyen glissant 12 mois - Univ Elem ({v.upper()})"
        df_ville_interp[f"IC_inf_{v}"] = df_ville_interp[col_name] - 1.96 * df_ville_interp[f"std_12m_{v}"]
        df_ville_interp[f"IC_sup_{v}"] = df_ville_interp[col_name] + 1.96 * df_ville_interp[f"std_12m_{v}"]

    # Calculate LPI Match Percentage
    lpi_col = "Prix moyen glissant 12 mois - LPI/IAD"
    
    if lpi_col in df_ville_interp.columns:
        # Match V1
        in_IC_v1 = (df_ville_interp[lpi_col] >= df_ville_interp["IC_inf_v1"]) & (df_ville_interp[lpi_col] <= df_ville_interp["IC_sup_v1"])
        pct_v1 = in_IC_v1.mean() * 100
        score_v1_total += pct_v1
        
        # Match V2
        in_IC_v2 = (df_ville_interp[lpi_col] >= df_ville_interp["IC_inf_v2"]) & (df_ville_interp[lpi_col] <= df_ville_interp["IC_sup_v2"])
        pct_v2 = in_IC_v2.mean() * 100
        score_v2_total += pct_v2
        
        # --- Visualization IC ---
        fig_ic = go.Figure()
        
        # V1 Area
        fig_ic.add_trace(go.Scatter(
            x=pd.concat([df_ville_interp["DATE"], df_ville_interp["DATE"][::-1]]),
            y=pd.concat([df_ville_interp["IC_sup_v1"], df_ville_interp["IC_inf_v1"][::-1]]),
            fill="toself", fillcolor="rgba(76,114,176,0.2)", line=dict(color="rgba(0,0,0,0)"),
            name="IC 95% (V1)"
        ))
        
        # V2 Area
        fig_ic.add_trace(go.Scatter(
            x=pd.concat([df_ville_interp["DATE"], df_ville_interp["DATE"][::-1]]),
            y=pd.concat([df_ville_interp["IC_sup_v2"], df_ville_interp["IC_inf_v2"][::-1]]),
            fill="toself", fillcolor="rgba(255,0,0,0.2)", line=dict(color="rgba(0,0,0,0)"),
            name="IC 95% (V2)"
        ))
        
        # Lines
        fig_ic.add_trace(go.Scatter(x=df_ville_interp["DATE"], y=df_ville_interp["Prix moyen glissant 12 mois - Univ Elem (V1)"], 
                                    mode='lines', name='Univ Elem (V1)', line=dict(color=colors[0])))
        fig_ic.add_trace(go.Scatter(x=df_ville_interp["DATE"], y=df_ville_interp["Prix moyen glissant 12 mois - Univ Elem (V2)"], 
                                    mode='lines', name='Univ Elem (V2)', line=dict(color=colors[1])))
        fig_ic.add_trace(go.Scatter(x=df_ville_interp["DATE"], y=df_ville_interp[lpi_col], 
                                    mode='lines+markers', name='LPI/IAD', line=dict(color=colors[2], dash='dot')))

        # Annotations
        fig_ic.add_annotation(xref="paper", yref="paper", x=0.01, y=0.99, text=f"Match LPI (V1): {pct_v1:.1f}%", showarrow=False, bgcolor="rgba(255,255,255,0.8)")
        fig_ic.add_annotation(xref="paper", yref="paper", x=0.01, y=0.94, text=f"Match LPI (V2): {pct_v2:.1f}%", showarrow=False, bgcolor="rgba(255,255,255,0.8)")

        fig_ic.update_layout(title=f"Validité Statistique V1 vs V2 - {ville}", height=500, template="plotly_white")
        fig_ic.write_html(os.path.join(CONFIG['output_dir'], f"Validité Statistique V1 vs V2 - {ville}.html"))

# --- Global Result ---
print("\n" + "="*80)
print(" RÉSULTATS GLOBAUX COMPARATIFS")
print("="*80)
if nb_villes > 0:
    print(f"Correspondance moyenne LPI (V1) : {score_v1_total / nb_villes:.2f} %")
    print(f"Correspondance moyenne LPI (V2) : {score_v2_total / nb_villes:.2f} %")
else:
    print("Aucune ville traitée.")


def get_stats(df, col_cl):
    df['Dif'] = df[col_cl] - df['Prix moyen glissant 12 mois - LPI/IAD']
    rmse = np.sqrt(np.mean(df['Dif']**2))
    corr = df[col_cl].corr(df['Prix moyen glissant 12 mois - LPI/IAD'])
    return pd.Series({'RMSE': rmse, 'Correlation': corr})

# Calcul des stats par groupe
stats_v1 = final_fusion.groupby(["Ville"]).apply(lambda x: get_stats(x, 'Prix moyen glissant 12 mois - Univ Elem (V1)')).reset_index()
stats_v2 = final_fusion.groupby(["Ville"]).apply(lambda x: get_stats(x, 'Prix moyen glissant 12 mois - Univ Elem (V2)')).reset_index()

# Comparaison finale
comparaison2 = pd.merge(stats_v1, stats_v2, on=["Ville"], suffixes=('_V1', '_V2'))

# Calcul du Gain (Positif = V2 est meilleure)
comparaison2['Gain_RMSE'] = comparaison2['RMSE_V1'] - comparaison2['RMSE_V2'] 
comparaison2['Gain_Corr'] = comparaison2['Correlation_V2'] - comparaison2['Correlation_V1']

print("\n" + "="*80)
print(" RÉSULTATS COMPARATIFS : Base Standard (V1) vs Base + Demande (V2)")
print("="*80)
print(f"Gain Moyen RMSE global : {comparaison2['Gain_RMSE'].mean():.4f} ")
print(f"Gain Moyen Corrélation : {comparaison2['Gain_Corr'].mean():.4f} ")
print("-" * 80)
print("Détail des améliorations (Top 10 Gains RMSE) :")
print(comparaison2.sort_values("Gain_RMSE", ascending=False))
output_path_vol = os.path.join(CONFIG['output_dir'], f"Comparaison des bases - LPI-IAD.csv")
comparaison2.to_csv(output_path_vol, index=False)
