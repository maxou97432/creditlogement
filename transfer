import pandas as pd
import numpy as np
import plotly.graph_objects as go
from statsmodels.tsa.holtwinters import ExponentialSmoothing
import plotly.io as pio
import warnings

# Configuration
warnings.filterwarnings("ignore")
pio.renderers.default = "notebook" 

# --- Initialisation ---
n_forecast = 2 
corrected_data = []
future_adjustments = []

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("🚀 Démarrage de la modélisation TES (Holt-Winters)...")

for name, group in grouped:
    zone, type_bien = name
    
    # 1. Préparation des données
    group = group.sort_values("Periode").set_index("Periode")
    group['Indice de prix (CL) - Corrigé TES'] = np.nan
    
    # Série de l'écart (Biais)
    ts_ecart = group['Dif'].dropna()
    
    # Il faut définir la fréquence pour statsmodels (Trimestriel 'Q')
    if not ts_ecart.empty:
        ts_ecart.index = pd.PeriodIndex(ts_ecart.index, freq='Q')
    
    if len(ts_ecart) > 12: # TES a besoin d'au moins 2 saisons complètes (4x2=8) + marge
        try:
            # 2. Modélisation TES (Holt-Winters)
            # Tendance additive + Saisonnalité additive (période 4)
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                seasonal='add', 
                seasonal_periods=4, 
                damped_trend=True, 
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # --- A. Correction Historique (Pour le Graphique) ---
            ecart_modelise = model_fit.fittedvalues
            # Reconversion de l'index Period en Timestamp pour le merge avec le groupe original
            ecart_modelise.index = ecart_modelise.index.to_timestamp()
            
            # Alignement strict des index
            ecart_modelise = ecart_modelise.reindex(group.index)
            
            cl_corrected_history = group['Indice de prix (CL)'] - ecart_modelise
            group['Indice de prix (CL) - Corrigé TES'] = cl_corrected_history
            
            # --- B. Calcul de la Prévision Future (Pour le Print uniquement) ---
            forecast_bias = model_fit.forecast(steps=n_forecast)
            
            # Calcul approximatif de l'intervalle de confiance pour TES (Sigma des résidus)
            sigma = np.std(model_fit.resid)
            # Marge à 95% pour T+1
            margin_error = 1.96 * sigma
            
            # Stockage des valeurs pour le tableau
            future_adjustments.append({
                "Zone": zone,
                "Type": type_bien,
                "Ajustement T+1": round(forecast_bias.iloc[0], 2),
                "Ajustement T+2": round(forecast_bias.iloc[1], 2),
                "Marge Erreur T+1": round(margin_error, 2)
            })

            # =================================================================
            # 3. Visualisation (HISTORIQUE UNIQUEMENT)
            # =================================================================
            
            fig = go.Figure()

            # Historique INSEE (Noir)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (INSEE) - Base 2020'],
                mode='lines', name='INSEE (Réalité)',
                line=dict(color='black', width=3)
            ))

            # Historique CL Brut (Rouge Pointillé)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (CL)'],
                mode='lines', name='CL (Brut)',
                line=dict(color='red', width=1, dash='dot')
            ))

            # Historique CL Corrigé TES (Bleu)
            fig.add_trace(go.Scatter(
                x=group.index, y=cl_corrected_history,
                mode='lines', name='CL Corrigé (TES)',
                line=dict(color='blue', width=2)
            ))

            fig.update_layout(
                title=f"<b>{zone} - {type_bien}</b> : Validation de la Correction Holt-Winters",
                yaxis_title="Indice (Base 2020 = 100)",
                template="plotly_white",
                height=500,
                legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
            )
            
            fig.show()
            
        except Exception as e:
            print(f"⚠️ Echec TES pour {name} : {e}")
            
    corrected_data.append(group.reset_index())

# Reconstitution
merge_corrected = pd.concat(corrected_data, ignore_index=True)

# --- Affichage du Tableau de Bord (Prévisions) ---
if future_adjustments:
    df_previsions = pd.DataFrame(future_adjustments)
    print("\n" + "="*80)
    print("📊 TABLEAU DE BORD : VALEURS D'AJUSTEMENT PRÉVUES (TES Holt-Winters)")
    print("Ces valeurs sont à soustraire de l'indice CL futur pour obtenir l'estimation INSEE.")
    print("="*80)
    pd.set_option('display.max_rows', None)
    display(df_previsions) # ou print(df_previsions) si pas dans un notebook
else:
    print("\nAucune prévision générée.")
