import numpy as np

sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    is_revolving = pl.col("Type_Credit").is_in(["Crédits Revolving", "CAV & autres"]),
)

# Inspection des lignes Crédits Revolving — qu'est-ce que NB et R valent ?
revolv = sub3.filter(pl.col("Type_Credit") == "Crédits Revolving")
print(f"=== Crédits Revolving — n = {revolv.height:,} ===\n")

print("Stats descriptives :")
print(f"  R           median = {revolv['R'].median():.4f}, mean = {revolv['R'].mean():.4f}")
print(f"  NB          median = {revolv['NB_MATURITE_IRBA'].median():.4f}")
print(f"  |NB - R|    median = {(revolv['NB_MATURITE_IRBA'] - revolv['R']).abs().median():.4f}")
print(f"  NB / R      median = {(revolv['NB_MATURITE_IRBA'] / revolv['R']).median():.4f}")

print(f"\n10 premières lignes :")
print(revolv.select(["R", "NB_MATURITE_IRBA", "T_INTRT", "Type_Credit"]).head(10))

# Quelle proportion satisfait |NB-R|<0.01 ? <0.1 ? <1 ?
diff = (revolv["NB_MATURITE_IRBA"] - revolv["R"]).abs().to_numpy()
print(f"\nDistribution de |NB - R| sur les Revolvers :")
for tol in [0.001, 0.01, 0.05, 0.1, 0.5, 1.0]:
    pct = (diff < tol).mean() * 100
    print(f"  |NB-R| < {tol:>5} : {pct:>5.1f}%")

# Idem pour CAV
cav = sub3.filter(pl.col("Type_Credit") == "CAV & autres")
print(f"\n=== CAV & autres — n = {cav.height:,} ===")
diff_cav = (cav["NB_MATURITE_IRBA"] - cav["R"]).abs().to_numpy()
print(f"Distribution de |NB - R| :")
