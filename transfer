# Configuration
warnings.filterwarnings("ignore")
pio.renderers.default = "notebook" 

# --- ÉTAPE 1 : Calcul de l'Indice Corrigé par HOLT (DES) ---

corrected_data = []
grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("Calcul des modèles de Lissage de Holt par segment...")

for name, group in grouped:
    zone, type_bien = name
    # Tri temporel indispensable
    group = group.sort_values("Periode").set_index("Periode")
    
    # On travaille sur la série de l'écart
    ts_ecart = group['Dif'].dropna()
    
    # Sécurité : Holt a besoin d'un peu plus de données que la moyenne simple
    if len(ts_ecart) > 12: 
        try:
            # Configuration du modèle de Holt (Tendance Additive)
            # damped_trend=True est souvent conseillé pour éviter que la tendance ne parte à l'infini
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                seasonal=None, 
                damped_trend=True,
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # Récupération des valeurs ajustées (Le "Biais modélisé")
            ecart_modelise = model_fit.fittedvalues
            
            # Réalignement sur l'index temporel
            ecart_modelise = ecart_modelise.reindex(group.index)
            
            # CALCUL DE L'INDICE CORRIGÉ
            # CL Corrigé = CL Brut - Biais Estimé par Holt
            group['Indice de prix (CL) - Corrigé Holt'] = group['Indice de prix (CL)'] - ecart_modelise
            
        except Exception as e:
            print(f"Echec Holt pour {name}: {e}")
            group['Indice de prix (CL) - Corrigé Holt'] = np.nan
    else:
        group['Indice de prix (CL) - Corrigé Holt'] = np.nan
        
    corrected_data.append(group.reset_index())

# Reconstitution du DataFrame
merge_corrected = pd.concat(corrected_data, ignore_index=True)


# --- ÉTAPE 2 : Préparation Plotly ---

df_plot = merge_corrected.melt(
    id_vars=["Periode", "VAL_MAILLE_GEO", "CD_TYPE_BIEN"],
    value_vars=[
        "Indice de prix (INSEE) - Base 2020", 
        "Indice de prix (CL)", 
        "Indice de prix (CL) - Corrigé Holt"
    ],
    var_name="Source",
    value_name="Indice_Valeur"
)

df_plot['Segment'] = df_plot['VAL_MAILLE_GEO'] + ' - ' + df_plot['CD_TYPE_BIEN']

# --- ÉTAPE 3 : Génération des Graphiques ---

segments_uniques = df_plot['Segment'].unique()

print(f"Génération des graphiques pour {len(segments_uniques)} segments...")

for segment in segments_uniques:
    df_segment = df_plot[df_plot['Segment'] == segment]
    df_segment = df_segment.dropna(subset=["Indice_Valeur"])
    
    if df_segment.empty:
        continue

    fig = px.line(
        df_segment,
        x="Periode",
        y="Indice_Valeur",
        color="Source",
        
        # Couleurs : Noir (Réalité), Rouge (Original), Bleu (Correction Holt)
        color_discrete_map={
            "Indice de prix (INSEE) - Base 2020": "black",
            "Indice de prix (CL)": "red",
            "Indice de prix (CL) - Corrigé Holt": "blue" 
        },
        
        title=f"Correction Dynamique (Holt) vs INSEE : {segment}",
        labels={
            "Indice_Valeur": "Indice (Base 2020 = 100)",
            "Periode": "Trimestre",
            "Source": "Indicateur"
        },
        height=500
    )

    # Styles de lignes pour bien distinguer
    # Pointillés pour l'original (CL) qui dérive
    fig.update_traces(patch={"line": {"dash": "dot", "width": 2}}, selector={"legendgroup": "Indice de prix (CL)"})
    # Trait épais solide pour la correction
    fig.update_traces(patch={"line": {"width": 3}}, selector={"legendgroup": "Indice de prix (CL) - Corrigé Holt"})
    # Trait solide normal pour l'INSEE
    fig.update_traces(patch={"line": {"width": 2}}, selector={"legendgroup": "Indice de prix (INSEE) - Base 2020"})

    # Zoom Y intelligent
    y_min = df_segment["Indice_Valeur"].min()
    y_max = df_segment["Indice_Valeur"].max()
    fig.update_yaxes(range=[y_min - 5, y_max + 5])

    # Ligne 100
    fig.add_hline(y=100, line_dash="dash", line_color="gray", opacity=0.5)

    fig.update_layout(template="plotly_white", title_x=0.5)
    fig.show()
