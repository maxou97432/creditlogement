# ── Correction 1 : date d'arrêté corrigée ────────────────────────
DT_ARRT = 23922  # 30/06/2025 (pas 24106 !)

# ── Vérification des colonnes disponibles ────────────────────────
print("Colonnes disponibles pour l'exception :")
print([c for c in result.columns if any(kw in c.upper() 
      for kw in ['TYPE_FAC', 'CONFIRME', 'REVOLVING', 'OBJET', 'LEQ', 'TF'])])

# ── Application de _calc_duration sur capret ─────────────────────
duration_brute = (
    pl.when(pl.col('NB_MATURITE_IRBA').is_not_null())
    .then(pl.col('NB_MATURITE_IRBA'))
    .otherwise((pl.col('DT_ECHEANCE_FEM') - DT_ARRT) / 365.25)
)

# Exception (adapte les noms de colonnes selon ce que tu as)
is_exception = (
    (pl.col('IND_CREDIT_CONFIRME') == 0) &
    (pl.col('NB_MATURITE_IRBA') < 1.0)
)

duration_finale = (
    pl.when(is_exception)
    .then(duration_brute)                     # Pas de floor
    .otherwise(duration_brute.clip(1.0, 5.0)) # Clip standard
)

result = result.with_columns(duration_finale.alias('TEST3_calc_duration'))

# ── Comparaison Test 3 vs NB_DURATION_IRBA ───────────────────────
n3 = result.filter(
    (pl.col('TEST3_calc_duration') - pl.col('NB_DURATION_IRBA')).abs() < 0.001
).height
print(f"\nTEST 3 — _calc_duration vs NB_DURATION_IRBA : {n3}/{result.height} ({n3/result.height:.1%})")
print(f"(vs TEST 1 qui avait 4 mismatches — est-ce que les 4 sont résolus ?)")
