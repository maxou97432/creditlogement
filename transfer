def meilleur_candidat_fusion_tailles_effet(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = LGD_COL,
    jenks_col: str = CLASS_COL,
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Fusionne basé sur tailles d'effet :
    Cohen's d < d_max_opt ET OVL > ovl_min_opt ET Wasserstein < w_max_opt
    """
    lf = df.lazy() if isinstance(df, pl.DataFrame) else df
    ordre = (
        lf.group_by([jenks_col, "year"]).agg(pl.col(lgd_col).mean().alias("m"))
          .group_by([jenks_col]).agg(pl.col("m").mean().alias("mean_LGD_global"))
          .sort("mean_LGD_global")
          .collect()
    )
    
    obligors = {}
    base_col = lf.select([jenks_col, lgd_col]).collect()
    for cls in base_col.select(jenks_col).unique().to_series():
        obligors[cls] = base_col.filter(pl.col(jenks_col) == cls).get_column(lgd_col).to_numpy()
    
    paires = []
    classes = ordre.get_column(jenks_col).to_list()
    for i in range(len(classes) - 1):
        c1, c2 = classes[i], classes[i + 1]
        a1, a2 = obligors[c1], obligors[c2]
        
        d = abs(cohen_d(a1, a2))
        o = overlap(a1, a2)
        w = wasserstein_distance(a1, a2)
        
        # Les TROIS critères doivent passer
        if (d < d_max_opt) and (o > ovl_min_opt) and (w < w_max_opt):
            paires.append({
                jenks_col: c1,
                "next_class": c2,
                "cohen_d": d,
                "ovl": o,
                "wasserstein": w,
                "severite_totale": w,  # priorité Wasserstein minimal
            })
    
    if not paires:
        return None, None
    
    df_paires = pl.DataFrame(paires).sort("severite_totale")
    meilleur = df_paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], df_paires


