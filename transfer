config = load_config("config.yaml")
catalogue = config["pipeline"]["notebooks"]
noms_catalogue = [nb["name"] for nb in catalogue]

# --- Sélection ---
if NOTEBOOKS_A_LANCER == "all":
    selection = noms_catalogue
else:
    inconnus = [n for n in NOTEBOOKS_A_LANCER if n not in noms_catalogue]
    if inconnus:
        raise ValueError(f"Notebooks demandés absents de config.yaml : {inconnus}\nCatalogue : {noms_catalogue}")
    selection = [n for n in noms_catalogue if n in NOTEBOOKS_A_LANCER]

notebooks_actifs = [nb for nb in catalogue if nb["name"] in selection]

def chemins_a_plat(valeur):
    """Aplatit un chemin simple OU un dict de chemins en liste de Path."""
    if valeur is None:
        return []
    if isinstance(valeur, dict):
        return list(valeur.values())
    return [valeur]

# --- Contrôle de la chaîne ---
produits = set()
alertes = []

for nb in notebooks_actifs:
    for entree in chemins_a_plat(nb.get("input_path")):
        if entree in produits:
            pass
        elif entree.exists():
            alertes.append(
                f"{nb['name']} : lit un fichier préexistant "
                f"({entree.name}, modifié le "
                f"{datetime.fromtimestamp(entree.stat().st_mtime):%d/%m/%Y %H:%M})"
            )
        else:
            raise FileNotFoundError(
                f"{nb['name']} : entrée introuvable ({entree}). "
                f"Le notebook qui la produit n'est ni dans la sélection, ni déjà exécuté."
            )
    for sortie in chemins_a_plat(nb.get("output_path")):
        produits.add(sortie)

# --- Récapitulatif ---
def noms_a_plat(valeur):
    if valeur is None:
        return "— (sources)"
    if isinstance(valeur, dict):
        return ", ".join(p.name for p in valeur.values())
    return valeur.name

plan = pd.DataFrame([{
    "notebook": nb["name"],
    "entrée":   noms_a_plat(nb.get("input_path")),
    "sortie":   noms_a_plat(nb.get("output_path")),
} for nb in notebooks_actifs])

print(f"RUN {RUN_ID} — {len(notebooks_actifs)}/{len(catalogue)} notebooks")
print(f"Fichiers intermédiaires : {config['intermediate_dir']}\n")

for a in alertes:
    print(f"  [!] {a}")

plan
