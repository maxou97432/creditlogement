import polars as pl

# Segment ANOMALIE déjà défini au script précédent
pop = df.filter(pl.col("CD_PORTFOLIO") == "Corporate")

# 1) Distribution du flag par SEGMENT
print(">>> IND_EXPO_SHOR_TERM × SEGMENT (Corporate uniquement)")
print(
    pop.group_by(["SEGMENT", "IND_EXPO_SHOR_TERM"])
    .agg(pl.len().alias("N"))
    .sort(["SEGMENT", "IND_EXPO_SHOR_TERM"])
)

# 2) Règle candidate : 
#    SI IND_EXPO_SHOR_TERM = 1  → pas de floor (duration = maturité brute)
#    SINON                       → clip(maturité, 1, 5)
pop = pop.with_columns(
    pl.when(pl.col("IND_EXPO_SHOR_TERM") == 1)
    .then(pl.col("NB_MATURITE_IRBA"))
    .otherwise(pl.col("NB_MATURITE_IRBA").clip(1.0, 5.0))
    .alias("NB_DURATION_SIMULE")
)

# 3) Taux de réplication
match = ((pop["NB_DURATION_SIMULE"] - pop["NB_DURATION_IRBA"]).abs() < 1e-6).sum()
total = len(pop)
print(f"\n>>> Taux de réplication Corporate avec IND_EXPO_SHOR_TERM : "
      f"{match:,} / {total:,}  ({100*match/total:.2f}%)")

# 4) Résidus résiduels (si < 100%)
residus = pop.filter(
    (pl.col("NB_DURATION_SIMULE") - pl.col("NB_DURATION_IRBA")).abs() >= 1e-6
)
if len(residus) > 0:
    print(f"\n>>> Résidus : {len(residus):,}")
    print(residus.select([
        "NB_MATURITE_IRBA", "NB_DURATION_IRBA", "NB_DURATION_SIMULE",
        "IND_EXPO_SHOR_TERM"
    ]).head(20))
