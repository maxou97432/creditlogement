        return json.load(f)


def construire_labels_quali(encoding_dict: dict) -> dict:
    """
    Inverse encoding_dict ({variable: {label: code}}) en
    {variable: {code: label}} pour ré-afficher les modalités quali encodées
    en leur libellé d'origine. Les codes sont castés en int (clés JSON
    toujours strings) pour matcher les colonnes Int des DataFrames polars.

    En cas de collision (deux labels différents mappés au même code, ce qui
    ne devrait pas arriver mais on ne sait jamais avec un encodage externe),
    le dernier rencontré gagne et un avertissement est affiché.
    """
    labels_quali = {}
    for var, mapping in encoding_dict.items():
        inverse, vus = {}, {}
        for label, code in mapping.items():
            code_int = int(code)
            if code_int in vus and vus[code_int] != label:
                print(f"   ATTENTION collision sur {var} : code {code_int} "
                      f"mappé à la fois à '{vus[code_int]}' et '{label}'")
            inverse[code_int] = label
            vus[code_int] = label
        labels_quali[var] = inverse
    return labels_quali
