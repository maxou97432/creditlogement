# ---------------------------------------------------------------------------
# OVL par permutation -- seuil de fusion calibré (non parachuté)
# ---------------------------------------------------------------------------

class OVLPermutationTest(HeterogeneityTest):
    """OVL-2 (Komaba, Johno & Nakamoto 2023) avec seuil de fusion calibré
    par permutation, plutôt que parachuté.

    Principe (cf. dossier validateur, section OVL-permutation) :
      1. ESTIMÉ      : ρ_2 estimé par bootstrap (n_boot tirages avec remise sur
                       A et B) -> distribution -> borne basse = percentile bas.
      2. RÉFÉRENCE H0 : pool A+B repartitionné aléatoirement aux tailles réelles
                       (n_perm permutations) -> distribution de ρ_2 "si A et B
                       étaient une seule population" (test de permutation, éq.
                       Theorem 3.5 du papier, approximé par Monte-Carlo).
      3. SEUIL       : percentile bas de la distribution H0.
      4. DÉCISION    : fusion si borne_basse_observée >= seuil_H0.

    ρ_2 = min_{v1<=v2} Σ_i min{F0|[vi,vi+1], F1|[vi,vi+1]}  (Definition 2.2).
    L'optimum ne dépend que des rangs combinés (Proposition 3.6) : calcul exact
    sur la séquence triée, O(m²), vectorisé numpy.

    La p-value de permutation est calculée mais DOCUMENTAIRE (comme Welch/KS) :
    elle sature à grand n. Le critère de décision est borne_basse >= seuil_H0,
    qui lui est insensible à n.

    Réf : Komaba, Johno & Nakamoto, "A novel statistical approach for two-sample
    testing based on the overlap coefficient", J. Math. Sci. Univ. Tokyo (2023).
    """

    name = "OVL-permutation"
    is_effect_size = True

    def __init__(
        self,
        n_boot: int = 500,
        n_perm: int = 500,
        percentile: float = 5.0,
        n_subsample: int = 300,
        min_ovl: Optional[float] = None,
        random_state: Optional[int] = 0,
    ) -> None:
        """
        n_boot      : nombre de tirages bootstrap pour l'OVL observé
        n_perm      : nombre de permutations pour la distribution H0
        percentile  : quantile bas (en %) -- borne basse ET seuil H0
        n_subsample : taille de sous-échantillon par classe (cap sur l'effectif).
                      ρ_2 converge vite ; 300 suffit et garde le O(m²) léger.
        min_ovl     : plancher métier optionnel sur la borne basse (None = aucun).
                      Si fourni, fusion exige aussi borne_basse >= min_ovl.
        random_state: graine (reproductibilité dossier validateur).
        """
        super().__init__()
        self.n_boot = int(n_boot)
        self.n_perm = int(n_perm)
        self.percentile = float(percentile)
        self.n_subsample = int(n_subsample)
        self.min_ovl = min_ovl
        self.random_state = random_state
        # stockés après fit() pour plot()
        self._boot_ovl: Optional[np.ndarray] = None
        self._h0_ovl: Optional[np.ndarray] = None

    # -- estimateur ρ_2 (exact sur les rangs, vectorisé) --------------------

    @staticmethod
    def _ovl2(a: np.ndarray, b: np.ndarray) -> float:
        """ρ_2 = min_{0<=j1<=j2<=m} r(j1,j2) sur la séquence triée combinée."""
        n_a, n_b = a.size, b.size
        m = n_a + n_b
        combined = np.concatenate([a, b])
        is_b = np.concatenate([np.zeros(n_a, dtype=bool),
                               np.ones(n_b, dtype=bool)])
        order = np.argsort(combined, kind="stable")
        is_b = is_b[order]
        # F0, F1 empiriques le long de la séquence triée, avec 0 en tête
        ca = np.concatenate(([0.0], np.cumsum(~is_b) / n_a))   # length m+1
        cb = np.concatenate(([0.0], np.cumsum(is_b) / n_b))
        # r(j1,j2) = min(ca[j1],cb[j1])               <- dépend de j1
        #          + min(ca[j2]-ca[j1], cb[j2]-cb[j1]) <- dépend des deux
        #          + min(1-ca[j2], 1-cb[j2])           <- dépend de j2
        t1 = np.minimum(ca, cb)                  # (m+1,)
        t3 = np.minimum(1.0 - ca, 1.0 - cb)      # (m+1,)
        da = ca[None, :] - ca[:, None]           # da[j1,j2] = ca[j2]-ca[j1]
        db = cb[None, :] - cb[:, None]
        total = t1[:, None] + np.minimum(da, db) + t3[None, :]
        # seuls les j1 <= j2 sont valides
        iu = np.triu_indices(m + 1)
        return float(total[iu].min())

    # -- calcul principal ---------------------------------------------------

    def _compute(self, a: np.ndarray, b: np.ndarray) -> dict:
        rng = np.random.default_rng(self.random_state)
        na_eff = min(a.size, self.n_subsample)
        nb_eff = min(b.size, self.n_subsample)

        # 1. bootstrap inter-classe -> OVL observé + borne basse
        boot = np.empty(self.n_boot)
        for i in range(self.n_boot):
            sa = a[rng.integers(0, a.size, na_eff)]
            sb = b[rng.integers(0, b.size, nb_eff)]
            boot[i] = self._ovl2(sa, sb)
        ovl_obs = float(np.median(boot))
        ovl_lower = float(np.percentile(boot, self.percentile))

        # 2. permutation H0 (pool repartitionné aux mêmes tailles)
        pool = np.concatenate([a, b])
        h0 = np.empty(self.n_perm)
        for i in range(self.n_perm):
            idx = rng.permutation(pool.size)[: na_eff + nb_eff]
            g1 = pool[idx[:na_eff]]
            g2 = pool[idx[na_eff:]]
            h0[i] = self._ovl2(g1, g2)
        seuil_h0 = float(np.percentile(h0, self.percentile))

        # p-value de permutation (DOCUMENTAIRE) :
        # proportion des ρ_2 sous H0 <= ρ_2 observé (overlap faible = atypique)
        p_perm = float((np.sum(h0 <= ovl_obs) + 1) / (self.n_perm + 1))

        self._boot_ovl = boot
        self._h0_ovl = h0

        # 3-4. décision : borne basse >= seuil H0 (+ plancher métier optionnel)
        decision = bool(ovl_lower >= seuil_h0)
        if self.min_ovl is not None:
            decision = bool(decision and ovl_lower >= self.min_ovl)

        floor_txt = "" if self.min_ovl is None else f" et >= plancher {self.min_ovl:.2f}"
        return {
            "statistic": ovl_obs,                # OVL-2 observé (médiane bootstrap)
            "p_value": p_perm,                   # documentaire (sature à grand n)
            "ovl_obs": ovl_obs,
            "ovl_lower": ovl_lower,              # borne basse à (100-percentile)%
            "seuil_h0": seuil_h0,                # seuil calibré par permutation
            "percentile": self.percentile,
            "n_a_eff": int(na_eff),
            "n_b_eff": int(nb_eff),
            "interpretation": (
                f"OVL-2={ovl_obs:.3f} ; borne basse {100 - self.percentile:.0f}%"
                f"={ovl_lower:.3f} vs seuil H0={seuil_h0:.3f} -> "
                + ("FUSION" if decision else "PAS DE FUSION")
                + f" (borne basse {'>=' if ovl_lower >= seuil_h0 else '<'} seuil{floor_txt})"
                + f" ; p_perm={p_perm:.2e} (documentaire)"
            ),
            "fusionnable": decision,
            "fusion_suggeree": decision,
        }

    # -- visualisation ------------------------------------------------------

    def plot(self, ax=None):
        if ax is None:
            _, ax = plt.subplots(figsize=(6, 4))
        if self._h0_ovl is None:
            raise RuntimeError(f"{self.name}: appeler fit() avant plot().")
        r = self.result
        ax.hist(self._h0_ovl, bins=40, density=True, alpha=0.45,
                color="#c44e52", label="H0 (pool repartitionné)")
        ax.hist(self._boot_ovl, bins=40, density=True, alpha=0.45,
                color="#4c72b0", label="OVL observé (bootstrap)")
        ax.axvline(r["seuil_h0"], color="#c44e52", ls="--", lw=1.8,
                   label=f"seuil H0 = {r['seuil_h0']:.3f}")
        ax.axvline(r["ovl_lower"], color="#4c72b0", ls="--", lw=1.8,
                   label=f"borne basse = {r['ovl_lower']:.3f}")
        ax.set_xlabel("OVL-2")
        ax.set_ylabel("densité")
        ax.set_title(f"{self.name} : "
                     + ("FUSION" if r["fusionnable"] else "PAS DE FUSION"))
        ax.legend(fontsize=7)
        return ax

