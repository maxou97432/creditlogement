"""
Empirical validation of the SRS type 1 (linear amortization) formula.

This script is purely a posteriori — it is NOT part of the production
calculation engine. Its sole purpose is to document and revalidate the
formula M = (n+1) / 24 with n = round(R*12) used for CD_TYPE_AMORT = 1.

Re-run periodically (e.g. each quarterly closing) to verify that the
formula remains valid and to monitor the residual outlier cluster.

Required DataFrame columns:
  - DT_DEBUT_AUTO, DT_ECHEANCE_FEM (SAS days)
  - CD_TYPE_AMORT (str or int) with value 1 = linear
  - NB_MATURITE_IRBA (float) — SRS target to reproduce
"""

import polars as pl
import numpy as np

DT_ARRT = 23922   # 30/06/2025 in SAS days — adjust for other reporting dates


# ============================================================
# 1. Build the type 1 population
# ============================================================
def type1_population(df: pl.DataFrame) -> pl.DataFrame:
    df = df.with_columns(
        CD_TYPE_AMORT = pl.col("CD_TYPE_AMORT").str.strip_chars().cast(pl.Int64, strict=False),
        R             = (pl.col("DT_ECHEANCE_FEM") - DT_ARRT) / 365.25,
        T0            = (pl.col("DT_ECHEANCE_FEM") - pl.col("DT_DEBUT_AUTO")) / 365.25,
    )
    return df.filter(
        (pl.col("CD_TYPE_AMORT") == 1)
        & pl.col("NB_MATURITE_IRBA").is_not_null()
    )


# ============================================================
# 2. Closed-form linear formula (CRR 162 with flat principal)
# ============================================================
def predict_m_linear(R_arr: np.ndarray) -> np.ndarray:
    """
    Computes M = (n+1) / (2*12) with n = round(R*12), n >= 1.
    No yield parameter, no calibration: structurally exact for flat
    principal repayments.
    """
    n_arr = np.maximum(1, np.round(R_arr * 12).astype(int))
    return (n_arr + 1) / 2 / 12


# ============================================================
# 3. Global validation
# ============================================================
def validate_linear_formula(df_type1: pl.DataFrame) -> dict:
    """
    Compare the predicted M to the SRS reference NB_MATURITE_IRBA
    on the entire type 1 population. Returns global quality metrics.
    """
    R_arr  = df_type1["R"].to_numpy()
    NB_arr = df_type1["NB_MATURITE_IRBA"].to_numpy()
    pred   = predict_m_linear(R_arr)
    err    = pred - NB_arr

    return {
        "n_observations"     : len(R_arr),
        "rmse_yrs"           : float(np.sqrt(np.mean(err**2))),
        "rmse_days"          : float(np.sqrt(np.mean(err**2)) * 365.25),
        "mae_days"           : float(np.mean(np.abs(err)) * 365.25),
        "mean_bias_days"     : float(np.mean(err) * 365.25),
        "median_bias_days"   : float(np.median(err) * 365.25),
        "pct_match_below_005": float((np.abs(err) < 0.05).mean() * 100),
        "pct_match_below_001": float((np.abs(err) < 0.01).mean() * 100),
        "pct_above_01"       : float((np.abs(err) > 0.10).mean() * 100),
    }


# ============================================================
# 4. Stability check across maturity bands
# ============================================================
def stability_by_band(df_type1: pl.DataFrame) -> pl.DataFrame:
    """
    Compute RMSE and bias on each R band. We expect RMSE to decrease
    with maturity, confirming that errors are pure discretization noise.
    """
    R_arr  = df_type1["R"].to_numpy()
    NB_arr = df_type1["NB_MATURITE_IRBA"].to_numpy()
    pred   = predict_m_linear(R_arr)
    err    = pred - NB_arr

    bands = [(0, 1), (1, 3), (3, 5), (5, 10), (10, 15), (15, 20), (20, 30)]
    rows = []
    for lo, hi in bands:
        mask = (R_arr >= lo) & (R_arr < hi)
        if mask.sum() < 30:
            continue
        e = err[mask] * 365.25
        rows.append({
            "R_band"        : f"[{lo}, {hi}[",
            "n"             : int(mask.sum()),
            "rmse_days"     : float(np.sqrt(np.mean(e**2))),
            "mean_bias_days": float(np.mean(e)),
        })
    return pl.DataFrame(rows)


# ============================================================
# 5. Test for a R<=1 bascule rule (as observed for type 3)
# ============================================================
def test_bascule_rule(df_type1: pl.DataFrame) -> pl.DataFrame:
    """
    For type 3, short facilities (R <= 1) systematically fall back
    to NB = R. We verify this rule does NOT apply to type 1, which
    follows the linear formula uniformly.
    """
    df = df_type1.with_columns(
        is_bascule = (pl.col("NB_MATURITE_IRBA") - pl.col("R")).abs() < 0.01,
        R_bin      = pl.when(pl.col("R") <= 1.0)
                       .then(pl.lit("R<=1"))
                       .otherwise(pl.lit("R>1")),
    )
    return df.group_by("R_bin").agg(
        n           = pl.len(),
        pct_bascule = pl.col("is_bascule").mean() * 100,
    ).sort("R_bin")


# ============================================================
# 6. Error distribution and outlier inspection
# ============================================================
def error_distribution(df_type1: pl.DataFrame) -> None:
    """
    Histogram of error in days. We look for:
      - A central mass within ±10 days (calendar noise)
      - A possible outlier cluster (e.g. ~+173 days, same as type 3)
    """
    R_arr  = df_type1["R"].to_numpy()
    NB_arr = df_type1["NB_MATURITE_IRBA"].to_numpy()
    pred   = predict_m_linear(R_arr)
    err_j  = (pred - NB_arr) * 365.25

    print(f"\n--- Error distribution (in days) ---")
    bins = [-365, -180, -60, -30, -10, 0, 10, 30, 60, 180, 365, 1000]
    for lo, hi in zip(bins[:-1], bins[1:]):
        mask = (err_j >= lo) & (err_j < hi)
        if mask.sum() > 0:
            print(f"  [{lo:>+5}, {hi:>+5}[ : {mask.sum():>6,} ({mask.mean()*100:>5.2f}%)")


# ============================================================
# 7. Full pipeline
# ============================================================
def full_validation(df: pl.DataFrame) -> dict:
    """Run all steps and print the full validation report."""
    df_type1 = type1_population(df)
    print(f"Type 1 population: n = {df_type1.height:,}")

    print("\n=== 1. Global validation ===")
    report = validate_linear_formula(df_type1)
    for k, v in report.items():
        if isinstance(v, float):
            print(f"  {k:<22} = {v:>10.4f}")
        else:
            print(f"  {k:<22} = {v}")

    print("\n=== 2. Stability across R bands ===")
    print(stability_by_band(df_type1))

    print("\n=== 3. Bascule rule R<=1 (should NOT apply to type 1) ===")
    print(test_bascule_rule(df_type1))

    error_distribution(df_type1)

    return report


# ============================================================
# Run
# ============================================================
if __name__ == "__main__":
    # df = pl.read_parquet("srs_X_capret.parquet")
    df = ...   # <-- your DataFrame
    report = full_validation(df)
    print(f"\n>>> Type 1 validation: "
          f"{report['pct_match_below_005']:.1f}% match within 0.05 years")
