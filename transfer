### 💻 Synchronisation des noms de fichiers (inchangé, hors boucle)

```python
def synchroniser_noms_fichiers(catalogue, dossier_notebooks="."):
    dossier = Path(dossier_notebooks)
    pattern_prefixe = re.compile(r"^\d+[A-Z]?\s*-\s*")

    for position, nb in enumerate(catalogue):
        nom_attendu = f"{position} - {nb['nom_metier']}.ipynb"
        chemin_attendu = dossier / nom_attendu

        if chemin_attendu.exists():
            nb["name"] = nom_attendu
            continue

        candidats = [
            f for f in dossier.glob("*.ipynb")
            if pattern_prefixe.sub("", f.stem).strip() == nb["nom_metier"]
        ]
        if len(candidats) == 0:
            raise FileNotFoundError(f"Aucun fichier trouvé pour '{nb['nom_metier']}' dans {dossier}.")
        if len(candidats) > 1:
            raise ValueError(f"Ambiguïté pour '{nb['nom_metier']}' : {[c.name for c in candidats]}")

        ancien = candidats[0]
        ancien.rename(chemin_attendu)
        print(f"[renommé] {ancien.name}  →  {nom_attendu}")
        nb["name"] = nom_attendu

    return catalogue


CATALOGUE_NOTEBOOKS = synchroniser_noms_fichiers(CATALOGUE_NOTEBOOKS, dossier_notebooks=".")
print(f"{len(CATALOGUE_NOTEBOOKS)} notebooks synchronisés.\n")
```

