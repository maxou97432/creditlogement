# ================================================================
#  FUSION GLOUTONNE PAR I²
# ================================================================

print("\n\n=== FUSION GLOUTONNE PAR I² ===\n")

# Reconstruire l'etat initial avec var et n
groups_state = {}
for row in class_stats_base.iter_rows(named=True):
    cls = str(row["CHR_model"])
    groups_state[cls] = {
        "mean"   : row["mean_lgd"],
        "var"    : row["var_lgd"],
        "n"      : row["n"],
        "members": [cls],
    }

# Ordre des classes (tri par mean_lgd)
ordre_classes = [str(c) for c in class_stats_base["CHR_model"].to_list()]

history_i2 = []
iteration  = 0

for _ in range(MAX_ITER):
    # Classes courantes dans l'ordre LGD
    ordre_courant = sorted(groups_state.keys(),
                           key=lambda c: groups_state[c]["mean"])

    if len(ordre_courant) <= 1:
        break

    # Trouver la paire adjacente avec le I² le plus bas
    best_i2   = np.inf
    best_pair = None

    for i in range(len(ordre_courant) - 1):
        ca, cb = ordre_courant[i], ordre_courant[i + 1]
        ga, gb = groups_state[ca], groups_state[cb]

        groups_tmp = [
            {"mean": ga["mean"], "var": ga["var"], "n": ga["n"]},
            {"mean": gb["mean"], "var": gb["var"], "n": gb["n"]},
        ]
        _, I2, _ = compute_Q_I2(groups_tmp)

        if I2 < best_i2:
            best_i2   = I2
            best_pair = (ca, cb)

    ca, cb = best_pair
    code, raison, diag = i2_fusion_test(
        df_base.filter(pl.col("CHR_model").is_in(
            [int(m) for m in groups_state[ca]["members"]])
        )["lgd_obligor"].to_numpy(),
        df_base.filter(pl.col("CHR_model").is_in(
            [int(m) for m in groups_state[cb]["members"]])
        )["lgd_obligor"].to_numpy(),
    )

    iteration += 1
    n_apres    = len(ordre_courant) - 1

    symbole = "✅" if code == 0 else "🟡" if code == 1 else "⛔"
    print(f"{symbole} it={iteration:3d} | n={n_apres:3d} | "
          f"{ca:<25} + {cb:<25} | "
          f"I²={diag['I2_pct']:5.1f}%  "
          f"gap={diag['gap']:.3f}")

    history_i2.append({
        "iteration" : iteration,
        "n_classes" : n_apres,
        "class_a"   : ca,
        "class_b"   : cb,
        "I2_pct"    : diag["I2_pct"],
        "Q"         : diag["Q"],
        "pval_Q"    : diag["pval_Q"],
        "gap"       : diag["gap"],
        "code"      : code,
        "raison"    : raison,
        "stop"      : code not in CODES_FUSIONNABLES,
    })

    if code not in CODES_FUSIONNABLES:
        print(f"\n🛑 Arret it={iteration} — {raison}")
        print(f"   Toutes les fusions restantes produisent I² >= {I2_MODERE*100:.0f}%")
        break

    # Fusionner dans groups_state
    ga  = groups_state.pop(ca)
    gb  = groups_state.pop(cb)
    n_new    = ga["n"] + gb["n"]
    mean_new = (ga["mean"] * ga["n"] + gb["mean"] * gb["n"]) / n_new
    # Variance poolee : formule exacte pour deux groupes
    var_new  = (
        (ga["n"] - 1) * ga["var"] +
        (gb["n"] - 1) * gb["var"] +
        ga["n"] * gb["n"] / n_new * (ga["mean"] - gb["mean"]) ** 2
    ) / (n_new - 1)

    new_label = f"{ca}|{cb}"
    groups_state[new_label] = {
        "mean"   : mean_new,
        "var"    : var_new,
        "n"      : n_new,
        "members": ga["members"] + gb["members"],
    }

# ================================================================
#  RESULTATS FINAUX
# ================================================================

results_i2   = pl.DataFrame(history_i2)
n_cls_final  = len(groups_state)

