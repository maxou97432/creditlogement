def _normalize(lf, *, cd_portfolio, ead, tx_edf, tx_lgd,
               duration=None, dt_echeance=None, dt_arrt=None, cd_type_amort=None):
    rename = {
        cd_portfolio: _CANON["cd_portfolio"],
        ead:          _CANON["ead"],
        tx_edf:       _CANON["tx_edf"],
        tx_lgd:       _CANON["tx_lgd"],
    }
    if duration      is not None: rename[duration]      = _CANON["duration"]
    if dt_echeance   is not None: rename[dt_echeance]   = _CANON["dt_echeance"]
    if dt_arrt       is not None: rename[dt_arrt]       = _CANON["dt_arrt"]
    if cd_type_amort is not None: rename[cd_type_amort] = _CANON["cd_type_amort"]

    rename = {k: v for k, v in rename.items() if k != v}

    # ── DIAGNOSTIC ──
    print(">>> params reçus :")
    print(f"    cd_portfolio  = {cd_portfolio!r}")
    print(f"    duration      = {duration!r}")
    print(f"    ead           = {ead!r}")
    print(f"    tx_edf        = {tx_edf!r}")
    print(f"    tx_lgd        = {tx_lgd!r}")
    print(f"    dt_echeance   = {dt_echeance!r}")
    print(f"    dt_arrt       = {dt_arrt!r}")
    print(f"    cd_type_amort = {cd_type_amort!r}")
    print(">>> rename dict appliqué :", rename)
    # ── fin diagnostic ──

    available = lf.collect_schema().names()
    missing   = [k for k in rename if k not in available]
    if missing:
        raise ValueError(
            f"Colonnes introuvables dans la base : {missing}. "
            f"Colonnes disponibles : {available}"
        )
    return lf.rename(rename) if rename else lf
