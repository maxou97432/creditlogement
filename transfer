## Calibration code

```python
"""
SRS pivot yield calibration for the progressive M Bâle formula (type 3).

This script is purely a posteriori — it is NOT part of the production
calculation engine. Its sole purpose is to document and revalidate the
YIELD_PIVOT_SRS = 0.0495 parameter used in the calculation module.

Re-run periodically (e.g. each quarterly closing) to verify that SRS has
not modified its internal parameter.

Required DataFrame columns:
  - DT_DEBUT_AUTO, DT_ECHEANCE_FEM (SAS days)
  - CD_TYPE_AMORT (str or int) with value 3 = progressive
  - FACTOR (str) — prudential factor
  - segment_trg (int) — commercial scoring segment
  - NB_MATURITE_IRBA (float) — SRS target to reproduce
"""

import polars as pl
import numpy as np
from scipy.optimize import minimize_scalar

DT_ARRT = 23922   # 30/06/2025 in SAS days — adjust for other reporting dates


# ============================================================
# 1. Build the "clean" calibration population
# ============================================================
# Exclude:
#   - short facilities (R <= 1) that fall back to NB = R
#   - non-amortizing products (FACTOR contains [1.71])
#   - non-amortizing commercial segments (44, 73, 74)
# On this subset, SRS strictly applies the progressive formula
# and the yield is observable.
# ============================================================
def calibration_population(df: pl.DataFrame) -> pl.DataFrame:
    df = df.with_columns(
        CD_TYPE_AMORT = pl.col("CD_TYPE_AMORT").str.strip_chars().cast(pl.Int64, strict=False),
        R             = (pl.col("DT_ECHEANCE_FEM") - DT_ARRT) / 365.25,
        has_171       = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
        seg_special   = pl.col("segment_trg").is_in([44, 73, 74]),
    )
    return df.filter(
        (pl.col("CD_TYPE_AMORT") == 3)
        & (pl.col("R") > 1.0)
        & (~pl.col("has_171"))
        & (~pl.col("seg_special"))
        & pl.col("NB_MATURITE_IRBA").is_not_null()
    )


# ============================================================
# 2. Progressive M Bâle formula (vectorized by group of n)
# ============================================================
def predict_m_bale_progressif(R_arr: np.ndarray, y: float, freq: int = 12) -> np.ndarray:
    """
    Computes M = (1/freq) * sum(k*(1+r)^(k-1)) / sum((1+r)^(k-1))
    with r = y/freq, n = round(R*freq), for an array of R values.

    Vectorized by groups of identical n for ~100x speedup over per-row loop.
    """
    r = y / freq
    n_arr = np.maximum(1, np.round(R_arr * freq).astype(int))
    preds = np.empty_like(R_arr, dtype=float)
    for n_unique in np.unique(n_arr):
        mask = n_arr == n_unique
        if abs(y) < 1e-12:
            preds[mask] = (n_unique + 1) / 2 / freq
        else:
            k = np.arange(1, n_unique + 1)
            w = (1 + r) ** (k - 1)
            preds[mask] = np.sum(k * w) / np.sum(w) / freq
    return preds


# ============================================================
# 3. Global calibration: RMSE minimization
# ============================================================
def calibrate_pivot_yield(df_calib: pl.DataFrame) -> dict:
    """
    Find the yield that minimizes RMSE between predictions and NB_MATURITE_IRBA
    on the calibration population.

    Returns:
      dict with optimal yield, RMSE, and quality metrics.
    """
    R_arr  = df_calib["R"].to_numpy()
    NB_arr = df_calib["NB_MATURITE_IRBA"].to_numpy()
    n_obs  = len(R_arr)

    def loss(y: float) -> float:
        preds = predict_m_bale_progressif(R_arr, y)
        return np.mean((preds - NB_arr) ** 2)

    res = minimize_scalar(
        loss,
        bounds=(0.001, 0.20),
        method='bounded',
        options={'xatol': 1e-8},
    )
    y_opt = res.x
    rmse  = np.sqrt(res.fun)

    # Quality metrics at optimal yield
    preds   = predict_m_bale_progressif(R_arr, y_opt)
    err     = preds - NB_arr
    abs_err = np.abs(err)

    return {
        "n_observations"     : n_obs,
        "optimal_yield"      : y_opt,
        "optimal_yield_pct"  : y_opt * 100,
        "rmse_yrs"           : rmse,
        "rmse_days"          : rmse * 365.25,
        "mae_yrs"            : float(np.mean(abs_err)),
        "mean_bias_days"     : float(np.mean(err) * 365.25),
        "pct_match_below_005": float((abs_err < 0.05).mean() * 100),
        "pct_match_below_001": float((abs_err < 0.01).mean() * 100),
    }


# ============================================================
# 4. Stability test across maturity bands
# ============================================================
def stability_by_band(df_calib: pl.DataFrame) -> pl.DataFrame:
    """
    For each R band, calibrate a local optimal yield.
    A constant yield across bands confirms parameter stability.
    """
    R_arr  = df_calib["R"].to_numpy()
    NB_arr = df_calib["NB_MATURITE_IRBA"].to_numpy()

    bands = [(1, 3), (3, 5), (5, 10), (10, 15), (15, 20), (20, 30), (30, 60)]
    rows = []
    for lo, hi in bands:
        mask = (R_arr >= lo) & (R_arr < hi)
        if mask.sum() < 50:
            continue
        R_s, NB_s = R_arr[mask], NB_arr[mask]
        def local_loss(y):
            return np.mean((predict_m_bale_progressif(R_s, y) - NB_s) ** 2)
        res = minimize_scalar(local_loss, bounds=(0.001, 0.20),
                               method='bounded', options={'xatol': 1e-7})
        rows.append({
            "R_band"          : f"[{lo}, {hi}[",
            "n"               : int(mask.sum()),
            "local_yield_pct" : res.x * 100,
            "rmse_days"       : np.sqrt(res.fun) * 365.25,
        })
    return pl.DataFrame(rows)


# ============================================================
# 5. Discrimination test: contractual rate vs pivot rate
# ============================================================
def test_contractual_rate(df_calib: pl.DataFrame, y_pivot: float) -> dict:
    """
    Compare pivot yield performance against per-line contractual rate.
    If the pivot wins, we confirm SRS does NOT use T_INTRT.
    """
    R_arr  = df_calib["R"].to_numpy()
    NB_arr = df_calib["NB_MATURITE_IRBA"].to_numpy()
    Y_arr  = df_calib["T_INTRT"].to_numpy()

    pred_pivot      = predict_m_bale_progressif(R_arr, y_pivot)
    pred_contractual = np.array([
        predict_m_bale_progressif(np.array([R]), y)[0]
        for R, y in zip(R_arr, Y_arr)
    ])

    rmse_pivot       = np.sqrt(np.mean((pred_pivot - NB_arr) ** 2))
    rmse_contractual = np.sqrt(np.mean((pred_contractual - NB_arr) ** 2))

    return {
        "rmse_pivot_yield_days"      : rmse_pivot * 365.25,
        "rmse_contractual_rate_days" : rmse_contractual * 365.25,
        "ratio"                      : rmse_contractual / rmse_pivot,
        "verdict"                    : ("Pivot yield beats contractual rate"
                                        if rmse_pivot < rmse_contractual
                                        else "Contractual rate is better"),
    }


# ============================================================
# 6. Full pipeline
# ============================================================
def full_calibration(df: pl.DataFrame) -> dict:
    """Run all steps and return the full report."""
    df_calib = calibration_population(df)
    print(f"Calibration population: n = {df_calib.height:,}")

    print("\n=== 1. Global calibration ===")
    report = calibrate_pivot_yield(df_calib)
    for k, v in report.items():
        if isinstance(v, float):
            print(f"  {k:<30} = {v:>10.4f}")
        else:
            print(f"  {k:<30} = {v}")

    print("\n=== 2. Stability across R bands ===")
    print(stability_by_band(df_calib))

    print("\n=== 3. Pivot yield vs contractual rate ===")
    discrim = test_contractual_rate(df_calib, report["optimal_yield"])
    for k, v in discrim.items():
        print(f"  {k:<30} = {v}")

    return {
        "calibrated_optimal_yield": report["optimal_yield"],
        "yield_for_production"    : 0.0495,   # conservative rounding
        "calibration_report"      : report,
        "stability"               : stability_by_band(df_calib).to_dicts(),
        "discrimination"          : discrim,
    }


# ============================================================
# Run
# ============================================================
if __name__ == "__main__":
    # df = pl.read_parquet("srs_X_capret.parquet")
    df = ...   # <-- your DataFrame
    report = full_calibration(df)
    print(f"\n>>> Yield retained for production: {report['yield_for_production']*100:.2f}%")
