def _color_somers_d(value: float) -> str:
    """Style CSS de fond selon les seuils Vert / Ambre / Rouge (couleur de
    texte fixée explicitement pour rester lisible quel que soit le thème
    du notebook, clair ou sombre)."""
    if value is None or (isinstance(value, float) and np.isnan(value)):
        return "background-color: #E0E0E0; color: #444444; font-weight: 600;"
    if value >= THRESHOLD_GREEN:
        return "background-color: #C6EFCE; color: #006100; font-weight: 600;"   # VERT
    if value >= THRESHOLD_AMBER:
        return "background-color: #FFEB9C; color: #9C5700; font-weight: 600;"   # AMBRE
    return "background-color: #FFC7CE; color: #9C0006; font-weight: 600;"       # ROUGE
