"""
pipeline/calc_indice.py — Calcul de l'indice de prix CL base 2020.

Lit prix_m2_univ_elem_ALL.csv (produit par calc_prix.py) et génère des CSV
par maille au format attendu par indice_prix_mlops/data/data_loader.py.

Format de sortie (par maille) :
    VAL_MAILLE_GEO, CD_TYPE_BIEN, ANCIENNETE, Periode, prix_mm_value,
    DIC_NAME, TYPE_MAILLE, TAUX_INFL_3M, TAUX_INFL_12M, Indice de prix (CL)

Fichiers produits dans cfg['output_dir'] :
    prix_m2_univ_elem_complet_CITY.csv
    prix_m2_univ_elem_complet_DEPT.csv
    prix_m2_univ_elem_complet_REGION.csv
    prix_m2_univ_elem_complet_PROVINCE.csv
    indice_prix_CL_ALL.csv   ← concaténation de toutes les mailles
"""

import os
import pandas as pd
import numpy as np


# ---------------------------------------------------------------------------
# Base year pour l'indice (peut être surchargée via cfg)
# ---------------------------------------------------------------------------
BASE_YEAR_DEFAULT = 2020


def _calculate_cl_index(df: pd.DataFrame, base_year: int) -> pd.DataFrame:
    """
    Calcule l'indice de prix CL base 100 = moyenne de base_year.

    Parameters
    ----------
    df        : DataFrame avec colonnes CD_TYPE_BIEN, ANCIENNETE, VAL_MAILLE_GEO, Periode, prix_mm_value
    base_year : Année de référence pour l'indice (ex: 2020)

    Returns
    -------
    df avec colonne 'Indice de prix (CL)' ajoutée
    """
    print(f"\n  Calcul indice CL (Base {base_year})...")

    df["Periode"] = pd.to_datetime(df["Periode"])
    mask_base = df["Periode"].dt.year == base_year

    if not df.loc[mask_base].empty:
        # Moyenne sur l'année de base, par (zone × type_bien × anciennete)
        pivot_base = (
            df.loc[mask_base]
            .groupby(["CD_TYPE_BIEN", "ANCIENNETE", "VAL_MAILLE_GEO"])["prix_mm_value"]
            .mean()
        )

        idx       = pd.MultiIndex.from_frame(df[["CD_TYPE_BIEN", "ANCIENNETE", "VAL_MAILLE_GEO"]])
        prix_base = idx.map(pivot_base)

        df["Indice de prix (CL)"] = (df["prix_mm_value"] / prix_base * 100).round(2)

        nb_zones = df["VAL_MAILLE_GEO"].nunique()
        nb_ok    = df["Indice de prix (CL)"].notna().sum()
        print(f"     ✓ Indice calculé pour {nb_zones} zones × {df['ANCIENNETE'].nunique()} périmètres — {nb_ok} valeurs non nulles")
    else:
        print(f"     ⚠  Aucune donnée {base_year} — indice non calculé")
        df["Indice de prix (CL)"] = np.nan

    return df


def run(cfg: dict):
    """
    Calcule l'indice de prix CL et génère les CSV pour indice_prix_mlops.

    Parameters
    ----------
    cfg : dict retourné par config.get_config()
        Clés utilisées :
            output_dir       : dossier où lire prix_m2_univ_elem_ALL.csv et écrire les CSV
            base_year_indice : int, année de base (défaut 2020)
    """
    output_dir = cfg["output_dir"]
    base_year  = cfg.get("base_year_indice", BASE_YEAR_DEFAULT)

    # ------------------------------------------------------------------
    # 1. Chargement du CSV complet
    # ------------------------------------------------------------------
    path_all = os.path.join(output_dir, "prix_m2_univ_elem_ALL.csv")
    if not os.path.exists(path_all):
        print(f"  ⚠  {path_all} introuvable — relancer l'étape 'prix' d'abord.")
        return

    print(f"\nChargement {path_all}...")
    df_all = pd.read_csv(path_all, parse_dates=["Periode"])
    print(f"  {len(df_all):,} lignes lues")

    # ------------------------------------------------------------------
    # 2. Renommer TYPE_BIEN → CD_TYPE_BIEN
    # ------------------------------------------------------------------
    df = df_all.rename(columns={"TYPE_BIEN": "CD_TYPE_BIEN"})

    # ------------------------------------------------------------------
    # 3. Format long : empiler prix_mm_3m et prix_mm_12m
    #    DIC_NAME = "prix_m2_3m" | "prix_m2_12m"
    # ------------------------------------------------------------------
    cols_communes = ["VAL_MAILLE_GEO", "TYPE_MAILLE", "CD_TYPE_BIEN", "ANCIENNETE",
                     "Periode", "TAUX_INFL_3M", "TAUX_INFL_12M"]

    df_3m  = df[cols_communes + ["prix_mm_3m"]].copy()
    df_3m  = df_3m.rename(columns={"prix_mm_3m": "prix_mm_value"})
    df_3m["DIC_NAME"] = "prix_m2_3m"

    df_12m = df[cols_communes + ["prix_mm_12m"]].copy()
    df_12m = df_12m.rename(columns={"prix_mm_12m": "prix_mm_value"})
    df_12m["DIC_NAME"] = "prix_m2_12m"

    df_long = pd.concat([df_3m, df_12m], ignore_index=True)
    df_long = df_long.sort_values(["TYPE_MAILLE", "VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "DIC_NAME"])

    # ------------------------------------------------------------------
    # 4. Calcul de l'indice base 2020
    #    Uniquement sur prix_mm_3m (cohérent avec data_loader de mlops)
    # ------------------------------------------------------------------
    df_idx = df_long[df_long["DIC_NAME"] == "prix_m2_3m"].copy()
    df_idx = _calculate_cl_index(df_idx, base_year)

    # Fusionner l'indice sur df_long
    df_long = df_long.merge(
        df_idx[["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "Indice de prix (CL)"]],
        on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode"],
        how="left"
    )

    # ------------------------------------------------------------------
    # 5. Export par maille
    # ------------------------------------------------------------------
    print("\n" + "="*60)
    print("EXPORT CSV PAR MAILLE")
    print("="*60)

    for maille in ["CITY", "DEPT", "REGION", "PROVINCE"]:
        df_m = df_long[df_long["TYPE_MAILLE"] == maille].copy()
        if df_m.empty:
            print(f"  ⚠  Aucune donnée pour {maille}")
            continue

        fname  = f"prix_m2_univ_elem_complet_{maille}.csv"
        fpath  = os.path.join(output_dir, fname)
        df_m.to_csv(fpath, index=False, encoding="utf-8-sig")
        print(f"  → {fname} : {len(df_m):,} lignes, {df_m['VAL_MAILLE_GEO'].nunique()} zones")

    # Export consolidé
    path_all_out = os.path.join(output_dir, "indice_prix_CL_ALL.csv")
    df_long.to_csv(path_all_out, index=False, encoding="utf-8-sig")
    print(f"\n  → indice_prix_CL_ALL.csv : {len(df_long):,} lignes")
    print(f"\n✓ Étape 'indice' terminée — fichiers dans : {output_dir}")
