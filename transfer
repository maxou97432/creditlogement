    )
    df_ville["std_12m (v2)"] = (
        df_ville["Prix moyen glissant 12 mois - Univ Elem (V2)"]
        .rolling(window=12, min_periods=3)
        .std()
    )

    # Intervalle de confiance 95 %

    df_ville["IC_inf_12m"] = df_ville["Prix moyen glissant 12 mois - Univ Elem (V1)"] - 1.96 * df_ville["std_12m (v1)"]
    df_ville["IC_sup_12m"] = df_ville["Prix moyen glissant 12 mois - Univ Elem (V1)"] + 1.96 * df_ville["std_12m (v1)"]
    df_ville["IC_inf_3m"] = df_ville["Prix moyen glissant 12 mois - Univ Elem (V2)"] - 1.96 * df_ville["std_12m (v2)"]
