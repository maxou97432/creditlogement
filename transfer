def fusion_glouton(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = None,
    log: bool = False,
    obligor_col: str = 'ID_CLIENT',
) -> Tuple[pl.LazyFrame, Optional[Dict[str, str]]]:
    """
    Applique itérativement la fusion des classes tant qu'une paire violante existe.
    Retourne le DataFrame final au grain (jenks_col, year) avec LGD pondérée
    et le dictionnaire {ancienne_classe: nouvelle_classe}.

    Entrée  : df au grain facilité, avec lgd_obligor calculée par obligor.
    Sortie  : df au grain (jenks_col, year) avec :
                - lgd_col        : LGD pondérée par nb_obligors
                - nb_obligor     : nb obligors distincts par (classe, year)

    Pondération : LGD_[k->m],t = Σ(LGD_l,t * E_l,t) / Σ(E_l,t)
    """
    mapping: Dict[str, str] = {}

    while True:
        # ----------------------------------------------------------------
        # Agrégation au grain (jenks_col, year) pour meilleur_candidat_fusion
        # Grain facilité -> grain obligor -> grain (classe, year)
        # ----------------------------------------------------------------
        df_agg = (
            df
            # Étape 1 : grain facilité -> grain (classe, year, obligor)
            # lgd_obligor est déjà calculée correctement par obligor
            .group_by([jenks_col, "year", obligor_col])
            .agg(
                pl.col(lgd_col).mean().alias("_lgd_obligor")
            )
            # Étape 2 : grain (classe, year, obligor) -> grain (classe, year)
            # moyenne pondérée par nb_obligors
            .group_by([jenks_col, "year"])
            .agg([
                pl.col("_lgd_obligor").mean().alias("_lgd_mean"),
                pl.col(obligor_col).n_unique().alias("nb_obligor"),
            ])
            .with_columns(
                (pl.col("_lgd_mean") * pl.col("nb_obligor")).alias("_num")
            )
            .group_by([jenks_col, "year"])
            .agg([
                (pl.col("_num").sum() / pl.col("nb_obligor").sum())
                .alias(lgd_col),
                pl.col("nb_obligor").sum().alias("nb_obligor"),
            ])
            .drop("_num")
        )

        paire, debug_df = meilleur_candidat_fusion(
            df_agg,
            nb_croisements_max=nb_croisements_max,
            ans_strict=ans_strict,
            lgd_col=lgd_col,
            jenks_col=jenks_col,
            log=log,
        )

        if not paire:                               # plus rien à fusionner
            nb_final = df_agg.collect().select(jenks_col).n_unique()
            print(f"SUCCES : {nb_final} classes finales.")
            break

        c1, c2 = paire
        nouveau_nom = f"{c1}_{c2}"
        print(f"Fusion de {c1} et de {c2} (sévérité = {debug_df['severite_totale'][0]})")

        # ----------------------------------------------------------------
        # Mise à jour du dictionnaire de mapping (chaînes déjà fusionnées)
        # ----------------------------------------------------------------
        for ancien, actuel in list(mapping.items()):
            if actuel in (c1, c2):
                mapping[ancien] = nouveau_nom

        for elem in (c1, c2):
            if elem not in mapping:
                mapping[elem] = nouveau_nom

        replace_tmp = {c1: nouveau_nom, c2: nouveau_nom}
        mapping.update(replace_tmp)

        # ----------------------------------------------------------------
        # Application de la fusion sur df GRAIN FACILITÉ
        # On renomme juste la classe — grain facilité intact
        # ----------------------------------------------------------------
        df = df.with_columns(
            pl.col(jenks_col)
              .cast(pl.Utf8)
              .replace(replace_tmp)
              .alias(jenks_col)
        )

    return df_agg, mapping
