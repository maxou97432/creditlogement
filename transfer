# Imports fonctionnels (conservés)
from fonctions import (DateOffset, ImportRecentData, CalcMetaNum, EffectifsParMailleGeo, DefMailleGeoCITY, DetectAno)
from fonctions import detect_ano_ml as detect_ano_ml_fct
from fonctions import Connector
import param_general as params
import time

import matplotlib.font_manager as fm


# Le chemin est conservé tel quel
geojson_path = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\metropole.geojson" 

# Chemins des données (vérifiez l'accessibilité)
prix_m2_univ_elem_MAJ_CITY = pd.read_csv(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\prix_m2_univ_elem_MAJ_CITY.csv")
df_communes = pd.read_excel(r"N:\uflujek\Commune_france.xlsx", sheet_name="Figure 1")
df_geo_gps = pd.read_csv(r'N:\uflujek\commune_france_gps.csv', sep=';')

# =============================================================================
# --- PALETTE DE COULEURS CRÉDIT LOGEMENT & POLICE ---
# =============================================================================
CL_TURQUOISE = '#00A79E' 
CL_BLACK = '#000000' 
CL_LIGHT_GREY = '#F0F0F0' 
CL_MEDIUM_GREY = '#CCCCCC' 

# --- CONFIGURATION DE POLICE ---
NOM_POLICE_CL = 'Century Gothic' 
plt.rcParams['font.family'] = 'sans-serif' 
plt.rcParams['font.sans-serif'] = [NOM_POLICE_CL, 'Arial', 'Verdana', 'sans-serif'] 
plt.rcParams['font.weight'] = 'medium' 

TITRE_FONT_WEIGHT = 'heavy' 

# =============================================================================
# --- PRÉPARATION DES DONNÉES ---
# =============================================================================

# 1. Nettoyage et Fusion
prix_m2_univ_elem_MAJ_CITY = prix_m2_univ_elem_MAJ_CITY[prix_m2_univ_elem_MAJ_CITY["TYPE_MAILLE"] == "CITY"]

df_communes['Commune'] = df_communes['Commune'].astype(str).str.upper()
df_prix_m2 = df_communes.merge(prix_m2_univ_elem_MAJ_CITY, left_on='Commune', right_on='VAL_MAILLE_GEO', how='right')

# 2. Fonction de formatage du texte pour l'affichage (Ville et Prix seulement)
def format_text_label(row):
    # Ligne 1 : Nom de la ville en MAJUSCULES
    ville = str(row['label']).upper() 
    
    # Ligne 2 : Prix
    prix_val = row['prix_mm_value']
    prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
    
    # Retourne deux lignes : Ville, Prix (séparées par '\n')
    return f"{ville}\n{prix}"


# =============================================================================
# --- PRÉPARATION DU CONTOUR GÉOGRAPHIQUE ---
# =============================================================================

try:
    france_gdf = gpd.read_file(geojson_path)
    dissolved_france = france_gdf.dissolve(by=None)
    france_outline_geometry = dissolved_france.geometry.iloc[0] 
    print("Contour de la France chargé et dissous avec succès.")
except Exception as e:
    print(f"!!! Échec critique du chargement du GeoJSON: {e}")
    sys.exit(1)


# =============================================================================
# --- CRÉATION DE LA CARTE MATPLOTLIB ---
# =============================================================================

print("Configuration de police 'Century Gothic' appliquée.")


types_bien = ['APT', 'MAI']

# --- DEFINITION DES OFFSETS SPÉCIFQUES ---
CUSTOM_LABEL_OFFSETS = {
    # Déplace le label de Toulon vers le bas/droite (inchangé)
    'TOULON': {'x': 0.1, 'y': -0.05} 
}


for type_bien in types_bien:
    print(f"\n--- Génération de la carte pour le type de bien : {type_bien} ---")
    
    df_prix_filtre = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
    df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
    df_map = df_geo_gps.merge(df_prix_filtre, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
    
    df_map = df_map[['label', 'latitude', 'longitude', 'prix_mm_value', "TAUX_INFL_3M", 'TAUX_INFL_12M']].copy()
    df_map = df_map.dropna(subset=['latitude', 'longitude'])
    df_map = df_map.drop_duplicates(subset='label', keep='first')
    
    if df_map.empty:
        print("Aucune donnée géographique valide trouvée pour ce type de bien.")
        continue
        
    df_map['Formatted_Label'] = df_map.apply(format_text_label, axis=1)
    geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
    gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326")
    
    # --- DESSIN ---
    fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=300) 
    fig.set_facecolor(CL_TURQUOISE) 
    
    # --- DESSIN DU CONTOUR DE LA FRANCE ---
    geometries_to_plot = [france_outline_geometry]
    if france_outline_geometry.geom_type == 'MultiPolygon':
        geometries_to_plot = list(france_outline_geometry.geoms)

    for geom in geometries_to_plot:
        # Remplissage de la France
        ax.fill(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_LIGHT_GREY, 
                zorder=1) 
                
        # Contour noir
        ax.plot(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_BLACK, 
                linewidth=1.0, 
                zorder=2)
    
    # Définir les limites de la vue (zoom sur la France)
    xmin, ymin, xmax, ymax = france_outline_geometry.bounds
    ax.set_xlim(xmin - 0.7, xmax + 0.7) 
    ax.set_ylim(ymin - 0.7, ymax + 0.7)

    # --- AJOUT DES ÉTIQUETTES ET DES BULLES ---
    
    # Variables d'Offset par DÉFAUT des Étiquettes
    DEFAULT_X_OFFSET = 0.08 
    DEFAULT_Y_OFFSET = 0.08 
    
    # Variables d'Offset des Bulles 
    BUBBLE_X_SHIFT = 0.30 
    BUBBLE_Y_SHIFT = 0.02 
    BUBBLE_RADIUS = 0.12 
    
    # Ajustement de l'espacement pour éviter la superposition
    # Cette valeur est critique pour l'écart vertical entre Ville et Prix
    LINE_SPACING = 0.045 
    
    for idx, row in gdf.iterrows():
        lon = row['longitude']
        lat = row['latitude']
        city_label = row['label'] 
        
        # --- LOGIQUE D'OFFSET SPÉCIFIQUE ---
        if city_label in CUSTOM_LABEL_OFFSETS:
            x_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['x']
            y_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['y']
        else:
            x_offset_city = DEFAULT_X_OFFSET
            y_offset_city = DEFAULT_Y_OFFSET
        # ---------------------------------------------

        # Séparation du texte
        full_text = row['Formatted_Label']
        formatted_parts = full_text.split('\n')
        ville = formatted_parts[0] 
        prix = formatted_parts[1]
        
        # Position de départ pour l'étiquette
        anchor_x = lon + x_offset_city
        anchor_y = lat + y_offset_city
        
        ha_align = 'right' if x_offset_city < 0 else 'left'
        va_align = 'top' if y_offset_city < 0 else 'bottom'
        
        # Paramètres pour la BBOX (fond blanc)
        bbox_props = dict(boxstyle="round,pad=0.2", fc="white", ec=CL_MEDIUM_GREY, lw=0.7, alpha=0.95)
        
        
        # 1. Dessiner le fond blanc (BBOX) en utilisant le texte complet invisible
        # Ceci permet à Matplotlib de calculer la zone de la bbox correctement pour englober les deux lignes.
        ax.text(
            anchor_x, 
            anchor_y, 
            full_text,
            fontsize=10, 
            ha=ha_align, 
            va=va_align,
            color='none', # Couleur de texte transparente
            zorder=3,
            bbox=bbox_props
        )
        
        # 2. Dessiner le Nom de la Ville (Ligne 1, en gras)
        ax.text(
            anchor_x, 
            anchor_y, 
            ville, 
            fontsize=10, 
            ha=ha_align, 
            va=va_align,
            color=CL_BLACK,
            weight='bold', 
            zorder=4 
        )
        
        # 3. Dessiner le Prix M2 (Ligne 2, en normal)
        # On applique le décalage pour la deuxième ligne (Prix)
        if va_align == 'bottom':
            prix_y = anchor_y - LINE_SPACING 
        elif va_align == 'top':
            prix_y = anchor_y + LINE_SPACING 
        else:
            prix_y = anchor_y 
            
        ax.text(
            anchor_x, 
            prix_y, 
            prix, 
            fontsize=10, 
            ha=ha_align, 
            va=va_align,
            color=CL_BLACK,
            weight='normal', 
            zorder=4
        )
        
        # 4. Ajout du point de ville d'origine (petit cercle noir)
        ax.plot(lon, lat, marker='o', color=CL_BLACK, markersize=5, zorder=4)

        # 5. Ajout de la 'Bulle d'Évolution'
        ti_12m = row['TAUX_INFL_12M']
        if pd.notna(ti_12m):
            color_evolution = '#E4002B' if ti_12m < 0 else CL_TURQUOISE
            
            # Coordonnées du centre de la bulle
            bubble_center_x = lon + x_offset_city + BUBBLE_X_SHIFT
            # On aligne la bulle sur la ligne du prix (prix_y)
            bubble_center_y = prix_y + BUBBLE_Y_SHIFT 
            
            # a. Dessin de la bulle (Cercle avec contour noir)
            ax.add_patch(plt.Circle(
                (bubble_center_x, bubble_center_y), 
                radius=BUBBLE_RADIUS, 
                color=color_evolution, 
                alpha=0.9,
                ec='black', 
                lw=1.0, 
                zorder=5
            ))
            
            # b. Texte dans la bulle (en gras)
            ax.text(
                bubble_center_x, 
                bubble_center_y, 
                f"{ti_12m:+.1%}".replace('.', ','),
                fontsize=7, 
                color='white', 
                ha='center', 
                va='center',
                weight='bold', 
                zorder=6
            )
    
    # --- FINALISATION DE L'IMAGE ---
    ax.axis('off') 
    
    # Titre principal (noir sur turquoise)
    title_text = f"LES PRIX DES {type_bien} DANS L'ANCIEN"
    ax.set_title(title_text, fontsize=20, loc='center', pad=20, color=CL_BLACK, ha='center', weight=TITRE_FONT_WEIGHT) 
    
    # Sous-titre et sources (noir sur turquoise)
    subtitle_text = "SUR 1 AN DANS LES PRINCIPALES VILLES"
    fig.text(0.5, 0.94, subtitle_text, ha='center', va='top', fontsize=12, color=CL_BLACK, weight='bold') 

    # Ajout de la source et de la légende
    fig.text(0.05, 0.03, "Source: Crédit Logement, MM 12M", ha='left', va='bottom', fontsize=9, color=CL_BLACK)
    
    fig.text(0.05, 0.1, "LÉGENDE ÉVOLUTION:", ha='left', va='bottom', fontsize=9, color=CL_BLACK, weight='bold')
    fig.text(0.05, 0.08, "Turquoise: Hausse", ha='left', va='bottom', fontsize=8, color=CL_TURQUOISE)
    fig.text(0.05, 0.06, "Rouge: Baisse", ha='left', va='bottom', fontsize=8, color='#E4002B')

    # --- AFFICHAGE SEUL ---
    plt.show() 
    plt.close(fig) 

    print(f"Génération de la carte pour {type_bien} terminée.")
