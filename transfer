print(f"\n=== Performance règle v2 (has_171 OU seg_special) ===")
print(f"RMSE                     : {np.sqrt(np.mean(err**2)):.5f}")
print(f"MAE                      : {np.mean(np.abs(err)):.5f}")
print(f"% lignes avec |err|<0.01 : {(np.abs(err) < 0.01).mean()*100:.2f}%")
print(f"% lignes avec |err|<0.05 : {(np.abs(err) < 0.05).mean()*100:.2f}%")
print(f"% lignes avec |err|>0.5  : {(np.abs(err) > 0.5).mean()*100:.2f}%")
