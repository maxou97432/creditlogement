# ---------------------------------------------------------------------------
# Dimensions de segmentation
# ---------------------------------------------------------------------------
TYPES_BIEN   = ["APT", "MAI"]        # types de biens distincts
ANCIENNETES  = ["NEUF", "ANCIEN"]    # anciennetés distinctes


def _calc_inflation(df: pd.DataFrame, group_cols: list, val_col: str) -> pd.DataFrame:
    """Calcule TAUX_INFL_3M et TAUX_INFL_12M sur val_col au sein de chaque groupe."""
    df = df.sort_values(group_cols + ["Periode"])
    df["TAUX_INFL_12M"] = df.groupby(group_cols)[val_col].pct_change(periods=12)
    df["TAUX_INFL_3M"]  = df.groupby(group_cols)[val_col].pct_change(periods=3)
    return df


def _run_segment(df_seg: pd.DataFrame, label: str, df_structure=None, df_arr=None) -> pd.DataFrame | None:
    """
    Lance process_dataset_restreint sur un sous-ensemble filtré.

    Parameters
    ----------
    df_seg      : données déjà filtrées (TYPE_BIEN + BIEN_NEUF éventuellement)
    label       : label passé à process_dataset_restreint (nom du run)
    df_structure: structure de référence optionnelle
    df_arr      : structure arrondissements optionnelle

    Returns
    -------
    DataFrame résultat ou None si vide.
    """
    if df_seg.empty:
        return None
    result = process_dataset_restreint(
        df_seg, label=label, df_structure=df_structure, df_arr=df_arr
    )
    return result if (result is not None and not result.empty) else None


def process_maille_wrapper(
    df: pd.DataFrame,
    maille_col: str,
    maille_name: str,
    df_structure=None,
    df_arr=None
) -> pd.DataFrame | None:
    """
    Calcule les prix glissants pour une maille géographique donnée,
    en produisant toutes les combinaisons TYPE_BIEN × ANCIENNETE
    (APT/MAI/ENSEMBLE × NEUF/ANCIEN/ENSEMBLE).

    Parameters
    ----------
    df          : Base de données filtrée sur le périmètre voulu.
    maille_col  : Colonne géographique dans `df` (ex. "DEPT", "REGION", "Ville").
    maille_name : Libellé de la maille (ex. "PROVINCE", "CITY", "DEPT").
    df_structure: Structure de référence (poids par univers élémentaire).
    df_arr      : Structure arrondissements (Paris/Lyon/Marseille), si applicable.

    Returns
    -------
    pd.DataFrame ou None — colonnes :
        VAL_MAILLE_GEO, TYPE_MAILLE, TYPE_BIEN, ANCIENNETE,
        Periode, prix_mm_3m, prix_mm_12m, surface_mm_3m, surface_mm_12m,
        VF_mm_3m, VF_mm_12m, nb_observations_3m, nb_observations_12m,
        nb_univers_3m, nb_univers_12m, TAUX_INFL_3M, TAUX_INFL_12M
    """
    print(f"\n--- Traitement de la maille : {maille_name} ---")
    start_time = datetime.now()

    # -----------------------------------------------------------------------
    # Préparation commune
    # -----------------------------------------------------------------------
    df_work = df.copy()

    if maille_col != "Ville":
        if "Ville" in df_work.columns:
            df_work = df_work.drop(columns=["Ville"])
        df_work = df_work.rename(columns={maille_col: "Ville"})

    df_work["Ville"] = df_work["Ville"].astype(str).str.strip().str.upper()
    df_work = df_work.dropna(subset=["Ville", "TYPE_BIEN", "NB_PIECES_RANGE"])

    # Adapter la structure si nécessaire
    structure_base = None
    if df_structure is not None:
        structure_base = df_structure.copy()
        if maille_col in structure_base.columns and maille_col != "Ville":
            structure_base = structure_base.rename(columns={maille_col: "Ville"})
        # Normaliser la clé Ville de la structure pour correspondre à df_work["Ville"].str.upper()
        # (nécessaire pour REGION dont les noms ont des accents et une casse mixte)
        if "Ville" in structure_base.columns:
            structure_base["Ville"] = structure_base["Ville"].astype(str).str.strip().str.upper()

    # -----------------------------------------------------------------------
    # Boucle sur les 9 combinaisons TYPE_BIEN × ANCIENNETE
    # -----------------------------------------------------------------------
    all_segments = []

    # Toutes les combinaisons explicites + ENSEMBLE
    type_bien_options  = TYPES_BIEN + ["ENSEMBLE"]
    anciennete_options = ANCIENNETES + ["ENSEMBLE"]

    for tb in type_bien_options:
        for anc in anciennete_options:

            # Filtrage TYPE_BIEN
            if tb == "ENSEMBLE":
                df_tb = df_work.copy()
                # Pour ENSEMBLE, on ne peut pas passer une structure TYPE_BIEN-spécifique ;
                # on utilise la structure globale telle quelle.
                struct_seg = structure_base
            else:
                df_tb = df_work[df_work["TYPE_BIEN"] == tb].copy()
                # Filtrer la structure sur le TYPE_BIEN correspondant
                struct_seg = (
                    structure_base[structure_base["TYPE_BIEN"] == tb].copy()
                    if structure_base is not None else None
                )

            # Filtrage ANCIENNETE
            if anc == "ENSEMBLE":
                df_seg = df_tb.copy()
            else:
                df_seg = df_tb[df_tb["BIEN_NEUF"] == anc].copy()
                if struct_seg is not None:
                    struct_seg = struct_seg[struct_seg["BIEN_NEUF"] == anc].copy()

            # Arrondissements uniquement pour le segment ENSEMBLE × ENSEMBLE (ou APT × ENSEMBLE)
            # Pour les segments filtrés, on ne passe pas df_arr (les arrondissements
            # ont leur propre répartition BIEN_NEUF et TYPE_BIEN dans leur structure).
            arr_seg = df_arr if (tb in ("APT", "ENSEMBLE") and anc == "ENSEMBLE") else None

            label_seg = f"{maille_name}_{tb}_{anc}"
            result = _run_segment(df_seg, label_seg, df_structure=struct_seg, df_arr=arr_seg)

            if result is None:
                print(f"  ↳ {tb} × {anc} : aucune donnée")
                continue

            # Extraire les colonnes utiles et renommer
            rename_map = {
                f"prix_mm_3m ({label_seg})":    "prix_mm_3m",
                f"prix_mm_12m ({label_seg})":   "prix_mm_12m",
                f"surface_mm_3m ({label_seg})": "surface_mm_3m",
                f"surface_mm_12m ({label_seg})":"surface_mm_12m",
                f"VF_mm_3m ({label_seg})":      "VF_mm_3m",
                f"VF_mm_12m ({label_seg})":     "VF_mm_12m",
            }
            result = result.rename(columns=rename_map)

            keep_cols = ["Ville", "Periode"] + list(rename_map.values()) + [
                "nb_observations_3m", "nb_observations_12m",
                "nb_univers_3m", "nb_univers_12m"
            ]
            keep_cols = [c for c in keep_cols if c in result.columns]
            result = result[keep_cols].copy()

            result["TYPE_MAILLE"] = maille_name
            result["TYPE_BIEN"]   = tb
            result["ANCIENNETE"]  = anc

            result = result.rename(columns={"Ville": "VAL_MAILLE_GEO"})

            print(f"  ✓ {tb} × {anc} : {len(result)} lignes")
            all_segments.append(result)

    if not all_segments:
        print(f"  ✗ Aucune donnée pour la maille {maille_name}")
        return None

    final = pd.concat(all_segments, ignore_index=True)

    # -----------------------------------------------------------------------
    # Taux d'inflation
    # -----------------------------------------------------------------------
    group_infl = ["VAL_MAILLE_GEO", "TYPE_MAILLE", "TYPE_BIEN", "ANCIENNETE"]
    final = _calc_inflation(final, group_infl, "prix_mm_3m")

    print(f"Traitement {maille_name} terminé en {datetime.now() - start_time}")
    print(f"  → {len(final)} lignes générées")
    return final


def extract_and_save_structure(df, maille_col, maille_name, resultats_dir):
    """
    Calcule et sauvegarde la structure de marché (poids par univers élémentaire).

    Parameters
    ----------
    df           : Base de transactions filtrée sur le périmètre voulu.
    maille_col   : Nom de la colonne géographique (ex. "DEPT", "REGION", "Ville").
    maille_name  : Libellé utilisé pour nommer le fichier de sortie.
    resultats_dir: Chemin vers le répertoire de sortie.

    Returns
    -------
    pd.DataFrame
        Structure avec colonnes :
        [maille_col, BIEN_NEUF, TYPE_BIEN, NB_PIECES_RANGE, volume_ref, poids_ref].
    """
    print(f"\n   Extraction structure {maille_name}...")

    dims = [maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
    structure = df.groupby(dims, dropna=False).size().reset_index(name="volume_ref")

    structure["TYPE_BIEN"] = structure["TYPE_BIEN"].astype(str).str.upper().str.strip()
    structure["PB"] = structure["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
    mask_coherence = structure["TYPE_BIEN"] == structure["PB"]
    structure = structure[mask_coherence].drop(columns=["PB"])

    structure["poids_ref"] = structure.groupby(maille_col)["volume_ref"].transform(
        lambda x: x / x.sum()
    )

    filename = f"structure_poids_{maille_name}.csv"
    path = os.path.join(resultats_dir, filename)
    structure.to_csv(path, index=False, encoding='utf-8-sig')

    print(f"      -> {filename}")
    print(f"         {len(structure)} univers, {structure[maille_col].nunique()} {maille_name}")

    return structure


if __name__ == "__main__":
    start_global = datetime.now()

    # ==========================================================================
    # 1. Chargement et préparation de la base
    # ==========================================================================
    base_ml = load_and_preprocess_data()

    if "CITY" in base_ml.columns:
        base_ml = base_ml.rename(columns={"CITY": "Ville"})

    resultats_dir = os.path.join(current_dir, "resultats")
