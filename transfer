df_res = pl.DataFrame(resultats)
deltas_array = np.array(df_res.get_column("delta").to_list())
n_array = np.array(df_res.get_column("n_chr").to_list())

# ============================================================================
# Détection du COUDE (méthode : pente maximale)
# ============================================================================
# Pente entre points consécutifs
pentes = np.diff(n_array) / np.diff(deltas_array)

# Indice où la pente est la plus négative (changement le plus abrupt)
idx_coude = np.argmin(pentes) + 1  # +1 car diff décale l'indice
delta_coude = deltas_array[idx_coude]
n_coude = n_array[idx_coude]
pente_coude = pentes[idx_coude - 1]

print("\n" + "=" * 70)
print(f"COUDE DÉTECTÉ : delta ≈ {delta_coude:.2f}  →  {n_coude} CHR_model")
print(f"Pente au coude : {pente_coude:.1f} CHR/delta")
print("=" * 70)

