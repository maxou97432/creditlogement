print(f"RMSE moyen Approx PROV/IDF  : {df_validation['RMSE_Approx_PROV_IDF'].mean():.2f}")
print(f"\nPerte de précision moyenne (Approx vs Exact) : {df_validation['Perte_Precision'].mean():.2f}")
