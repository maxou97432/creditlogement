import polars as pl
import numpy as np

def fusion_par_materialite(
    df_obligor,
    class_col="CHR_model",
    lgd_col="lgd_obligor",
    seuil_ecart_lgd=1.0,      # points de LGD : en dessous, ecart juge non materiel
    seuil_cohen_d=0.2,        # taille d'effet : en dessous, chevauchement juge fort
    max_passes=50,
):
    """
    Balayage sequentiel des classes adjacentes (triees par LGD moyenne).
    Fusionne deux classes si ELLES SONT PROCHES sur les DEUX criteres :
      - ecart de moyenne LGD < seuil_ecart_lgd  (materialite RWA)
      - Cohen's d           < seuil_cohen_d     (chevauchement)
    Re-teste apres chaque fusion (transitivite) jusqu'a stabilite.
    """
    work = df_obligor.select([class_col, lgd_col]).clone()
    work = work.with_columns(pl.col(class_col).cast(pl.Utf8).alias("_grp"))

    for passe in range(max_passes):
        # stats par groupe courant, triees par LGD moyenne = adjacence
        stats = (
            work.group_by("_grp")
            .agg(
                pl.len().alias("n"),
                pl.col(lgd_col).mean().alias("mean"),
                pl.col(lgd_col).var().alias("var"),
            )
            .sort("mean")
        )
        s = stats.to_numpy()
        cols = stats.columns
        i_g, i_n, i_m, i_v = (cols.index(x) for x in ["_grp","n","mean","var"])

        if len(s) <= 1:
            break

        fusion_faite = False
        for i in range(len(s) - 1):
            g1, g2 = s[i], s[i+1]
            n1, n2 = int(g1[i_n]), int(g2[i_n])
            m1, m2 = g1[i_m], g2[i_m]
            v1, v2 = g1[i_v], g2[i_v]

            ecart = abs(m2 - m1)
            sp = np.sqrt(((n1-1)*v1 + (n2-1)*v2) / (n1+n2-2))
            d = ecart / sp if sp > 0 else np.inf

            proche = (ecart < seuil_ecart_lgd) and (d < seuil_cohen_d)
            decision = "FUSION" if proche else "garder"
            print(f"[passe {passe}] {g1[i_g]} (m={m1:.2f}) vs {g2[i_g]} (m={m2:.2f}) "
                  f"| ecart={ecart:.3f} | d={d:.3f} -> {decision}")

            if proche:
                # fusionner g2 dans g1, puis on recommence (transitivite)
                work = work.with_columns(
                    pl.when(pl.col("_grp") == g2[i_g])
                      .then(pl.lit(g1[i_g]))
                      .otherwise(pl.col("_grp"))
                      .alias("_grp")
                )
                fusion_faite = True
                break   # recalcul des stats avant la fusion suivante

        if not fusion_faite:
            print(f"\nStabilite atteinte (passe {passe}) : plus aucune fusion.")
            break

    resultat = (
        work.group_by("_grp")
        .agg(pl.len().alias("n"), pl.col(lgd_col).mean().alias("lgd_moyenne"))
        .sort("lgd_moyenne")
    )
    return work, resultat
