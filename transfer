"""
main.py — orchestre la pipeline indicateur prix immobilier.

Usage
-----
Modifier les variables ci-dessous puis lancer :
    python main.py

Étapes disponibles : "base", "base_restreinte", "prix", "cartes", "lpi"
"""
import sys
import os
from datetime import datetime

PROJECT_DIR = os.path.dirname(os.path.abspath(__file__))
if PROJECT_DIR not in sys.path:
    sys.path.insert(0, PROJECT_DIR)

from config import get_config

# =============================================================================
# PARAMÈTRES — choisir ici avant de lancer
# =============================================================================

VARIANTE = "v2_restreint"       # Choisir: "v1_complet" | "v2_restreint"

ETAPES = ["prix", "cartes", "lpi"]   # Chosir parmi : "base" pour lancer la création de la base_complete_filtree, 
                                     # "base_restreinte" pour la création de la base_restreinte, 
                                     # "prix" pour la création des poids structurels et la création des tables de prix, 
                                     # "cartes" pour la création des cartes dees prix dans les grandes villes, 
                                     # "lpi" pour la comparaison avec le baromètre LPI/IAD
                                     # Tout mettre dans l'ordre pour avoir l'ensemble de la pipeline

SEGMENT = {
    "TYPE_BIEN":  "APT",        # Choisir: "APT" | "MAI" | "ENSEMBLE"
    "ANCIENNETE": "ANCIEN",     # Choisir: "NEUF" | "ANCIEN" | "ENSEMBLE"
}

# =============================================================================


def main():
    cfg = get_config(variante=VARIANTE, segment=SEGMENT)

    print("\n" + "="*80)
    print(f"  PIPELINE INDICATEUR PRIX — {cfg['description'].upper()}")
    print(f"  Variante    : {cfg['variante']}")
    print(f"  Étapes      : {', '.join(ETAPES)}")
    print(f"  Segment     : {cfg['segment_carte']['TYPE_BIEN']} × {cfg['segment_carte']['ANCIENNETE']}")
    print(f"  Sorties     : {cfg['output_dir']}")
    print("="*80 + "\n")

    start_global = datetime.now()

    if "base" in ETAPES:
        print("\n" + "─"*60)
        print("  ÉTAPE : base_work")
        print("─"*60)
        from pipeline.base_work import run as run_base
        run_base(cfg)

    if "base_restreinte" in ETAPES:
        print("\n" + "─"*60)
        print("  ÉTAPE : base_restreinte")
        print("─"*60)
        from pipeline.base_restreinte import run as run_restreinte
        run_restreinte(cfg)

    if "prix" in ETAPES:
        print("\n" + "─"*60)
        print("  ÉTAPE : calc_prix")
        print("─"*60)
        from pipeline.calc_prix import run as run_prix
        run_prix(cfg)

    if "cartes" in ETAPES:
        print("\n" + "─"*60)
        print("  ÉTAPE : cartes")
        print("─"*60)
        from pipeline.cartes import run as run_cartes
        run_cartes(cfg)

    if "lpi" in ETAPES:
        print("\n" + "─"*60)
        print("  ÉTAPE : comparaison_lpi")
        print("─"*60)
        from pipeline.comparaison_lpi import run as run_lpi
        run_lpi(cfg)

    print("\n" + "="*80)
    print(f"  Pipeline terminée en {datetime.now() - start_global}")
    print("="*80 + "\n")


if __name__ == "__main__":
    main()
