# --- Définition des constantes de colonnes ---
INSEE_COL = "Indice de prix (INSEE) - Base 2020"
CL_COL = "Indice de prix (CL)"

# 1. Calcul de la Corrélation (Méthode .apply() pour éviter le MultiIndex de colonnes)
def calculate_correlation_value(df):
    """Calcule la corrélation de Pearson entre CL et INSEE."""
    return df[CL_COL].corr(df[INSEE_COL])

correlation_mat = (
    merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
    .apply(calculate_correlation_value)
    .rename("Corrélation") # Renomme la série de résultat
    .reset_index()          # Transforme l'index (les groupes) en colonnes
)

# 2. Stats (Ecarts)
ecarts_stats = (
    merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])[["Dif"]]
    .agg(
        Ecart_Moyen=("Dif", "mean"),
        Ecart_type=("Dif", "std"),
        Ecart_min=("Dif", "min"),
        Ecart_max=("Dif", "max")
    )
    .reset_index()
)

# 3. RMSE
def rmse(series):
    return np.sqrt(np.mean(series**2))

rmse_results = (
    merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])[["Dif"]]
    .agg(RMSE=("Dif", rmse))
    .reset_index()
)

# 4. Fusion finale (fonctionne maintenant car toutes les sources ont des colonnes à un seul niveau)
comparaison = (
    ecarts_stats
    .merge(rmse_results, on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
    .merge(correlation_mat, on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
)

# Afficher les premières lignes du résultat final
print("\n--- Résultat Final de la Comparaison Statistique ---")
print(comparaison.head())
