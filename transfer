_CANON = {
    "cd_portfolio": "cd_portfolio",
    "duration":     "duration",
    "ead":          "MT_EAD_FLOOR",
    "tx_edf":       "tx_edf",
    "tx_lgd":       "tx_lgd",
}
def _normalize(
    lf: pl.LazyFrame,
    *,
    cd_portfolio: str,
    duration:     str,
    ead:          str,
    tx_edf:       str,
    tx_lgd:       str,
) -> pl.LazyFrame:
    """Renomme les colonnes utilisateur vers les noms canoniques internes."""
    rename = {
        cd_portfolio: _CANON["cd_portfolio"],
        duration:     _CANON["duration"],
        ead:          _CANON["ead"],
        tx_edf:       _CANON["tx_edf"],
        tx_lgd:       _CANON["tx_lgd"],
    }
    rename = {k: v for k, v in rename.items() if k != v}

    available = lf.collect_schema().names()
    missing   = [k for k in rename if k not in available]
    if missing:
        raise ValueError(
            f"Colonnes introuvables dans la base : {missing}. "
            f"Colonnes disponibles : {available}"
        )
    return lf.rename(rename) if rename else lf
