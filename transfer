import numpy as np

revolv = df_avec_pred.filter(
    (pl.col("CD_TYPE_AMORT") == 3)
    & pl.col("Type_Credit").is_in(["Crédits Revolving", "CAV & autres"])
)

# Hypothèse : NB = clip(R + δ, 1, 5) où δ est un "ajout réglementaire"
R = revolv["R"].to_numpy()
NB = revolv["NB_MATURITE_IRBA"].to_numpy()
T0 = revolv["T0"].to_numpy()

# Test 1 : NB = clip(R, 1, 5) ?
pred1 = np.clip(R, 1.0, 5.0)
err1  = NB - pred1
print(f"H1: NB = clip(R, 1, 5)         RMSE = {np.sqrt(np.mean(err1**2))*365.25:.1f} jours")
print(f"                                  %|err|<0.05 = {(np.abs(err1)<0.05).mean()*100:.1f}%")

# Test 2 : NB = 1 systematique
pred2 = np.ones_like(R)
err2  = NB - pred2
print(f"\nH2: NB = 1 (constante)         RMSE = {np.sqrt(np.mean(err2**2))*365.25:.1f} jours")
print(f"                                  %|err|<0.05 = {(np.abs(err2)<0.05).mean()*100:.1f}%")

# Test 3 : NB = clip(R + 1, 1, 5) ? (ajoute 1 an avant de clipper)
pred3 = np.clip(R + 1.0, 1.0, 5.0)
err3  = NB - pred3
print(f"\nH3: NB = clip(R + 1, 1, 5)     RMSE = {np.sqrt(np.mean(err3**2))*365.25:.1f} jours")
print(f"                                  %|err|<0.05 = {(np.abs(err3)<0.05).mean()*100:.1f}%")

# Stats : NB / 0.9993 (regarde si NB est multiple d'un certain seuil)
print(f"\nNB stats : médiane={np.median(NB):.4f}, q25={np.quantile(NB,0.25):.4f}, q75={np.quantile(NB,0.75):.4f}")
print(f"           min={np.min(NB):.4f}, max={np.max(NB):.4f}")
print(f"\n% lignes avec NB exactement entre 0.99 et 1.01 : {((NB>0.99)&(NB<1.01)).mean()*100:.1f}%")
print(f"% lignes avec NB > 5 : {(NB>5).mean()*100:.1f}%")
print(f"% lignes avec NB < 1 : {(NB<1).mean()*100:.1f}%")
print(f"% lignes avec 1 <= NB <= 5 : {((NB>=1)&(NB<=5)).mean()*100:.1f}%")
