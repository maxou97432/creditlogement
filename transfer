import re
import pickle

def lire_variables_modele(seg: dict) -> set[str]:
    """
    Charge le pickle du modèle (résultats statsmodels OLS) et extrait
    les noms de variables sources utilisées (sans le suffixe _groupN).
    """
    model_path = seg.get("Model_path")
    if not model_path:
        return set()

    with open(model_path, "rb") as f:
        results = pickle.load(f)

    params_index = getattr(results, "params", results).index

    pattern = re.compile(r"_group\d+.*$")
    vars_sources = {
        pattern.sub("", nom) for nom in params_index
        if nom != "Intercept"
    }
    return vars_sources


def check_variables_utilisees(
    cols_a_verifier: list[str],
    segments: list[dict],
) -> dict[str, dict[str, bool]]:
    """
    Pour chaque colonne à vérifier, indique si elle est utilisée
    dans le modèle de chaque type de segment (CURERATE / NONCURE).
    """
    resultats: dict[str, dict[str, bool]] = {col: {} for col in cols_a_verifier}

    vars_par_type: dict[str, set[str]] = {}
    for seg in segments:
        type_seg = seg["Type"]
        if type_seg not in vars_par_type:
            vars_par_type[type_seg] = lire_variables_modele(seg)

    for col in cols_a_verifier:
        for type_seg, vars_modele in vars_par_type.items():
            resultats[col][type_seg] = col in vars_modele

    return resultats


def deriver_column_actions(resultats: dict[str, dict[str, bool]]) -> dict[str, str]:
    """
    force si utilisée dans au moins un modèle, drop sinon.
    """
    actions = {}
    for col, usage in resultats.items():
        utilisee = any(usage.values())
        actions[col] = "force" if utilisee else "drop"
    return actions
