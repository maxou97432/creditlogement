sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    has_171  = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
    is_revolving = pl.col("Type_Credit").is_in(["Crédits Revolving", "CAV & autres"]),
)

# Cas 1 : has_171 ET Type_Credit = Revolving/CAV
g1 = sub3.filter(pl.col("has_171") & pl.col("is_revolving"))
# Cas 2 : has_171 ET pas Revolving/CAV  
g2 = sub3.filter(pl.col("has_171") & ~pl.col("is_revolving"))
# Cas 3 : pas has_171 ET Revolving/CAV
g3 = sub3.filter(~pl.col("has_171") & pl.col("is_revolving"))
# Cas 4 : ni l'un ni l'autre
g4 = sub3.filter(~pl.col("has_171") & ~pl.col("is_revolving"))

import numpy as np
for name, g in [("has_171 ET Revolving",     g1),
                ("has_171 SEUL (pas Revolv)", g2),
                ("Revolving SEUL (pas 171)", g3),
                ("ni l'un ni l'autre",        g4)]:
    if g.height == 0:
        print(f"{name}: n=0\n")
        continue
    R = g["R"].to_numpy()
    NB = g["NB_MATURITE_IRBA"].to_numpy()
    print(f"=== {name} — n = {g.height:,} ===")
    print(f"  R  median = {np.median(R):.4f}")
    print(f"  NB median = {np.median(NB):.4f}")
    print(f"  |NB-R|  < 0.01  : {(np.abs(NB-R)<0.01).mean()*100:.1f}%")
    print(f"  NB ≈ 1 (clip)   : {(np.abs(NB-1.0)<0.01).mean()*100:.1f}%")
    print(f"  NB ≈ R/2 progr. : {(np.abs(NB - R/2)<0.05).mean()*100:.1f}%")
    print()

# Top 5 lignes pour chaque cas, pour visualiser
for name, g in [("has_171 ET Revolving", g1), ("has_171 SEUL", g2), 
                ("Revolving SEUL", g3)]:
    if g.height > 0:
        print(f"--- {name} : 5 premières lignes ---")
        print(g.select(["R", "NB_MATURITE_IRBA", "Type_Credit", 
                         "CD_PORT_PRUDENTIEL"]).head(5))
        print()
