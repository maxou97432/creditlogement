# 2. Fonction de formatage du texte pour l'affichage (Ville, Prix, et Taux d'évolution)
def format_text_label(row):
    # Ligne 1 : Nom de la ville en MAJUSCULES
    ville = str(row['label']).upper() 
    
    # Ligne 2 : Prix
    prix_val = row['prix_mm_value']
    prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
    
    # Ligne 3 : Taux d'inflation 3M et 12M
    ti_3m = row["TAUX_INFL_3M"]
    ti_12m = row["TAUX_INFL_12M"]
    
    ti_3m_str = f"{ti_3m:+.1%}".replace('.', ',') if pd.notna(ti_3m) else ""
    ti_12m_str = f"{ti_12m:+.1%}".replace('.', ',') if pd.notna(ti_12m) else ""
    
    # Formatage de la ligne d'évolution
    evolution_line = ""
    if ti_3m_str or ti_12m_str:
        evolution_line = f"({ti_3m_str} / {ti_12m_str})".replace(" / ", "/").replace(" ()", "")
        # Nettoyage si un seul des deux taux est présent
        if evolution_line.startswith('(/'): evolution_line = evolution_line.replace('(/', '(')
        if evolution_line.endswith('/)'): evolution_line = evolution_line.replace('/)', ')')
        if evolution_line == '(/)': evolution_line = ''
    
    # Retourne les trois lignes
    return f"{ville}\n{prix}\n{evolution_line}"


