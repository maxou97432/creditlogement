# Agrégation en lazy, collect uniquement le résultat agrégé (~111k lignes, léger)
df_order_pl = (
    lf.select(
        (100 - pl.col("LGD_3ANS_finale")).alias(_SCORE),
        pl.col("LGD_3ANS_finale").alias(_TARGET),
    )
    .group_by(_SCORE)
    .agg(
        pl.len().alias(_WEIGHT),
        pl.col(_TARGET).mean().alias(_TARGET_MEAN),
    )
    .sort(_SCORE)
    .collect()          # 111 840 lignes -> rapide
)

# conversion de la petite table seulement (instantané sur 111k lignes)
df_order = df_order_pl.to_pandas()

cache = _build_weighted_jenks_cache(df_order, 20)
print("k_feasible =", _max_possible_k(cache))
print("dp[1, -1] fini ?", np.isfinite(cache["dp"][1, -1]))
print("dp[2, -1] fini ?", np.isfinite(cache["dp"][2, -1]))
