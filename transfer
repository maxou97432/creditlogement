_COULEURS_SOUS_MOTIF = {
    "constante": "#F4CCCC",
    "modalite_dominante_trop_concentree": "#FFF2CC",
    "trop_peu_valeurs_distinctes": "#D9EAD3",
    "variance_nulle": "#D0E0E3",
    "optimisation_echouee": "#EAD1DC",
    "absente": "#D9D9D9",
    "erreur_inattendue": "#F9CB9C",
    "autre": "#CFE2F3",
}


def exporter_variables_ignorees_excel(
    df_variables_ignorees: pd.DataFrame,
    chemin: Path,
    nom_feuille: str = "Variables_ignorees",
):
    """
    Exporte df_variables_ignorees (sortie de appliquer_decoupage_cart_optimise)
    dans un fichier Excel autonome, avec le formatage standard du pack
    (write_formatted_sheet) et un code couleur par sous_motif pour repérer
    rapidement les catégories d'échec en audit.
    """
    chemin = Path(chemin)
    chemin.parent.mkdir(parents=True, exist_ok=True)
    STARTCOL = 1

    with pd.ExcelWriter(chemin, engine="xlsxwriter") as writer:
        ws = write_formatted_sheet(
            writer, df_variables_ignorees, nom_feuille,
            tab_color="#CC4125", startcol=STARTCOL, index=False, largeur=22,
        )

        if "sous_motif" in df_variables_ignorees.columns:
            workbook = writer.book
            col_idx = STARTCOL + list(df_variables_ignorees.columns).index("sous_motif")
            col_lettre_motif = col_lettre(col_idx)
            derniere_ligne = len(df_variables_ignorees) + 1

            for motif, couleur in _COULEURS_SOUS_MOTIF.items():
                fmt = workbook.add_format({"bg_color": couleur})
                ws.conditional_format(
                    1, STARTCOL, derniere_ligne, STARTCOL + len(df_variables_ignorees.columns) - 1,
                    {
                        "type": "formula",
                        "criteria": f'=${col_lettre_motif}2="{motif}"',
                        "format": fmt,
                    },
                )

    print(f"Variables ignorées exportées : {chemin}")
    return chemin
