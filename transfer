def compute_stats_origine(
    base_df: pl.LazyFrame,
    jenks_col: str,
    lgd_col: str,
    obligor_col: str = 'ID_CLIENT',
) -> pl.LazyFrame:
    """Calcule le nombre d'observations, le min, le max et le LGD moyen annuel (avant fusion)."""
    return base_df.group_by([jenks_col, "year"]).agg([
        pl.col(obligor_col).n_unique().alias("nb_obligor"),
        pl.col(lgd_col).min().alias("Min LGD"),
        pl.col(lgd_col).max().alias("Max LGD"),
        pl.col(lgd_col).mean().alias("LGD moyenne annuelle\n(avant fusion)"),
    ])


def build_mapping_df(
    mapping: dict,
    jenks_col: str,
) -> pl.LazyFrame:
    """Crée la table contenant la correspondance ancienne classe -> classe après fusion."""
    return pl.DataFrame({
        jenks_col: list(mapping.keys()),
        "CHR après fusion": list(mapping.values()),
    }).lazy()


def build_tableau_detail(
    base_df: pl.LazyFrame,
    stats_origine: pl.LazyFrame,
    mapping_df: pl.LazyFrame,
    jenks_col: str,
    obligor_col: str,
) -> pl.LazyFrame:
    """Construit le tableau détaillé contenant les statistiques avant/après fusion ainsi que le LGD long terme.

    nb_obligor (après fusion) est recalculé directement sur base_df (grain facilité) après
    application du mapping, et non sommé depuis les nb_obligor par sous-classe Jenks --
    une somme sur-compte les obligors présents dans plusieurs sous-classes fusionnées
    ensemble la même année.
    """
    tableau = (
        stats_origine
        .join(mapping_df, on=jenks_col, how="left")
        .rename({jenks_col: "CHR avant fusion", "year": "Année"})
        .with_columns(pl.col("CHR après fusion").fill_null(pl.col("CHR avant fusion")))
        .with_columns((
            (pl.col("LGD moyenne annuelle\n(avant fusion)") * pl.col("nb_obligor")).sum()
            .over(["CHR après fusion", "Année"])
            / pl.col("nb_obligor").sum().over(["CHR après fusion", "Année"])
        ).alias("LGD moyenne annuelle\n(après fusion)"))
        .filter(pl.col("CHR avant fusion").is_not_null())
    )

    # nb_obligor correct : recalculé sur les données brutes après application du mapping,
    # pour éviter le double comptage des obligors à double appartenance entre sous-classes
    nb_obligor_apres_fusion = (
        base_df
        .join(mapping_df, on=jenks_col, how="left")
        .rename({jenks_col: "CHR avant fusion", "year": "Année"})
        .with_columns(pl.col("CHR après fusion").fill_null(pl.col("CHR avant fusion")))
        .group_by(["CHR après fusion", "Année"])
        .agg(pl.col(obligor_col).n_unique().alias("nb_obligor_apres_fusion"))
    )

    tableau = tableau.join(
        nb_obligor_apres_fusion, on=["CHR après fusion", "Année"], how="left"
    )

    lra_avant = (
        tableau.unique(subset=["CHR avant fusion", "Année"])
        .group_by("CHR avant fusion")
        .agg(pl.col("LGD moyenne annuelle\n(avant fusion)").mean().alias("LGD long terme par CHR\n(avant fusion)"))
    )
    lra_apres = (
        tableau.unique(subset=["CHR après fusion", "Année"])
        .group_by("CHR après fusion")
        .agg(pl.col("LGD moyenne annuelle\n(après fusion)").mean().alias("LGD long terme par CHR\n(après fusion)"))
    )

    return (
        tableau
        .join(lra_avant, on="CHR avant fusion", how="left")
        .join(lra_apres, on="CHR après fusion", how="left")
        .sort(["LGD long terme par CHR\n(avant fusion)", "Année"])
        .select([
            pl.all().exclude("CHR après fusion"),
            pl.col("CHR après fusion"),
        ])
    )


def build_tableau_recap(
    tableau_detail: pl.LazyFrame,
) -> pl.DataFrame:
    """Agrège les statistiques détaillées par classe après fusion et par année."""
    return (
        tableau_detail
        .select([
            pl.col("CHR après fusion"),
            pl.col("Année"),
            pl.col("nb_obligor_apres_fusion"),
            pl.col("Min LGD"),
            pl.col("Max LGD"),
            pl.col("LGD moyenne annuelle\n(après fusion)"),
            pl.col("LGD long terme par CHR\n(après fusion)"),
        ])
        .group_by(["CHR après fusion", "Année"])
        .agg([
            pl.col("nb_obligor_apres_fusion").first().alias("Effectifs (obligors)"),
            pl.col("Min LGD").min(),
            pl.col("Max LGD").max(),
            pl.col("LGD moyenne annuelle\n(après fusion)").first(),
            pl.col("LGD long terme par CHR\n(après fusion)").first(),
        ])
        .sort(["LGD long terme par CHR\n(après fusion)", "Année"])
    )
