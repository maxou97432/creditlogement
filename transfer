        criterion: str = "ovl",
        label_style: str = "ordinal",
        k_min: int = 1,
        lgd_gap_threshold: Optional[float] = None,
        ovl_threshold: Optional[float] = None,
    ) -> dict:
        """...docstring existante...

        ovl_threshold : seuil OVL pour la décision de fusion si criterion="ovl".
                        Si None, utilise self.seuil_calibre si disponible,
                        sinon retombe sur OVL_MODERE/OVL_STRICT par défaut.
        """
        if lgd_gap_threshold is None:
            lgd_gap_threshold = self.lgd_gap_threshold

        # résoudre le seuil OVL effectif
        seuil_ovl_effectif = ovl_threshold or self.seuil_calibre

        # construire la factory de tests avec le bon seuil OVL
        def _make_tests():
            if self._tests_factory is not None:
                if seuil_ovl_effectif is not None:
                    # remplacer OVLTest par une version avec le seuil calibré
                    tests = []
                    for t in self._tests_factory:
                        if isinstance(t, OVLTest):
                            tests.append(OVLTest(
                                method=t.method,
                                ovl_modere=seuil_ovl_effectif,
                                ovl_strict=min(seuil_ovl_effectif + 0.25, 1.0),
                            ))
                        else:
                            tests.append(t)
                    return tests
                return self._tests_factory
            # suite par défaut avec seuil calibré si disponible
            if seuil_ovl_effectif is not None:
                return [
                    WelchTest(), KruskalWallisTest(), ANOVATest(),
                    KolmogorovSmirnovTest(), CohensDTest(), HedgesGTest(),
                    WassersteinTest(),
                    OVLTest(
                        method="kde",
                        ovl_modere=seuil_ovl_effectif,
                        ovl_strict=min(seuil_ovl_effectif + 0.25, 1.0),
                    ),
                ]
            return _default_suite()

