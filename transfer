# 2. Fonction de formatage du texte pour l'affichage
def format_text_label(row):
    ville = str(row['label']).capitalize()
    
    prix_val = row['prix_mm_value']
    prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
    
    ti_3m = row["TAUX_INFL_3M"]
    ti_12m = row["TAUX_INFL_12M"]
    
    ti_3m_str = f"{ti_3m:+.1%}".replace('.', ',') if pd.notna(ti_3m) else ""
    ti_12m_str = f"{ti_12m:+.1%}".replace('.', ',') if pd.notna(ti_12m) else ""
    
    evolution_line = ""
    if ti_3m_str or ti_12m_str:
        evolution_line = f"({ti_3m_str} / {ti_12m_str})".replace(" / ", "").replace(" ()", "")
        
    return f"{ville}\n{prix}\n{evolution_line}"


