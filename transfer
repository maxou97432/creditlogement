import numpy as np

# Les vrais cas problématiques : NB_DURATION > 1 AND NB_MATURITE < 1 AND les deux diffèrent significativement
vrais_cas = pop[
    (pop["NB_MATURITE_IRBA"] < 1.0) &
    (pop["NB_DURATION_IRBA"] > 1.0 + 1e-6)
]
print(f"Vrais cas 'NB_DURATION > 1 malgré NB_MATURITE < 1' : {len(vrais_cas):,}")

# Distribution des NB_DURATION dans ces cas
print("\n>>> Distribution de NB_DURATION_IRBA dans ces cas")
print(vrais_cas["NB_DURATION_IRBA"].describe())

# Par code objet
print("\n>>> Par CD_OBJ_FIN")
print(vrais_cas.groupby("CD_OBJ_FIN").size().sort_values(ascending=False).head(10))

# Quelle colonne ≠ NB_MATURITE pourrait être la source ?
print("\n>>> Colonnes candidates (match exact avec NB_DURATION_IRBA, sans clip)")
for col in vrais_cas.select_dtypes(include=[np.number]).columns:
    if col in ["NB_DURATION_IRBA", "NB_MATURITE_IRBA"]:
        continue
    try:
        m_exact = ((vrais_cas[col] - vrais_cas["NB_DURATION_IRBA"]).abs() < 1e-3).sum()
        m_clip  = ((vrais_cas[col].clip(1.0, 5.0) - vrais_cas["NB_DURATION_IRBA"]).abs() < 1e-3).sum()
        if m_exact > 0.3 * len(vrais_cas) or m_clip > 0.3 * len(vrais_cas):
            print(f"  {col:40s}  exact={m_exact:,}  clip={m_clip:,}  / {len(vrais_cas):,}")
    except Exception:
        pass
