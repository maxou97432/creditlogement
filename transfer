display(df_calib)

# Identifier le seuil recommande
acceptables = df_calib.filter(pl.col("acceptable"))
if acceptables.height > 0:
    # Seuil le plus grand encore acceptable = max fusions sans depasser la limite
    seuil_retenu = acceptables["g_seuil"].max()
    n_retenu     = acceptables.filter(
        pl.col("g_seuil") == seuil_retenu)["n_classes"].item()
    delta_retenu = acceptables.filter(
        pl.col("g_seuil") == seuil_retenu)["delta_mae_pct"].item()
    print(f"\n✅ SEUIL RECOMMANDE : g < {seuil_retenu}")
    print(f"   → {n_retenu} classes finales")
    print(f"   → ΔMAE = {delta_retenu:+.3f}% < {SEUIL_MAE_PCT}%")
else:
    print(f"\n⚠️  Aucun seuil ne respecte ΔMAE < {SEUIL_MAE_PCT}%")
    print(f"   Envisagez d'assouplir SEUIL_MAE_PCT")

