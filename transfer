# -------------------------------------------------------------
# RÈGLE 2 : Formule de la Date de Maturité Bâloise (Reverse-Engineering)
# -------------------------------------------------------------
print("▶ RÈGLE 2 : Moteur de Date de centre de gravité (Duration Date)")
print("  (Application de l'équation : Expected Date = Arrêté + D * 365.25)")

srs_audit = srs_audit.with_columns(
    (pl.lit(DT_ARRT) + pl.col('NB_MATURITE_IRBA') * 365.25).alias('Expected_Duration_Date_Jours')
)
n_r2 = srs_audit.filter(
    (pl.col('Expected_Duration_Date_Jours') - pl.col('DT_ECHEANCE_FEM')).abs() <= 1.0
).height

print(f"  └─> Pour les {n_r1} contrats ci-dessus, Duration Date = Date de Maturité finale.")
