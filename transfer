# Refaire le test en excluant les colonnes d'identifiants
id_cols = {c for c in base.columns if any(kw in c.upper() 
           for kw in ["SK_", "ID_", "NO_", "NUM_", "REF_", "CD_DOS", "NB_DOS"])}

print("Colonnes ID exclues :", len(id_cols))

# Parmi les résultats, montrer uniquement les non-IDs avec score > 1%
resultats_utiles = [(col, desc, score) for col, desc, score in resultats
                    if col not in id_cols and score > 0.01]

print("\n=== RÉSULTATS UTILES (hors IDs) ===")
for col, desc, score in sorted(resultats_utiles, key=lambda x: -x[2]):
    print(f"  {score:.1%}  {col}: {desc}")
