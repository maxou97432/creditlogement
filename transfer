# 3. Tester la règle finale
PORTFOLIOS_BASCULE = ["QRE", "CORP"]   # ajuster selon (1)

def m_bale_progressif(R, y, freq=12):
    n = max(1, int(round(R * freq)))
    if abs(y) < 1e-12:
        return (n + 1) / 2 / freq
    r = y / freq
    k = np.arange(1, n + 1)
    w = (1 + r) ** (k - 1)
    return float(np.sum(k * w) / np.sum(w)) / freq

def m_srs_type3(R, cd_prud, y=0.0497):
    if cd_prud in PORTFOLIOS_BASCULE:
        return R
    if R <= 1.0:
        return R
    return m_bale_progressif(R, y)

