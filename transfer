import polars as pl
import numpy as np
from jenks_calculator import _build_weighted_jenks_cache, _max_possible_k

# Noms internes (constantes du module, écrites en clair)
SCORE_INTERNE       = "__score__"
TARGET_INTERNE      = "__target__"
WEIGHT_INTERNE      = "__weight__"
TARGET_MEAN_INTERNE = "__target_mean__"

# Table préparée exactement comme make_df_algo la produit
df_order = (
    lf.select(
        (100 - pl.col("LGD_3ANS_finale")).alias(SCORE_INTERNE),
        pl.col("LGD_3ANS_finale").alias(TARGET_INTERNE),
    )
    .group_by(SCORE_INTERNE)
    .agg(
        pl.len().alias(WEIGHT_INTERNE),
        pl.col(TARGET_INTERNE).mean().alias(TARGET_MEAN_INTERNE),
    )
    .sort(SCORE_INTERNE)
    .collect()
    .to_pandas()
)

