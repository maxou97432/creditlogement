# 3. Augmenter le poids par défaut pour simuler l'aspect 'Bold' du logo CL
# Cela affectera la plupart des textes, y compris les labels.
plt.rcParams['font.weight'] = 'medium' 

# 4. Définir explicitement les titres en gras (Black/Heavy)
