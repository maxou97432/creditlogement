def eta_squared(values: np.ndarray, labels: np.ndarray) -> float:
    """
    eta² : fraction de variance de la LGD expliquée par les classes.
    SS_inter / SS_total. Borné [0,1], INSENSIBLE à n.
    """
    grand_mean = values.mean()
    ss_total = ((values - grand_mean) ** 2).sum()
    if ss_total == 0:
        return 0.0
    ss_inter = 0.0
    for lab in np.unique(labels):
        grp = values[labels == lab]
        ss_inter += len(grp) * (grp.mean() - grand_mean) ** 2
    return float(ss_inter / ss_total)

def epsilon_squared_kw(values: np.ndarray, labels: np.ndarray) -> float:
    """
    epsilon² basé sur Kruskal-Wallis (version rangs, robuste aux formes).
    eps² = (H - k + 1) / (n - k). Borné [0,1], INSENSIBLE à n.
    """
    groups = [values[labels == lab] for lab in np.unique(labels)]
    k = len(groups)
    n = len(values)
    if k < 2 or n <= k:
        return 0.0
    H, _ = sp_stats.kruskal(*groups)
    return float(max(0.0, (H - k + 1) / (n - k)))


