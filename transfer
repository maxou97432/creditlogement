# comparateur léger, mêmes données, juste pour solve()
cmp_light = FusionComparator(
    df,
    class_col="CHR_apres_fusion",
    lgd_col="lgd_obligor",
    obligor_col="ID_CLIENT",
    pairs="adjacent",
    tests=[
        OVLPermutationTest(
            n_boot=30,        # juste pour la décision bool
            n_perm=30,        # idem
            n_subsample=50,   # idem
            min_ovl=0.5,
            random_state=42,
        ),
    ],
)

sol = cmp_light.solve(criterion="OVL-Perm", label_style="glouton")
print(f"{sol['n_initial']} -> {sol['n_final']} classes")
print(sol["log"])
