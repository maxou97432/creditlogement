# ÉTAPE 1 : Comparaison MATURITE capret (duration) vs NB_MATURITE_IRBA (srs)
# ══════════════════════════════════════════════════════════════════

etape1 = srs_X_capret.with_columns(
    (pl.col('duration') - pl.col('NB_MATURITE_IRBA')).alias('Ecart_Maturite')
)

n_match = etape1.filter(pl.col('Ecart_Maturite').abs() < 0.01).height
print(f"Match : {n_match}/{etape1.height} ({n_match/etape1.height:.1%})")

print("\nStats de l'écart :")
print(etape1['Ecart_Maturite'].describe())

print("\nDivergences par Type_Credit :")
print(
    etape1.filter(pl.col('Ecart_Maturite').abs() >= 0.01)
    .group_by('Type_Credit')
    .agg(
        pl.len().alias('nb'),
        pl.col('Ecart_Maturite').mean().round(3).alias('Ecart_moyen'),
        pl.col('Ecart_Maturite').min().round(3).alias('Ecart_min'),
        pl.col('Ecart_Maturite').max().round(3).alias('Ecart_max')
    ).sort('nb', descending=True)
)
