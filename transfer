    print("\nTests:", dict(Counter(h["test"] for h in history)),
          " | Codes:", dict(Counter(h["code"] for h in history)))
else:
    print("\nAucune fusion.")
print(f"\nTaux de réduction : {100*(1-n1/n0):.1f} %")
