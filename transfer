# Convertir DT_ECHEANCE_AUTO_MOY de YYYYMMDD entier → date réelle
capret_test = capret.with_columns(
    pl.col('DT_ECHEANCE_AUTO_MOY')
    .cast(pl.Utf8)
    .str.to_date('%Y%m%d')
    .alias('DT_DURATION_DATE')
).with_columns(
    (
        (pl.col('DT_DURATION_DATE') - pl.lit(date(2025, 6, 30))).dt.total_days() / 365.25
    ).alias('Duration_depuis_AUTO_MOY')
)

# Comparer avec NB_MATURITE_IRBA (srs) sur la base fusionnée
print("Match Duration_AUTO_MOY vs NB_MATURITE_IRBA :")
compare = srs_X_capret.join(
    capret_test.select(['ta_cle', 'Duration_depuis_AUTO_MOY']),
    on='ta_cle', how='left'
)
n = compare.filter(
    (pl.col('Duration_depuis_AUTO_MOY') - pl.col('NB_MATURITE_IRBA')).abs() < 0.01
).height
print(f"{n}/{compare.height} ({n/compare.height:.1%})")
