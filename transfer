# =============================================================================
# 4. COMPARAISON LPI-IAD (STATS)
# =============================================================================
print("\n--- Comparaison LPI-IAD ---")

try:
    # 1. Chargement V1 (Standard) - On vérifie s'il est déjà chargé
    if 'df_v1' not in locals() or df_v1 is None:
        df_v1 = load_cl_results(PATH_RESULTATS_V1, "V1")
    
    # 2. Chargement LPI
    lpi_df = pd.read_excel(PATH_LPI, sheet_name="V2", skiprows=2)
    lpi_df = lpi_df.iloc[:, :3] # Garde les 3 premières colonnes (Date, Ville, Prix)
    lpi_df.columns = ["Periode", "VAL_MAILLE_GEO", "Prix_LPI"]
    
    # Nettoyage LPI
    lpi_df["Periode"] = pd.to_datetime(lpi_df["Periode"], errors='coerce')
    lpi_df["VAL_MAILLE_GEO"] = lpi_df["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
    lpi_df["Prix_LPI"] = pd.to_numeric(lpi_df["Prix_LPI"], errors='coerce')
    
    # DEBUG : Afficher un exemple pour vérifier le format
    print(f"   > LPI chargé : {len(lpi_df)} lignes.")
    print(f"   > Exemple Ville LPI : {lpi_df['VAL_MAILLE_GEO'].iloc[0]}")
    print(f"   > Exemple Date LPI  : {lpi_df['Periode'].iloc[0]}")

    # 3. Fusion
    if df_v1 is not None and df_v2 is not None:
        # On ne garde que les données 'Ville' et '12 mois'
        v1_city = df_v1[(df_v1["MAILLE_TYPE"] == "CITY") & (df_v1["DIC_NAME"] == "prix_m2_12m")].copy()
        v2_city = df_v2[(df_v2["MAILLE_TYPE"] == "CITY") & (df_v2["DIC_NAME"] == "prix_m2_12m")].copy()
        
        # Nettoyage avant fusion (sécurité)
        v1_city["VAL_MAILLE_GEO"] = v1_city["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
        v2_city["VAL_MAILLE_GEO"] = v2_city["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
        v1_city["Periode"] = pd.to_datetime(v1_city["Periode"])
        v2_city["Periode"] = pd.to_datetime(v2_city["Periode"])

        # Merge V1 + V2
        cols_v2_merge = ["VAL_MAILLE_GEO", "Periode", "CD_TYPE_BIEN", "Prix_M2_V2"]
        merge_cl = pd.merge(v1_city, v2_city[cols_v2_merge], 
                            on=["VAL_MAILLE_GEO", "Periode", "CD_TYPE_BIEN"], how="inner")
        
        print(f"   > Fusion V1+V2 : {len(merge_cl)} lignes communes.")

        # Merge avec LPI
        final_comp = pd.merge(merge_cl, lpi_df, on=["VAL_MAILLE_GEO", "Periode"], how="inner")
        print(f"   > Fusion Totale (avec LPI) : {len(final_comp)} lignes communes.")
        
        if final_comp.empty:
            print("   /!\\ ATTENTION : Aucune correspondance trouvée avec LPI.")
            print("   -> Vérifiez les noms de villes (ex: ST ETIENNE vs SAINT-ETIENNE) ou les formats de dates.")
        else:
            # 4. Calcul Stats (MÉTHODE ROBUSTE SANS APPLY)
            stats_list = []
            grouped = final_comp.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
            
            for (geo, type_b), group in grouped:
                if len(group) == 0: continue
                
                # Calcul RMSE
                rmse_v1 = np.sqrt(((group['Prix_M2_V1'] - group['Prix_LPI'])**2).mean())
                rmse_v2 = np.sqrt(((group['Prix_M2_V2'] - group['Prix_LPI'])**2).mean())
                
                # Calcul Corrélation (nécessite au moins 2 points)
                if len(group) > 1:
                    corr_v1 = group['Prix_M2_V1'].corr(group['Prix_LPI'])
                    corr_v2 = group['Prix_M2_V2'].corr(group['Prix_LPI'])
                else:
                    corr_v1, corr_v2 = np.nan, np.nan
                
                stats_list.append({
                    "VAL_MAILLE_GEO": geo,
                    "CD_TYPE_BIEN": type_b,
                    "RMSE_V1": rmse_v1,
                    "RMSE_V2": rmse_v2,
                    "Correlation_V1": corr_v1,
                    "Correlation_V2": corr_v2
                })
            
            if stats_list:
                # Création du DataFrame final
                stats = pd.DataFrame(stats_list)
                
                # Calcul du gain (Positif = V2 meilleure)
                stats["Gain_RMSE"] = stats["RMSE_V1"] - stats["RMSE_V2"]
                
                print("\nTOP 10 AMÉLIORATIONS (RMSE V2 < V1) :")
                print(stats.sort_values("Gain_RMSE", ascending=False).head(10)[["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Gain_RMSE", "RMSE_V1", "RMSE_V2"]])
                
                outfile = os.path.join(params.CONFIG['output_dir'], "Comparatif_LPI_Stats.csv")
                stats.to_csv(outfile, index=False)
                print(f"Stats sauvegardées : {outfile}")
            else:
                print("   /!\\ Pas assez de données pour calculer les stats.")

except Exception as e:
    print(f"Erreur lors de la comparaison LPI : {e}")
    # Affiche plus de détails pour le debug
    import traceback
    traceback.print_exc()
