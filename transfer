def m_bale_progressif_v2(R, y, freq=12):
    """Variante : floor au lieu de round, et plancher n=1."""
    n = max(1, int(np.floor(R * freq + 0.5)))  # arrondi standard
    if abs(y) < 1e-12:
        return (n + 1) / 2 / freq
    r = y / freq
    k = np.arange(1, n + 1)
    w = (1 + r) ** (k - 1)
    return float(np.sum(k * w) / np.sum(w)) / freq

def m_bale_progressif_continu(R, y):
    """Version continue : intégrale au lieu de somme."""
    if R < 1e-6:
        return R
    if abs(y) < 1e-6:
        return R / 2
    # M = sum(k * (1+r)^(k-1)) / sum((1+r)^(k-1)) en continu sur [0, R]
    # avec poids w(t) = (1+y)^t (exponentiel) et yield annuel y
    # = [R*(1+y)^R / ln(1+y) - ((1+y)^R - 1) / ln(1+y)^2] / [((1+y)^R - 1) / ln(1+y)]
    L = np.log(1 + y)
    num = R * (1+y)**R / L - ((1+y)**R - 1) / L**2
    den = ((1+y)**R - 1) / L
    return num / den

