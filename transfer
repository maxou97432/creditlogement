from pathlib import Path
from typing import Any, Dict, List, Optional
import yaml

ROOT = Path(__file__).resolve().parent.parent

# Clés métier obligatoires : absence = erreur, pas de valeur par défaut silencieuse.
CLES_METIER_REQUISES = [
    "target", "lgd_observed", "lgd_calc", "lgd", "ead", "obligor", "facility",
    "date_defaut", "date_photo", "statut", "clos",
    "segment_col", "jenks_submodel", "chr_inversion", "chr_heterogeneite",
]

CLES_CHEMINS_REQUISES = [
    "input_dir", "output_dir", "notebooks_dir", "sortie_nb", "segmentation_file",
]


def load_config(name: str = "config.yaml") -> Dict[str, Any]:
    """
    Charge config.yaml, valide les clés obligatoires, résout les chemins en Path
    absolus et résout la chaîne entrée/sortie de chaque notebook.

    Cette fonction est l'unique point d'entrée de la configuration : elle doit
    être utilisée aussi bien par l'orchestrateur que par les notebooks lancés
    en standalone, pour que les deux modes soient strictement identiques.
    """
    cfg_path = ROOT / name
    if not cfg_path.exists():
        raise FileNotFoundError(f"Fichier de configuration introuvable : {cfg_path}")

    with open(cfg_path, encoding="utf-8") as f:
        config: Dict[str, Any] = yaml.safe_load(f)

    _valider_cles(config)
    _resoudre_chemins(config)
    _resoudre_chaine_notebooks(config)

    return config


# --------------------------------------------------------------------------- #
# Validation
# --------------------------------------------------------------------------- #
def _valider_cles(config: Dict[str, Any]) -> None:
    manquantes = [k for k in CLES_CHEMINS_REQUISES + CLES_METIER_REQUISES
                  if k not in config]
    if manquantes:
        raise KeyError(f"Clés absentes de config.yaml : {manquantes}")

    if "pipeline" not in config or "notebooks" not in config["pipeline"]:
        raise KeyError("Section 'pipeline.notebooks' absente de config.yaml")

    if "execution" not in config:
        raise KeyError("Section 'execution' absente de config.yaml")

    noms = [nb["name"] for nb in config["pipeline"]["notebooks"]]
    doublons = {n for n in noms if noms.count(n) > 1}
    if doublons:
        raise ValueError(f"Notebooks dupliqués dans config.yaml : {doublons}")


# --------------------------------------------------------------------------- #
# Résolution des chemins
# --------------------------------------------------------------------------- #
def _resoudre_chemins(config: Dict[str, Any]) -> None:
    config["root"] = ROOT
    config["input_dir"] = ROOT / config["input_dir"]
    config["output_dir"] = ROOT / config["output_dir"]
    config["notebooks_dir"] = ROOT / config["notebooks_dir"]

    config["intermediate_dir"] = config["output_dir"] / config["sortie_nb"]
    config["report_dir"] = config["output_dir"] / config.get("report_dir", "reports")
    config["segmentation_path"] = config["input_dir"] / config["segmentation_file"]
    config["working_path"] = config["output_dir"]

    for p in (config["input_dir"], config["output_dir"],
              config["intermediate_dir"], config["report_dir"]):
        p.mkdir(parents=True, exist_ok=True)


# --------------------------------------------------------------------------- #
# Résolution de la chaîne entrée / sortie
# --------------------------------------------------------------------------- #
def _resoudre_chaine_notebooks(config: Dict[str, Any]) -> None:
    """
    Transforme les références symboliques ('rassemblement_file') en chemins
    absolus, ajoutés sous 'input_path' / 'output_path' pour chaque notebook.
    Les clés symboliques d'origine sont conservées pour la traçabilité.
    """
    dossier = config["intermediate_dir"]

    for nb in config["pipeline"]["notebooks"]:
        for role in ("input_file", "output_file"):
            cle = nb.get(role)
            champ = role.replace("_file", "_path")

            if cle is None:
                nb[champ] = None
                continue

            if cle not in config:
                raise KeyError(
                    f"Notebook '{nb['name']}' : '{role}: {cle}' ne correspond à "
                    f"aucune clé de config.yaml (section fichiers intermédiaires)."
                )
            nb[champ] = dossier / config[cle]


# --------------------------------------------------------------------------- #
# Accès depuis un notebook
# --------------------------------------------------------------------------- #
def get_notebook_io(config: Dict[str, Any], nom_notebook: str):
    """
    Retourne (chemin_entree, chemin_sortie) pour un notebook donné.
    À appeler en tête de chaque notebook métier.
    """
    for nb in config["pipeline"]["notebooks"]:
        if nb["name"] == nom_notebook:
            entree = nb.get("input_path")
            sortie = nb.get("output_path")
            return (Path(entree) if entree else None,
                    Path(sortie) if sortie else None)

    connus = [nb["name"] for nb in config["pipeline"]["notebooks"]]
    raise KeyError(f"Notebook '{nom_notebook}' absent de config.yaml. Connus : {connus}")


def serialiser_pour_papermill(config: Dict[str, Any]) -> Dict[str, Any]:
    """
    Papermill sérialise les paramètres en JSON : les objets Path doivent être
    convertis en str avant injection, sinon l'exécution échoue.
    """
    def conv(o):
        if isinstance(o, Path):
            return str(o)
        if isinstance(o, dict):
            return {k: conv(v) for k, v in o.items()}
        if isinstance(o, list):
            return [conv(v) for v in o]
        return o
    return conv(config)
