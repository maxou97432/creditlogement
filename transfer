import numpy as np
from scipy.optimize import minimize_scalar

# Population
sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    has_171     = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
    seg_special = pl.col("segment_trg").is_in([44, 73, 74]),
)
sub_pur = sub3.filter(
    (pl.col("R") > 1.0) & (~pl.col("has_171")) & (~pl.col("seg_special"))
)
R_arr  = sub_pur["R"].to_numpy()
NB_arr = sub_pur["NB_MATURITE_IRBA"].to_numpy()

def predict_with_n(R_arr, y, n_func):
    """n_func(R) renvoie le nombre de périodes."""
    r = y / 12
    n_arr = np.array([n_func(R) for R in R_arr])
    n_arr = np.maximum(1, n_arr)
    preds = np.empty_like(R_arr)
    for n_unique in np.unique(n_arr):
        mask = n_arr == n_unique
        k = np.arange(1, n_unique + 1)
        w = (1 + r) ** (k - 1)
        preds[mask] = np.sum(k * w) / np.sum(w) / 12
    return preds

variantes_n = {
    "round(R*12)":              lambda R: int(round(R * 12)),
    "floor(R*12)":              lambda R: int(np.floor(R * 12)),
    "ceil(R*12)":               lambda R: int(np.ceil(R * 12)),
    "round(R*12) + 1":          lambda R: int(round(R * 12)) + 1,
    "round((DT_ECH-DT_ARRT)/30)": lambda R: int(round(R * 365.25 / 30)),
    "round((DT_ECH-DT_ARRT)/30.4375)": lambda R: int(round(R * 365.25 / 30.4375)),
}

print(f"{'Variante n':<35} {'y_opt':>10} {'RMSE':>10} {'jours':>8}")
print("=" * 65)
for name, n_func in variantes_n.items():
    def loss(y, nf=n_func):
        return np.mean((predict_with_n(R_arr, y, nf) - NB_arr)**2)
    res = minimize_scalar(loss, bounds=(0.001, 0.20),
                          method='bounded', options={'xatol': 1e-7})
    rmse = np.sqrt(res.fun)
    print(f"{name:<35} {res.x*100:>9.4f}% {rmse:>10.5f} {rmse*365.25:>8.2f}")

# Et tester par tranche de R avec la meilleure variante
print(f"\n--- Yield optimal par tranche, n = round(R*12) + 1 ---")
print(f"{'tranche':<14} {'n':>8} {'y_opt':>10} {'RMSE jours':>12}")
for lo, hi in [(1,3), (3,5), (5,10), (10,15), (15,20), (20,30)]:
    mask = (R_arr >= lo) & (R_arr < hi)
    if mask.sum() < 50: continue
    R_s, NB_s = R_arr[mask], NB_arr[mask]
    nf = lambda R: int(round(R * 12)) + 1
    def loss_l(y):
        return np.mean((predict_with_n(R_s, y, nf) - NB_s)**2)
    res = minimize_scalar(loss_l, bounds=(0.001, 0.20),
                          method='bounded', options={'xatol': 1e-7})
    print(f"[{lo:>2}, {hi:>2}[      {mask.sum():>8} {res.x*100:>9.4f}% "
          f"{np.sqrt(res.fun)*365.25:>11.2f}")
