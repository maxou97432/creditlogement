# =====================================================================
# DIAGNOSTIC : obligors avec plusieurs facilités par date de défaut
# =====================================================================

# Colonnes à adapter si nécessaire
OBLIGOR_COL = config['Obligor']    # identifiant obligor
DATE_DEF_COL = "datdef"            # date de défaut
FACILITE_COL = config['Facilite']  # identifiant facilité (à adapter)

diagnostic_multi_facilites = (
    lf_LGD
    .filter(pl.col(DATE_DEF_COL).is_not_null())    # exclure les non-défauts si besoin
    .group_by([OBLIGOR_COL, DATE_DEF_COL])
    .agg([
        pl.len().alias("nb_facilites"),
        pl.col(FACILITE_COL).n_unique().alias("nb_facilites_distinctes"),
    ])
    .filter(pl.col("nb_facilites") > 1)            # garder uniquement les multi-facilités
    .sort([OBLIGOR_COL, DATE_DEF_COL])
    .collect()
)

# Résumé global
n_obligors_multi = diagnostic_multi_facilites[OBLIGOR_COL].n_unique()
n_lignes_multi   = diagnostic_multi_facilites.height
total_obligors   = lf_LGD.select(pl.col(OBLIGOR_COL).n_unique()).collect().item()

print("=" * 70)
print("DIAGNOSTIC — Obligors avec plusieurs facilités par date de défaut")
print("=" * 70)
print(f"Obligors concernés     : {n_obligors_multi:>8,} / {total_obligors:,}")
print(f"Paires (obligor, date) : {n_lignes_multi:>8,}")
print()

# Distribution du nombre de facilités
print("Distribution du nombre de facilités par (obligor, date) :")
print(
    diagnostic_multi_facilites
    .group_by("nb_facilites")
    .agg(pl.len().alias("nb_paires"))
    .sort("nb_facilites")
)

# Détail des cas (optionnel, premières lignes)
print("\nDétail (premières lignes) :")
with pl.Config(tbl_rows=20, tbl_cols=-1):
    print(diagnostic_multi_facilites.head(20))
