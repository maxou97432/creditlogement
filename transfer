sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    is_bascule = (pl.col("NB_MATURITE_IRBA") - pl.col("R")).abs() < 0.01,
    has_171    = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
)
print("=== Croisement has_171 × is_bascule ===")
print(sub3.group_by("has_171").agg(
    n           = pl.len(),
    pct_bascule = pl.col("is_bascule").mean() * 100,
    R_min       = pl.col("R").min(),
    R_max       = pl.col("R").max(),
))

print("\n=== Croisement has_171 × R_bin ===")
print(sub3.with_columns(
    R_bin = pl.when(pl.col("R") <= 1.0).then(pl.lit("R<=1")).otherwise(pl.lit("R>1"))
).group_by(["has_171", "R_bin"]).agg(
    n           = pl.len(),
    pct_bascule = pl.col("is_bascule").mean() * 100,
).sort(["has_171", "R_bin"]))
