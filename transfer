MAPPING_TYPE_VERS_CLE_SORTIE = {"CURERATE": "curerate", "NONCURE": "noncure"}

for t, lf in lf_by_type.items():
    if t not in MAPPING_TYPE_VERS_CLE_SORTIE:
        raise ValueError(f"Type '{t}' inattendu, non prévu dans CHEMIN_SORTIE : {list(CHEMIN_SORTIE)}")
    sous_cle = MAPPING_TYPE_VERS_CLE_SORTIE[t]
    lf.collect().write_parquet(str(CHEMIN_SORTIE[sous_cle]))
    print(f"{t} sauvegardé → {CHEMIN_SORTIE[sous_cle].name}")
