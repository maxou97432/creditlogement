print(f"RMSE Prophet Optimisé : {best_rmse:.4f}")


# ==============================================================================
# 2. XGBOOST RÉCURSIF (Correction du Lag 4)
# ==============================================================================

# A. Préparation (Différenciation)
df_ml = pd.DataFrame(ts_ecart.copy())
df_ml.columns = ['y']
df_ml['y_diff'] = df_ml['y'].diff()

# B. Feature Engineering
# On a besoin d'accéder jusqu'à t-4, donc on crée les colonnes pour l'entrainement
for i in range(1, 5): # Créer lag_1, lag_2, lag_3, lag_4
    df_ml[f'lag_{i}'] = df_ml['y_diff'].shift(i)

df_ml = df_ml.dropna()

# C. Split Train/Test
train_size = len(df_ml) - n_test

# Sélection des features UTILES pour le modèle (on peut ignorer lag_3 ici si on veut)
features_cols = ['lag_1', 'lag_2', 'lag_4']
X = df_ml[features_cols]
y = df_ml['y_diff']

X_train, y_train = X.iloc[:train_size], y.iloc[:train_size]
X_test, y_test = X.iloc[train_size:], y.iloc[train_size:]

# D. Entraînement (RandomizedSearch)
param_dist = {
    'n_estimators': randint(100, 1000), # Réduit pour aller plus vite
    'learning_rate': uniform(0.01, 0.2),
    'max_depth': randint(2, 6),         # Profondeur réduite pour éviter l'overfitting sur petites séries
    'subsample': uniform(0.6, 0.4),
    'colsample_bytree': uniform(0.6, 0.4)
}

base_model = XGBRegressor(objective='reg:squarederror', random_state=42, n_jobs=-1)

rs = RandomizedSearchCV(
    estimator=base_model,
    param_distributions=param_dist,
    n_iter=20, # Réduit pour le test
    scoring='neg_root_mean_squared_error',
    cv=TimeSeriesSplit(n_splits=3),
    verbose=0,
    n_jobs=-1,
    random_state=42
)

rs.fit(X_train, y_train)
best_xgb = rs.best_estimator_

# E. PRÉVISION RÉCURSIVE (Correction du Buffer)
# On récupère les 4 dernières valeurs réelles connues du Train pour initialiser le buffer
# Buffer = [y_diff_t-1, y_diff_t-2, y_diff_t-3, y_diff_t-4]
# Note : df_ml contient tout l'historique jusqu'à la fin, il faut prendre juste avant le test
last_train_idx = train_size - 1
history_buffer = [
    df_ml['y_diff'].iloc[last_train_idx],     # lag_1
    df_ml['y_diff'].iloc[last_train_idx - 1], # lag_2
    df_ml['y_diff'].iloc[last_train_idx - 2], # lag_3 (Utile pour le futur lag_4 !)
    df_ml['y_diff'].iloc[last_train_idx - 3]  # lag_4
]

predictions_diff = []

for i in range(n_test):
    # 1. Construire le vecteur X pour la prédiction (On prend lag 1, 2 et 4)
    # history_buffer[0] est lag_1, history_buffer[1] est lag_2, history_buffer[3] est lag_4
    current_features = np.array([[
        history_buffer[0], 
        history_buffer[1], 
        history_buffer[3]
    ]])
    
    # 2. Prédire
    pred_diff = best_xgb.predict(current_features)[0]
    predictions_diff.append(pred_diff)
    
    # 3. Mettre à jour le buffer (Glissement)
    # On insère la nouvelle prédiction au début (nouveau lag_1)
    # On supprime le dernier élément (ancien lag_4 qui sort de la fenêtre)
    history_buffer.insert(0, pred_diff)
    history_buffer.pop() 

# F. Reconstruction (Diff -> Niveau)
last_real_value = train.iloc[-1]
pred_xgb_levels = []
current_val = last_real_value

for diff in predictions_diff:
    current_val = current_val + diff
    pred_xgb_levels.append(current_val)

rmse_xgb_recursive = np.sqrt(mean_squared_error(test, pred_xgb_levels))

print(f"RMSE XGBoost (Récursif + Diff) : {rmse_xgb_recursive:.4f}")
