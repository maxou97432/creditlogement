from scipy.stats import wasserstein_distance
import numpy as np

def cohen_d(arr1, arr2):
    """Cohen's d : écart standardisé (indépendant de n)"""
    n1, n2 = len(arr1), len(arr2)
    s1, s2 = arr1.std(ddof=1), arr2.std(ddof=1)
    sp = np.sqrt(((n1-1)*s1**2 + (n2-1)*s2**2) / (n1+n2-2))
    return (arr2.mean() - arr1.mean()) / sp if sp > 0 else 0

def overlap(arr1, arr2, n_bins=50):
    """OVL : pourcentage de recouvrement (indépendant de n)"""
    lo = min(arr1.min(), arr2.min())
    hi = max(arr1.max(), arr2.max())
    bins = np.linspace(lo, hi, n_bins)
    p, _ = np.histogram(arr1, bins=bins)
    q, _ = np.histogram(arr2, bins=bins)
    p, q = p / p.sum(), q / q.sum()
    return float(np.minimum(p, q).sum())

def meilleur_candidat_fusion_robuste(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Fusionne la paire adjacente la plus PROCHE qui passe TOUS les critères :
    1. gap < DELTA_LGD (matérialité)
    2. |Cohen's d| < D_MAX (petit effet)
    3. OVL > OVL_MIN (recouvrement)
    4. Wasserstein < W_MAX (distributions proches)
    
    Tous les critères doivent passer (AND logic).
    Aucun ne dépend de n → robuste à grand échantillon.
    """
    ordre_global = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(pl.col("mean_LGD_year").mean().alias("mean_LGD_global"))
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))
        .sort(["seg", "mean_LGD_global"])
        .collect()
    )

    obligors = {}
    base = df.select([jenks_col, lgd_col]).collect()
    for cls in base.select(jenks_col).unique().to_series():
        obligors[cls] = base.filter(pl.col(jenks_col) == cls).get_column(lgd_col).to_numpy()

    paires = []
    for i in range(len(ordre_global) - 1):
        cls_1 = ordre_global[jenks_col][i]
        seg_1 = cls_1.split("_")[0]
        cls_2 = None
        for j in range(i + 1, len(ordre_global)):
            if ordre_global[jenks_col][j].split("_")[0] == seg_1:
                cls_2 = ordre_global[jenks_col][j]
                break
        if cls_2 is None:
            continue

        arr1, arr2 = obligors[cls_1], obligors[cls_2]
        gap = abs(arr2.mean() - arr1.mean())
        d = cohen_d(arr1, arr2)
        o = overlap(arr1, arr2)
        w = wasserstein_distance(arr1, arr2)

        # TOUS les critères doivent passer
        if (gap < DELTA_LGD) and (abs(d) < D_MAX) and (o > OVL_MIN) and (w < W_MAX):
            paires.append({
                "class_1": cls_1,
                "class_2": cls_2,
                "gap": gap,
                "cohen_d": d,
                "ovl": o,
                "wasserstein": w,
                "severite_totale": gap,  # priorité à la plus proche
            })

    if not paires:
        return None, None

    df_paires = pl.DataFrame(paires).sort("severite_totale")
    meilleur = df_paires.head(1)
    return [meilleur["class_1"][0], meilleur["class_2"][0]], df_paires


