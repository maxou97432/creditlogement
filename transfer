def compare_to_srs(df: pl.DataFrame) -> dict:
    """
    Compare recomputed values against original SRS values.
    Returns a dictionary of global quality metrics, plus prints a
    detailed report including stratification by CD_TYPE_AMORT and
    error distribution in days.
    """
    df = df.with_columns(
        err_maturite = pl.col("NB_MATURITE_RECALCULE") - pl.col("NB_MATURITE_IRBA"),
        err_duration = pl.col("NB_DURATION_RECALCULE") - pl.col("NB_DURATION_IRBA"),
    ).with_columns(
        abs_err_maturite = pl.col("err_maturite").abs(),
        abs_err_duration = pl.col("err_duration").abs(),
    )

    err_m = df["err_maturite"].drop_nulls().to_numpy()
    err_d = df["err_duration"].drop_nulls().to_numpy()

    # ============================================================
    # 1. Global metrics
    # ============================================================
    print("\n=== 1. Global metrics ===")
    print(f"  n_observations              = {len(err_m):>10,}")
    print(f"  RMSE maturite (days)        = {np.sqrt(np.mean(err_m**2))*365.25:>10.2f}")
    print(f"  RMSE duration (days)        = {np.sqrt(np.mean(err_d**2))*365.25:>10.2f}")
    print(f"  MAE maturite (days)         = {np.mean(np.abs(err_m))*365.25:>10.2f}")
    print(f"  MAE duration (days)         = {np.mean(np.abs(err_d))*365.25:>10.2f}")
    print(f"  % match maturite |err|<0.05 = {(np.abs(err_m)<0.05).mean()*100:>10.2f}%")
    print(f"  % match duration |err|<0.05 = {(np.abs(err_d)<0.05).mean()*100:>10.2f}%")
    print(f"  % match maturite |err|<0.1  = {(np.abs(err_m)<0.10).mean()*100:>10.2f}%")
    print(f"  % match duration |err|<0.1  = {(np.abs(err_d)<0.10).mean()*100:>10.2f}%")

    # ============================================================
    # 2. Performance by CD_TYPE_AMORT
    # ============================================================
    print("\n=== 2. Performance by CD_TYPE_AMORT ===")
    breakdown = df.group_by("CD_TYPE_AMORT").agg(
        n               = pl.len(),
        rmse_maturite   = (pl.col("err_maturite") ** 2).mean().sqrt(),
        rmse_duration   = (pl.col("err_duration") ** 2).mean().sqrt(),
        mae_maturite    = pl.col("abs_err_maturite").mean(),
        mae_duration    = pl.col("abs_err_duration").mean(),
        pct_mat_005     = (pl.col("abs_err_maturite") < 0.05).mean() * 100,
        pct_mat_01      = (pl.col("abs_err_maturite") < 0.10).mean() * 100,
        pct_dur_005     = (pl.col("abs_err_duration") < 0.05).mean() * 100,
        pct_dur_01      = (pl.col("abs_err_duration") < 0.10).mean() * 100,
    ).sort("CD_TYPE_AMORT")
    print(breakdown)

    # ============================================================
    # 3. Distribution of errors (in days) — maturity
    # ============================================================
    print("\n=== 3. Distribution of maturity errors (in days) ===")
    err_m_days = err_m * 365.25
    bins = [-365, -180, -60, -30, -10, -1, 1, 10, 30, 60, 180, 365, 10000]
    n_total = len(err_m_days)
    for lo, hi in zip(bins[:-1], bins[1:]):
        mask = (err_m_days >= lo) & (err_m_days < hi)
        if mask.sum() > 0:
            pct = mask.mean() * 100
            bar = "█" * int(pct / 2) if pct > 1 else ""
            print(f"  [{lo:>+5}, {hi:>+5}[ days : {mask.sum():>8,} ({pct:>5.2f}%) {bar}")

    # ============================================================
    # 4. Distribution of errors (in days) — duration
    # ============================================================
    print("\n=== 4. Distribution of duration errors (in days) ===")
    err_d_days = err_d * 365.25
    for lo, hi in zip(bins[:-1], bins[1:]):
        mask = (err_d_days >= lo) & (err_d_days < hi)
        if mask.sum() > 0:
            pct = mask.mean() * 100
            bar = "█" * int(pct / 2) if pct > 1 else ""
            print(f"  [{lo:>+5}, {hi:>+5}[ days : {mask.sum():>8,} ({pct:>5.2f}%) {bar}")

    return {
        "n_observations"         : len(err_m),
        "rmse_maturite_days"     : float(np.sqrt(np.mean(err_m**2)) * 365.25),
        "rmse_duration_days"     : float(np.sqrt(np.mean(err_d**2)) * 365.25),
        "mae_maturite_days"      : float(np.mean(np.abs(err_m)) * 365.25),
        "mae_duration_days"      : float(np.mean(np.abs(err_d)) * 365.25),
        "pct_match_maturite_005" : float((np.abs(err_m) < 0.05).mean() * 100),
        "pct_match_duration_005" : float((np.abs(err_d) < 0.05).mean() * 100),
        "pct_match_maturite_01"  : float((np.abs(err_m) < 0.10).mean() * 100),
        "pct_match_duration_01"  : float((np.abs(err_d) < 0.10).mean() * 100),
        "by_type"                : breakdown.to_dicts(),
    }
