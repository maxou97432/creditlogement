df_ob_class = (
    lf_LGD3
    .join(counts, on="Jenks_Submodel", how="left")
    .with_columns(
        (pl.col("lgd_obligor") * pl.col("count_distinct_id_client").cast(pl.Float64))
        .alias("weighted_lgd")
    )
    .group_by("Jenks_Submodel")
    .agg(
        (pl.col("weighted_lgd").sum() / 
         pl.col("count_distinct_id_client").cast(pl.Float64).sum())
        .alias("lgd_obligor_hlc")
    )
    .collect()
)
