# ============================================================
# 3. Stats globales
# ============================================================
def stats_global(df, col_err, label):
    err = df[col_err].drop_nulls().to_numpy()
    abs_err = np.abs(err)
    print(f"\n=== {label} (n = {len(err):,}) ===")
    print(f"  RMSE          : {np.sqrt(np.mean(err**2)):.5f} ans  ({np.sqrt(np.mean(err**2))*365.25:.2f} jours)")
    print(f"  MAE           : {np.mean(abs_err):.5f} ans  ({np.mean(abs_err)*365.25:.2f} jours)")
    print(f"  Erreur moy    : {np.mean(err):+.5f} ans  ({np.mean(err)*365.25:+.2f} jours)")
    print(f"  Erreur médian : {np.median(err):+.5f} ans  ({np.median(err)*365.25:+.2f} jours)")
    print(f"  max|err|      : {np.max(abs_err):.5f} ans")
    print(f"  % |err| < 0,001 (≈match parfait) : {(abs_err < 0.001).mean()*100:>6.2f}%")
    print(f"  % |err| < 0,01                   : {(abs_err < 0.01).mean()*100:>6.2f}%")
    print(f"  % |err| < 0,05                   : {(abs_err < 0.05).mean()*100:>6.2f}%")
    print(f"  % |err| < 0,1                    : {(abs_err < 0.1).mean()*100:>6.2f}%")
    print(f"  % |err| > 0,5                    : {(abs_err > 0.5).mean()*100:>6.2f}%")

stats_global(df_final, "err_maturite", "MATURITÉ globale")
stats_global(df_final, "err_duration", "DURATION globale (clip[1,5])")

