import pandas as pd
import polars as pl

# --- import de la version pandas de référence (adapte le nom du module) ---
from survival_rate_pandas import extrapolate_all_categories   # <-- ton fichier pandas

# ======================================================================
# PARAMÈTRES (repris de ta cellule [6])
# ======================================================================
CAT             = 1.0            # une valeur de HLC à tester
ANNEE_COURANTE  = 2020
CATEGORY_COLUMN = "HLC"
FIELDS          = ["CRR_", "CA_"]
MARGINAL_FIELDS = ["RR_", "AD_"]
FINAL_COL       = f"{FIELDS[0]}_final"   # -> "CRR__final"

# ======================================================================
# 1) On restreint dtmlz2 à UNE catégorie (rapide)
# ======================================================================
dtm_cat = dtmlz2.filter(pl.col(CATEGORY_COLUMN) == CAT)

# version polars (lazy)
dtm_pl = dtm_cat

# version pandas : mêmes lignes + colonne 'datdef_ap_mdef' attendue par le pandas
dtm_pd = (
    dtm_cat
    .with_columns(pl.col("datdef_corr").alias("datdef_ap_mdef"))  # alias pour le pandas
    .collect()
    .to_pandas()
)
print(f"{dtm_pd.shape[0]:,} lignes pour HLC={CAT}")

# ======================================================================
# 2) Pipeline PANDAS (référence)  — date_fin/datdef hardcodés
# ======================================================================
_, filled_pd = extrapolate_all_categories(
    annee_courante=ANNEE_COURANTE,
    dtm_in=dtm_pd,
    category_column=CATEGORY_COLUMN,
    fields=FIELDS,
    final_suffix="_final",
    marginal_fields=MARGINAL_FIELDS,
    stepwise_SR=True,
    weighted_facility=True,
)

# ======================================================================
# 3) Pipeline POLARS (à valider)
# ======================================================================
_, filled_pl_lazy = SR_mod.extrapolate_all_categories_lazy(
    annee_courante=ANNEE_COURANTE,
    dtm_in=dtm_pl,
    category_column=CATEGORY_COLUMN,
    fields=FIELDS,
    final_suffix="_final",
    date_fin="date_fin",
    datdef="datdef_corr",
    marginal_fields=MARGINAL_FIELDS,
    stepwise_SR=True,
    weighted_facility=True,
)
filled_pl = filled_pl_lazy.collect()

# ======================================================================
# 4) Comparaison par génération
# ======================================================================
r = (filled_pd[filled_pd[CATEGORY_COLUMN] == CAT]
       .groupby("generation")[FINAL_COL].mean().rename("pandas"))

n = (filled_pl.filter(pl.col(CATEGORY_COLUMN) == CAT)
       .group_by("generation").agg(pl.col(FINAL_COL).mean().alias("polars"))
       .sort("generation").to_pandas().set_index("generation")["polars"])

cmp = pd.concat([r, n], axis=1).sort_index()
cmp["ecart_abs"]  = (cmp["pandas"] - cmp["polars"]).abs()
cmp["ecart_rel%"] = 100 * cmp["ecart_abs"] / cmp["pandas"].abs()

print(f"\n=== HLC {CAT} — {FINAL_COL} ===")
print(cmp)
print(f"\nÉcart absolu max : {cmp['ecart_abs'].max():.6f}")
if cmp["ecart_abs"].max() < 1e-6:
    print("✅ IDENTIQUE")
else:
    print("⚠️ DIVERGENCE (regarde les générations récentes)")
