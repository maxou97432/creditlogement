# =============================================================================
# 8. CALCUL DES PRIX SUR LA BASE RESTREINTE (V2_STRUCT uniquement)
# =============================================================================
print("\n" + "="*80)
print(" CALCUL DES PRIX V2_STRUCT (Poids V1 sur Base Restreinte)")
print("="*80)

# Chemins
path_base_v1 = r"N:\uflumth\indicateur_marche\univers_elementaire\base_complete_filtree.parquet"
path_base_v2 = output_path  # La base qu'on vient de créer

top15 = ["PARIS", "MARSEILLE", "LYON", "LILLE", "RENNES", "TOULOUSE", "BORDEAUX", 
         "NICE", "STRASBOURG", "NANTES", "MONTPELLIER", "TOULON", "REIMS", 
         "SAINT-ETIENNE", "LE HAVRE"]

# -----------------------------------------------------------------------------
# 8.1 EXTRACTION STRUCTURE DE MARCHÉ V1
# -----------------------------------------------------------------------------
print("\nChargement V1 pour extraction structure...")
raw_v1 = pd.read_parquet(path_base_v1)
df_v1_clean = raw_v1.rename(columns={"ville_": "Ville"})
df_v1_clean["Ville"] = df_v1_clean["Ville"].astype(str).str.strip().str.upper()
df_v1_clean["Ville"] = df_v1_clean["Ville"].replace({"HAVRE": "LE HAVRE", "SAINT ETIENNE": "SAINT-ETIENNE"})
df_v1_clean = df_v1_clean[df_v1_clean["Ville"].isin(top15)]

# Calcul des poids par univers
dims = ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
structure_v1 = df_v1_clean.groupby(dims, dropna=False).size().reset_index(name="volume_ref")
structure_v1["TYPE_BIEN"] = structure_v1["TYPE_BIEN"].astype(str).str.strip().str.upper()
structure_v1["PB"] = structure_v1["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
structure_v1 = structure_v1[structure_v1["TYPE_BIEN"] == structure_v1["PB"]].drop(columns=["PB"])
structure_v1["poids_structure"] = structure_v1.groupby("Ville")["volume_ref"].transform(lambda x: x / x.sum())
structure_v1 = structure_v1[["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE", "poids_structure"]]
print(f"✓ Structure V1 extraite : {len(structure_v1)} univers élémentaires")

# -----------------------------------------------------------------------------
# 8.2 CALCUL DES PRIX V2_STRUCT
# -----------------------------------------------------------------------------
print("\nTraitement V2_STRUCT...")
raw_v2 = pd.read_parquet(path_base_v2)

# Filtrage DEMANDE == 0
if "DEMANDE" in raw_v2.columns:
    raw_v2 = raw_v2[raw_v2["DEMANDE"] == 0]

# Nettoyage
raw_v2 = raw_v2.rename(columns={"ville_": "Ville"})
raw_v2["DATE"] = pd.to_datetime(raw_v2["DATE"], errors="coerce")
raw_v2["Ville"] = raw_v2["Ville"].astype(str).str.strip().str.upper()
raw_v2["Ville"] = raw_v2["Ville"].replace({"HAVRE": "LE HAVRE", "SAINT ETIENNE": "SAINT-ETIENNE"})
raw_v2 = raw_v2[raw_v2["Ville"].isin(top15)]
raw_v2 = raw_v2.dropna(subset=["DATE", "Ville", "TYPE_BIEN"])
raw_v2["Periode"] = raw_v2["DATE"].dt.to_period("M").dt.to_timestamp()

# Agrégation mensuelle
keys = ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE", "Periode"]
univers_mensuel = raw_v2.groupby(keys, dropna=False).agg(
    nb_transac=("ID", "size"), prix_moyen=("Prix_m2", "mean")
).reset_index()

# Nettoyage cohérence Type/Pièces
univers_mensuel["PB"] = univers_mensuel["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
univers_mensuel["TYPE_BIEN"] = univers_mensuel["TYPE_BIEN"].astype(str).str.strip().str.upper()
univers_mensuel = univers_mensuel[univers_mensuel["TYPE_BIEN"] == univers_mensuel["PB"]].drop(columns="PB")

# Complétion mois manquants
def complete_months(g):
    g = g.sort_values("Periode").set_index("Periode")
    idx = pd.date_range(g.index.min(), g.index.max(), freq="MS")
    g = g.reindex(idx)
    for col in ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]:
        g[col] = g[col].ffill().bfill()
    g["nb_transac"] = g["nb_transac"].fillna(0)
    return g.reset_index().rename(columns={"index": "Periode"})

univers_complet = univers_mensuel.groupby(
    ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], group_keys=False
).apply(complete_months)

# Application des poids V1
univers_complet = univers_complet.merge(structure_v1, on=["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], how="left")
univers_complet = univers_complet.rename(columns={"poids_structure": "poids_relatif"})
univers_complet = univers_complet.dropna(subset=["poids_relatif"])

# Indicatrices
typokeys = ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
univers_complet = univers_complet.sort_values(typokeys + ["Periode"])
univers_complet["I_12m"] = univers_complet.groupby(typokeys, group_keys=False)["nb_transac"].transform(
    lambda s: (s.rolling(window=12, min_periods=12).sum() > 0).astype(int))

# Moyenne mobile pondérée 12 mois
resultats = []
for ville in univers_complet["Ville"].unique():
    df_v = univers_complet[univers_complet["Ville"] == ville].sort_values("Periode")
    periodes = df_v["Periode"].unique()
    
    for i, periode in enumerate(periodes):
        start = max(0, i - 11)
        df_fenetre = df_v[df_v["Periode"].isin(periodes[start:i+1])]
        df_actif = df_fenetre[(df_fenetre["prix_moyen"].notna()) & (df_fenetre["I_12m"] == 1)]
        
        if len(df_actif) > 0 and df_actif["poids_relatif"].sum() > 0:
            prix_mm = np.average(df_actif["prix_moyen"], weights=df_actif["poids_relatif"])
        else:
            prix_mm = np.nan
        
        resultats.append({"Ville": ville, "Periode": periode, "prix_mm_12m": prix_mm})

res_v2_struct = pd.DataFrame(resultats)

# -----------------------------------------------------------------------------
# 8.3 EXPORT
# -----------------------------------------------------------------------------
output_prix = os.path.join(OUTPUT_DIR, "prix_V2_STRUCT.csv")
res_v2_struct.to_csv(output_prix, index=False)
print(f"\n✓ Prix V2_STRUCT sauvegardés : {output_prix}")
print(f"  - {res_v2_struct['Ville'].nunique()} villes, {len(res_v2_struct)} lignes")
