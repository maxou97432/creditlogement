# ============================================================
#  CRITERE DE PARSIMONIE — fusion gloutonne
#  Cellule 2 : fusion iterative, on s'arrete quand la perte
#              depasse le seuil de tolerance
# ============================================================

# Seuils de tolerance (perte relative acceptee sur chaque critere)
TOL_R2       = 0.02   # on accepte de perdre jusqu'a 2% de R2
TOL_GINI     = 0.02   # idem Gini
TOL_MAE      = 0.05   # on accepte +5% de MAE (erreur prediction)

MAX_ITER_PARS = 200   # securite

def get_adjacent_pairs(df: pl.DataFrame, class_col: str, target_col: str):
    """Paires adjacentes triees par LGD moyenne croissante."""
    stats = (
        df.group_by(class_col)
        .agg(pl.col(target_col).mean().alias("mean_lgd"))
        .sort("mean_lgd")
    )
    classes = stats[class_col].to_list()
    pairs = [(classes[i], classes[i+1]) for i in range(len(classes)-1)]
    return pairs


def merge_classes_df(df: pl.DataFrame, ca, cb, class_col: str) -> pl.DataFrame:
    """Fusionne ca et cb en une nouvelle classe nommee 'ca|cb'."""
    new_name = f"{ca}|{cb}"
    return df.with_columns(
        pl.when(pl.col(class_col).is_in([ca, cb]))
        .then(pl.lit(new_name))
        .otherwise(pl.col(class_col))
        .alias(class_col)
    )


# Boucle de fusion gloutonne
df_current  = df_base.clone()
history_par = []
r2_ref      = scores_ref["r2"]
gini_ref    = scores_ref["gini"]
mae_ref     = scores_ref["mae_pred"]

print(f"Reference : R2={r2_ref:.6f}  Gini={gini_ref:.6f}  MAE={mae_ref:.6f}\n")

for it in range(MAX_ITER_PARS):
    pairs = get_adjacent_pairs(df_current, "CHR_model", "lgd_obligor")
    if not pairs:
        print("Plus de paires adjacentes.")
        break

    # Tester toutes les paires, garder celle qui perd le moins de R2
    best = None
    best_loss_r2 = np.inf

    for ca, cb in pairs:
        df_merged  = merge_classes_df(df_current, ca, cb, "CHR_model")
        sc         = compute_scores(df_merged, "CHR_model", "lgd_obligor")
        loss_r2    = (r2_ref    - sc["r2"])    / r2_ref    if r2_ref   > 0 else 0
        loss_gini  = (gini_ref  - sc["gini"])  / gini_ref  if gini_ref > 0 else 0
        delta_mae  = (sc["mae_pred"] - mae_ref) / mae_ref  if mae_ref  > 0 else 0

        if loss_r2 < best_loss_r2:
            best_loss_r2 = loss_r2
            best = {
                "ca": ca, "cb": cb,
                "scores": sc,
                "loss_r2"  : round(loss_r2,   6),
                "loss_gini": round(loss_gini,  6),
                "delta_mae": round(delta_mae,  6),
            }

    # Critere d'arret : la meilleure fusion disponible depasse un seuil
    stop_r2   = best["loss_r2"]   > TOL_R2
    stop_gini = best["loss_gini"] > TOL_GINI
    stop_mae  = best["delta_mae"] > TOL_MAE

    symbole = "✅" if not (stop_r2 or stop_gini or stop_mae) else "⚠️"
    print(f"{symbole} it={it+1:3d} | {str(best['ca']):<20} + {str(best['cb']):<20} | "
          f"R2={best['scores']['r2']:.6f} (-{best['loss_r2']*100:.3f}%)  "
          f"Gini={best['scores']['gini']:.6f} (-{best['loss_gini']*100:.3f}%)  "
          f"MAE={best['scores']['mae_pred']:.4f} (+{best['delta_mae']*100:.3f}%)")

    history_par.append({
        "iteration" : it + 1,
        "class_a"   : best["ca"],
        "class_b"   : best["cb"],
        "n_classes" : best["scores"]["n_classes"],
        "r2"        : best["scores"]["r2"],
        "gini"      : best["scores"]["gini"],
        "mae_pred"  : best["scores"]["mae_pred"],
        "loss_r2"   : best["loss_r2"],
        "loss_gini" : best["loss_gini"],
        "delta_mae" : best["delta_mae"],
        "stop_r2"   : stop_r2,
        "stop_gini" : stop_gini,
        "stop_mae"  : stop_mae,
    })

    if stop_r2 or stop_gini or stop_mae:
        raisons = []
        if stop_r2:   raisons.append(f"R2 -perte={best['loss_r2']*100:.2f}%>{TOL_R2*100}%")
        if stop_gini: raisons.append(f"Gini -perte={best['loss_gini']*100:.2f}%>{TOL_GINI*100}%")
        if stop_mae:  raisons.append(f"MAE +delta={best['delta_mae']*100:.2f}%>{TOL_MAE*100}%")
        print(f"\n🛑 Arret it={it+1} : {' | '.join(raisons)}")
        break

    df_current = merge_classes_df(df_current, best["ca"], best["cb"], "CHR_model")

print(f"\nClasses finales : {df_current['CHR_model'].n_unique()}")


