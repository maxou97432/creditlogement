df['Text_Label'] = df.apply(create_label_text, axis=1)

# Créer une colonne pour la taille/couleur (ici, basée sur le prix)
df['Prix_Size'] = df['prix_mm_value'] / 1000 # Pour avoir une taille de bulle raisonnable

# Crée le graphique de dispersion géographique
fig = px.scatter_geo(
    df,
    lat='latitude',
    lon='longitude',
    hover_name='label', # Nom affiché au survol
