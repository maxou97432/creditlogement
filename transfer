# 1. Analyse macro par libellé d'engagement
print("=== ANALYSE DES ÉCARTS PAR LB_ENGAGEMENT ===")
analyse_lb = (
    srs_X_capret
    .filter(pl.col("Ecart_Final") > 0.0001)  # On ne garde que les vrais écarts finaux
    .group_by("LB_ENGAGEMENT")
    .agg([
        pl.len().alias("Nombre_Anomalies"),
        pl.col("Ecart_Final").mean().round(4).alias("Ecart_Final_Moyen"),
        # Regardons l'écart brut (avant le clip) pour comprendre la logique SAS
        (pl.col("duration_brute_calculee") - pl.col("NB_MATURITE_IRBA")).abs().mean().round(4).alias("Ecart_Brut_Moyen"),
        pl.col("NB_MATURITE_IRBA").mean().round(4).alias("Maturite_SAS_Moyenne")
    ])
    .sort("Nombre_Anomalies", descending=True)
)

# On affiche les 10 pires libellés
print(analyse_lb.head(10))

# 2. Zoom sur le pire délinquant (remplace par le premier de ta liste)
pire_lb = analyse_lb["LB_ENGAGEMENT"][0] if analyse_lb.height > 0 else None
if pire_lb:
    print(f"\n=== ZOOM SUR LE PIRE : {pire_lb} ===")
    print(
        srs_X_capret.filter((pl.col("LB_ENGAGEMENT") == pire_lb) & (pl.col("Ecart_Final") > 0.0001))
        .select(["DT_DEBUT_AUTO", "DT_ECHEANCE_FEM", "CD_TYPE_AMORT", "duration_brute_calculee", "NB_MATURITE_IRBA"])
        .head(5)
    )
