def generate_map(df_data_maj):
    """Génère la carte de France à partir d'un DataFrame de données (pas de relecture CSV)."""
    
    print("\n--- Génération des cartes ---")
    
    try:
        # Chargement des données Géo (Statiques)
        france_gdf = gpd.read_file(CONFIG['geojson_path'])
        dissolved_france = france_gdf.dissolve(by=None)
        france_geometry = dissolved_france.to_crs("EPSG:2154").geometry.iloc[0]
        
        # Récupération du continent
        geometries_list = list(france_geometry.geoms) if france_geometry.geom_type == 'MultiPolygon' else [france_geometry]
        geometries_list.sort(key=lambda x: x.area, reverse=True)
        france_outline_geometry = geometries_list[0]
        
        # Chargement GPS/Communes
        df_communes = pd.read_excel(CONFIG['communes_path'], sheet_name="Figure 1")
        df_geo_gps = pd.read_csv(CONFIG['gps_path'], sep=';')
        
    except Exception as e:
        print(f"Erreur chargement données géo : {e}")
        return

    # Préparation Données Prix (Depuis mémoire)
    df_data = df_data_maj[df_data_maj["TYPE_MAILLE"] == "CITY"].copy()
    df_communes['Commune'] = df_communes['Commune'].astype(str).str.upper()
    
    df_prix_m2 = df_communes.merge(df_data, left_on='Commune', right_on='VAL_MAILLE_GEO', how='right')
    df_prix_m2["VAL_MAILLE_GEO"] = df_prix_m2["VAL_MAILLE_GEO"].replace({
        "HAVRE": "LE HAVRE", "SAINT ETIENNE": "ST ETIENNE"
    })

    # Paramètres Graphiques
    CL_TURQUOISE, CL_BLACK, CL_LIGHT_GREY = '#A8DADC', '#1D3557', '#F5F5DC'
    CL_BLUE_3M, CL_RED_12M = '#000000', '#CB4735'
    CUSTOM_LABEL_OFFSETS = {
        'MONTPELLIER': {'x': -5000, 'y': 60000}, 'MARSEILLE': {'x': -5000, 'y': -5000},
        'TOULON': {'x': 5000, 'y': -10000}, 'NICE': {'x': 30000, 'y': 3000},
        'LILLE': {'x': 0, 'y': -10000}, 'LYON': {'x': 6000, 'y': 60000},
        'PARIS': {'x': 5000, 'y': 3000}
    }

    # Boucle sur les types de biens
    for type_bien in ['APT', 'MAI']:
        df_filter = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
        
        df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
        df_map = df_geo_gps.merge(df_filter, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
        df_map = df_map.drop_duplicates(subset='label')
        
        if df_map.empty: continue
        
        # Création GéoDataFrame
        geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
        gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326").to_crs("EPSG:2154")
        
        # Plot
        fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=150)
        fig.set_facecolor(CL_TURQUOISE)
        
        x, y = france_outline_geometry.exterior.xy
        ax.fill(x, y, color=CL_LIGHT_GREY, zorder=1)
        ax.plot(x, y, color=CL_BLACK, linewidth=1.0, zorder=2)
        
        xmin, ymin, xmax, ymax = france_outline_geometry.bounds
        ax.set_xlim(xmin - 5000, xmax + 5000)
        ax.set_ylim(ymin - 5000, ymax + 5000)
        ax.axis('off')
        
        # Étiquettes
        for _, row in gdf.iterrows():
            city = row['label']
            x_c, y_c = row.geometry.x, row.geometry.y
            
            offset = CUSTOM_LABEL_OFFSETS.get(city, {'x': 3000, 'y': 3000})
            anchor_x, anchor_y = x_c + offset['x'], y_c + offset['y']
            ha = 'right' if offset['x'] < 0 else 'left'
            
            prix_txt = f"{round(row['prix_mm_value']):,} €".replace(',', ' ')
            ax.text(anchor_x, anchor_y, f"{city}\n{prix_txt}", ha=ha, va='top', fontsize=12, weight='bold')
            ax.plot(x_c, y_c, marker='o', color=CL_BLACK, markersize=5)

        title = f"PRIX {type_bien} - {df_filter['DT_MAJ_PM2'].max().strftime('%B %Y')}"
        ax.set_title(title, fontsize=20, weight='bold', pad=20)
        
        out_file = os.path.join(CONFIG['output_dir'], f"carte_prix_m2_CITY_{type_bien}_V2.png")
        plt.savefig(out_file, bbox_inches='tight', facecolor=CL_TURQUOISE)
        plt.close()
        print(f"  Carte générée : {out_file}")

