# Cherche les colonnes dates
date_cols = [c for c in df.columns if any(k in c.upper() for k in 
             ["DATE", "DT_", "_DT", "DEBUT", "FIN", "ECH", "ORIG", "MISE"])]
print(date_cols)

# Une fois identifiées (ex : DT_MISE_PLACE et DT_ECHEANCE) :
df = df.with_columns(
    ((pl.col("DT_ECHEANCE") - pl.col("DT_MISE_PLACE")).dt.total_days() / 365.25)
    .alias("MATURITE_ORIGINELLE")
)

pop = df.filter(
    (pl.col("IND_CREDIT_CONFIRME") == 0) &
    (pl.col("Flag_Revolving") == 0) &
    (pl.col("PORTEFEUILLE") == "Corporate")
)

# Distribution comparée
print(
    pop.group_by("SEGMENT").agg(
        pl.col("MATURITE_ORIGINELLE").mean().alias("mat_orig_mean"),
        pl.col("MATURITE_ORIGINELLE").median().alias("mat_orig_median"),
        (pl.col("MATURITE_ORIGINELLE") < 1.0).sum().alias("n_mat_orig_lt_1y"),
        pl.count().alias("N"),
    )
)

# Test discriminant
pop = pop.with_columns((pl.col("MATURITE_ORIGINELLE") < 1.0).alias("COURT_TERME_ORIG"))
print(
    pop.group_by(["SEGMENT", "COURT_TERME_ORIG"])
    .agg(pl.count().alias("N"))
    .sort(["SEGMENT", "COURT_TERME_ORIG"])
)
