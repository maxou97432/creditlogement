prix_m2_univ_elem_MAJ_CITY = prix_m2_univ_elem_MAJ_CITY[prix_m2_univ_elem_MAJ_CITY["TYPE_MAILLE"] == "CITY"]
df_communes['Commune'] = df_communes['Commune'].astype(str).str.upper()
df_prix_m2 = df_communes.merge(prix_m2_univ_elem_MAJ_CITY, left_on='Commune', right_on='VAL_MAILLE_GEO', how='right')

def format_text_label(row):
    ville = str(row['label']).upper() 
    prix_val = row['prix_mm_value']
    prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
    return f"{ville}\n{prix}"

# =============================================================================
# --- PRÉPARATION DU CONTOUR GÉOGRAPHIQUE ---
# =============================================================================

try:
    france_gdf = gpd.read_file(geojson_path)
    dissolved_france = france_gdf.dissolve(by=None)
    france_outline_geometry = dissolved_france.geometry.iloc[0] 
    print("Contour de la France chargé.")
except Exception as e:
    print(f"!!! Échec critique: {e}")
    sys.exit(1)

# =============================================================================
# --- CRÉATION DE LA CARTE MATPLOTLIB ---
# =============================================================================

print("Configuration de police 'Century Gothic' appliquée.")

types_bien = ['APT', 'MAI']

# --- DEFINITION DES OFFSETS ULTRA-PRÉCIS (Le "Tuning") ---
# x positif : vers la droite / x négatif : vers la gauche
# y positif : vers le haut / y négatif : vers le bas
CUSTOM_LABEL_OFFSETS = {
    # SUD-EST (La zone encombrée)
    'MONTPELLIER': {'x': -0.15, 'y': 0.10}, # Poussé vers la gauche (Ouest) et haut
    'MARSEILLE':   {'x': 0.10,  'y': 0.10}, # Poussé un peu à droite et haut
    'TOULON':      {'x': 0.10,  'y': -0.20}, # Poussé vers le bas (dans la mer)
    'NICE':        {'x': -0.15, 'y': 0.05}, # Poussé vers la gauche (terre) pour éviter l'Italie/Mer
    'GRENOBLE':    {'x': 0.15, 'y': 0.0},   # Poussé à droite

    # FRONTIÈRES & CÔTES (Pour rentrer dans les terres)
    'BORDEAUX':    {'x': 0.15,  'y': 0.0},  # Poussé vers la droite (terre)
    'NANTES':      {'x': 0.15,  'y': 0.0},  # Poussé vers la droite (terre)
    'RENNES':      {'x': 0.15,  'y': 0.0},  # Poussé vers la droite (terre)
    'LILLE':       {'x': 0.0,   'y': -0.25}, # Poussé vers le bas (terre) pour éviter la Belgique
    'STRASBOURG':  {'x': -0.15, 'y': 0.0},  # Poussé vers la gauche (terre) pour éviter l'Allemagne
    
    # CENTRE / AUTRES
    'PARIS':       {'x': 0.15, 'y': 0.05},
    'LYON':        {'x': -0.15, 'y': 0.05}, # Poussé à gauche pour s'éloigner de Grenoble
    'TOULOUSE':    {'x': -0.15, 'y': 0.05}, # Poussé à gauche
}

for type_bien in types_bien:
    print(f"\n--- Génération de la carte pour le type de bien : {type_bien} ---")
    
    df_prix_filtre = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
    df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
    df_map = df_geo_gps.merge(df_prix_filtre, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
    
    df_map = df_map[['label', 'latitude', 'longitude', 'prix_mm_value', "TAUX_INFL_3M", 'TAUX_INFL_12M']].copy()
    df_map = df_map.dropna(subset=['latitude', 'longitude'])
    df_map = df_map.drop_duplicates(subset='label', keep='first')
    
    if df_map.empty: continue
        
    df_map['Formatted_Label'] = df_map.apply(format_text_label, axis=1)
    geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
    gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326")
    
    # --- DESSIN ---
    fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=300) 
    fig.set_facecolor(CL_TURQUOISE) 
    
    # --- DESSIN DU CONTOUR ---
    geometries_to_plot = [france_outline_geometry]
    if france_outline_geometry.geom_type == 'MultiPolygon':
        geometries_to_plot = list(france_outline_geometry.geoms)

    for geom in geometries_to_plot:
        ax.fill(geom.exterior.xy[0], geom.exterior.xy[1], color=CL_LIGHT_GREY, zorder=1) 
        ax.plot(geom.exterior.xy[0], geom.exterior.xy[1], color=CL_BLACK, linewidth=1.0, zorder=2)
    
    xmin, ymin, xmax, ymax = france_outline_geometry.bounds
    ax.set_xlim(xmin - 0.7, xmax + 0.7) 
    ax.set_ylim(ymin - 0.7, ymax + 0.7)

    # --- AJOUT DES ÉTIQUETTES ---
    
    DEFAULT_X_OFFSET = 0.08 
    DEFAULT_Y_OFFSET = 0.08 
    LINE_SPACING = 0.13 
    RATE_SPACING_X = 0.60 
    
    # DEFINITION DU HALO BLANC (Contour autour du texte)
    halo_effect = [pe.withStroke(linewidth=2.5, foreground="white")]

    for idx, row in gdf.iterrows():
        lon = row['longitude']
        lat = row['latitude']
        city_label = row['label'] 
        
        if city_label in CUSTOM_LABEL_OFFSETS:
            x_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['x']
            y_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['y']
        else:
            x_offset_city = DEFAULT_X_OFFSET
            y_offset_city = DEFAULT_Y_OFFSET

        ville = str(row['label']).upper()
        prix_val = row['prix_mm_value']
        prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
        ti_3m = row['TAUX_INFL_3M']
        ti_12m = row['TAUX_INFL_12M']
        
        anchor_x = lon + x_offset_city
        anchor_y = lat + y_offset_city
        
        # Alignement dynamique : si offset X négatif, on aligne à droite pour que le texte "pousse" vers la gauche
        ha_align = 'right' if x_offset_city < 0 else 'left'
        va_align_box = 'top' 
        
        # 1. Nom de la Ville (Ligne 1)
        ax.text(anchor_x, anchor_y, ville, fontsize=10, ha=ha_align, va=va_align_box,
                color=CL_BLACK, weight='bold', zorder=4, 
                path_effects=halo_effect) # Ajout du halo
        
        # 2. Prix M2 (Ligne 2)
        prix_y = anchor_y - LINE_SPACING 
        ax.text(anchor_x, prix_y, prix, fontsize=10, ha=ha_align, va=va_align_box,
                color=CL_BLACK, weight='normal', zorder=4,
                path_effects=halo_effect) # Ajout du halo
        
        # 3. Taux d'inflation (Ligne 3)
        ti_y = prix_y - LINE_SPACING 
        
        # Taux 3M (BLEU)
        if pd.notna(ti_3m):
            text_3m = f"3M: {ti_3m:+.1%}".replace('.', ',')
        else:
            text_3m = "3M: N/A"

        ax.text(anchor_x, ti_y, text_3m, fontsize=10, ha=ha_align, va=va_align_box,
                color=CL_BLUE_3M, weight='bold', zorder=4, # Mis en gras pour lisibilité
                path_effects=halo_effect) # Ajout du halo
        
        # Taux 12M (ROUGE)
        if pd.notna(ti_12m):
            text_12m = f"12M: {ti_12m:+.1%}".replace('.', ',')
        else:
            text_12m = "12M: N/A"

        # Calcul position 12M
        if ha_align == 'left':
            x_12m = anchor_x + RATE_SPACING_X
            align_12m = 'left'
        else:
            x_12m = anchor_x - RATE_SPACING_X
            align_12m = 'right'

        ax.text(x_12m, ti_y, text_12m, fontsize=10, ha=align_12m, va=va_align_box,
                color=CL_RED_12M, weight='bold', zorder=4, # Mis en gras pour lisibilité
                path_effects=halo_effect) # Ajout du halo

        # 4. Point Ville
        ax.plot(lon, lat, marker='o', color=CL_BLACK, markersize=5, zorder=4, 
                markeredgecolor='white', markeredgewidth=0.5) # Petit contour blanc sur le point aussi

    # --- FINALISATION ---
    ax.axis('off') 
    title_text = f"LES PRIX DES {type_bien} DANS L'ANCIEN"
    ax.set_title(title_text, fontsize=20, loc='center', pad=20, color=CL_BLACK, ha='center', weight=TITRE_FONT_WEIGHT) 
    subtitle_text = "SUR 1 AN DANS LES PRINCIPALES VILLES"
    fig.text(0.5, 0.94, subtitle_text, ha='center', va='top', fontsize=12, color=CL_BLACK, weight='bold') 

    fig.text(0.05, 0.03, "Source: Crédit Logement, MM 12M", ha='left', va='bottom', fontsize=9, color=CL_BLACK)
    fig.text(0.05, 0.1, "LÉGENDE TAUX:", ha='left', va='bottom', fontsize=9, color=CL_BLACK, weight='bold')
    fig.text(0.05, 0.08, "Bleu: Taux 3 mois", ha='left', va='bottom', fontsize=8, color=CL_BLUE_3M)
    fig.text(0.05, 0.06, "Rouge: Taux 12 mois", ha='left', va='bottom', fontsize=8, color=CL_RED_12M)

    plt.show() 
    plt.close(fig) 
    print(f"Génération terminée pour {type_bien}")
