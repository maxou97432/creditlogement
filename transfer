def get_stats(df, col_cl):
    df_copy = df.copy()
    df_copy['Dif'] = df_copy[col_cl] - df_copy['Prix moyen glissant 12 mois - LPI/IAD']
    rmse = np.sqrt(np.mean(df_copy['Dif']**2))
    corr = df_copy[col_cl].corr(df_copy['Prix moyen glissant 12 mois - LPI/IAD'])
    return pd.Series({'RMSE': rmse, 'Correlation': corr})

