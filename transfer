def _eval_pair(self, a, b, criterion, lgd_gap_threshold,
               tests_override=None, ovl_precomputed=None):
    """Retourne (mergeable: bool, score: float).

    ovl_precomputed : si fourni (float), court-circuite tout recalcul —
                      la décision est prise directement sur cette valeur.
                      Utilisé par solve() pour les paires initiales déjà
                      calculées dans _runs (zéro recalcul KDE).
    """
    # -- court-circuit cache -----------------------------------------------
    if ovl_precomputed is not None and criterion.lower() == "ovl":
        seuil = (
            self.seuil_calibre if self.seuil_calibre is not None
            else OVL_MODERE
        )
        mergeable = bool(ovl_precomputed >= seuil)
        return mergeable, float(ovl_precomputed)

    # -- recalcul complet (nouveaux groupes fusionnés) ---------------------
    tests = (tests_override if tests_override is not None
             else (self._tests_factory if self._tests_factory is not None
                   else _default_suite()))
    suite = HeterogeneityTestSuite(a, b, tests=tests).fit_all()
    c = criterion.lower()
    if c in ("ovl", "cohen", "combined"):
        v = (suite.get_verdict("combined", lgd_gap_threshold=lgd_gap_threshold)
             if c == "combined" else suite.get_verdict(c))
        if v["fusionnable"] is None:
            raise ValueError(
                f"criterion='{criterion}' nécessite que le test correspondant "
                f"soit présent dans la suite. "
                f"Suite actuelle : {[t.name for t in tests]}"
            )
        mergeable = bool(v["fusionnable"])
        if c == "ovl":
            score = v["ovl"]
        elif c == "cohen":
            score = -abs(v["cohen_d"])
        else:
            score = -v["lgd_gap"]
        return mergeable, float(score)

    t = suite.get_test(criterion)
    r = t.result
    mergeable = bool(r["fusion_suggeree"])
    if r["p_value"] is not None:
        score = r["p_value"]
    elif t.name.startswith("OVL"):
        score = r["statistic"]
    else:
        score = -abs(r["statistic"])
    return mergeable, float(score)


def solve(
    self,
    criterion: str = "ovl",
    label_style: str = "ordinal",
    k_min: int = 1,
    lgd_gap_threshold: Optional[float] = None,
    ovl_threshold: Optional[float] = None,
) -> dict:
    """Fusion séquentielle transitive selon le critère choisi.

    Optimisation : pour criterion="ovl", les OVL des paires initiales
    sont lus depuis _runs (cache) sans recalcul. Seuls les nouveaux
    groupes issus de fusions transitives déclenchent un recalcul KDE.
    En pratique ~95% des appels sont servis depuis le cache.
    """
    if lgd_gap_threshold is None:
        lgd_gap_threshold = self.lgd_gap_threshold

    tests_solve = self._make_tests(seuil_ovl=ovl_threshold)

    # -- cache OVL depuis _runs (paires initiales déjà calculées) ---------
    # clé : (frozenset({ca}), frozenset({cb})) — insensible à l'ordre
    cache_ovl: dict = {}
    if self._runs and criterion.lower() == "ovl":
        for meta, per_test in self._runs:
            if "OVL (Weitzman)" in per_test:
                ca, cb = meta["class_a"], meta["class_b"]
                key = (frozenset({ca}), frozenset({cb}))
                cache_ovl[key] = float(per_test["OVL (Weitzman)"]["statistic"])

    arrays = dict(self.arrays)
    groups: List[List[str]] = [[c] for c in self.order]
    glouton_label: Dict[int, str] = {id(g): c for g, c in zip(groups, self.order)}

    def garr(g: List[str]) -> np.ndarray:
        return np.concatenate([arrays[c] for c in g])

    def get_ovl_cache(ga: List[str], gb: List[str]) -> Optional[float]:
        """Retourne l'OVL depuis le cache si la paire est initiale
        (chaque groupe = une seule classe d'origine), None sinon."""
        if len(ga) == 1 and len(gb) == 1:
            key = (frozenset({ga[0]}), frozenset({gb[0]}))
            return cache_ovl.get(key)
        return None

    log: List[dict] = []
    it = 0
    while len(groups) > k_min:
        groups.sort(key=lambda g: garr(g).mean())
        best = None  # (score, i)
        for i in range(len(groups) - 1):
            ovl_cached = get_ovl_cache(groups[i], groups[i + 1])
            mergeable, score = self._eval_pair(
                garr(groups[i]), garr(groups[i + 1]),
                criterion, lgd_gap_threshold,
                tests_override=tests_solve,
                ovl_precomputed=ovl_cached,   # None → recalcul, float → cache
            )
            if mergeable and (best is None or score > best[0]):
                best = (score, i)
        if best is None:
            break
        it += 1
        i = best[1]
        ga, gb = groups[i], groups[i + 1]
        new_group = ga + gb
        glouton_label[id(new_group)] = (
            f"{glouton_label[id(ga)]}_{glouton_label[id(gb)]}"
        )
        log.append({
            "iteration": it,
            "groupe_a": "+".join(ga), "groupe_b": "+".join(gb),
            "n_a": int(garr(ga).size), "n_b": int(garr(gb).size),
            "critere": criterion,
            "score": float(best[0]),
            "mean_a": round(float(garr(ga).mean()), 4),
            "mean_b": round(float(garr(gb).mean()), 4),
            "gap_lgd": round(float(abs(garr(ga).mean() - garr(gb).mean())), 4),
            "label_fusionne": glouton_label[id(new_group)],
            "depuis_cache": get_ovl_cache(ga, gb) is not None,
        })
        groups = groups[:i] + [new_group] + groups[i + 2:]

