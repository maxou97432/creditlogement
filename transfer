def meilleur_candidat_fusion_tost(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    TOST (Two One-Sided Tests) :
    
    Fusionne si l'IC (1-2*alpha) du gap est dans (-delta, +delta).
    
    Avec grand n : IC très étroit → le gap doit être VRAIMENT proche de 0
    pour rentrer dans la bande. C'est exactement ce qu'on veut.
    
    delta = la marge de matérialité en pts LGD (décision métier documentée)
    alpha = 0.05 → IC à 90%
    """
    from scipy import stats as sp_stats
    
    ordre_global = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(pl.col("mean_LGD_year").mean().alias("mean_LGD_global"))
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))
        .sort(["seg", "mean_LGD_global"])
        .collect()
    )

    obligors_per_class = {}
    df_collected = df.select([jenks_col, lgd_col]).collect()
    for cls_name in df_collected.select(jenks_col).unique().to_series():
        obligors_per_class[cls_name] = (
            df_collected.filter(pl.col(jenks_col) == cls_name)
            .select(lgd_col)
            .to_numpy()
            .flatten()
        )

    paires_list = []
    
    for i in range(len(ordre_global) - 1):
        row_i = ordre_global[i]
        seg_i = row_i[jenks_col].str.split("_").list.first().item()
        cls_1 = row_i[jenks_col].item()
        mean_1 = row_i["mean_LGD_global"].item()

        cls_2, mean_2 = None, None
        for j in range(i + 1, len(ordre_global)):
            row_j = ordre_global[j]
            seg_j = row_j[jenks_col].str.split("_").list.first().item()
            if seg_j == seg_i:
                cls_2 = row_j[jenks_col].item()
                mean_2 = row_j["mean_LGD_global"].item()
                break
        
        if cls_2 is None:
            continue

        arr1 = obligors_per_class[cls_1]
        arr2 = obligors_per_class[cls_2]
        n1, n2 = len(arr1), len(arr2)
        gap = mean_2 - mean_1

        # --- TOST : calcul de l'IC (1-2*alpha) du gap ---
        s1, s2 = arr1.std(ddof=1), arr2.std(ddof=1)
        se = np.sqrt(s1**2 / n1 + s2**2 / n2)

        # Welch-Satterthwaite df
        df_w = (s1**2/n1 + s2**2/n2)**2 / (
            (s1**2/n1)**2/(n1-1) + (s2**2/n2)**2/(n2-1)
        )
        tcrit = sp_stats.t.ppf(1 - ALPHA_TOST, df_w)
        ci_low  = gap - tcrit * se
        ci_high = gap + tcrit * se

        # Équivalent si IC entièrement dans (-delta, +delta)
        tost_pass = (ci_low > -DELTA_LGD) and (ci_high < DELTA_LGD)

        if not tost_pass:
            continue

        paires_list.append({
            jenks_col: cls_1,
            "next_class": cls_2,
            "gap": gap,
            "ci_low": ci_low,
            "ci_high": ci_high,
            "se": se,
            "n_lo": n1,
            "n_hi": n2,
            "severite_totale": -abs(gap),
        })

    paires = pl.DataFrame(paires_list) if paires_list else pl.DataFrame()

    if log:
        print("=== TOST : équivalence de moyennes ===")
        print(f"Paires candidates : {paires.height}")
        if paires.height > 0:
            print(paires.sort("severite_totale", descending=True).head(10))

    if paires.height == 0:
        return None, None

    paires = paires.sort("severite_totale", descending=True)
    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires


