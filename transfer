        def calc_mm_local(g, window, col_prix, col_indic):
            result = []
            g = g.sort_values("Periode")
            periodes = g["Periode"].unique()
            for i, periode in enumerate(periodes):
                start = max(0, i - window + 1)
                df_fenetre = g[g["Periode"].isin(periodes[start:i+1])]
                df_actif = df_fenetre[(df_fenetre[col_prix].notna()) & (df_fenetre[col_indic] == 1)]
                if len(df_actif) == 0:
                    result.append({"Periode": periode, "prix_mm": np.nan})
                    continue
                total_poids = df_actif["poids_relatif"].sum()
                if total_poids > 0:
                    # RENORMALISATION : les poids des segments actifs doivent sommer à 1
                    poids_renorm = df_actif["poids_relatif"] / total_poids
                    prix_mm = np.average(df_actif[col_prix], weights=poids_renorm)
                else:
                    prix_mm = np.nan
                result.append({"Periode": periode, "prix_mm": prix_mm})
            return pd.DataFrame(result)
