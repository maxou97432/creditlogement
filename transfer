# ---------------------------------------------------------------
# Étape 6bis. Calcul du target pour la population NonCure pure
# ---------------------------------------------------------------
# Contrairement à la population Cure, un compte NonCure n'a pas besoin
# de blend contrefactuel : P(Cure) = 0 par construction, donc
# param_CALC = param_OBSERVED directement (LGD réellement observée).

lf_noncure_final = lf_NonCure.with_columns(
    pl.col(CFG['param_OBSERVED']).alias(CFG['param_CALC'])
)

# Version lissée par classe Jenks, pour rester cohérent avec le lissage
# appliqué côté Cure (avg_param_CALC = moyenne réelle par classe)
lf_noncure_final = lf_noncure_final.with_columns(
    pl.col(CFG['param_OBSERVED'])
      .mean()
      .over("Jenks_class")
      .alias(f'avg_{CFG["param_CALC"]}')
)

print("Vérification population NonCure :")
print(
    lf_noncure_final
    .select([CFG['param_OBSERVED'], CFG['param_CALC'], f'avg_{CFG["param_CALC"]}'])
    .describe()
)

# ---------------------------------------------------------------
# Fusion Cure (avec blend) + NonCure (brut) avant nettoyage/standardisation
# ---------------------------------------------------------------
lf_lgd_full = pl.concat([lf_lgd, lf_noncure_final], how="diagonal_relaxed")

print("Répartition Cure / NonCure dans la base finale :")
print(
    lf_lgd_full.select("Sous_modele").collect().to_series().value_counts()
)
