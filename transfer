cmp = (
    FusionComparator(
        df_brut,
        class_col="CHR_apres_fusion",
        lgd_col="lgd_obligor",
        obligor_col="ID_CLIENT",
        pairs="adjacent",
        tests=[OVLTest(method="kde")],
    )
    .run()
    .calibrate(
        seuils=[round(s, 2) for s in np.arange(0.50, 0.76, 0.05)],
        n_bootstrap=200,
        n_subsample=300,
        random_state=42,
    )
)

print(f"Seuil calibré : {cmp.seuil_calibre}")
print(cmp.df_calibration)

# solve() utilise automatiquement seuil_calibre
sol = cmp.solve(criterion="ovl", label_style="glouton")
print(f"{sol['n_initial']} → {sol['n_final']} classes")
