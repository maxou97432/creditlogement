import polars as pl
from typing import Tuple, List, Optional

# ---- CONFIG ----
CLASS_COL = "CHR_model"
LGD_COL   = "lgd_obligor"

# Variable globale : seuil de matérialité (points de LGD)
DELTA_LGD_MODELE = 1.5
# ----------------

def meilleur_candidat_fusion_modele(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,      # conservé pour compat, ignoré
    ans_strict: int = 0,              # idem
    lgd_col: str = LGD_COL,
    jenks_col: str = CLASS_COL,
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Niveau MODÈLE : fusionne la paire de CHR_model ADJACENTES (ordre LRA GLOBAL,
    SANS cloisonnement par segment) la plus proche dont l'écart de LGD moyenne
    de long terme est < DELTA_LGD_MODELE.
    """
    
    # Étape 1 : calculer LRA par classe (moyenne des moyennes annuelles)
    ordre_global = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(pl.col("mean_LGD_year").mean().alias("mean_LGD_global"))
        .sort("mean_LGD_global")  # ← ordre GLOBAL, pas de seg
    )

    # Étape 2 : chercher les paires adjacentes et filtrer sur DELTA_LGD_MODELE
    paires = (
        ordre_global.with_columns([
            pl.col(jenks_col).shift(-1).alias("next_class"),           # ← shift global
            pl.col("mean_LGD_global").shift(-1).alias("next_lgd"),    # ← pas de .over("seg")
        ])
        .filter(pl.col("next_class").is_not_null())
        .with_columns((pl.col("next_lgd") - pl.col("mean_LGD_global")).alias("ecart_lgd"))
        .filter(pl.col("ecart_lgd") < DELTA_LGD_MODELE)   # ← FILTRE SUR LA VARIABLE GLOBALE
        .with_columns((-pl.col("ecart_lgd")).alias("severite_totale"))
        .sort("severite_totale", descending=True)
        .select([jenks_col, "next_class", "severite_totale", "ecart_lgd"])
        .collect()
    )

    if log:
        print(f"=== Paires sous le seuil DELTA_LGD_MODELE={DELTA_LGD_MODELE} ===")
        print("Aucune paire." if paires.height == 0 else paires)

    if paires.height == 0:
        return None, None

    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires
