def meilleur_candidat_fusion_materialite(
    df: pl.LazyFrame,
    delta_lgd: float = 1.0,          # points de LGD : LA marge métier documentée
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Fusionne la paire de classes ADJACENTES (par LRA, intra-segment) la plus
    proche, si leur écart de LGD moyenne est < delta_lgd. Sinon (None, None).
    """
    # LRA par classe (moyenne des moyennes annuelles) + segment = préfixe du nom
    ordre_global = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(pl.col("mean_LGD_year").mean().alias("mean_LGD_global"))
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))
        .sort(["seg", "mean_LGD_global"])
    )

    # voisin adjacent INTRA-segment (par LRA croissante) + écart
    paires = (
        ordre_global.with_columns([
            pl.col(jenks_col).shift(-1).over("seg").alias("next_class"),
            pl.col("mean_LGD_global").shift(-1).over("seg").alias("next_lgd"),
        ])
        .filter(pl.col("next_class").is_not_null())          # haut de chaque segment : pas de voisin
        .with_columns((pl.col("next_lgd") - pl.col("mean_LGD_global")).alias("ecart_lgd"))
        .filter(pl.col("ecart_lgd") < delta_lgd)             # matérialité : trop proches
        .sort("ecart_lgd")                                   # la plus proche d'abord
        .select([jenks_col, "next_class", "mean_LGD_global", "next_lgd", "ecart_lgd"])
        .collect()
    )

    if log:
        print("=== Paires sous le seuil de matérialité ===")
        print("Aucune paire." if paires.height == 0 else paires)

    if paires.height == 0:
        return None, None

    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires

paire, debug_df = meilleur_candidat_fusion_materialite(
            df, delta_lgd=delta_lgd, lgd_col=lgd_col, jenks_col=jenks_col, log=log
        )
