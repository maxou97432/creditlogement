# Le chemin est conservé tel quel
geojson_path = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\metropole.geojson" 

# Chemins des données (conservés)
prix_m2_univ_elem_MAJ_CITY = pd.read_csv(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\prix_m2_univ_elem_MAJ_CITY.csv")
df_communes = pd.read_excel(r"N:\uflujek\Commune_france.xlsx", sheet_name="Figure 1")
df_geo_gps = pd.read_csv(r'N:\uflujek\commune_france_gps.csv', sep=';')

# =============================================================================
# --- PALETTE DE COULEURS & POLICE ---
# =============================================================================
CL_TURQUOISE = '#00A79E' 
CL_BLACK = '#000000' 
CL_LIGHT_GREY = '#F0F0F0' 
CL_BLUE_3M = '#004B9B' 
CL_RED_12M = '#E4002B' 

NOM_POLICE_CL = 'Century Gothic' 
plt.rcParams['font.family'] = 'sans-serif' 
plt.rcParams['font.sans-serif'] = [NOM_POLICE_CL, 'Arial', 'Verdana', 'sans-serif'] 
plt.rcParams['font.weight'] = 'medium' 
TITRE_FONT_WEIGHT = 'heavy' 

TAUX_FONT_SIZE = 9
DEFAULT_FONT_SIZE = 10 

# DÉFINITION DU SYSTÈME DE COORDONNÉES CIBLE (Lambert 93)
TARGET_CRS = "EPSG:2154"

# =============================================================================
# --- PRÉPARATION DES DONNÉES ---
# =============================================================================

prix_m2_univ_elem_MAJ_CITY = prix_m2_univ_elem_MAJ_CITY[prix_m2_univ_elem_MAJ_CITY["TYPE_MAILLE"] == "CITY"]
df_communes['Commune'] = df_communes['Commune'].astype(str).str.upper()
df_prix_m2 = df_communes.merge(prix_m2_univ_elem_MAJ_CITY, left_on='Commune', right_on='VAL_MAILLE_GEO', how='right')

# =============================================================================
# --- PRÉPARATION DU CONTOUR GÉOGRAPHIQUE ET PROJECTION ---
# =============================================================================

try:
    # 1. Charger et projeter le contour
    france_gdf = gpd.read_file(geojson_path)
    dissolved_france = france_gdf.dissolve(by=None)
    france_outline_geometry = dissolved_france.to_crs(TARGET_CRS).geometry.iloc[0] # PROJECTION ICI
    print(f"Contour de la France chargé et projeté en {TARGET_CRS}.")
except Exception as e:
    print(f"!!! Échec critique lors du chargement ou de la projection du GeoJSON: {e}")
    sys.exit(1)

# =============================================================================
# --- CRÉATION DE LA CARTE MATPLOTLIB ---
# =============================================================================

types_bien = ['APT', 'MAI']

# --- NOUVELLE DEFINITION DES OFFSETS EN MÈTRES (m) ---
# 10000 mètres = 10 km. Les offsets sont beaucoup plus petits.
METER_OFFSET = 1000 # 1 km.
X_OFFSET_DEFAULT = 3500 # 3.5 km
Y_OFFSET_DEFAULT = 3500 # 3.5 km

CUSTOM_LABEL_OFFSETS = {
    # Offsets en mètres (facteur 1000 = 1km)
    # SUD-EST (Zone encombrée)
    'MONTPELLIER': {'x': -8000, 'y': 5000}, 
    'MARSEILLE':   {'x': -8000,  'y': -8000}, # Gauche, Bas
    'TOULON':      {'x': 5000,  'y': -10000},
    'NICE':        {'x': -8000, 'y': 3000}, 
    'GRENOBLE':    {'x': 8000, 'y': 0},   

    # FRONTIÈRES & CÔTES (Pour rentrer dans les terres)
    'BORDEAUX':    {'x': 8000,  'y': 0},  
    'NANTES':      {'x': 8000,  'y': 0},  
    'RENNES':      {'x': 8000,  'y': 0},  
    'LILLE':       {'x': 0,   'y': -15000}, # 15 km vers le bas
    'STRASBOURG':  {'x': -8000, 'y': 0},  
    
    # CENTRE / AUTRES
    'PARIS':       {'x': 8000, 'y': 3000},
    'LYON':        {'x': -8000, 'y': 3000}, 
    'TOULOUSE':    {'x': -8000, 'y': 3000}, 
}

for type_bien in types_bien:
    print(f"\n--- Génération de la carte pour le type de bien : {type_bien} ---")
    
    df_prix_filtre = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
    df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
    df_map = df_geo_gps.merge(df_prix_filtre, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
    
    df_map = df_map[['label', 'latitude', 'longitude', 'prix_mm_value', "TAUX_INFL_3M", 'TAUX_INFL_12M']].copy()
    df_map = df_map.dropna(subset=['latitude', 'longitude'])
    df_map = df_map.drop_duplicates(subset='label', keep='first')
    
    if df_map.empty: continue
        
    # 2. Créer et projeter les points des villes
    geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
    # Les coordonnées sont en WGS 84 (EPSG:4326) dans le CSV
    gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326")
    # PROJECTION ICI
    gdf = gdf.to_crs(TARGET_CRS) 
    
    # --- DESSIN DE LA CARTE ---
    fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=300) 
    fig.set_facecolor(CL_TURQUOISE) 
    
    # 3. Dessin du contour (déjà projeté)
    geometries_to_plot = [france_outline_geometry]
    if france_outline_geometry.geom_type == 'MultiPolygon':
        geometries_to_plot = list(france_outline_geometry.geoms)

    for geom in geometries_to_plot:
        x, y = geom.exterior.xy
        ax.fill(x, y, color=CL_LIGHT_GREY, zorder=1) 
        ax.plot(x, y, color=CL_BLACK, linewidth=1.0, zorder=2)
    
    xmin, ymin, xmax, ymax = france_outline_geometry.bounds
    # Définition des limites de la carte dans le nouveau CRS (en mètres)
    ax.set_xlim(xmin - 5000, xmax + 5000) 
    ax.set_ylim(ymin - 5000, ymax + 5000)

    # --- AJOUT DES ÉTIQUETTES ---
    
    LINE_SPACING = 15000 # Espacement vertical entre les lignes (en mètres)
    RATE_INNER_SPACING_X = 40000 # Espacement entre les deux taux (en mètres)
    
    halo_effect = [pe.withStroke(linewidth=2.5, foreground="white")]

    for idx, row in gdf.iterrows():
        # Utiliser les coordonnées projetées (x, y)
        x_coord = row.geometry.x 
        y_coord = row.geometry.y 
        city_label = row['label'] 
        
        # Définition des offsets
        if city_label in CUSTOM_LABEL_OFFSETS:
            x_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['x']
            y_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['y']
        else:
            x_offset_city = X_OFFSET_DEFAULT
            y_offset_city = Y_OFFSET_DEFAULT

        ville = str(row['label']).upper()
        prix_val = row['prix_mm_value']
        prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
        ti_3m = row['TAUX_INFL_3M']
        ti_12m = row['TAUX_INFL_12M']
        
        # Ancrage du texte
        anchor_x = x_coord + x_offset_city
        anchor_y = y_coord + y_offset_city
        
        ha_box_align = 'right' if x_offset_city < 0 else 'left'
        va_align = 'top' 
        
        # 1. Nom de la Ville (Ligne 1) 
        ax.text(anchor_x, anchor_y, ville, fontsize=DEFAULT_FONT_SIZE, ha=ha_box_align, va=va_align,
                color=CL_BLACK, weight='bold', zorder=4, 
                path_effects=halo_effect) 
        
        # 2. Prix M2 (Ligne 2) 
        prix_y = anchor_y - LINE_SPACING 
        ax.text(anchor_x, prix_y, prix, fontsize=DEFAULT_FONT_SIZE, ha=ha_box_align, va=va_align,
                color=CL_BLACK, weight='normal', zorder=4,
                path_effects=halo_effect) 
        
        # 3. Taux d'inflation (Ligne 3) - Taille réduite (9)
        ti_y = prix_y - LINE_SPACING 
        
        # Taux 3M (BLEU) - Toujours en premier
        if pd.notna(ti_3m):
            text_3m = f"3M: {ti_3m:+.1%}".replace('.', ',')
        else:
            text_3m = "3M: N/A"

        # Dessin du 3M (BLEU)
        ax.text(anchor_x, ti_y, text_3m, fontsize=TAUX_FONT_SIZE, ha=ha_box_align, va=va_align,
                color=CL_BLUE_3M, weight='bold', zorder=4, 
                path_effects=halo_effect) 
        
        # Taux 12M (ROUGE) - Toujours en second
        if pd.notna(ti_12m):
            text_12m = f"12M: {ti_12m:+.1%}".replace('.', ',')
        else:
            text_12m = "12M: N/A"

        # --- LOGIQUE DE POSITIONNEMENT FIXE (3M puis 12M) ---
        if ha_box_align == 'left':
            x_12m = anchor_x + RATE_INNER_SPACING_X
            align_12m = 'left' 
        else: # ha_box_align == 'right'
            x_12m = anchor_x - RATE_INNER_SPACING_X
            align_12m = 'right' 
        # -----------------------------------------------------

        # Dessin du 12M (ROUGE)
        ax.text(x_12m, ti_y, text_12m, fontsize=TAUX_FONT_SIZE, ha=align_12m, va=va_align,
                color=CL_RED_12M, weight='bold', zorder=4, 
                path_effects=halo_effect)

        # 4. Point Ville
        # Utiliser les coordonnées projetées (x_coord, y_coord)
        ax.plot(x_coord, y_coord, marker='o', color=CL_BLACK, markersize=5, zorder=4, 
                markeredgecolor='white', markeredgewidth=0.5) 

    # --- FINALISATION ---
    ax.axis('off') 
    title_text = f"LES PRIX DES {type_bien} DANS L'ANCIEN"
    ax.set_title(title_text, fontsize=20, loc='center', pad=20, color=CL_BLACK, ha='center', weight=TITRE_FONT_WEIGHT) 
    subtitle_text = "SUR 1 AN DANS LES PRINCIPALES VILLES"
    fig.text(0.5, 0.94, subtitle_text, ha='center', va='top', fontsize=12, color=CL_BLACK, weight='bold') 

    # LÉGENDE
    fig.text(0.05, 0.03, "Source: Crédit Logement, MM 12M", ha='left', va='bottom', fontsize=9, color=CL_BLACK)
    fig.text(0.05, 0.1, "LÉGENDE TAUX:", ha='left', va='bottom', fontsize=9, color=CL_BLACK, weight='bold')
    fig.text(0.05, 0.08, "Bleu: Taux 3 mois", ha='left', va='bottom', fontsize=8, color=CL_BLUE_3M)
    fig.text(0.05, 0.06, "Rouge: Taux 12 mois", ha='left', va='bottom', fontsize=8, color=CL_RED_12M)

    plt.show() 
    plt.close(fig) 
    print(f"Génération terminée pour {type_bien}")
