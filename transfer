def macaulay_annuite_actu(R, y, freq=12):
    """
    Duration de Macaulay sur annuité constante :
    flux totaux (capital + intérêts) constants, ACTUALISÉS.
    """
    n = max(1, int(round(R * freq)))
    if abs(y) < 1e-12:
        return (n + 1) / 2 / freq
    r = y / freq
    v = 1.0 / (1.0 + r)
    t = np.arange(1, n + 1)
    pv = v ** t  # CF constants -> coefficient égal, ne compte pas
    return float(np.sum(t * pv) / np.sum(pv)) / freq


# Test sur le type 3 avec taux contractuel
sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3)
R  = sub3["R"].to_numpy()
NB = sub3["NB_MATURITE_IRBA"].to_numpy()
T_INTRT = sub3["T_INTRT"].to_numpy()

# Variante A : Macaulay avec T_INTRT
pred_macaulay_contr = np.array([macaulay_annuite_actu(r, y) for r, y in zip(R, T_INTRT)])
# Variante B : Macaulay avec yield pivot 5%
pred_macaulay_5pct  = np.array([macaulay_annuite_actu(r, 0.05) for r in R])

for name, pred in [("Macaulay + T_INTRT", pred_macaulay_contr),
                    ("Macaulay + 5%",      pred_macaulay_5pct)]:
    err = pred - NB
    print(f"{name:<25} RMSE={np.sqrt(np.mean(err**2)):.5f}  "
          f"MAE={np.mean(np.abs(err)):.5f}  max={np.max(np.abs(err)):.5f}")

# Stratification par R pour voir si Macaulay corrige le biais sur les courts
print("\nStratification (Macaulay + T_INTRT) :")
for lo, hi in [(0,1), (1,3), (3,5), (5,10), (10,15), (15,20), (20,30)]:
    mask = (R >= lo) & (R < hi)
    if mask.sum() < 50: continue
    err = pred_macaulay_contr[mask] - NB[mask]
    print(f"  [{lo:>2}, {hi:>2}[  n={mask.sum():>6}  "
          f"RMSE={np.sqrt(np.mean(err**2)):.5f}")
