def diff(a, b, name):
    # aligne sur index + colonnes communes avant de soustraire
    a2, b2 = a.align(b, join="inner")
    d = (a2 - b2).abs().max().max()
    print(f"{name:22s} écart max = {d:.3e}")

print(f"\n=== Tables intermédiaires HLC={CAT} ===")
diff(res_pd["n_open_cases"],     res_pl["n_open_cases"],     "n_open_cases")
diff(res_pd["CRR_"],             res_pl["CRR_"],             "CRR_ (mean)")
diff(res_pd["unobs_SR"],         res_pl["unobs_SR"],         "unobs_SR")
diff(res_pd["extrapolated_RR_"], res_pl["extrapolated_RR_"], "extrapolated_RR_")

