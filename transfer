lgd_col = "LGD_finale_maxBIS"
weight_col = "ead_fin"

# Étape 1 : LGD au grain obligor x datdef
# pondéré par l'EAD (Σ LGD x EAD / Σ EAD)
lgd_by_obligor = (
    df
    .group_by(["ID_CLIENT", "datdef"])
    .agg(
        (pl.col(lgd_col) * pl.col(weight_col)).sum() / pl.col(weight_col).sum()
        .alias("lgd_obligor")
    )
)

# Étape 2 : joindre sur df pour récupérer la HLC
df = df.join(
    lgd_by_obligor,
    how="left",
    on=["ID_CLIENT", "datdef"]
)

# Étape 3 : LGD obligor par HLC
# moyenne simple (chaque obligor x datdef pèse 1)
lgd_obligor = (
    df.unique(["ID_CLIENT", "datdef", "HLC"])  # un seul enregistrement par couple
    .group_by("HLC")
    .agg([
        pl.col("lgd_obligor").mean().alias("LGD_obligor"),
        pl.len().alias("nb_obligor")
    ])
    .sort("HLC")
)

print("\n=== LGD moyen (obligor) par HLC ===")
print(lgd_obligor)
