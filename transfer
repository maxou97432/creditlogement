cmp = FusionComparator(
    df_modele, class_col=CLASS_COL, lgd_col=LGD_COL,
    obligor_col=OBLIGOR_COL, pairs="adjacent",
).run()

with pl.Config(fmt_str_lengths=100, tbl_rows=-1):
    print(cmp.matrix())        # OVL + flag_ovl + fusion suggérée par test, par paire adjacente

cmp.calibrate(
    seuils=[round(s, 2) for s in np.arange(0.53, 0.63, 0.01)],   # start < stop
    n_bootstrap=400,
    n_subsample=1000,
    random_state=42,
    n_jobs=-1,             # parallélisé
)
print(cmp.df_calibration)
print(f"\nSeuil OVL modéré retenu (max ARI) : {cmp.seuil_calibre}")

# défaut conservateur : ne fusionne que RED (>= seuil strict = modéré + 0.25)
sol = cmp.solve(criterion="ovl", label_style="glouton", orange_policy="keep")

print(f"{sol['n_initial']} classes → {sol['n_final']} classes finales "
      f"({sol['n_initial'] - sol['n_final']} fusions)\n")
with pl.Config(fmt_str_lengths=200, tbl_rows=-1):
    print(sol["log"])

print("\nComposition finale :")
for label, membres in sorted(sol["composition"].items()):
    print(f"  {label} : {' + '.join(membres)}")
