def construire_table_seuils(dict_seuils: dict, decimales: int = 2) -> pd.DataFrame:
    """
    Table plate, une ligne par tranche CART : variable, colonne_binee,
    indice_tranche, borne_inf, borne_sup, label, effectif, pct_effectif.
    effectif = nombre d'observations non-nulles tombées dans la tranche au
    moment du fit CART (population utilisée pour le découpage, pas
    nécessairement identique à la population complète en cas de nulls).
    """
    rows = []
    for var, info in dict_seuils.items():
        bins = info["bins"]
        effectifs = info.get("effectifs")
        total = sum(effectifs) if effectifs else None
        for i in range(len(bins) - 1):
            lower, upper = bins[i], bins[i + 1]
            effectif = effectifs[i] if effectifs else None
            rows.append({
                "variable": var,
                "colonne_binee": info["colonne_binee"],
                "indice_tranche": i,
                "borne_inf": lower,
                "borne_sup": upper,
                "label": label_intervalle(lower, upper, decimales),
                "effectif": effectif,
                "pct_effectif": (100 * effectif / total) if (effectif is not None and total) else None,
            })
    return pd.DataFrame(rows)
