# ----------------------------------------------------------------------
# Determine la methode d'agregation par episode (contigu -> moyenne ; sinon -> max)
# ----------------------------------------------------------------------
def determine_methodes(generations, label=""):
    methodes = {}
    for dt, gens in generations.items():
        if not gens:
            methodes[dt] = None
            print(f"  [{label}] DT {dt} : aucune generation significative")
        elif est_contigu(gens):
            methodes[dt] = "moyenne"
            print(f"  [{label}] DT {dt} : {gens} -> contigu/homogene -> moyenne number-weighted")
        else:
            methodes[dt] = "max"
            print(f"  [{label}] DT {dt} : {gens} -> NON contigu -> max{{LGD(Yi)}} (jugement expert)")
    return methodes


# ----------------------------------------------------------------------
# Orchestrateur : identification GLOBALE ou PAR SEGMENT
# ----------------------------------------------------------------------
def execution(base, segment_col, lgd_col, freq, downturn, alpha, lag,
              niveau_identification="global"):
    """
    niveau_identification : "global"  -> t-test sur tout le portefeuille, memes generations pour tous les HLC (REBOOT)
                            "segment" -> t-test refait dans chaque HLC, generations propres a chaque classe
    """
    if niveau_identification not in ("global", "segment"):
        raise ValueError("niveau_identification doit valoir 'global' ou 'segment'")
    if not isinstance(downturn, (list, tuple, set)):
        downturn = [downturn]
    date_col = "annee" if freq == "annee" else "year_quarter"

    if segment_col is None or segment_col not in base.columns:
        segment_list = [None]
    else:
        segment_list = base.select(pl.col(segment_col).unique()).to_series().to_list()

    all_tests = []
    generations_glob = methodes_glob = None

    # --- Identification GLOBALE (une seule fois) ---
    if niveau_identification == "global":
        print("=== Identification GLOBALE des generations downturn ===")
        generations_glob, tests_g, _ = identifie_generations(base, lgd_col, date_col,
                                                             downturn, lag, alpha)
        methodes_glob = determine_methodes(generations_glob, label="GLOBAL")
        if tests_g.height:
            all_tests.append(tests_g.with_columns(pl.lit("GLOBAL").alias("segment")))
    else:
        print("=== Identification PAR SEGMENT des generations downturn ===")

    results = []
    for seg in segment_list:
        seg_label = str(seg) if seg is not None else "Global"
        df_seg = base.filter(pl.col(segment_col) == seg) if seg is not None else base
        lra_hlc = float(df_seg.select(pl.col(lgd_col).mean()).item())   # LRA du HLC (number-weighted)

        # --- Source des generations selon le niveau choisi ---
        if niveau_identification == "global":
            generations, methodes = generations_glob, methodes_glob
        else:
            generations, tests_s, _ = identifie_generations(df_seg, lgd_col, date_col,
                                                            downturn, lag, alpha)
            methodes = determine_methodes(generations, label=seg_label)
            if tests_s.height:
                all_tests.append(tests_s.with_columns(pl.lit(seg_label).alias("segment")))

        # --- Quantification de l'impact ---
        best = None
        for dt, gens in generations.items():
            if not gens:
                continue
            sub = df_seg.filter(pl.col(date_col).is_in(gens))
            if sub.height == 0:
                continue
            if methodes[dt] == "moyenne":
                lgd_dt = float(sub.select(pl.col(lgd_col).mean()).item())        # number-weighted
            else:
                yr_seg = sub.group_by(date_col).agg(pl.col(lgd_col).mean().alias("lgd_annee"))
                lgd_dt = float(yr_seg.select(pl.col("lgd_annee").max()).item())  # max{LGD(Yi)}
            impact = max((lgd_dt - lra_hlc) / lra_hlc, 0.0)
            cand = {"downturn": dt, "generations": gens, "methode": methodes[dt],
                    "LGD_DT": lgd_dt, "n_dt": int(sub.height), "impact": impact}
            if best is None or impact > best["impact"]:
                best = cand

        if best is None:
            best = {"downturn": None, "generations": [], "methode": None,
                    "LGD_DT": lra_hlc, "n_dt": None, "impact": 0.0}

        lgd_downturn = lra_hlc * (1 + best["impact"])
        moc = lgd_downturn - lra_hlc

        results.append({
            "segment": seg_label,
            "niveau_identification": niveau_identification,
            "downturn": best["downturn"],
            "generations": str(best["generations"]),
            "methode": best["methode"],
            "expert_a_valider": best["methode"] == "max",
            "n_dt": best["n_dt"],
            "lra": lra_hlc,
            "LGD_DT": best["LGD_DT"],
            "impact": best["impact"],
            "lgd_downturn": lgd_downturn,
            "moc": moc,
        })
        print(f"Seg {seg_label:>6} : LRA={lra_hlc:.4f}  LGD_DT={best['LGD_DT']:.4f}  "
              f"({best['methode']})  impact={best['impact']*100:.2f}%  "
              f"LGD_downturn={lgd_downturn:.4f}  MoC={moc:.4f}")

    df_all_test = pl.concat(all_tests) if all_tests else pl.DataFrame()
    return pl.DataFrame(results), df_all_test
