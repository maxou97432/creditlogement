import matplotlib.pyplot as plt
import polars as pl

# Échantillon par segment pour visualiser
for ptf in ["Corporate", "Retail"]:
    sub = df.filter(pl.col("CD_PORTFOLIO") == ptf).sample(n=20_000, seed=42)
    mat = sub["NB_MATURITE_IRBA"].to_numpy()
    dur = sub["NB_DURATION_IRBA"].to_numpy()
    
    fig, ax = plt.subplots(figsize=(10, 8))
    ax.scatter(mat, dur, s=1, alpha=0.2)
    ax.plot([0, 10], [0, 10], 'r--', lw=0.5, label='y=x')
    ax.axhline(1, color='g', ls=':', lw=0.5)
    ax.axhline(5, color='g', ls=':', lw=0.5)
    ax.axvline(1, color='g', ls=':', lw=0.5)
    ax.axvline(5, color='g', ls=':', lw=0.5)
    ax.set_xlim(0, 10); ax.set_ylim(0, 10)
    ax.set_xlabel("NB_MATURITE_IRBA")
    ax.set_ylabel("NB_DURATION_IRBA")
    ax.set_title(f"{ptf}  (n={len(sub):,})")
    ax.legend()
    plt.tight_layout()
    plt.savefig(f"scatter_{ptf}.png", dpi=120)
    plt.show()
