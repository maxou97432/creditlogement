try:
    france_gdf = gpd.read_file(geojson_path)
    dissolved_france = france_gdf.dissolve(by=None)
    
    # 1. Projeter et extraire la géométrie du MultiPolygon
    france_geometry = dissolved_france.to_crs(TARGET_CRS).geometry.iloc[0] 
    
    # 2. Séparer les différents polygones (continent et îles)
    geometries_list = []
    if france_geometry.geom_type == 'MultiPolygon':
        geometries_list = list(france_geometry.geoms)
    else:
        geometries_list = [france_geometry]

    # 3. Trouver le plus grand polygone (le continent)
    if geometries_list:
        # Trier par aire (surface) et prendre le plus grand (le continent)
        geometries_list.sort(key=lambda x: x.area, reverse=True)
        france_outline_geometry = geometries_list[0]
        print("INFO: La Corse et les îles mineures ont été exclues.")
    else:
        raise ValueError("Aucune géométrie de contour trouvée après dissolution.")
        
except Exception as e:
    print(f"!!! Échec critique lors du chargement ou de la projection du GeoJSON: {e}")
    sys.exit(1)

