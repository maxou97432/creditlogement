# ── Étape 1 : Recréer la sous-population ──────────────────────────
sous_pop2 = base.filter(
    (pl.col("IND_CREDIT_CONFIRME") == 0.0) &
    (pl.col("NB_MATURITE_IRBA") < 1.0) &
    (pl.col("Flag_Revolving") == 0.0)
).with_columns(
    pl.when(pl.col("NB_DURATION_IRBA") == 1.0)
    .then(pl.lit("floor_OK"))
    .otherwise(pl.lit("pas_floor"))
    .alias("groupe")
)

floor_ok  = sous_pop2.filter(pl.col("groupe") == "floor_OK")
pas_floor = sous_pop2.filter(pl.col("groupe") == "pas_floor")

print(f"floor_OK  : {floor_ok.height} lignes")
print(f"pas_floor : {pas_floor.height} lignes")

# ── Étape 2 : Tester les colonnes candidates ───────────────────────
for col in ["CD_PORT_PRUDENTIEL", "CD_CLASSE_COLLECTE",
            "CD_SEGMENTATION_MAE", "CD_CLASS_EXP_STD",
            "CD_TYPE_AMORT", "CD_PORTFOLIO"]:
    if col not in base.columns:
        print(f"{col} : absent")
        continue
    print(f"\n--- {col} ---")
    print("floor_OK :")
    print(floor_ok[col].value_counts().sort("count", descending=True).head(5))
    print("pas_floor :")
    print(pas_floor[col].value_counts().sort("count", descending=True).head(5))
