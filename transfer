def get_TTW(dtm, ttwcol: str = "TTW"):
    """Recupere l'unique valeur de TTW d'une table (pandas ou polars)."""
    if pl is not None and isinstance(dtm, (pl.DataFrame, pl.LazyFrame)):
        vals = (dtm.lazy().select(pl.col(ttwcol).unique()).collect()
                .to_series().to_list())
    else:
        vals = list(pd.unique(dtm[ttwcol]))
    assert len(vals) == 1, f"Too many TTW: {vals}"
    return int(vals[0])


def extrapolate_survival_rate(annee_courante: int, TTW: int,
                              fields: Sequence[str] = ("CRR_",),
                              *,
                              n_open_cases: pd.DataFrame | None = None,
                              means: Mapping[str, pd.DataFrame] | None = None,
                              stepwise_SR: bool = False,
                              weighted_facility: bool = False,
                              expanding_dev_factor: bool = True,
                              expanding_sr: bool = False,
                              deflator: str = "n_open_start",
                              mask_rule: str = "observation",
                              **kwargs: Any) -> dict[str, Any]:
    """Calcule dev factors, survival rates et marges extrapolees.

    Travaille exclusivement sur les triangles agreges, donc identique quel que
    soit le moteur qui les a produits.
    """
    results: dict[str, Any] = {"n_open_cases": n_open_cases}
    for f in fields:
        results[f] = means[f]

    for f in fields:
        results[f"m{f}_open"] = get_RR_open(results[f], n_open_cases, TTW=TTW,
                                            deflator=deflator)
        results[f"dev_factor_m{f}"] = get_dev_factor(
            results[f"m{f}_open"], n_open_cases,
            TTW=TTW, weighted_facility=weighted_facility,
            expanding=expanding_dev_factor,       # FIX-01
        )

    first = fields[0]
    if stepwise_SR:
        results["unobs_SR"] = get_unobserved_SR_stepwise(
            n_open_cases, results[first], TTW=TTW,
            weighted_facility=weighted_facility)
    else:
        results["unobs_SR"] = get_unobserved_survival_rate(
            n_open_cases, results[first], TTW=TTW, expanding=expanding_sr)

    for f in fields:
        suffix = f[1:] if f.startswith("C") else f
        results[f"extrapolated_{suffix}"] = get_extrapolated_RR(
            results["unobs_SR"], results[f"dev_factor_m{f}"], n_open_cases,
            annee_courante - 1, TTW=TTW, mask_rule=mask_rule)

    return results


def extrapolate_all_categories(annee_courante: int,
                               dtm_in,
                               category_column: str,
                               fields: Sequence[str],
                               marginal_fields: Sequence[str],
                               final_suffix: str = "_final",
                               engine: str = "pandas",
                               preset: str = "corrected",
                               snapshot_year: int | None = None,
                               bounds: Mapping[str, tuple] | None = None,
                               **kwargs: Any):
    """Extrapole tous les champs, pour toutes les categories.

    Parameters
    ----------
    engine : {"pandas", "polars"}
        Moteur de calcul. ``"polars"`` est recommande au-dela de ~500 k lignes.
        Les deux moteurs partagent le coeur methodologique et doivent produire
        des chiffres identiques.
    bounds : mapping, optional
        Bornes structurelles par champ, ex. ``{"CAD_act_": (None, 0.0)}``
        pour interdire un CAD positif. Appliquees a chaque horizon reconstruit
        (OPEN-03).
    kwargs
        Transmis a :func:`extrapolate_survival_rate` (``stepwise_SR``,
        ``weighted_facility``, ``expanding_dev_factor``).

    Returns
    -------
    (results, dtm_filled)
    """
    if engine not in ("pandas", "polars"):
        raise ValueError(f"engine doit valoir 'pandas' ou 'polars', recu {engine!r}")
    if engine == "polars" and pl is None:
        raise ImportError("polars n'est pas installe")
    if preset not in PRESETS:
        raise ValueError(f"preset doit valoir {list(PRESETS)}, recu {preset!r}")

    # Le preset fournit les defauts ; tout kwarg explicite le surcharge.
    cfg = dict(PRESETS[preset])
    cfg.update({k: v for k, v in kwargs.items() if k in cfg})
    kwargs = {k: v for k, v in kwargs.items() if k not in cfg}
    sas_completion = cfg.pop("sas_completion")
    if sas_completion and snapshot_year is None:
        snapshot_year = annee_courante
        log.warning("preset='sas' : snapshot_year non fourni, %s utilise", snapshot_year)

    bounds = bounds or {}

    # --- FIX-06 : on utilise category_column, plus la chaine "categories"
    if engine == "polars":
        base = dtm_in.lazy() if isinstance(dtm_in, pl.DataFrame) else dtm_in
        pairs = (base.select([category_column, "TTW"]).unique().collect())
        n_pairs, n_cats = pairs.height, pairs[category_column].n_unique()
        cats = pairs[category_column].to_list()
    else:
        _d = dtm_in[[category_column, "TTW"]]
        n_pairs = _d.drop_duplicates().shape[0]
        n_cats = _d[category_column].nunique()
        cats = list(pd.unique(dtm_in[category_column]))
    assert n_pairs == n_cats, "There is a mismatch in terms of TTW per category"

    results: dict[Any, Any] = {}
    parts = []

    for cat in cats:
        # ---------------------------------------------------------- sous-table
        if engine == "polars":
            sub_dtm = base.filter(pl.col(category_column) == cat)
            TTW = get_TTW(sub_dtm)
            if sas_completion:
                sub_dtm = apply_sas_completion_pl(sub_dtm, fields, TTW, snapshot_year)
            sub_pl = _add_required_fields_pl(sub_dtm, fields, marginal_fields, TTW).collect()
            n_open_cases = get_n_open_pl(sub_pl, TTW)
            means = {f: get_mean_pl(sub_pl, f, TTW=TTW) for f in fields}
        else:
            sub_dtm = dtm_in.loc[dtm_in[category_column] == cat, :].copy()  # FIX-08
            TTW = get_TTW(sub_dtm)
            if sas_completion:
                sub_dtm = apply_sas_completion_pd(sub_dtm, fields, TTW,
                                                  snapshot_year, inplace=True)
            sub_dtm = add_required_fields(sub_dtm, fields, marginal_fields,
                                          TTW=TTW, inplace=True)
            n_open_cases = get_n_open_pd(sub_dtm, TTW)
            means = {f: get_mean_pd(sub_dtm, f, TTW=TTW) for f in fields}

        # ------------------------------------------- coeur methodologique
        results[cat] = extrapolate_survival_rate(
            annee_courante, TTW, fields=fields,
            n_open_cases=n_open_cases, means=means, **cfg, **kwargs)

        # ---------------------------------------- reinjection, champ par champ
        # FIX-03 / FIX-08 : UNE seule table par categorie, enrichie
        # successivement. L'ancienne version empilait le resultat
        # intermediaire ET le resultat final dans la liste de sortie.
        if engine == "polars":
            filled = sub_pl.lazy()
            for f in fields:
                suffix = f[1:] if f.startswith("C") else f
                lo, hi = bounds.get(f, (None, None))
                filled = extrapolate_on_dtm_pl(
                    filled, results[cat][f"extrapolated_{suffix}"],
                    f, TTW, f"{f}{final_suffix}", lower_bound=lo, upper_bound=hi)
            parts.append(filled.collect())
        else:
            filled = sub_dtm
            for f in fields:
                suffix = f[1:] if f.startswith("C") else f
                lo, hi = bounds.get(f, (None, None))
                filled = extrapolate_on_dtm_pd(
                    filled, results[cat][f"extrapolated_{suffix}"],
                    f, TTW, f"{f}{final_suffix}",
                    lower_bound=lo, upper_bound=hi, inplace=True)
            parts.append(filled)

    dtm_filled = pl.concat(parts, how="vertical") if engine == "polars" \
        else pd.concat(parts, axis=0)
    return results, dtm_filled


def _add_required_fields_pl(lf: "pl.LazyFrame", cum_names: Sequence[str],
                            marg_names: Sequence[str], TTW: int,
                            date_fin: str = "date_fin",
                            datdef: str = "datdef_ap_mdef") -> "pl.LazyFrame":
    """Equivalent polars de :func:`add_required_fields`."""
    delta = (pl.col(date_fin) - pl.col(datdef)).dt.total_days()
    exprs = [(delta >= 365 * (i - 1)).alias(f"open_H{i}") for i in range(1, TTW + 1)]
    for c, m in zip(cum_names, marg_names):
        exprs.append(pl.col(f"{c}1an").alias(f"{m}1an"))
        for i in range(2, TTW + 1):
            prev = f"{c}1an" if i == 2 else f"{c}{i-1}ans"
            exprs.append((pl.col(f"{c}{i}ans") - pl.col(prev)).alias(f"{m}{i}ans"))
    return lf.with_columns(exprs)


