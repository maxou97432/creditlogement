def meilleur_candidat_fusion_v6_welch(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    WELCH-BASED : fusionne la paire adjacente la plus PROCHE,
    SAUF si test de Welch rejette l'équivalence (p < alpha).
    
    Logique :
      - Welch H0 : "les deux distributions ont la même moyenne"
      - p >= alpha : on ne rejette pas H0 → équivalentes → FUSIONNER
      - p < alpha  : on rejette H0 → différentes → BLOQUER
    
    Plus simple que TOST, plus robuste que juste écart de moyennes.
    """
    from scipy import stats as sp_stats
    
    ordre_global = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(
            pl.col("mean_LGD_year").mean().alias("mean_LGD_global"),
            pl.col("mean_LGD_year").std(ddof=1).alias("std_LGD_global"),
        )
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))
        .sort(["seg", "mean_LGD_global"])
        .collect()
    )

    obligors_per_class = {}
    df_collected = df.select([jenks_col, lgd_col]).collect()
    for cls_name in df_collected.select(jenks_col).unique().to_series():
        obligors_per_class[cls_name] = (
            df_collected.filter(pl.col(jenks_col) == cls_name)
            .select(lgd_col)
            .to_numpy()
            .flatten()
        )

    paires_list = []
    
    for i in range(len(ordre_global) - 1):
        row_i = ordre_global[i]
        seg_i = row_i[jenks_col].str.split("_").list.first().item()
        cls_1 = row_i[jenks_col].item()
        mean_1 = row_i["mean_LGD_global"].item()

        # Chercher voisin intra-segment
        cls_2 = None
        mean_2 = None
        
        for j in range(i + 1, len(ordre_global)):
            row_j = ordre_global[j]
            seg_j = row_j[jenks_col].str.split("_").list.first().item()
            
            if seg_j == seg_i:
                cls_2 = row_j[jenks_col].item()
                mean_2 = row_j["mean_LGD_global"].item()
                break
        
        if cls_2 is None:
            continue

        arr1 = obligors_per_class[cls_1]
        arr2 = obligors_per_class[cls_2]
        gap = mean_2 - mean_1
        
        # --- TEST DE WELCH ---
        t_stat, p_value = sp_stats.ttest_ind(arr1, arr2, equal_var=False)
        
        # VETO : si p < alpha, rejeter l'équivalence → ne pas fusionner
        if p_value < ALPHA_WELCH:
            continue  # BLOQUÉ : distributions significativement différentes
        
        # VETO (optionnel) : Wasserstein comme guard-rail supplémentaire
        w = wasserstein_distance(arr1, arr2)
        if w > W_MAX:
            continue  # BLOQUÉ : distributions trop éloignées même si Welch passe
        
        # Si Welch ne rejette pas (p >= alpha) : FUSION !
        paires_list.append({
            jenks_col: cls_1,
            "next_class": cls_2,
            "gap": gap,
            "t_stat": t_stat,
            "p_welch": p_value,
            "welch_pass": p_value >= ALPHA_WELCH,
            "wasserstein": w,
            "n_lo": len(arr1),
            "n_hi": len(arr2),
            "severite_totale": abs(gap),  # Plus proche = score bas = priorité
        })

    paires = pl.DataFrame(paires_list) if paires_list else pl.DataFrame()

    if log:
        print("=== V6: Welch + Wasserstein (guard-rail) ===")
        print(f"Paires candidates : {paires.height}")
        if paires.height > 0:
            print(paires.sort("severite_totale").head(5))

    if paires.height == 0:
        return None, None

    # Fusionner la PLUS PROCHE (écart minimal)
    paires = paires.sort("severite_totale")
    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires


