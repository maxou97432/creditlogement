# ============ CONFIGURATION DU PIPELINE ============
pipeline:
  name: "Pipeline_LGD_RiskQuant"
  notebooks:
    - name: "0 - Chargement.ipynb"
      input_file: null                      # lit les DTM + l'Excel de segmentation
      output_file: "loaded_file"

    - name: "1A - Calcul_LGD.ipynb"
      input_file: "loaded_file"
      output_file: "score_file"

    - name: "1B - Creation CHR.ipynb"
      input_file: "score_file"
      output_file: "chr_file"

    - name: "2 - Rassemblement niveau Modèle.ipynb"
      input_file: "chr_file"
      output_file: "rassemblement_file"

    - name: "3 - TTW and LGD Extrapolation.ipynb"
      input_file: "rassemblement_file"
      output_file: "survival_rate_file"

    - name: "4 - Calcul_obligor.ipynb"
      # TEMPORAIRE : pointe sur la sortie du NB2 tant que le NB3 n'est pas finalisé.
      # À repasser sur "survival_rate_file" le jour où le NB3 est réactivé.
      input_file: "rassemblement_file"
      output_file: "lra_file"

    - name: "5A - Tests d'hétérogénéité.ipynb"
      input_file: "lra_file"
      output_file: "heterogeneite_file"

    - name: "5B - HLC Verification.ipynb"
      input_file: "heterogeneite_file"
      output_file: "heterogeneite_file"     # à ajuster si le 5B écrit ailleurs

    - name: "6 - MoC C.ipynb"
      input_file: "heterogeneite_file"
      output_file: "moc_c_file"

    - name: "7 - MoC Downturn.ipynb"
      input_file: "moc_c_file"
      output_file: "downturn_file"

execution:
  method: "papermill"
  stop_on_error: true
