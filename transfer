import pandas as pd
import numpy as np
import itertools
import warnings
import logging
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_squared_error
from statsmodels.tsa.arima.model import ARIMA
from statsmodels.tsa.holtwinters import ExponentialSmoothing
from prophet import Prophet

# --- CONFIGURATION ---
warnings.filterwarnings("ignore")
logging.getLogger('cmdstanpy').setLevel(logging.WARNING)
logging.getLogger('prophet').setLevel(logging.WARNING)

# --- BOUCLE SUR CHAQUE SEGMENT ---
unique_segments = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

for segment_name, segment_data in unique_segments:
    print(f"\n========================================================")
    print(f"ANALYSE DU SEGMENT : {segment_name}")
    print(f"========================================================")

    # 1. PRÉPARATION DES DONNÉES
    df_analyse = segment_data.sort_values("Periode").set_index("Periode")
    
    if 'Dif' not in df_analyse.columns:
        df_analyse['Dif'] = df_analyse['Indice de prix (CL)'] - df_analyse['Indice de prix (INSEE) - Base 2020']

    ts_ecart = df_analyse['Dif'].dropna()
    ts_ecart.index = pd.PeriodIndex(ts_ecart.index, freq='Q')

    print(f"   Série chargée : {len(ts_ecart)} trimestres du {ts_ecart.index[0]} au {ts_ecart.index[-1]}")
    
    if len(ts_ecart) < 16: # Besoin de minimum 16 points pour CV 5 splits + horizon 4
        print("   ⚠️ Série trop courte pour l'analyse complète. Passage au segment suivant.")
        continue

    # ==============================================================================
    # 2. OPTIMISATION SARIMA (Grid Search AIC)
    # ==============================================================================
    print("   2. Optimisation SARIMA...")
    
    p = q = range(0, 3) 
    d = [1]
    P = Q = range(0, 2)
    D = [0, 1]
    s = [4]

    pdq = list(itertools.product(p, d, q))
    seasonal_pdq = list(itertools.product(P, D, Q, s))

    best_aic = float("inf")
    best_order = (1, 1, 0)
    best_seasonal_order = (0, 0, 0, 4)
    
    train_calibration = ts_ecart.iloc[:int(len(ts_ecart)*0.75)] # Calibration sur le passé

    for param in pdq:
        for param_seasonal in seasonal_pdq:
            try:
                mod = ARIMA(train_calibration, order=param, seasonal_order=param_seasonal,
                            enforce_stationarity=False, enforce_invertibility=False)
                results = mod.fit()
                if results.aic < best_aic:
                    best_aic = results.aic
                    best_order = param
                    best_seasonal_order = param_seasonal
            except:
                continue
                
    print(f"      -> SARIMA Optimal : Order={best_order}, Seasonal={best_seasonal_order}")

    # ==============================================================================
    # 3. OPTIMISATION PROPHET (Grid Search Rapide sur CV interne)
    # ==============================================================================
    print("   3. Optimisation Prophet...")
    # On optimise Prophet sur une validation croisée interne avant le tournoi final
    
    prophet_params_grid = {
        'changepoint_prior_scale': [0.01, 0.05, 0.1, 0.5],
        'seasonality_prior_scale': [0.1, 1.0, 10.0]
    }
    
    df_prophet_tuning = pd.DataFrame({'ds': train_calibration.index.to_timestamp(), 'y': train_calibration.values})
    
    best_prophet_rmse = float('inf')
    best_prophet_params = {'changepoint_prior_scale': 0.05, 'seasonality_prior_scale': 10.0} # Defaut
    
    # Grid search manuel simple sur Prophet (Hold-out interne)
    for cp_scale in prophet_params_grid['changepoint_prior_scale']:
        for seas_scale in prophet_params_grid['seasonality_prior_scale']:
            try:
                m = Prophet(changepoint_prior_scale=cp_scale, seasonality_prior_scale=seas_scale, 
                            yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False)
                m.fit(df_prophet_tuning)
                # Test sur la fin du set de calibration (simulé)
                future = m.make_future_dataframe(periods=4, freq='Q')
                fcst = m.predict(future)
                # On compare juste la dernière année ajustée (in-sample fit quality proxy)
                rmse_proxy = np.sqrt(mean_squared_error(df_prophet_tuning['y'][-4:], fcst['yhat'][-4:]))
                
                if rmse_proxy < best_prophet_rmse:
                    best_prophet_rmse = rmse_proxy
                    best_prophet_params = {'changepoint_prior_scale': cp_scale, 'seasonality_prior_scale': seas_scale}
            except:
                continue
                
    print(f"      -> Prophet Optimal : {best_prophet_params}")


    # ==============================================================================
    # 4. LE TOURNOI : CROSS-VALIDATION (Robustesse)
    # ==============================================================================
    print("   4. Tournoi Cross-Validation...")

    n_splits = 5
    test_horizon = 4
    tscv = TimeSeriesSplit(n_splits=n_splits, test_size=test_horizon)

    results_cv = {'SARIMA Opti': [], 'DES (Holt)': [], 'TES (Holt-Winters)': [], 'Prophet Opti': []}

    for train_index, test_index in tscv.split(ts_ecart):
        cv_train = ts_ecart.iloc[train_index]
        cv_test = ts_ecart.iloc[test_index]

        # A. SARIMA
        try:
            mod = ARIMA(cv_train, order=best_order, seasonal_order=best_seasonal_order, 
                        enforce_stationarity=False, enforce_invertibility=False).fit()
            pred = mod.forecast(steps=test_horizon)
            results_cv['SARIMA Opti'].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except:
            results_cv['SARIMA Opti'].append(np.nan)

        # B. DES (Holt)
        try:
            mod = ExponentialSmoothing(cv_train, trend='add', seasonal=None, damped_trend=True, initialization_method="estimated").fit()
            pred = mod.forecast(steps=test_horizon)
            results_cv['DES (Holt)'].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except:
            results_cv['DES (Holt)'].append(np.nan)

        # C. TES (Holt-Winters)
        try:
            mod = ExponentialSmoothing(cv_train, trend='add', seasonal='add', seasonal_periods=4, damped_trend=True, initialization_method="estimated").fit()
            pred = mod.forecast(steps=test_horizon)
            results_cv['TES (Holt-Winters)'].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except:
            results_cv['TES (Holt-Winters)'].append(np.nan)

        # D. Prophet Optimisé
        try:
            df_cv = pd.DataFrame({'ds': cv_train.index.to_timestamp(), 'y': cv_train.values})
            m = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False, **best_prophet_params)
            m.fit(df_cv)
            future = m.make_future_dataframe(periods=test_horizon, freq='Q')
            fcst = m.predict(future)
            pred = fcst['yhat'].iloc[-test_horizon:].values
            results_cv['Prophet Opti'].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except:
            results_cv['Prophet Opti'].append(np.nan)

    # ==============================================================================
    # 5. RÉSULTATS FINAUX DU SEGMENT
    # ==============================================================================
    df_results = pd.DataFrame(results_cv)
    summary = pd.DataFrame({
        'RMSE Moyen': df_results.mean(),
        'Stabilité (Std)': df_results.std()
    }).sort_values("RMSE Moyen")
    
    print("\n   🏆 CLASSEMENT DU SEGMENT :")
    print(summary)
    print(f"   ✅ Vainqueur : {summary.index[0]}")
