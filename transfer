# 1. Définition des plages de paramètres
# On reste prudent (0 à 2) pour éviter le sur-apprentissage et les temps de calcul infinis
p = q = range(0, 5)
d = [1] # On sait que la série n'est pas stationnaire (ADF False)

P = Q = range(0, 4) # Saisonniers : souvent 0 ou 1 suffit
D = [0, 1]          # Différenciation saisonnière : à tester
s = [4]             # S = 4 car données Trimestrielles (Quarterly)

# Création de toutes les combinaisons possibles
pdq = list(itertools.product(p, d, q))
seasonal_pdq = list(itertools.product(P, D, Q, s))

print(f"Nombre total de modèles à tester : {len(pdq) * len(seasonal_pdq)}")
print("Recherche du meilleur modèle SARIMA en cours... (Patience)")
print("-" * 50)

best_aic = float("inf")
best_params = None
best_seasonal_params = None
best_model = None

# 2. Boucle de Grid Search
for param in pdq:
    for param_seasonal in seasonal_pdq:
        try:
            # Entrainement du modèle SARIMA
            # enforce_stationarity=False permet d'éviter des erreurs sur des séries courtes
            mod = ARIMA(train,
                        order=param,
                        seasonal_order=param_seasonal,
                        enforce_stationarity=False,
                        enforce_invertibility=False)

            results = mod.fit()

            # Sélection sur critère AIC
            if results.aic < best_aic:
                best_aic = results.aic
                best_params = param
                best_seasonal_params = param_seasonal
                best_model = results
            
            # Optionnel : Afficher l'avancement (peut être verbeux)
            # print(f'SARIMA{param}x{param_seasonal} - AIC:{results.aic:.2f}')

        except:
            continue

