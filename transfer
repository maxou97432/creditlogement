def apply_nice_correction(df):
    """Corrige le nom de ville pour Nice basé sur les codes IRIS/ZIP."""
    col_ref = None
    if "code_iris" in df.columns: col_ref = "code_iris"
    elif "IRIS" in df.columns: col_ref = "IRIS"
    
    if col_ref:
        # On s'assure que c'est du string
        mask_nice = df[col_ref].astype(str).str[:5].isin(CODES_INSEE_NICE)
        if mask_nice.sum() > 0:
            df.loc[mask_nice, "Ville"] = "NICE"
    return df

def process_cl_dataset(file_path, label_version, is_v2=False):
    """
    Traite une base CL (V1 ou V2) pour produire une série temporelle de prix lissés.
    """
    print(f"\n--- Traitement CL : {label_version} ---")
    try:
        df = pd.read_parquet(file_path)
    except Exception as e:
        print(f"Erreur critique chargement {file_path}: {e}")
        return None

    # 1. Renommage Standard
    rename_map = {"ville_": "Ville", "DEPT_Corse_2A_2B": "DEPT", "code_iris": "IRIS"}
    df = df.rename(columns=rename_map)
    df["Ville"] = df["Ville"].astype(str).str.strip().str.upper()
    
    # 2. Filtrages Spécifiques
    if is_v2:
        # Filtres stricts pour la V2
        if "SOURCE" in df.columns: df = df[df["SOURCE"] == "CL"]
        
        # Filtre Métropole
        dept = df["DEPT"].astype(str).str.upper().str.strip()
        metropole = {f"{i:02d}" for i in range(1, 96)} | {"2A", "2B"}
        df = df[dept.isin(metropole)]
        
        # Filtre Nature Opération
        if "CD_NATUR_OP" in df.columns:
            df = df[~df["CD_NATUR_OP"].isin(["TVX", "RAC"])]
            
        # !!! CRITIQUE : On ne garde que les transactions (Demande=0) pour le prix !!!
        if "DEMANDE" in df.columns:
            df = df[df["DEMANDE"] == 0]

    # 3. Nettoyage Commun
    df["DATE"] = pd.to_datetime(df["DATE"], errors="coerce")
    
    # Harmonisation Noms Villes
    df["Ville"] = df["Ville"].replace({
        "HAVRE": "LE HAVRE", "SAINT ETIENNE": "SAINT-ETIENNE", "ST ETIENNE": "SAINT-ETIENNE"
    })
    df = apply_nice_correction(df)
    
    # Filtre Top 15 et Dates valides
    df = df[df["Ville"].isin(TOP15_CITIES)]
    df = df.dropna(subset=["DATE", "Ville", "TYPE_BIEN"])
    df["Periode"] = df["DATE"].dt.to_period("M").dt.to_timestamp()

    # 4. Agrégation Mensuelle
    keys = ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE", "Periode"]
    univ_mensuel = df.groupby(keys, dropna=False).agg(
        nb_transac=("ID", "size"),
        prix_moyen=("Prix_m2", "mean")
    ).reset_index()

    # Nettoyage Typologies
    univ_mensuel["PB"] = univ_mensuel["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
    univ_mensuel["TYPE_BIEN"] = univ_mensuel["TYPE_BIEN"].astype(str).str.strip().str.upper()
    univ_mensuel = univ_mensuel[univ_mensuel["TYPE_BIEN"] == univ_mensuel["PB"]].drop(columns="PB")

    # 5. Complétion des mois manquants
    def complete_months(g):
        g = g.sort_values("Periode").set_index("Periode")
        idx = pd.date_range(g.index.min(), g.index.max(), freq="MS")
        g = g.reindex(idx)
        for col in ["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]:
            g[col] = g[col].ffill().bfill()
        g["nb_transac"] = g["nb_transac"].fillna(0)
        return g.reset_index().rename(columns={"index": "Periode"})

    univ_complet = univ_mensuel.groupby(["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], group_keys=False).apply(complete_months)

    # 6. Poids Structurels & Indicatrices
    poids = univ_mensuel.groupby(["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], as_index=False)["nb_transac"].sum()
    poids = poids.rename(columns={"nb_transac": "poids_total"})
    poids["poids_relatif"] = poids.groupby('Ville')["poids_total"].transform(lambda x: x / x.sum())
    
    univ_complet = univ_complet.merge(poids, on=["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], how="left")
    
    # Indicateur de présence sur 12 mois
    univ_complet = univ_complet.sort_values(keys)
    univ_complet["I_12m"] = univ_complet.groupby(["Ville", "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"])["nb_transac"].transform(
        lambda s: (s.rolling(12, min_periods=12).sum() > 0).astype(int)
    )

    # 7. Moyenne Mobile Pondérée (12 Mois)
    def calc_weighted_mm(g):
        res = []
        periodes = g["Periode"].unique()
        for i, p in enumerate(periodes):
            start = max(0, i - 11)
            subset = g[g["Periode"].isin(periodes[start:i+1])]
            subset = subset[(subset["prix_moyen"].notna()) & (subset["I_12m"] == 1)]
            
            val = np.nan
            if not subset.empty and subset["poids_relatif"].sum() > 0:
                val = np.average(subset["prix_moyen"], weights=subset["poids_relatif"])
            res.append({"Periode": p, "prix_mm": val})
        return pd.DataFrame(res)

    final_res = []
    for ville in univ_complet["Ville"].unique():
        mm = calc_weighted_mm(univ_complet[univ_complet["Ville"] == ville])
        mm["Ville"] = ville
        mm = mm.rename(columns={"prix_mm": f"Indice CL ({label_version})"})
        final_res.append(mm)

    return pd.concat(final_res, ignore_index=True)

