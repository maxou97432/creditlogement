import pandas as pd
import numpy as np
import plotly.graph_objects as go
from statsmodels.tsa.holtwinters import ExponentialSmoothing
import plotly.io as pio
import warnings
from IPython.display import display # Import for display function

# Configuration
warnings.filterwarnings("ignore")
pio.renderers.default = "notebook" 

# --- Initialisation ---
n_forecast = 2 # Nombre de trimestres à prédire (T+1, T+2)
corrected_data = [] 
future_adjustments = [] 

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("🚀 Démarrage de la modélisation Holt-Winters (TEST + PRÉVISION)...")

for name, group in grouped:
    zone, type_bien = name
    
    # 1. Préparation des données
    group = group.sort_values("Periode").set_index("Periode")
    group['Indice de prix (CL) - Corrigé TES'] = np.nan
    
    # Série de l'écart (Biais)
    ts_ecart = group['Dif'].dropna()
    
    # Données nécessaires pour la prévision
    last_cl_value = group['Indice de prix (CL)'].iloc[-1]
    last_date = group.index[-1]
    
    # On force la fréquence pour statsmodels
    if not ts_ecart.empty and len(ts_ecart) > 12:
        try:
            ts_modeling = ts_ecart.copy()
            ts_modeling.index = pd.PeriodIndex(ts_modeling.index, freq='Q')
        except Exception as e:
            print(f"Échec de l'indexation Period pour {name}: {e}")
            continue

        try:
            # =================================================================
            # 2. Modélisation TES (Holt-Winters)
            # =================================================================
            model = ExponentialSmoothing(
                ts_modeling, 
                trend='add', 
                seasonal='add', 
                seasonal_periods=4, 
                damped_trend=True, 
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # =================================================================
            # 3. Calculs : Passé (Backtest) et Futur (Forecast)
            # =================================================================
            
            # --- A. Correction Historique (LE FIX) ---
            # 1. Récupérer les valeurs ajustées (Fitted Values)
            ecart_modelise = model_fit.fittedvalues
            
            # 2. Conversion de PeriodIndex -> DatetimeIndex pour l'alignement
            ecart_modelise.index = ecart_modelise.index.to_timestamp()
            
            # 3. Calcul de la courbe corrigée (CL Brut - Biais Modélisé)
            cl_corrected_history = group['Indice de prix (CL)'] - ecart_modelise.reindex(group.index)
            group['Indice de prix (CL) - Corrigé TES'] = cl_corrected_history
            
            # --- B. Prévision Future ---
            forecast_bias = model_fit.forecast(n_forecast)
            sigma = np.std(model_fit.resid)
            confidence_interval = [1.96 * sigma * np.sqrt(step) for step in range(1, n_forecast + 1)]
            
            # Stockage des ajustements pour le tableau
            future_adjustments.append({
                "Zone": zone,
                "Type": type_bien,
                "Ajustement T+1": round(forecast_bias.iloc[0], 2),
                "Ajustement T+2": round(forecast_bias.iloc[1], 2),
                "Marge Erreur": round(confidence_interval[0], 2)
            })

            # =================================================================
            # 4. Visualisation
            # =================================================================
            
            fig = go.Figure()

            # Historique : INSEE (Noir)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (INSEE) - Base 2020'],
                mode='lines', name='INSEE (Réalité)', line=dict(color='black', width=3)
            ))

            # Historique : CL Brut (Rouge Pointillé)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (CL)'],
                mode='lines', name='CL (Brut)', line=dict(color='red', width=1, dash='dot')
            ))

            # Historique : CL Corrigé (Bleu)
            fig.add_trace(go.Scatter(
                x=group.index, y=cl_corrected_history, # Utilise la série calculée ci-dessus
                mode='lines', name='CL Corrigé (TES)', line=dict(color='blue', width=2)
            ))

            # Mise en page
            fig.add_vline(x=last_date, line_width=1, line_dash="dash", line_color="gray")
            fig.update_layout(
                title=f"<b>{zone} - {type_bien}</b> : Validation Historique TES",
                yaxis_title="Indice (Base 2020 = 100)", template="plotly_white", height=550
            )
            
            fig.show()
            
        except Exception as e:
            print(f"⚠️ Echec de la modélisation pour {name}: {e}")
            
    corrected_data.append(group.reset_index())

# --- Reconstitution du DataFrame Global ---
merge_corrected = pd.concat(corrected_data, ignore_index=True)

# --- Affichage du Tableau de Bord ---
if future_adjustments:
    df_previsions = pd.DataFrame(future_adjustments)
    print("\n" + "="*80)
    print("📊 AJUSTEMENTS PRÉVUS (TES Holt-Winters)")
    print("="*80)
    display(df_previsions)
