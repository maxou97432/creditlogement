"""
=======================================================================
Traduction Python du code SAS — Simul RWA q4 2024
Transcrit fidèlement depuis les captures d'écran (images).
=======================================================================
"""

import math
import polars as pl
from scipy.special import ndtr, ndtri


# ==============================================================
# Constantes math
# ==============================================================

PROBIT_999  = float(ndtri(0.999))
PROBIT_0001 = float(ndtri(0.0001))
DENOM_35    = 1.0 - math.exp(-35.0)
DENOM_50    = 1.0 - math.exp(-50.0)


# ==============================================================
# Wrappers SciPy -> Polars
# ==============================================================

def _cdf(expr: pl.Expr) -> pl.Expr:
    if isinstance(expr, (int, float)):
        expr = pl.lit(expr)
    return expr.map_batches(
        lambda s: pl.Series(name=s.name, values=ndtr(s.to_numpy())),
        return_dtype=pl.Float64,
    )


def _ppf(expr: pl.Expr) -> pl.Expr:
    if isinstance(expr, (int, float)):
        expr = pl.lit(expr)
    return expr.map_batches(
        lambda s: pl.Series(name=s.name, values=ndtri(s.to_numpy())),
        return_dtype=pl.Float64,
    )


def _clip_duration(col: str = "duration") -> pl.Expr:
    # Parité SAS : en SAS, une valeur manquante (.) est considérée < tout nombre.
    # Donc "if duree < 1 then D = 1" est Vrai si duree est null → D = 1.0.
    # Les 56 lignes CORP/SME_CORP avec duration nulle sont concernées.
    return (
        pl.when(pl.col(col).is_null() | (pl.col(col) < 1))
        .then(1.0)
        .when(pl.col(col) > 5)
        .then(5.0)
        .otherwise(pl.col(col).cast(pl.Float64))
    )


