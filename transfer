print("▶ TEST ANALYTIQUE : Calcul théorique selon 'demonstrations_duration.md'")

# 1. Variables Financières 
r_mensuel = (pl.col('T_INTRT') / 100.0) / 12.0
n_mois = pl.col('MATURITE').cast(pl.Float64)

# 2. Implémentation des formules de ton fichier
srs_fusion = srs_fusion.with_columns(
    
    # TYPE 3 : Amortissement Progressif (CF constants -> centre de gravité = milieu exact)
    pl.when(pl.col('CD_TYPE_AMORT').is_in(['3']))
    .then((n_mois + 1.0) / 2.0)
    
    # TYPE 1 : Amortissement Linéaire (CF décroissants -> centre de gravité tiré vers la gauche par r)
    .when(pl.col('CD_TYPE_AMORT').is_in(['1']))
    .then(
        ((n_mois + 1.0) / 2.0) * ((1.0 + r_mensuel * (n_mois + 2.0) / 3.0) / (1.0 + r_mensuel * (n_mois + 1.0) / 2.0))
    )
    
    # TYPE 4 : Prêts Bullet (Intérêts constants puis gros capital -> tiré un tout petit peu vers la gauche par r)
    .when(pl.col('CD_TYPE_AMORT').is_in(['4']))
    .then(
        (n_mois * (1.0 + r_mensuel * (n_mois + 1.0) / 2.0)) / (1.0 + n_mois * r_mensuel)
    )
    
    # TYPE 2 : Dégressif
    .when(pl.col('CD_TYPE_AMORT').is_in(['2']))
    .then(n_mois / 3.0)
    
    # DEFAULT
    .otherwise(n_mois)
    .alias('ANALYTIQUE_MATURITE_MOIS')
)

# 3. Conversion en ANNÉES et application du Clip [1; 5] Bâle II
srs_fusion = srs_fusion.with_columns(
    (pl.col('ANALYTIQUE_MATURITE_MOIS') / 12.0).alias('ANALYTIQUE_MATURITE_IRBA')
).with_columns(
    pl.col('ANALYTIQUE_MATURITE_IRBA').clip(1.0, 5.0).alias('ANALYTIQUE_DURATION_IRBA')
)

# 4. Évaluation factuelle
dataset_valide = srs_fusion.drop_nulls('T_INTRT')
if dataset_valide.height > 0:
    match_brute = dataset_valide.filter(
        (pl.col('ANALYTIQUE_MATURITE_IRBA') - pl.col('NB_MATURITE_IRBA')).abs() <= 0.1
    ).height
    
    match_clippe = dataset_valide.filter(
        (pl.col('ANALYTIQUE_DURATION_IRBA') - pl.col('NB_DURATION_IRBA')).abs() <= 0.1
    ).height

    print(f"Bilan de concordance des formules 'demonstrations_duration.md' sur {dataset_valide.height} lignes avec taux :")
    print(f"  └─> Taux de Parité brute (Équations pures vs Réalité SAS) : {match_brute/dataset_valide.height:.1%} ({match_brute} lignes).")
    print(f"  └─> Taux de Parité réglementaire (Bornes [1, 5] appliquées) : {match_clippe/dataset_valide.height:.1%} ({match_clippe} lignes).\n")

    # Zoom sur les divergences 
    if match_brute < dataset_valide.height:
        print("Lignes où Bâle II n'a visiblement PAS suivi le comportement mathématique standard :")
        print(dataset_valide.filter(
            (pl.col('ANALYTIQUE_MATURITE_IRBA') - pl.col('NB_MATURITE_IRBA')).abs() > 0.5
        ).select([
            'CD_TYPE_AMORT', 'MATURITE', 'T_INTRT', 
            'ANALYTIQUE_MATURITE_IRBA', 'NB_MATURITE_IRBA'
        ]).head(5))
