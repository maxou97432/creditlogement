def get_config(variante: str = None, segment: dict = None,
               avec_lpi: bool = True,
               source_structure: str = "dvf_cl") -> dict:
    """
    Retourne la configuration complète pour un run.

    Parameters
    ----------
    variante         : "v1_complet" | "v2_restreint". Défaut VARIANTE_DEFAULT.
    segment          : {"TYPE_BIEN": ..., "ANCIENNETE": ...}. Défaut SEGMENT_CARTE_DEFAULT.
    avec_lpi         : bool. Si False, les graphiques d'évolution n'incluent pas la courbe LPI.
    source_structure : "dvf_cl" | "v2_restreint". Source des poids structurels.

    Returns
    -------
    dict avec les clés :
        variante, path_base, source_filter, label, output_dir,
        path_structure, path_lpi, segment_carte, path_geojson, path_gps,
        avec_lpi, source_structure
    """
    v = variante or VARIANTE_DEFAULT
    if v not in VARIANTES:
        raise ValueError(f"Variante inconnue '{v}'. Choix : {list(VARIANTES)}")

    # Résoudre le chemin de la base structurelle
    if source_structure not in PATH_STRUCTURES:
        raise ValueError(f"source_structure inconnu '{source_structure}'. Choix : {list(PATH_STRUCTURES)}")
    path_struct = PATH_STRUCTURES[source_structure]

    var_cfg = VARIANTES[v]
    output_dir = os.path.join(RESULTATS_DIR, var_cfg["output_subdir"])
    os.makedirs(output_dir, exist_ok=True)

    return {
        "variante":         v,
        "path_base":        var_cfg["path_base"],
        "source_filter":    var_cfg["source_filter"],
        "label":            var_cfg["label"],
        "output_dir":       output_dir,
        "description":      var_cfg["description"],
        "path_structure":   path_struct,
        "source_structure": source_structure,
        "path_lpi":         PATH_LPI,
        "path_geojson":     PATH_GEOJSON,
        "path_gps":         PATH_GPS,
        "segment_carte":    segment or SEGMENT_CARTE_DEFAULT,
        "avec_lpi":         avec_lpi,
    }
