# =============================================================================
# --- CRÉATION DE LA CARTE MATPLOTLIB ---
# =============================================================================

print("Configuration de police 'Century Gothic' appliquée.")


types_bien = ['APT', 'MAI']

# --- DEFINITION DES OFFSETS SPÉCIFQUES ---
CUSTOM_LABEL_OFFSETS = {
    # Déplace le label de Toulon vers le bas/droite (inchangé)
    'TOULON': {'x': 0.1, 'y': -0.05} 
}


for type_bien in types_bien:
    print(f"\n--- Génération de la carte pour le type de bien : {type_bien} ---")
    
    df_prix_filtre = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
    df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
    df_map = df_geo_gps.merge(df_prix_filtre, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
    
    df_map = df_map[['label', 'latitude', 'longitude', 'prix_mm_value', "TAUX_INFL_3M", 'TAUX_INFL_12M']].copy()
    df_map = df_map.dropna(subset=['latitude', 'longitude'])
    df_map = df_map.drop_duplicates(subset='label', keep='first')
    
    if df_map.empty:
        print("Aucune donnée géographique valide trouvée pour ce type de bien.")
        continue
        
    df_map['Formatted_Label'] = df_map.apply(format_text_label, axis=1)
    geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
    gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326")
    
    # --- DESSIN ---
    fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=300) 
    fig.set_facecolor(CL_TURQUOISE) 
    
    # --- DESSIN DU CONTOUR DE LA FRANCE ---
    geometries_to_plot = [france_outline_geometry]
    if france_outline_geometry.geom_type == 'MultiPolygon':
        geometries_to_plot = list(france_outline_geometry.geoms)

    for geom in geometries_to_plot:
        # Remplissage de la France
        ax.fill(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_LIGHT_GREY, 
                zorder=1) 
                
        # Contour noir
        ax.plot(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_BLACK, 
                linewidth=1.0, 
                zorder=2)
    
    # Définir les limites de la vue (zoom sur la France)
    xmin, ymin, xmax, ymax = france_outline_geometry.bounds
    ax.set_xlim(xmin - 0.7, xmax + 0.7) 
    ax.set_ylim(ymin - 0.7, ymax + 0.7)

    # --- AJOUT DES ÉTIQUETTES ET DES COULEURS DE TEXTE ---
    
    DEFAULT_X_OFFSET = 0.08 
    DEFAULT_Y_OFFSET = 0.08 
    
    # (AJUSTÉ) Espacement entre les lignes de texte (à ajuster si besoin)
    LINE_SPACING_UNIT = 0.045 # Unité de base pour l'espacement
    
    # (AJUSTÉ) Padding des cadres pour accommoder 4 lignes de texte
    bbox_props = dict(boxstyle="round,pad=0.6", fc="white", ec=CL_MEDIUM_GREY, lw=0.7, alpha=0.95)
    
    for idx, row in gdf.iterrows():
        lon = row['longitude']
        lat = row['latitude']
        city_label = row['label'] 
        
        # --- LOGIQUE D'OFFSET SPÉCIFIQUE ---
        if city_label in CUSTOM_LABEL_OFFSETS:
            x_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['x']
            y_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['y']
        else:
            x_offset_city = DEFAULT_X_OFFSET
            y_offset_city = DEFAULT_Y_OFFSET
        # ---------------------------------------------

        # Séparation du texte en ses 4 parties
        full_text = row['Formatted_Label']
        formatted_parts = full_text.split('\n')
        ville = formatted_parts[0] 
        prix = formatted_parts[1]
        ti_3m_text = formatted_parts[2]
        ti_12m_text = formatted_parts[3]
        
        # Position de départ pour l'étiquette
        anchor_x = lon + x_offset_city
        anchor_y = lat + y_offset_city
        
        ha_align = 'right' if x_offset_city < 0 else 'left'
        va_align = 'top' if y_offset_city < 0 else 'bottom'
        
        # 1. Dessiner le fond blanc (BBOX) en utilisant le texte complet invisible
        ax.text(
            anchor_x, 
            anchor_y, 
            full_text,
            fontsize=10, 
            ha=ha_align, 
            va=va_align,
            color='none', 
            zorder=3,
            bbox=bbox_props
        )
        
        # Décalages spécifiques pour chaque ligne dans la bbox (va='bottom')
        # Ajustement manuel pour centrer verticalement les 4 lignes dans la bbox étendue
        if va_align == 'bottom':
            # La ville est la plus haute, décalage positif depuis l'ancre
            ville_y_adjusted = anchor_y + (LINE_SPACING_UNIT * 1.5) 
            prix_y_adjusted = anchor_y - (LINE_SPACING_UNIT * 0.5) 
            ti_3m_y_adjusted = anchor_y - (LINE_SPACING_UNIT * 1.5) 
            ti_12m_y_adjusted = anchor_y - (LINE_SPACING_UNIT * 2.5) 
        else: # va_align == 'top'
            # La ville est la plus basse, décalage négatif depuis l'ancre
            ville_y_adjusted = anchor_y - (LINE_SPACING_UNIT * 1.5)
            prix_y_adjusted = anchor_y + (LINE_SPACING_UNIT * 0.5)
            ti_3m_y_adjusted = anchor_y + (LINE_SPACING_UNIT * 1.5)
            ti_12m_y_adjusted = anchor_y + (LINE_SPACING_UNIT * 2.5)

        # 2. Dessiner le Nom de la Ville (Ligne 1, en gras, noir)
        ax.text(
            anchor_x, 
            ville_y_adjusted, 
            ville, 
            fontsize=10, 
            ha=ha_align, 
            va='center', # Utilisation de 'center' pour un meilleur contrôle
            color=CL_BLACK,
            weight='bold', 
            zorder=4 
        )
        
        # 3. Dessiner le Prix M2 (Ligne 2, normal, noir)
        ax.text(
            anchor_x, 
            prix_y_adjusted, 
            prix, 
            fontsize=10, 
            ha=ha_align, 
            va='center', # Utilisation de 'center'
            color=CL_BLACK, # Prix en noir
            weight='normal', 
            zorder=4
        )
        
        # 4. Dessiner le Taux d'inflation 3M (Ligne 3, coloré)
        ti_3m_val_raw = row['TAUX_INFL_3M']
        color_ti_3m = COLOR_INFL_BAISSE if pd.notna(ti_3m_val_raw) and ti_3m_val_raw < 0 else COLOR_INFL_3M
        
        ax.text(
            anchor_x, 
            ti_3m_y_adjusted, 
            ti_3m_text, 
            fontsize=9, # Taille légèrement plus petite
            ha=ha_align, 
            va='center', # Utilisation de 'center'
            color=color_ti_3m,
            weight='bold', 
            zorder=4
        )

        # 5. Dessiner le Taux d'inflation 12M (Ligne 4, coloré)
        ti_12m_val_raw = row['TAUX_INFL_12M']
        color_ti_12m = COLOR_INFL_BAISSE if pd.notna(ti_12m_val_raw) and ti_12m_val_raw < 0 else COLOR_INFL_12M

        ax.text(
            anchor_x, 
            ti_12m_y_adjusted, 
            ti_12m_text, 
            fontsize=9, # Taille légèrement plus petite
            ha=ha_align, 
            va='center', # Utilisation de 'center'
            color=color_ti_12m,
            weight='bold', 
            zorder=4
        )
        
        # 6. Ajout du point de ville d'origine (petit cercle noir)
        ax.plot(lon, lat, marker='o', color=CL_BLACK, markersize=5, zorder=4)
        
    # --- FINALISATION DE L'IMAGE ---
    ax.axis('off') 
    
    # Titre principal (noir sur turquoise)
    title_text = f"LES PRIX DES {type_bien} DANS L'ANCIEN"
    ax.set_title(title_text, fontsize=20, loc='center', pad=20, color=CL_BLACK, ha='center', weight=TITRE_FONT_WEIGHT) 
    
    # Sous-titre et sources (noir sur turquoise)
    subtitle_text = "SUR 1 AN DANS LES PRINCIPALES VILLES"
    fig.text(0.5, 0.94, subtitle_text, ha='center', va='top', fontsize=12, color=CL_BLACK, weight='bold') 

    # Ajout de la source et de la légende (MIS À JOUR pour 3M et 12M)
    fig.text(0.05, 0.03, "Source: Crédit Logement, MM 12M", ha='left', va='bottom', fontsize=9, color=CL_BLACK)
    
    fig.text(0.05, 0.13, "LÉGENDE ÉVOLUTION:", ha='left', va='bottom', fontsize=9, color=CL_BLACK, weight='bold')
    fig.text(0.05, 0.11, f"Couleur {COLOR_INFL_3M}: Taux 3 Mois", ha='left', va='bottom', fontsize=8, color=COLOR_INFL_3M)
    fig.text(0.05, 0.09, f"Couleur {COLOR_INFL_12M}: Taux 12 Mois", ha='left', va='bottom', fontsize=8, color=COLOR_INFL_12M)
    fig.text(0.05, 0.07, f"Couleur {COLOR_INFL_BAISSE}: Baisse (3M ou 12M)", ha='left', va='bottom', fontsize=8, color=COLOR_INFL_BAISSE)

    # --- AFFICHAGE SEUL ---
    plt.show() 
    plt.close(fig) 

    print(f"Génération de la carte pour {type_bien} terminée.")
