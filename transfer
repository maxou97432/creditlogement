        sas_completion=False,
        deflator="n_open_start",
        expanding_dev_factor=True,
        expanding_sr=False,
        weighted_facility=False,
        mask_rule="observation",
    ),
    # Replication du programme SAS "3-2 Completion".
    # NOTE — la replication porte sur la METHODE, pas sur les anomalies
    # identifiees dans le SAS : C1 (`SR_1 = count_sum / H1_copie` inverse),
    # C4 (blocs TTWK 6/5/4 melangeant un marginal d'horizon k avec un cumul
    # d'horizon k+1) et C17 (percentiles P01 calcules mais jamais appliques)
    # ne sont PAS reproduits. Un ecart residuel avec le SAS est donc attendu
    # et doit etre attribue a ces trois postes.
    "sas": dict(
        sas_completion=True,
        deflator="sas_sr_end",
        expanding_dev_factor=True,
        expanding_sr=True,
        weighted_facility=False,
        mask_rule="observation",
    ),
}

