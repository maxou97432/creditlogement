r = (filled_pd[filled_pd[CATEGORY_COLUMN] == CAT]
       .groupby("generation")[FINAL_COL].mean().rename("pandas"))
n = (filled_pl.filter(pl.col(CATEGORY_COLUMN) == CAT)
       .group_by("generation").agg(pl.col(FINAL_COL).mean().alias("polars"))
       .sort("generation").to_pandas().set_index("generation")["polars"])
cmp = pd.concat([r, n], axis=1).sort_index()
cmp["ecart_abs"] = (cmp["pandas"] - cmp["polars"]).abs()
print(f"\n=== Sortie finale {FINAL_COL} ===")
print(cmp)
