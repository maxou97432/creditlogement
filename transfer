import numpy as np
import polars as pl

DT_ARRT = 23922          # 30/06/2025 en jours SAS — à ajuster pour autres dates d'arrêté
YIELD_PIVOT_SRS = 0.0495 # Yield pivot calibré sur 158 668 facilités progressives propres


def m_srs_type1(R: float) -> float:
    """Linéaire — CD_TYPE_AMORT = 1."""
    n = max(1, int(round(R * 12)))
    return (n + 1) / 2 / 12


def m_srs_type3(R: float, has_171: bool, seg_special: bool,
                y: float = YIELD_PIVOT_SRS) -> float:
    """Progressif — CD_TYPE_AMORT = 3."""
    if has_171 or seg_special or R <= 1.0:
        return R
    n = max(1, int(round(R * 12)))
    r = y / 12
    k = np.arange(1, n + 1)
    w = (1 + r) ** (k - 1)
    return float(np.sum(k * w) / np.sum(w)) / 12


def calcul_maturite_irba(df: pl.DataFrame) -> pl.DataFrame:
    """
    Calcul vectorisé de NB_MATURITE_IRBA et NB_DURATION_IRBA sur tout un DataFrame.
    
    Inputs requis : DT_ECHEANCE_FEM, DT_DEBUT_AUTO, T_INTRT,
                    CD_TYPE_AMORT (str), FACTOR (str), segment_trg (int),
                    CD_PORT_PRUDENTIEL (str)
    """
    df = df.with_columns(
        CD_TYPE_AMORT = pl.col("CD_TYPE_AMORT").str.strip_chars().cast(pl.Int64, strict=False),
        R  = (pl.col("DT_ECHEANCE_FEM") - DT_ARRT) / 365.25,
        T0 = (pl.col("DT_ECHEANCE_FEM") - pl.col("DT_DEBUT_AUTO")) / 365.25,
        has_171     = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
        seg_special = pl.col("segment_trg").is_in([44, 73, 74]),
    )
    
    R_arr   = df["R"].to_numpy()
    type_a  = df["CD_TYPE_AMORT"].to_numpy()
    h171    = df["has_171"].to_numpy()
    sspec   = df["seg_special"].to_numpy()
    
    nb = np.empty_like(R_arr)
    for i, (R, t, h, s) in enumerate(zip(R_arr, type_a, h171, sspec)):
        if t in (2, 4, 9):
            nb[i] = R
        elif t == 1:
            nb[i] = m_srs_type1(R)
        elif t == 3:
            nb[i] = m_srs_type3(R, h, s)
        else:
            nb[i] = R
    
    return df.with_columns(
        NB_MATURITE_IRBA = pl.Series(nb),
        NB_DURATION_IRBA = pl.Series(np.clip(nb, 1.0, 5.0)),
    )
