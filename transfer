import polars as pl
import numpy as np
from scipy import stats as sp_stats
from scipy.stats import kruskal, levene
from typing import Tuple
from collections import Counter

# =====================================================================
# CONFIGURATION
# =====================================================================
df_base       = base                 # base rassemblée niveau modèle (grain obligor)
TARGET_COL    = "lgd_obligor"
CLASS_COL     = "CHR_model"
P_VALUE_FLOOR = 0.05
MAX_ITER      = 100
ALPHA_TOST    = 0.05

# --- CHOIX DE LA MARGE D'ÉQUIVALENCE DU TOST -------------------------
#   "absolute" : bande fixe ±DELTA_LGD en points de LGD (le delta du coude)
#   "equipe"   : bande proportionnelle max(0.2*lgd, .5)/max(0.3*lgd, 1)  (logique équipe)
MARGIN_MODE   = "absolute"
DELTA_LGD     = 1.5                   # utilisé seulement si MARGIN_MODE="absolute" (delta du coude)
# ---------------------------------------------------------------------

# =====================================================================
# UTILITAIRES
# =====================================================================
def get_lgd_vectors(lf: pl.LazyFrame, cls: str) -> np.ndarray:
    return (lf.filter(pl.col(CLASS_COL) == cls)
              .select(TARGET_COL).collect()
              .get_column(TARGET_COL).to_numpy())

def get_margins(mean_lgd: float) -> Tuple[float, float]:
    """
    Renvoie (delta_a, delta_b), les bornes d'équivalence du TOST.
      - MARGIN_MODE="absolute" : bande symétrique fixe = DELTA_LGD (delta du coude)
      - MARGIN_MODE="equipe"   : marge proportionnelle à la LGD (logique de l'équipe)
    """
    if MARGIN_MODE == "equipe":
        return max(0.2 * mean_lgd, 0.5), max(0.3 * mean_lgd, 1.0)   # échelle 0-100
    return DELTA_LGD, DELTA_LGD

# =====================================================================
# TESTS D'HÉTÉROGÉNÉITÉ  -> (possible: bool, details: dict)
#   possible = True  =>  classes équivalentes  =>  FUSION autorisée
# =====================================================================
def welch_heterogeneity(a, b, p_floor=P_VALUE_FLOOR) -> Tuple[bool, dict]:
    """Welch (petit n) : fusion si p >= floor (aucune différence détectée)."""
    t, p = sp_stats.ttest_ind(a, b, equal_var=False)
    d = {"test": "welch", "p_value": float(p),
         "mean_a": float(a.mean()), "mean_b": float(b.mean()),
         "n_a": int(len(a)), "n_b": int(len(b))}
    if p >= p_floor:
        d["reason"] = "p>=floor (non distinguables)"
        return True, d
    d["reason"] = "p<floor (distinctes)"
    return False, d

def kw_heterogeneity(a, b, p_floor=P_VALUE_FLOOR) -> Tuple[bool, dict]:
    """Kruskal-Wallis (repli non-paramétrique)."""
    H, p = kruskal(a, b)
    d = {"test": "kw", "p_value": float(p),
         "mean_a": float(a.mean()), "mean_b": float(b.mean()),
         "n_a": int(len(a)), "n_b": int(len(b))}
    if p >= p_floor:
        d["reason"] = "p>=floor (non distinguables)"
        return True, d
    d["reason"] = "p<floor (distinctes)"
    return False, d

def levene_heterogeneity(a, b, p_floor=P_VALUE_FLOOR) -> Tuple[bool, dict]:
    """Levene (égalité des variances) ; sinon repli Welch."""
    stat, p = levene(a, b)
    d = {"test": "levene", "p_value": float(p),
         "mean_a": float(a.mean()), "mean_b": float(b.mean()),
         "n_a": int(len(a)), "n_b": int(len(b))}
    if p >= p_floor:
        d["reason"] = "variances egales (p>=floor)"
        return True, d
    return welch_heterogeneity(a, b, p_floor)

def tost_heterogeneity(a, b, mean_lgd, alpha=ALPHA_TOST) -> Tuple[bool, dict]:
    """
    TOST (équivalence) pour les grands effectifs.
    Fusion si l'IC (1-2*alpha) de l'écart des moyennes tient dans la bande
    d'équivalence définie par get_margins(). delta_a = marge stricte,
    delta_b = marge modérée (fusion encore acceptée, signalée comme telle).
    """
    delta_a, delta_b = get_margins(mean_lgd)
    n1, n2 = len(a), len(b)
    s1, s2 = a.std(ddof=1), b.std(ddof=1)
    gap = b.mean() - a.mean()
    se  = np.sqrt(s1**2/n1 + s2**2/n2)
    dfw = (s1**2/n1 + s2**2/n2)**2 / ((s1**2/n1)**2/(n1-1) + (s2**2/n2)**2/(n2-1))
    tcrit = sp_stats.t.ppf(1 - alpha, dfw)
    ci_lo, ci_hi = gap - tcrit*se, gap + tcrit*se
    d = {"test": "tost", "p_value": float("nan"),
         "mean_a": float(a.mean()), "mean_b": float(b.mean()),
         "n_a": int(n1), "n_b": int(n2)}
    if (ci_lo > -delta_a) and (ci_hi < delta_a):
        d["reason"] = f"equiv stricte (+-{delta_a:.3f}) IC[{ci_lo:.3f},{ci_hi:.3f}]"
        return True, d
    if (ci_lo > -delta_b) and (ci_hi < delta_b):
        d["reason"] = f"equiv MODEREE (+-{delta_b:.3f}) IC[{ci_lo:.3f},{ci_hi:.3f}]"
        return True, d
    d["reason"] = f"non equiv (IC[{ci_lo:.3f},{ci_hi:.3f}] hors +-{delta_a:.3f})"
    return False, d

def ReturnThreshold(mean_lgd: float) -> int:
    """Effectif au-delà duquel on bascule sur le TOST (échelle LGD 0-100)."""
    if mean_lgd < 5:   return 80000
    if mean_lgd < 10:  return 40000
    if mean_lgd < 20:  return 20000
    return 10000

# =====================================================================
# OPÉRATIONS SUR LES CLASSES
# =====================================================================
def merge_classes(lf, cls_a, cls_b, new_name) -> pl.LazyFrame:
    return lf.with_columns(
        pl.when(pl.col(CLASS_COL).is_in([cls_a, cls_b]))
          .then(pl.lit(new_name))
          .otherwise(pl.col(CLASS_COL))
          .alias(CLASS_COL)
    )

def build_adjacent_pairs(lf) -> pl.DataFrame:
    """Paires adjacentes en ordre LRA GLOBAL (niveau modèle, pas de cloisonnement)."""
    cm = (lf.group_by(CLASS_COL)
            .agg(pl.col(TARGET_COL).mean().alias("mean_lgd"))
            .sort("mean_lgd").collect())
    P = [(cm[i, CLASS_COL], cm[i+1, CLASS_COL],
          abs(cm[i+1, "mean_lgd"] - cm[i, "mean_lgd"])) for i in range(cm.height - 1)]
    return pl.DataFrame({"class_a": [p[0] for p in P],
                         "class_b": [p[1] for p in P],
                         "severite_totale": [p[2] for p in P]})

# =====================================================================
# BOUCLE PRINCIPALE
# =====================================================================
def iterative_homogeneity_reduction(lf, p_floor=P_VALUE_FLOOR, max_iter=MAX_ITER):
    current, history = lf, []
    for it in range(max_iter):
        candidates = build_adjacent_pairs(current).sort("severite_totale")
        fused = False
        for cls_a, cls_b, severity in candidates.iter_rows():
            a = get_lgd_vectors(current, cls_a)
            b = get_lgd_vectors(current, cls_b)
            mean_lgd = float((a.sum() + b.sum()) / (len(a) + len(b)))

            if len(a) + len(b) > ReturnThreshold(mean_lgd):
                possible, det = tost_heterogeneity(a, b, mean_lgd)
            else:
                possible, det = welch_heterogeneity(a, b, p_floor)
                if not possible:
                    possible, det = kw_heterogeneity(a, b, p_floor)
                if not possible:
                    possible, det = levene_heterogeneity(a, b, p_floor)

            if possible:
                new_name = f"{cls_a}_{cls_b}"
                current = merge_classes(current, cls_a, cls_b, new_name)
                fused = True
                history.append({
                    "iteration": it, "class_a": cls_a, "class_b": cls_b,
                    "new_class": new_name, "test": det["test"], "reason": det["reason"],
                    "gap": round(abs(det["mean_b"] - det["mean_a"]), 4),
                    "mean_a": round(det["mean_a"], 3), "mean_b": round(det["mean_b"], 3),
                    "n_a": det["n_a"], "n_b": det["n_b"], "severite": round(severity, 4),
                })
                break
        if not fused:
            break
    return current, history

# =====================================================================
# EXÉCUTION + SORTIE DÉTAILLÉE
# =====================================================================
lf = df_base.lazy()
n0 = lf.select(CLASS_COL).unique().collect().height
reduced_lf, history = iterative_homogeneity_reduction(lf)
df_final = reduced_lf.collect()
n1 = df_final[CLASS_COL].n_unique()

print("=" * 100)
print(f"RÉDUCTION — mode marge='{MARGIN_MODE}'"
      + (f" (DELTA_LGD={DELTA_LGD})" if MARGIN_MODE == "absolute" else "")
      + f"  |  {n0} -> {n1} CHR_model  ({len(history)} fusions)")
print("=" * 100)
if history:
    hist_df = pl.DataFrame(history)
    print("\nDÉTAIL DES FUSIONS :\n")
    with pl.Config(tbl_rows=200, tbl_cols=-1, tbl_width_chars=240, fmt_str_lengths=80):
        print(hist_df.select(["iteration", "class_a", "class_b", "new_class",
                              "test", "gap", "mean_a", "mean_b", "n_a", "n_b", "reason"]))
    print("\nTests ayant déclenché les fusions :", dict(Counter(h["test"] for h in history)))
else:
    print("\nAucune fusion : classes jugées hétérogènes au seuil retenu.")
print(f"\nTaux de réduction : {100 * (1 - n1/n0):.1f} %")
