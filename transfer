def build_pipeline(
    cap_pret_lf,
    *,
    cd_portfolio: str,
    duration:     str,
    ead:          str,
    tx_edf:       str,
    tx_lgd:       str,
    dt_echeance:  str,
    dt_arrt:      str,
    cd_type_amort: str,
    DURATION_MODE: str | None = None,
    drop_tmp:     bool = True,
) -> pl.LazyFrame:
    # 1) Rename des colonnes utilisateur vers les noms canoniques
    lf = _normalize(
        cap_pret_lf,
        cd_portfolio=cd_portfolio,
        duration=duration,
        ead=ead,
        tx_edf=tx_edf,
        tx_lgd=tx_lgd,
        dt_echeance=dt_echeance,
        dt_arrt=dt_arrt,
        cd_type_amort=cd_type_amort,
    )

    # 2) Recalcul de maturité si mode "NEW"
    if DURATION_MODE == "NEW":
        lf = compute_maturite_irba(lf)   # nom de ta fonction

    # 3) Préparation base — pas de noms de colonnes, juste DURATION_MODE
    lf = build_base(lf, DURATION_MODE=DURATION_MODE)

    # 4) Calcul RWA_init
    lf = add_all_rwa_scenarios(lf)       # ou add_rwa_init_scenario selon ton nom

    # 5) Cleanup
    if drop_tmp:
        lf = drop_tmp_cols(lf)

    return lf
