def detecter_distribution(lf: pl.LazyFrame, target: str, tol: float = 1e-9) -> str:
    """
    Détecte automatiquement la distribution de la target à partir de ses valeurs
    observées, plutôt que de dépendre d'un nom/clé de config potentiellement
    ambigu ou mal renseigné.

    Retourne "bernoulli" si la target ne prend que des valeurs dans {0, 1}
    (à tol près, pour tolérer d'éventuels flottants du type 0.0/1.0),
    "continuous" sinon.
    """
    valeurs_uniques = (
        lf.select(pl.col(target).drop_nulls().unique())
          .collect()
          .to_series()
    )

    est_binaire = valeurs_uniques.is_in([0, 1]).all() and valeurs_uniques.len() <= 2

    distribution = "bernoulli" if est_binaire else "continuous"
    print(f"Distribution détectée pour '{target}' : {distribution} "
          f"({valeurs_uniques.len()} valeur(s) unique(s) : {sorted(valeurs_uniques.to_list())[:5]}"
          f"{'...' if valeurs_uniques.len() > 5 else ''})")
    return distribution
