# Groups_state reference (65 classes, pas de fusion)
groups_ref = {
    str(r["CHR_model"]): {
        "mean"   : float(r["mean_lgd"]),
        "var"    : float(r["var_lgd"]),
        "n"      : int(r["n"]),
        "members": [str(r["CHR_model"])],
    }
    for r in class_stats_base.iter_rows(named=True)
}

mae_ref    = mae_from_groups(groups_ref, df_base)
n_ref      = len(groups_ref)

print(f"REFERENCE : {n_ref} classes | MAE = {mae_ref:.6f}\n")


# ================================================================
#  BOUCLE SUR LES SEUILS
# ================================================================

resultats_calibration = []

for g_seuil in G_SEUILS_TEST:
    res     = run_fusion_for_seuil(g_seuil, class_stats_base)
    mae_g   = mae_from_groups(res["groups"], df_base)
    delta   = (mae_g - mae_ref) / mae_ref * 100
    ok      = delta <= SEUIL_MAE_PCT

    resultats_calibration.append({
        "g_seuil"       : g_seuil,
        "n_classes"     : res["n_classes"],
        "n_fusions"     : res["n_fusions"],
        "mae"           : round(mae_g,  6),
        "delta_mae_pct" : round(delta,  3),
        "acceptable"    : ok,
    })

    symbole = "✅" if ok else "❌"
    print(f"{symbole} g < {g_seuil:.2f} | "
          f"n={res['n_classes']:3d} classes | "
          f"MAE={mae_g:.6f} | "
          f"ΔMAE={delta:+.3f}% "
          f"({'< ' if ok else '>= '}{SEUIL_MAE_PCT}%)")


# ================================================================
#  TABLEAU + GRAPHE
# ================================================================

df_calib = pl.DataFrame(resultats_calibration)

print(f"\n{'='*65}")
