# ================================================================
    # FEUILLE GLOBALE : toutes les classes, tous segments confondus
    # ================================================================
    ws_global = wb.create_sheet(title="GLOBAL")
    r = 1

    # Titre
    ws_global.merge_cells(start_row=r, start_column=1, end_row=r, end_column=10)
    sc(ws_global.cell(r, 1),
       f"{title} — LGD par classe (tous segments)",
       fill=BLUE_DARK, font=Font(color="FFFFFF", bold=True, size=12))
    r += 1
    graph_row_global = r

    # Calcul global : toutes classes, toutes années
    all_years = sorted(df[year_col].drop_nulls().unique().to_list())
    all_classes = sorted(df[class_col].drop_nulls().unique().to_list())

    t_global = (
        df.group_by([class_col, year_col])
        .agg(pl.col(lgd_col).mean().round(4).alias("mean_lgd"))
        .sort([class_col, year_col])
    )
    t_global_dict = {
        (r_[class_col], r_[year_col]): r_["mean_lgd"]
        for r_ in t_global.iter_rows(named=True)
    }

    # Graphique
    n_classes = len(all_classes)
    fig_h = max(6, n_classes * 0.3)  # hauteur adaptative selon le nombre de classes
    fig, ax = plt.subplots(figsize=(14, fig_h))
    colors = plt.cm.tab20.colors

    for i, cls in enumerate(all_classes):
        means, yrs_plot = [], []
        for yr in all_years:
            val = t_global_dict.get((cls, yr))
            if val is not None:
                means.append(val)
                yrs_plot.append(yr)
        if means:
            ax.plot(yrs_plot, means, marker="o", label=cls,
                    color=colors[i % len(colors)], linewidth=1.5,
                    alpha=0.85)

    ax.set_title(f"LGD moyenne par classe — Tous segments ({title})", fontsize=13)
    ax.set_xlabel("Année")
    ax.set_ylabel(f"{lgd_col} (moyenne)")
    ax.legend(loc="upper left", bbox_to_anchor=(1, 1),
              fontsize=6, ncol=max(1, n_classes // 20))
    ax.grid(True, alpha=0.3)
    plt.tight_layout()

    buf_global = io.BytesIO()
    fig.savefig(buf_global, format="png", dpi=120, bbox_inches="tight")
    plt.close(fig)
    buf_global.seek(0)

    img_global = XLImage(buf_global)
    img_global.anchor = f"A{graph_row_global}"
    ws_global.add_image(img_global)
