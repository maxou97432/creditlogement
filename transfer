# Reprend `diag` (déjà trié par perte_eta croissant) et `eta_full`
diag_cum = diag.with_columns([
    pl.col("perte_eta").cum_sum().alias("perte_eta_cumulee"),
    (100 * pl.col("perte_eta").cum_sum() / eta_full).alias("perte_cum_pct"),
    (pl.int_range(1, diag.height + 1)).alias("n_fusions"),
])

with pl.Config(tbl_rows=64, tbl_cols=-1, tbl_width_chars=160, float_precision=5):
    print(diag_cum.select(["class_1","class_2","perte_relative_pct","perte_cum_pct","n_fusions"]))

# Budget de perte TOTALE autorisé (sur l'eta² global) — choix métier
for budget_pct in [0.5, 1.0, 2.0, 5.0]:
    n_fus = diag_cum.filter(pl.col("perte_cum_pct") <= budget_pct).height
    print(f"budget {budget_pct:>4}% d'eta² total  ->  {n_fus} fusions  ->  {65 - n_fus} CHR_model")
