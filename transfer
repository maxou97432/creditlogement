import pandas as pd
import numpy as np
import plotly.graph_objects as go
from statsmodels.tsa.holtwinters import ExponentialSmoothing
import warnings

warnings.filterwarnings("ignore")
n_forecast = 2 

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("Génération des graphiques de l'Ajustement Prévu (Forecasted Bias)...")

for name, group in grouped:
    zone, type_bien = name
    group = group.sort_values("Periode").set_index("Periode")
    
    # On analyse UNIQUEMENT l'écart (La correction à appliquer)
    ts_ecart = group['Dif'].dropna()
    
    if len(ts_ecart) > 12:
        try:
            # Modélisation de la dynamique de l'écart
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                damped_trend=True, 
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # Prévision de l'écart futur
            forecast_bias = model_fit.forecast(n_forecast)
            
            # Intervalle de confiance
            sigma = np.std(model_fit.resid)
            confidence_interval = []
            for step in range(1, n_forecast + 1):
                confidence_interval.append(1.96 * sigma * np.sqrt(step))
            
            upper_bound = forecast_bias + confidence_interval
            lower_bound = forecast_bias - confidence_interval
            
            # Dates
            last_date = ts_ecart.index[-1]
            future_dates = [last_date + pd.DateOffset(months=3*i) for i in range(1, n_forecast+1)]
            
            # --- VISUALISATION (Focus sur l'Ajustement) ---
            
            fig = go.Figure()

            # 1. Historique de l'écart réel
            fig.add_trace(go.Scatter(
                x=ts_ecart.index, y=ts_ecart,
                mode='lines+markers', name='Écart Historique (CL - INSEE)',
                line=dict(color='gray'), marker=dict(size=4)
            ))

            # 2. Tendance lissée par le modèle (Pour voir si le modèle "comprend" l'histoire)
            fig.add_trace(go.Scatter(
                x=ts_ecart.index, y=model_fit.fittedvalues,
                mode='lines', name='Tendance Modélisée (Holt)',
                line=dict(color='blue', width=1)
            ))

            # 3. Prévision de l'ajustement (Ligne Rouge)
            fig.add_trace(go.Scatter(
                x=future_dates, y=forecast_bias,
                mode='lines+markers+text', name='Ajustement Prévu',
                line=dict(color='red', width=3),
                text=[f"{v:.2f} pts" for v in forecast_bias], # Affiche la valeur exacte
                textposition="top center"
            ))

            # 4. Zone d'incertitude
            fig.add_trace(go.Scatter(
                x=future_dates + future_dates[::-1],
                y=list(upper_bound) + list(lower_bound)[::-1],
                fill='toself',
                fillcolor='rgba(255, 0, 0, 0.2)',
                line=dict(color='rgba(255,255,255,0)'),
                showlegend=True, name='Marge d\'erreur (95%)'
            ))

            # Ligne Zéro (Si l'écart est à 0, CL = INSEE)
            fig.add_hline(y=0, line_dash="solid", line_color="black", line_width=1)

            fig.update_layout(
                title=f"Ajustement à appliquer sur l'Indice CL : {zone} - {type_bien}",
                yaxis_title="Points d'indice (Correction)",
                template="plotly_white",
                height=500,
                legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
            )
            
            # Séparation Passé/Futur
            fig.add_vline(x=last_date, line_width=1, line_dash="dash", line_color="gray")

            fig.show()

        except Exception as e:
            print(f"Erreur sur {name}: {e}")
