import polars as pl
import numpy as np
from datetime import datetime

YIELD_PIVOT_SRS = 0.0495


def date_to_sas(date_col: str) -> pl.Expr:
    """Convert a regular date to SAS format (float days since 1960-01-01)."""
    sas_reference = datetime(1960, 1, 1)
    return (
        pl.col(date_col)
        .cast(pl.Datetime)
        .map_batches(lambda s: (s - sas_reference).dt.total_days())
    )


def m_srs_type1_expr(R_col: str = "R") -> pl.Expr:
    """
    Linear (CD_TYPE_AMORT = 1): M = (n+1) / 24, n = round(R*12), n >= 1.
    Pure Polars expression — no Python callback.
    """
    n = pl.max_horizontal(pl.lit(1), (pl.col(R_col) * 12).round().cast(pl.Int64))
    return (n + 1) / 2 / 12


def m_srs_type3_expr(R_col: str = "R", y: float = YIELD_PIVOT_SRS) -> pl.Expr:
    """
    Progressive (CD_TYPE_AMORT = 3): undiscounted M Bâle weighted by principal,
    constant annuity, pivot yield y.

    Closed-form formula:
        M = (1/12) * [(n*(1+r)^n)/((1+r)^n - 1) - 1/r]
    where r = y/12 and n = round(R*12), n >= 1.

    This is the analytical sum of the geometric series — no Python loop required.
    """
    r = y / 12
    n = pl.max_horizontal(pl.lit(1), (pl.col(R_col) * 12).round().cast(pl.Int64))
    one_plus_r_n = (1 + r) ** n
    # M (months) = n * (1+r)^n / ((1+r)^n - 1) - 1/r
    M_months = (n.cast(pl.Float64) * one_plus_r_n) / (one_plus_r_n - 1) - 1 / r
    return M_months / 12


def compute_maturite_irba(df: pl.LazyFrame, dt_arrt_col: str = "DT_ARRT",
                           dt_echn_col: str = "D_ECHNC_AUTRS2") -> pl.LazyFrame:
    """
    Compute NB_MATURITE_RECALCULE and NB_DURATION_RECALCULE on a Polars LazyFrame.
    
    Required columns:
      - DT_ARRT (or column passed via dt_arrt_col): reporting date
      - D_ECHNC_AUTRS2 (or column passed via dt_echn_col): final maturity date
      - CD_TYPE_AMORT: amortization type ('1', '2', '3', '4', '9')
    """
    df = df.with_columns(
        date_to_sas(dt_arrt_col).alias("DT_ARRT_sas"),
        CD_TYPE_AMORT = pl.col("CD_TYPE_AMORT").cast(pl.Utf8, strict=False),
    ).with_columns(
        R = (pl.col(dt_echn_col) - pl.col("DT_ARRT_sas")) / 365.25,
    )

    # NB_MATURITE_RECALCULE — branchement par type via expressions natives
    df = df.with_columns(
        pl.when(pl.col("CD_TYPE_AMORT") == "1").then(m_srs_type1_expr("R"))
          .when(pl.col("CD_TYPE_AMORT") == "2").then(pl.col("R"))
          .when(pl.col("CD_TYPE_AMORT") == "3").then(m_srs_type3_expr("R"))
          .when(pl.col("CD_TYPE_AMORT").is_in(["4", "9"])).then(pl.col("R"))
          .otherwise(pl.col("R"))
          .alias("NB_MATURITE_RECALCULE")
    )

    # Clip final [1, 5]
    df = df.with_columns(
        pl.when(pl.col("NB_MATURITE_RECALCULE") < 1).then(1.0)
          .when(pl.col("NB_MATURITE_RECALCULE") > 5).then(5.0)
          .otherwise(pl.col("NB_MATURITE_RECALCULE"))
          .alias("NB_DURATION_RECALCULE")
    )

    return df
