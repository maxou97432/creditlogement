### 💻 Cellule — Résolution automatique des entrées/sorties

```python
def resoudre_entree_effective(index, catalogue, selection, config):
    """
    Détermine le chemin d'entrée réel du notebook à cet index :
      - si le producteur normal de l'entrée déclarée est actif, on
        l'utilise tel quel ;
      - sinon, on remonte au dernier notebook actif précédent et on
        prend SA sortie (repli automatique, loggé) ;
      - le cas dict (Cure/NonCure) est résolu tel quel, sans repli.
    """
    nb = catalogue[index]
    entree_declaree = nb.get("input_file")

    if entree_declaree is None:
        return None

    if isinstance(entree_declaree, dict):
        return {k: config["intermediate_dir"] / config[v] for k, v in entree_declaree.items()}

    producteur_normal = next(
        (n for n in catalogue[:index] if n.get("output_file") == entree_declaree),
        None
    )
    if producteur_normal and producteur_normal["name"] in selection:
        return config["intermediate_dir"] / config[entree_declaree]

    for n in reversed(catalogue[:index]):
        if n["name"] in selection and isinstance(n.get("output_file"), str):
            print(f"  [repli] {nb['name']} lira la sortie de {n['name']} "
                  f"({n['output_file']}) au lieu de {entree_declaree}")
            return config["intermediate_dir"] / config[n["output_file"]]

    raise ValueError(
        f"{nb['name']} : aucune entrée disponible dans la sélection actuelle "
        f"(attendait '{entree_declaree}')"
    )


def resoudre_sortie(nb, config):
    sortie_declaree = nb.get("output_file")
    if sortie_declaree is None:
        return None
    if isinstance(sortie_declaree, dict):
        return {k: config["intermediate_dir"] / config[v] for k, v in sortie_declaree.items()}
    return config["intermediate_dir"] / config[sortie_declaree]


notebooks_actifs = []
for index, nb in enumerate(catalogue):
    if nb["name"] not in selection:
        continue
    entree_path = resoudre_entree_effective(index, catalogue, selection, config)
    sortie_path = resoudre_sortie(nb, config)
    notebooks_actifs.append({**nb, "input_path": entree_path, "output_path": sortie_path})

print(f"{len(notebooks_actifs)} notebooks actifs résolus.")
```

