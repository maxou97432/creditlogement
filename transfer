def diagnostics_welch_kruskal_modele(
    df,
    class_col: str = CLASS_COL,
    lgd_col: str = LGD_COL,
) -> pl.DataFrame:
    """
    Paires de CHR_model ADJACENTES dans l'ordre LRA GLOBAL (PAS de cloisonnement
    par segment : les fusions inter-segments sont recherchées au niveau modèle).
    Welch (moyennes) + Kruskal-Wallis (distributions par rangs) avec p-values.
    USAGE DESCRIPTIF : à grand n les p-values saturent, le tableau documente.
    """
    lf = df.lazy() if isinstance(df, pl.DataFrame) else df

    # LRA par classe, ordre GLOBAL croissant (tous segments confondus)
    ordre = (
        lf.group_by([class_col, "year"]).agg(pl.col(lgd_col).mean().alias("m"))
          .group_by([class_col]).agg(pl.col("m").mean().alias("mean_LGD_global"))
          .sort("mean_LGD_global")
          .collect()
    )

    # Obligors bruts par classe
    obligors = {}
    base_col = lf.select([class_col, lgd_col]).collect()
    for cls in base_col.select(class_col).unique().to_series():
        obligors[cls] = base_col.filter(pl.col(class_col) == cls).get_column(lgd_col).to_numpy()

    rows = []
    classes = ordre.get_column(class_col).to_list()
    means   = ordre.get_column("mean_LGD_global").to_list()
    for i in range(len(classes) - 1):
        c1, c2 = classes[i], classes[i + 1]      # voisin global, sans filtre segment
        a1, a2 = obligors[c1], obligors[c2]
        t_w, p_w = sp_stats.ttest_ind(a1, a2, equal_var=False)
        h_k, p_k = sp_stats.kruskal(a1, a2)
        rows.append({
            "class_1": c1, "class_2": c2,
            "n_1": len(a1), "n_2": len(a2),
            "mean_1": float(a1.mean()), "mean_2": float(a2.mean()),
            "gap_lgd": float(a2.mean() - a1.mean()),
            "welch_p": float(p_w), "kruskal_p": float(p_k),
        })
    return pl.DataFrame(rows)


# ---- Exécution ----
ALPHA = 0.05
diag = diagnostics_welch_kruskal_modele(df_base)

