MARGIN_MODE = "equipe"
diag = build_adjacent_pairs(df_base.lazy()).sort("severite_totale")
rows = []
for ca, cb, sev in diag.iter_rows():
    a = get_lgd_vectors(df_base.lazy(), ca)
    b = get_lgd_vectors(df_base.lazy(), cb)
    mean_lgd = float((a.sum()+b.sum())/(len(a)+len(b)))
    delta_a, delta_b = get_margins(mean_lgd)

    # MA condition : IC entier dans ±delta_b
    n1, n2 = len(a), len(b); s1, s2 = a.std(ddof=1), b.std(ddof=1)
    gap = b.mean()-a.mean(); se = np.sqrt(s1**2/n1+s2**2/n2)
    dfw = (s1**2/n1+s2**2/n2)**2/((s1**2/n1)**2/(n1-1)+(s2**2/n2)**2/(n2-1))
    tcrit = sp_stats.t.ppf(1-0.05, dfw)
    ci_lo, ci_hi = gap-tcrit*se, gap+tcrit*se
    ma_cond = (ci_lo > -delta_b) and (ci_hi < delta_b)

    # ANCIENNE condition : deux ttest unilatéraux, p < 0.05
    _, p_a = sp_stats.ttest_ind(a, b + delta_b, equal_var=False)
    ancienne_cond = p_a < 0.05

    rows.append({"a":ca,"b":cb,"gap":round(sev,3),"delta_b":round(delta_b,2),
                 "IC_lo":round(ci_lo,3),"IC_hi":round(ci_hi,3),
                 "MA_fusionne":ma_cond, "ANCIENNE_fusionne":ancienne_cond})
print(pl.DataFrame(rows))
