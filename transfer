# --- Configuration de la police de secours (Fallback) ---

# 1. Utiliser 'sans-serif', le choix le plus compatible.
plt.rcParams['font.family'] = 'sans-serif' 

# 2. Forcer le style en sélectionnant une police de secours commune (ex: Arial)
