    df_final2 = pd.concat(dfs_to_concat2, ignore_index=True)

    

except FileNotFoundError as e:
    print(f"Erreur de lecture de fichier CL : {e}")
    sys.exit(1)

# Nettoyage df_final
df_final = df_final[df_final['DIC_NAME'] != "prix_m2_3m"]
df_final = df_final.drop(columns=["TYPE_MAILLE","TAUX_INFL_12M","TAUX_INFL_3M", "DIC_NAME"], errors='ignore') 


# --- 2. Calcul de l'indice CL (Base 2020) ---
df_final["Periode"] = pd.to_datetime(df_final["Periode"]) # Conversion sûre
mask_2020 = df_final["Periode"].dt.year == 2020

if not df_final.loc[mask_2020].empty:
    # Pivot par type de bien et zone géograhique
    pivot_2020_CL = df_final.loc[mask_2020].groupby(["CD_TYPE_BIEN","VAL_MAILLE_GEO"])["prix_mm_value"].mean()
    
    # Application du pivot (Mapping multi-index)
    df_final["Indice de prix (CL)"] = (
        (df_final["prix_mm_value"] / 
         df_final.set_index(["CD_TYPE_BIEN","VAL_MAILLE_GEO"]).index.map(pivot_2020_CL)
        ) * 100 
    ).round(2)
else:
    print("Attention: Aucune donnée CL trouvée pour 2020")
    df_final["Indice de prix (CL)"] = np.nan

# --- 3. Chargement et Préparation des données INSEE ---
types_biens = ['APT', 'MAI']
perimetre_insee = ['92', '93', '94', '95', '91','75', '78', '77', "MARSEILLE", "LYON", "LILLE",'NORD-PAS-DE-CALAIS','PACA','RHONE-ALPES','PROVINCE','AUVERGNE','IDF']
insee_path = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\table_rapport (2025)"
insee_to_concat = []

for perimetre in perimetre_insee:
    for type_b in types_biens:
        try:
            file_p = os.path.join(insee_path, f"valeurs_trimestrielles_{perimetre}_{type_b}.csv")
            valeurs_trimestrielles = pd.read_csv(file_p, sep=';')
            
            # Nettoyage structurel (slicing des 4 premières lignes inutiles)
            valeurs_trimestrielles = valeurs_trimestrielles[3:].copy()
            
            # Renommage dynamique de la colonne indice (souvent en position 1)
            col_indice = valeurs_trimestrielles.columns[1]
            valeurs_trimestrielles = valeurs_trimestrielles.rename(columns={col_indice: 'Indice de prix (INSEE)'})
            
            # Conversion numérique forcée (les erreurs deviennent NaN)
            valeurs_trimestrielles['Indice de prix (INSEE)'] = pd.to_numeric(
                valeurs_trimestrielles['Indice de prix (INSEE)'], errors='coerce'
            )
            
            # Parsing de la date (Ex: "2015-T1")
            valeurs_trimestrielles['Year'] = valeurs_trimestrielles['Libellé'].apply(lambda x: int(str(x).split('-')[0]))
            valeurs_trimestrielles['Quarter'] = valeurs_trimestrielles['Libellé'].apply(lambda x: int(str(x).split('T')[-1]))
            
            # Création chaîne propre YYYYQx
            valeurs_trimestrielles["Date code"] = (
                valeurs_trimestrielles['Year'].astype(str) + 'Q' + valeurs_trimestrielles["Quarter"].astype(str)
            )
            
            # Conversion en PeriodIndex
            valeurs_trimestrielles["Periode"] = pd.PeriodIndex(valeurs_trimestrielles["Date code"], freq="Q").to_timestamp()
            
            valeurs_trimestrielles["VAL_MAILLE_GEO"] = perimetre
            valeurs_trimestrielles["CD_TYPE_BIEN"] = type_b
            
            # On garde uniquement les colonnes utiles
            keep_cols = ["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "Indice de prix (INSEE)"]
            insee_to_concat.append(valeurs_trimestrielles[keep_cols])
            
        except Exception as e:
            # print(f"Info: Pas de fichier ou erreur pour {perimetre}_{type_b}")
            continue

if insee_to_concat:
    insee_final = pd.concat(insee_to_concat, ignore_index=True)
    
    # Harmonisation des noms de régions
    remplacement_regions = {
        "RHONE-ALPES": "RHÔNE-ALPES",
        "PACA": "PROVENCE-ALPES-CÔTE D'AZUR",
        "IDF": "ÎLE-DE-FRANCE"
    }
    insee_final["VAL_MAILLE_GEO"] = insee_final["VAL_MAILLE_GEO"].replace(remplacement_regions)
else:
    print("Erreur critique: Aucun fichier INSEE chargé.")
    sys.exit(1)

# --- 4. Calcul de l'indice INSEE (Base 2020) ---
insee_final["Periode"] = pd.to_datetime(insee_final["Periode"])
mask_2020_insee = insee_final["Periode"].dt.year == 2020

if not insee_final.loc[mask_2020_insee].empty:
    pivot_2020_insee = insee_final.loc[mask_2020_insee].groupby(["CD_TYPE_BIEN","VAL_MAILLE_GEO"])["Indice de prix (INSEE)"].mean()
    
    insee_final["Indice de prix (INSEE) - Base 2020"] = (
        (insee_final["Indice de prix (INSEE)"] / 
         insee_final.set_index(["CD_TYPE_BIEN","VAL_MAILLE_GEO"]).index.map(pivot_2020_insee)
        ) * 100 
    ).round(2)
else:
    print("Attention: Données INSEE 2020 manquantes.")

# --- 5. Nettoyage et Création des Clés de Fusion ---
for df in (df_final, insee_final):
    df["VAL_MAILLE_GEO"] = df["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
    df["CD_TYPE_BIEN"] = df["CD_TYPE_BIEN"].astype(str).str.strip().str.upper()

# Création de la clé string ROBUSTE "YYYYQx" (Ex: "2025Q2")
df_final['Periode_Key'] = df_final["Periode"].dt.to_period('Q').astype(str)
insee_final['Periode_Key'] = insee_final["Periode"].dt.to_period('Q').astype(str)



# --- 6. Fusion (Merge) ---
merge = pd.merge(
    df_final, 
    insee_final.drop(columns=['Periode']), # On enlève la date Timestamp INSEE pour éviter doublon
    how="inner",
    left_on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode_Key"],
    right_on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode_Key"]
)

# --- 7. Nettoyage Final et Conversion Date ---

# Renommer la clé de fusion pour la clarté (optionnel, car on va recréer Periode)
merge = merge.rename(columns={'Periode_Key': 'Periode_Trimestre_Str'})

# CORRECTION : On filtre pour être sûr qu'on n'a que des formats valides (YYYYQx)
# Cela élimine les lignes parasites qui causent l'erreur "Unknown format: PERIODE"
merge = merge[merge['Periode_Trimestre_Str'].str.match(r'^\d{4}Q\d$', na=False)]

# Reconstruction de l'index temporel propre
merge["Periode"] = pd.PeriodIndex(merge['Periode_Trimestre_Str'], freq='Q').to_timestamp(how="end")
temp_period = pd.PeriodIndex(merge['Periode_Trimestre_Str'],freq='Q').to_timestamp(how='end')
merge["Periode"] = temp_period.normalize().map(lambda x: x.replace(day=1))

# Nettoyage colonnes inutiles
merge = merge.drop(columns=['prix_mm_value', 'Periode_Trimestre_Str', 'Periode_Merge'], errors='ignore')
merge = merge.loc[:, ~merge.columns.duplicated()]


# Tri final
merge = merge.sort_values(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode"])

print(f"\nFusion réussie ! {len(merge)} lignes prêtes pour l'analyse.")
merge = merge[~merge["Indice de prix (INSEE) - Base 2020"].isna()]
merge.head()


INSEE_COL = "Indice de prix (INSEE) - Base 2020"
CL_COL = "Indice de prix (CL)"

merge['Dif'] = merge["Indice de prix (CL)"] - merge['Indice de prix (INSEE) - Base 2020']
# 1. Calcul de la Corrélation 
def calculate_correlation_value(df):
    """Calcule la corrélation de Pearson """
    return df[CL_COL].corr(df[INSEE_COL])

correlation_mat = (
    merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
    .apply(calculate_correlation_value)
    .rename("Corrélation") 
    .reset_index()          
)

# 2. Stats (Ecarts)
ecarts_stats = (
    merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])[["Dif"]]
    .agg(
        Ecart_Moyen=("Dif", "mean"),
        Ecart_type=("Dif", "std"),
        Ecart_min=("Dif", "min"),
        Ecart_max=("Dif", "max")
    )
    .reset_index()
)

# 3. RMSE
def rmse(series):
    return np.sqrt(np.mean(series**2))

rmse_results = (
    merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])[["Dif"]]
    .agg(RMSE=("Dif", rmse))
    .reset_index()
)

# 4. Fusion finale 
comparaison = (
    ecarts_stats
    .merge(rmse_results, on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
    .merge(correlation_mat, on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])
)

print("\n--- Résultat de la Comparaison Statistique ---")
print(90*"=")
print(comparaison.describe())
