# Si le cluster a un différé de ~6 mois en début de vie,
# le rapport "ancienneté / T0" devrait être atypique
import numpy as np

cluster = sub_court.filter((pl.col("err_jours") > 160) & (pl.col("err_jours") < 185))
normal_ = sub_court.filter(pl.col("err_jours").abs() < 10)

for name, sub in [("cluster +173j", cluster), ("normale", normal_)]:
    T0  = sub["T0"].to_numpy()
    R   = sub["R"].to_numpy()
    NB  = sub["NB_MATURITE_IRBA"].to_numpy()
    print(f"\n--- {name} (n={len(R)}) ---")
    print(f"  R médian       : {np.median(R):.4f}")
    print(f"  T0 médian      : {np.median(T0):.4f}")
    print(f"  NB médian      : {np.median(NB):.4f}")
    print(f"  NB/R médian    : {np.median(NB/R):.4f}")
    print(f"  (T0-R)/T0      : {np.median((T0-R)/T0):.4f}  # ancienneté %")
    # Pour un amort progressif normal, NB ≈ R/2 approximativement
    # Donc NB - R/2 devrait être ~ 0. Si décalage = différé.
    print(f"  NB - R/2       : {np.median(NB - R/2)*365.25:+.1f} jours")
