inflation:
    method: 'compound'  # 'simple', 'compound', 'exponential'
    lookback_periods: 4  # Nombre de trimestres pour calcul taux
    smoothing_alpha: 0.3  # Pour lissage exponentiel
    
training:
  retrain_frequency: 'quarterly'
  validation_split: 0.2
  min_train_size: 8
  
  # Critères de sauvegarde
  save_criteria:
    min_correlation: 0.85
    max_rmse: 10.0
    improvement_threshold: 0.02  # 2% amélioration minimum

inference:
  confidence_level: 0.95
  output_format: 'csv'
  batch_size: 100
  
monitoring:
  metrics:
    - 'rmse'
    - 'correlation'
    - 'mean_absolute_error'
    - 'bias'
  
  drift_threshold: 0.15  # 15% changement = alerte
  alert_email: null  # À configurer si besoin

paths:
  models: "artifacts/models"
  predictions: "artifacts/predictions"
  metrics: "artifacts/metrics"
  logs: "logs"
