import pandas as pd
from statsmodels.tsa.holtwinters import ExponentialSmoothing
import warnings

# On ignore les warnings de convergence pour la clarté
warnings.filterwarnings("ignore")

# Liste pour stocker les résultats
previsions = []

# On boucle sur chaque segment (Zone / Type de bien)
grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("Calcul des prévisions en cours...\n")

for name, group in grouped:
    zone, type_bien = name
    
    # 1. Préparation de la série temporelle de l'écart
    ts_ecart = group.sort_values("Periode").set_index("Periode")['Dif'].dropna()
    
    # Sécurité : il faut un minimum de points pour modéliser
    if len(ts_ecart) > 4:
        try:
            # 2. Modèle de Holt (Lissage Double Exponentiel)
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                damped_trend=True, 
                initialization_method="estimated"
            ).fit()
            
            # 3. Prévision sur 2 périodes (T+1 et T+2)
            forecast = model.forecast(2)
            
            # 4. Stockage propre
            previsions.append({
                "Zone": zone,
                "Type": type_bien,
                "Dernier Écart Connu": round(ts_ecart.iloc[-1], 2),
                "Ajustement Prévu T+1": round(forecast.iloc[0], 2),
                "Ajustement Prévu T+2": round(forecast.iloc[1], 2)
            })
            
        except:
            pass

# Conversion en DataFrame pour un affichage propre
df_resultats = pd.DataFrame(previsions)

print("=== TABLEAU DES AJUSTEMENTS À APPLIQUER (INDICE CL - AJUSTEMENT = INSEE ESTIMÉ) ===")
print(df_resultats.to_string(index=False))
