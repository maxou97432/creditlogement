def meilleur_candidat_fusion_chevauchement(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,      # compat, ignoré
    ans_strict: int = 0,              # compat, ignoré
    lgd_col: str = LGD_COL,
    jenks_col: str = CLASS_COL,
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Fusionne la paire adjacente (ordre LRA global) dont les intervalles à 95 %
    se CHEVAUCHENT le plus.

    USE_N = True  : borne = moyenne ± Z·σ/√n   (IC de la moyenne, dépend de n)
    USE_N = False : borne = moyenne ± Z·σ      (dispersion des obligors, robuste à n)

    Chevauchement : borne_sup(classe basse) > borne_inf(classe haute).
    On fusionne la paire au chevauchement maximal (= severite_totale max).
    """
    # moyenne, écart-type, effectif par classe (sur obligors bruts)
    stats = (
        df.group_by([jenks_col])
        .agg([
            pl.col(lgd_col).mean().alias("mu"),
            pl.col(lgd_col).std(ddof=1).alias("sigma"),
            pl.len().alias("n"),
        ])
        .with_columns(
            # demi-largeur : avec ou sans /sqrt(n) selon USE_N
            (pl.lit(Z) * pl.col("sigma") /
             (pl.col("n").sqrt() if USE_N else pl.lit(1.0))).alias("demi")
        )
        .with_columns([
            (pl.col("mu") - pl.col("demi")).alias("borne_inf"),
            (pl.col("mu") + pl.col("demi")).alias("borne_sup"),
        ])
        .sort("mu")   # ordre LRA global, pas de cloisonnement segment
    )

    # paires adjacentes + mesure de chevauchement
    paires = (
        stats.with_columns([
            pl.col(jenks_col).shift(-1).alias("next_class"),
            pl.col("borne_inf").shift(-1).alias("next_inf"),
            pl.col("mu").shift(-1).alias("next_mu"),
        ])
        .filter(pl.col("next_class").is_not_null())
        # chevauchement = combien la borne sup de la basse dépasse la borne inf de la haute
        .with_columns((pl.col("borne_sup") - pl.col("next_inf")).alias("chevauchement"))
        .with_columns((pl.col("next_mu") - pl.col("mu")).alias("gap"))
        .filter(pl.col("chevauchement") > 0)           # il faut qu'elles se chevauchent
        .with_columns(pl.col("chevauchement").alias("severite_totale"))
        .sort("severite_totale", descending=True)       # le plus gros chevauchement d'abord
        .select([jenks_col, "next_class", "severite_totale", "chevauchement", "gap"])
        .collect()
    )

    if log:
        mode = "IC moyenne (±Zσ/√n)" if USE_N else "dispersion (±Zσ)"
        print(f"=== Chevauchements 95 % — mode {mode} ===")
        print("Aucune paire ne se chevauche." if paires.height == 0 else paires)

    if paires.height == 0:
        return None, None

    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires


