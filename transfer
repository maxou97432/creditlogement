def export_outliers_excel(outliers_df, filename="outliers_analysis.xlsx"):
    """Exporte les outliers et analyses dans un fichier Excel multi-feuilles"""
    print("\n" + "="*80)
    print("EXPORT DES OUTLIERS")
    print("="*80)
    
    try:
        with pd.ExcelWriter(filename, engine='openpyxl') as writer:
            # Feuille 1: Tous les outliers
            outliers_df.to_excel(writer, sheet_name="Tous_les_outliers", index=False)
            
            # Feuille 2: Statistiques par critère
            criteres_list = []
            for idx, row in outliers_df.iterrows():
                reason_val = row["OUTLIER_REASON"]
                if pd.notna(reason_val) and str(reason_val).strip() != "":
                    reasons = str(reason_val).split("|")
                else:
                    reasons = ["Non_specifie"]
                for reason in reasons:
                    criteres_list.append(reason.strip())
            
            criteres_stats = pd.DataFrame({
                "Critère": pd.Series(criteres_list).value_counts().index,
                "Nombre": pd.Series(criteres_list).value_counts().values,
                "Pourcentage": (pd.Series(criteres_list).value_counts().values / len(outliers_df) * 100).round(2)
            })
            criteres_stats.to_excel(writer, sheet_name="Stats_par_critere", index=False)
            
            # Feuille 3: Top départements
            if "LIBELLE_DEPT" in outliers_df.columns:
                top_dept = outliers_df["LIBELLE_DEPT"].value_counts().head(20).reset_index()
                top_dept.columns = ["Département", "Nombre_outliers"]
                top_dept.to_excel(writer, sheet_name="Top_departements", index=False)
            
            # Feuille 4: Évolution temporelle
            if "YEAR" in outliers_df.columns:
                temp_evolution = outliers_df["YEAR"].value_counts().sort_index().reset_index()
