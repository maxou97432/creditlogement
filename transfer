# 2. Fonction de formatage du texte pour l'affichage (MAIN MODIFICATION ICI)
def format_text_label(row):
    # Ligne 1 : Nom de la ville en MAJUSCULES
    ville = str(row['label']).upper() 
    
    # Ligne 2 : Prix
    prix_val = row['prix_mm_value']
    prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
    
    # Ligne 3 : Taux d'inflation 3M
    ti_3m_val = row['TAUX_INFL_3M']
    ti_3m = f"3M: {ti_3m_val:+.1%}".replace('.', ',') if pd.notna(ti_3m_val) else "3M: N/A"
    
    # Ligne 4 : Taux d'inflation 12M
    ti_12m_val = row['TAUX_INFL_12M']
    ti_12m = f"12M: {ti_12m_val:+.1%}".replace('.', ',') if pd.notna(ti_12m_val) else "12M: N/A"
    
    # Retourne QUATRE lignes : Ville, Prix, 3M, 12M (séparées par '\n')
    return f"{ville}\n{prix}\n{ti_3m}\n{ti_12m}"


# =============================================================================
# --- PRÉPARATION DU CONTOUR GÉOGRAPHIQUE ---
# =============================================================================

try:
    france_gdf = gpd.read_file(geojson_path)
    dissolved_france = france_gdf.dissolve(by=None)
    france_outline_geometry = dissolved_france.geometry.iloc[0] 
    print("Contour de la France chargé et dissous avec succès.")
except Exception as e:
