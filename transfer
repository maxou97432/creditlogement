from scipy.stats import kruskal, levene
from collections import Counter

# =====================================================================
# CONFIGURATION
# =====================================================================
df_base       = base                  # base rassemblée niveau modèle (grain obligor)
TARGET_COL    = "lgd_obligor"
CLASS_COL     = "CHR_model"
P_VALUE_FLOOR = 0.05
MAX_ITER      = 1000
ECHELLE       = 100.0                  # LGD en base 100

# >>> NIVEAU D'ACCEPTATION DES FUSIONS <
CODES_FUSIONNABLES = {0, 1}            # {0}=strict, {0,1}=large

# >>> SEUILS OVL (recouvrement empirique, robuste au n et à la forme) <
OVL_STRICT  = 0.75                     # code 0 : fort recouvrement
OVL_MODERE  = 0.50                     # code 1 : recouvrement modéré
N_BINS_OVL  = 100

# =====================================================================
# UTILITAIRES
# =====================================================================
def get_lgd_vectors(lf, cls):
    return (lf.filter(pl.col(CLASS_COL) == cls)
              .select(TARGET_COL).collect()
              .get_column(TARGET_COL).to_numpy())

def ReturnThreshold(mean_lgd):
    """Seuil d'effectif pour bascule vers OVL (mean_lgd en base 100)."""
    if mean_lgd < 5:   return 80000
    if mean_lgd < 10:  return 40000
    if mean_lgd < 20:  return 20000
    return 10000

# =====================================================================
# OVL EMPIRIQUE — recouvrement des distributions, sans hypothèse de forme
# =====================================================================
def overlap_empirique(a: np.ndarray, b: np.ndarray, n_bins: int = N_BINS_OVL):
    """
    OVL = aire d'intersection des deux densités estimées par histogramme.
    1.0 = distributions identiques, 0.0 = aucun recouvrement.
    Indépendant de n et de la forme de la distribution.
    """
    lo = min(a.min(), b.min())
    hi = max(a.max(), b.max())
    bins = np.linspace(lo, hi, n_bins + 1)

    hist_a, _ = np.histogram(a, bins=bins, density=True)
    hist_b, _ = np.histogram(b, bins=bins, density=True)

    bin_width = bins[1] - bins[0]
    ovl = float(np.sum(np.minimum(hist_a, hist_b)) * bin_width)
    return ovl, bins, hist_a, hist_b

def overlap_test(a, b, mean_lgd):
    """
    Test de recouvrement : code 0/1/99 selon OVL.
    code 0 = fort recouvrement (fusionnable)
    code 1 = recouvrement modéré
    code 99 = peu de recouvrement (distinctes)
    """
    ovl, _, _, _ = overlap_empirique(a, b)
    if ovl > OVL_STRICT:
        return 0, f"OVL={ovl:.3f} > {OVL_STRICT} (fort recouvrement)"
    elif ovl > OVL_MODERE:
        return 1, f"OVL={ovl:.3f} > {OVL_MODERE} (recouvrement modere)"
    else:
        return 99, f"OVL={ovl:.3f} <= {OVL_MODERE} (peu de recouvrement)"

# =====================================================================
# TESTS À PETIT EFFECTIF (cascade Welch -> KW -> Levene)
# =====================================================================
def WelchTest(a, b):
    _, p = sp_stats.ttest_ind(a, b, equal_var=False)
    return float(p)

def KWTest(a, b):
    _, p = kruskal(a, b)
    return float(p)

def MarginTest(mean_a, mean_b, mean_lgd):
    """Marge de matérialité en cas d'échec Welch/KW à petit n."""
    delta_a = max(0.2 * mean_lgd, 0.005 * ECHELLE)
    delta_b = max(0.3 * mean_lgd, 0.01  * ECHELLE)
    ad = abs(mean_b - mean_a)
    if ad < delta_a: return 0, f"MARGIN OK (<{delta_a:.2f})"
    if ad < delta_b: return 1, f"MARGIN MODERE (<{delta_b:.2f})"
    return 99, f"MARGIN SEVERE (>={delta_b:.2f})"

# =====================================================================
# DÉCISION DE FUSION POUR UNE PAIRE
# =====================================================================
def tester_paire(a, b):
    """Renvoie (fusionnable: bool, test: str, code: int, raison: str)."""
    n = len(a) + len(b)
    mean_lgd = float((a.sum() + b.sum()) / n)

    if n > ReturnThreshold(mean_lgd):
        code, raison = overlap_test(a, b, mean_lgd)   # grand n -> OVL
        test = "ovl"
    else:
        p_w = WelchTest(a, b)                          # petit n -> cascade
        if p_w >= P_VALUE_FLOOR:
            code, raison, test = 0, f"WELCH p={p_w:.3f}>=floor", "welch"
        else:
            p_kw = KWTest(a, b)
            if p_kw >= P_VALUE_FLOOR:
                code, raison, test = 0, f"KW p={p_kw:.3f}>=floor", "kw"
            else:
                code, raison = MarginTest(a.mean(), b.mean(), mean_lgd)
                test = "margin"
    return (code in CODES_FUSIONNABLES), test, code, raison

# =====================================================================
# OPÉRATIONS SUR LES CLASSES
# =====================================================================
def merge_classes(lf, ca, cb, new):
    return lf.with_columns(
        pl.when(pl.col(CLASS_COL).is_in([ca, cb]))
          .then(pl.lit(new)).otherwise(pl.col(CLASS_COL)).alias(CLASS_COL))

def build_adjacent_pairs(lf):
    """Paires adjacentes, ordre LRA global (niveau modèle)."""
    cm = (lf.group_by(CLASS_COL).agg(pl.col(TARGET_COL).mean().alias("m"))
            .sort("m").collect())
    P = [(cm[i, CLASS_COL], cm[i+1, CLASS_COL], abs(cm[i+1, "m"] - cm[i, "m"]))
         for i in range(cm.height - 1)]
    return pl.DataFrame({"class_a": [p[0] for p in P],
                         "class_b": [p[1] for p in P],
                         "severite_totale": [p[2] for p in P]})

# =====================================================================
# BOUCLE DE REGROUPEMENT
# =====================================================================
def regroupement(lf, max_iter=MAX_ITER):
    current, history = lf, []
    for it in range(max_iter):
        candidates = build_adjacent_pairs(current).sort("severite_totale")
        fused = False
        for ca, cb, sev in candidates.iter_rows():
            a = get_lgd_vectors(current, ca)
            b = get_lgd_vectors(current, cb)
            ok, test, code, raison = tester_paire(a, b)
            if ok:
                new = f"{ca}_{cb}"
                current = merge_classes(current, ca, cb, new)
                fused = True
                history.append({
                    "iteration": it, "class_a": ca, "class_b": cb, "new_class": new,
                    "test": test, "code": code, "gap": round(sev, 4),
                    "mean_a": round(float(a.mean()), 3), "mean_b": round(float(b.mean()), 3),
                    "n_a": len(a), "n_b": len(b), "raison": raison,
                })
                break
        if not fused:
            break
    return current, history

# =====================================================================
# DIAGNOSTIC OVL — PAIRES ADJACENTES + GRAPHIQUES
# =====================================================================
def plot_overlap(a, b, cls_a, cls_b, ovl, bins, hist_a, hist_b, ax=None):
    if ax is None:
        fig, ax = plt.subplots(figsize=(8, 4))

    centers = (bins[:-1] + bins[1:]) / 2
    width = bins[1] - bins[0]

    ax.bar(centers, hist_a, width=width, alpha=0.5, label=f"Classe {cls_a} (n={len(a)})", color="steelblue")
    ax.bar(centers, hist_b, width=width, alpha=0.5, label=f"Classe {cls_b} (n={len(b)})", color="darkorange")

    overlap_height = np.minimum(hist_a, hist_b)
    ax.bar(centers, overlap_height, width=width, alpha=0.7, color="green",
           label=f"Recouvrement (OVL={ovl:.3f})")

    ax.set_xlabel("LGD (pts)")
    ax.set_ylabel("Densite")
    ax.set_title(f"{cls_a} vs {cls_b} - OVL = {ovl:.3f}")
    ax.legend()
    return ax

def diagnostic_ovl(lf, n_graphs=5):
    """Tableau OVL pour toutes les paires adjacentes + graphiques pour les n_graphs plus proches."""
    diag_pairs = build_adjacent_pairs(lf).sort("severite_totale")

    rows = []
    for ca, cb, sev in diag_pairs.iter_rows():
        a = get_lgd_vectors(lf, ca)
        b = get_lgd_vectors(lf, cb)
        ovl, _, _, _ = overlap_empirique(a, b)
        rows.append({
            "class_a": ca, "class_b": cb,
            "gap": round(sev, 4), "OVL": round(ovl, 4),
            "n_a": len(a), "n_b": len(b),
            "fusionnable": "OUI" if ovl > OVL_MODERE else "NON",
        })

    df_ovl = pl.DataFrame(rows)
    with pl.Config(tbl_rows=100, tbl_cols=-1):
        print(df_ovl)

    if n_graphs > 0:
        fig, axes = plt.subplots(n_graphs, 1, figsize=(8, 4 * n_graphs))
        if n_graphs == 1:
            axes = [axes]
        for i, (ca, cb, sev) in enumerate(diag_pairs.head(n_graphs).iter_rows()):
            a = get_lgd_vectors(lf, ca)
            b = get_lgd_vectors(lf, cb)
            ovl, bins, hist_a, hist_b = overlap_empirique(a, b)
            plot_overlap(a, b, ca, cb, ovl, bins, hist_a, hist_b, ax=axes[i])
        plt.tight_layout()
        plt.show()

    return df_ovl

