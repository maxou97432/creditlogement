# Vérifie la distribution des "micro-écarts"
check = srs_X_capret.with_columns(
    ((pl.col('MATURITE')/12).clip(1,5) - pl.col('NB_DURATION_IRBA')).alias('diff')
)

print("Exactement 0.0        :", check.filter(pl.col('diff') == 0.0).height)
print("Entre 0 et 0.001      :", check.filter((pl.col('diff').abs() > 0.0) & (pl.col('diff').abs() < 0.001)).height)
print("Entre 0.001 et 0.01   :", check.filter((pl.col('diff').abs() >= 0.001) & (pl.col('diff').abs() < 0.01)).height)
print("Supérieur à 0.01      :", check.filter(pl.col('diff').abs() >= 0.01).height)
