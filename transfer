# -------------------------------------------------------------
# RÈGLE 3 : Plafonds Réglementaires (Floor et Cap)
# -------------------------------------------------------------
print("▶ RÈGLE 3 : Application du Floor (1 an) et du Cap (5 ans)")
anomalies_cap = srs_audit.filter(pl.col('NB_DURATION_IRBA') > 5.001)
anomalies_floor = srs_audit.filter(pl.col('NB_DURATION_IRBA') < 0.999)
print(f"  └─> Dépassements hors limites hautes (> 5 ans) : {anomalies_cap.height} (Strict 0 attendu).")
print(f"  └─> Dépassements sous limites basses (< 1 an)  : {anomalies_floor.height} candidats aux exemptions.\n")


# -------------------------------------------------------------
# RÈGLE 4 : Exceptions Réglementaires au Floor (< 1 an)
# -------------------------------------------------------------
print("▶ RÈGLE 4 : Validité de l'Exception de Maturité Initiale (< 1 an)")
if anomalies_floor.height > 0:
    
    # Évaluation numérique brute de la maturité (évite les erreurs de parsing str to_date)
    # Formule approchée ans : Diff YYYYMMDD / 10000 | Diff Jours SAS / 365.25
    audit_init = anomalies_floor.with_columns(
        (pl.col('DT_ECHEANCE_FEM') - pl.col('DT_DEBUT_AUTO')).alias('difference_brute')
    ).with_columns(
        pl.when(pl.col('DT_DEBUT_AUTO') > 300000)
        .then(pl.col('difference_brute') / 10000.0) 
        .otherwise(pl.col('difference_brute') / 365.25)
        .alias('Maturite_Initiale_Approx_Ans')
    )
    
    respectent = audit_init.filter(pl.col('Maturite_Initiale_Approx_Ans') <= 1.0).height
    print(f"  └─> {respectent} prêts sur {anomalies_floor.height} respectent l'exception de maturité initiale < 1 an.")
else:
    print("  └─> Aucune exception détectée.")

