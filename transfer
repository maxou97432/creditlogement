def exemples_par_critere(outliers_df):
    """Affiche des exemples concrets d'outliers pour chaque critère"""
    print("\n" + "="*80)
    print("EXEMPLES CONCRETS PAR CRITÈRE D'ÉLIMINATION")
    print("="*80)
    
    # Obtenir les critères uniques
    all_criteres = set()
    for reasons in outliers_df["OUTLIER_REASON"].dropna():
        for reason in str(reasons).split("|"):
            all_criteres.add(reason.strip())
    
    cols_display = ["ville_", "TYPE_BIEN", "Prix_m2", "NB_SURF_HAB", "NB_PIECES", "YEAR", "OUTLIER_REASON"]
    cols_available = [col for col in cols_display if col in outliers_df.columns]
    
    for critere in sorted(all_criteres):
        if critere == "Non spécifié":
            continue
            
        # Filtrer les outliers pour ce critère
        mask = outliers_df["OUTLIER_REASON"].str.contains(critere, na=False, regex=False)
        subset = outliers_df[mask]
        
        if len(subset) == 0:
            continue
            
        print(f"\n🔍 Exemples pour : {critere}")
        print("-" * 80)
        
        # Prendre 5 exemples aléatoires
        n_samples = min(5, len(subset))
        samples = subset[cols_available].sample(n=n_samples, random_state=42)
        print(samples.to_string(index=False))
        print()


def export_outliers_excel(outliers_df, filename="outliers_analysis.xlsx"):
    """Exporte les outliers et analyses dans un fichier Excel multi-feuilles"""
    print("\n" + "="*80)
    print("EXPORT DES OUTLIERS")
    print("="*80)
    
    try:
        with pd.ExcelWriter(filename, engine='openpyxl') as writer:
            # Feuille 1: Tous les outliers
            outliers_df.to_excel(writer, sheet_name="Tous_les_outliers", index=False)
            
            # Feuille 2: Statistiques par critère
            criteres_list = []
            for idx, row in outliers_df.iterrows():
                reasons = str(row["OUTLIER_REASON"]).split("|") if pd.notna(row["OUTLIER_REASON"]) else ["Non spécifié"]
                for reason in reasons:
                    criteres_list.append(reason.strip())
            
            criteres_stats = pd.DataFrame({
                "Critère": pd.Series(criteres_list).value_counts().index,
                "Nombre": pd.Series(criteres_list).value_counts().values,
                "Pourcentage": (pd.Series(criteres_list).value_counts().values / len(outliers_df) * 100).round(2)
            })
            criteres_stats.to_excel(writer, sheet_name="Stats_par_critere", index=False)
            
            # Feuille 3: Top départements
            if "LIBELLE_DEPT" in outliers_df.columns:
                top_dept = outliers_df["LIBELLE_DEPT"].value_counts().head(20).reset_index()
                top_dept.columns = ["Département", "Nombre_outliers"]
                top_dept.to_excel(writer, sheet_name="Top_departements", index=False)
            
            # Feuille 4: Évolution temporelle
            if "YEAR" in outliers_df.columns:
                temp_evolution = outliers_df["YEAR"].value_counts().sort_index().reset_index()
                temp_evolution.columns = ["Année", "Nombre_outliers"]
                temp_evolution.to_excel(writer, sheet_name="Evolution_temporelle", index=False)
        
        print(f"\n✅ Fichier exporté avec succès : {filename}")
        print(f"   Nombre total d'outliers : {len(outliers_df):,}")
    except Exception as e:
        print(f"\n❌ Erreur lors de l'export : {e}")
    print()


def rapport_complet_outliers(outliers_df, base_clean):
    """Génère un rapport complet sur les outliers avec toutes les analyses"""
    print("\n\n")
    print("="*80)
    print("=" * 30 + " RAPPORT COMPLET " + "=" * 34)
    print("=" * 25 + " ANALYSE DES OUTLIERS " + "=" * 34)
    print("="*80)
    
    # Vue d'ensemble
    total = len(outliers_df) + len(base_clean)
    print(f"\n📊 VUE D'ENSEMBLE")
    print("-" * 80)
    print(f"  Nombre total de biens traités    : {total:,}")
    print(f"  Biens valides conservés           : {len(base_clean):,} ({len(base_clean)/total*100:.2f}%)")
    print(f"  Outliers détectés et retirés      : {len(outliers_df):,} ({len(outliers_df)/total*100:.2f}%)")
    
    # Analyses détaillées
    analyser_par_critere(outliers_df)
    analyse_geo_par_critere(outliers_df)
    analyse_temporelle_par_critere(outliers_df)
    analyse_typologie_par_critere(outliers_df)
    analyse_source_par_critere(outliers_df)
    exemples_par_critere(outliers_df)
    
    # Export Excel
    timestamp = datetime.now().strftime("%Y-%m-%d_%H%M")
    filename = f"outliers_analysis_{timestamp}.xlsx"
    export_outliers_excel(outliers_df, filename)
    
    print("="*80)
    print("FIN DU RAPPORT")
    print("="*80)
    print("\n")
    
    return outliers_df


