types_bien = ['APT', 'MAI']

for type_bien in types_bien:
    print(f"\n--- Génération de la carte pour le type de bien : {type_bien} ---")
    
    df_prix_filtre = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
    df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
    df_map = df_geo_gps.merge(df_prix_filtre, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
    
    df_map = df_map[['label', 'latitude', 'longitude', 'prix_mm_value', "TAUX_INFL_3M", 'TAUX_INFL_12M']].copy()
    df_map = df_map.dropna(subset=['latitude', 'longitude'])
    df_map = df_map.drop_duplicates(subset='label', keep='first')
    
    if df_map.empty:
        print("Aucune donnée géographique valide trouvée pour ce type de bien.")
        continue
        
    df_map['Formatted_Label'] = df_map.apply(format_text_label, axis=1)
    geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
    gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326")
    
    # --- DESSIN ---
    fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=300) # Augmente la taille de la figure
    
    # Fond de l'image (Zone de l'océan/extérieur) - Couleur de fond générale
    fig.set_facecolor(CL_TURQUOISE) # Utilise le turquoise de CL
    
    # --- DESSIN DU CONTOUR DE LA FRANCE ---
    geometries_to_plot = [france_outline_geometry]
    if france_outline_geometry.geom_type == 'MultiPolygon':
        geometries_to_plot = list(france_outline_geometry.geoms)

    for geom in geometries_to_plot:
        # Remplissage de la France
        ax.fill(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_LIGHT_GREY, # Gris clair pour le fond de la France
                zorder=1) 
                
        # Contour noir
        ax.plot(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_BLACK, 
                linewidth=1.0, # Épaisseur du contour
                zorder=2)
    
    # Définir les limites de la vue (zoom sur la France)
    xmin, ymin, xmax, ymax = france_outline_geometry.bounds
    ax.set_xlim(xmin - 0.7, xmax + 0.7) # Augmente légèrement les marges
    ax.set_ylim(ymin - 0.7, ymax + 0.7)

    # --- AJOUT DES ÉTIQUETTES ET DES BULLES ---
    
    x_offset = 0.08 # Décalage horizontal plus grand
    y_offset = 0.08 # Décalage vertical plus grand
    
    for idx, row in gdf.iterrows():
        lon = row['longitude']
        lat = row['latitude']
        
        # 1. Dessiner le fond blanc de l'étiquette et le texte
        ax.text(
            lon + x_offset, 
            lat + y_offset, 
            row['Formatted_Label'],
            fontsize=10, # Taille de police légèrement augmentée
            ha='left', 
            va='bottom',
            color=CL_BLACK,
            zorder=3,
            bbox=dict(boxstyle="round,pad=0.2", fc="white", ec=CL_MEDIUM_GREY, lw=0.7, alpha=0.95) # Bordure grise
        )

        # 2. Ajout du point de ville d'origine (petit cercle noir)
        ax.plot(lon, lat, marker='o', color=CL_BLACK, markersize=4, zorder=4)

        # 3. Ajout de la 'Bulle d'Évolution'
        ti_12m = row['TAUX_INFL_12M']
        if pd.notna(ti_12m):
            # Utilisation de couleurs contrastées pour l'évolution
            color_evolution = '#E4002B' if ti_12m < 0 else CL_TURQUOISE # Rouge pour négatif, Turquoise pour positif
            
            # Placement de la bulle
            ax.add_patch(plt.Circle(
                (lon + x_offset + 0.35, lat + 0.1), # Ajuster le placement de la bulle
                radius=0.12, # Taille de la bulle
                color=color_evolution, alpha=0.9,
                zorder=5
            ))
            # Texte dans la bulle
            ax.text(
                lon + x_offset + 0.35, 
                lat + 0.1, 
                f"{ti_12m:+.1%}".replace('.', ','),
                fontsize=7, color='white', ha='center', va='center',
                zorder=6
            )
    
    # --- FINALISATION DE L'IMAGE ---
    ax.axis('off') # Retirer les axes (latitude/longitude)
    
    # Titre principal (noir sur turquoise)
    title_text = f"LES PRIX DES {type_bien} DANS L'ANCIEN"
    ax.set_title(title_text, fontsize=20, loc='center', pad=20, color=CL_BLACK, ha='center',weight = TITRE_FONT_WEIGHT) # Centré
    
    # Sous-titre et sources (noir sur turquoise)
    subtitle_text = "SUR 1 AN DANS LES PRINCIPALES VILLES"
