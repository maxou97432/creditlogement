def analyser_par_critere(outliers_df):
    """Analyse la répartition des outliers par critère d'élimination"""
    print("\n" + "="*80)
    print("ANALYSE PAR CRITÈRE D'ÉLIMINATION")
    print("="*80)
    
    # Séparer les critères multiples (séparés par |)
    criteres_list = []
    for idx, row in outliers_df.iterrows():
        reason_val = row["OUTLIER_REASON"]
        if pd.notna(reason_val) and str(reason_val).strip() != "":
            reasons = str(reason_val).split("|")
        else:
            reasons = ["Non_specifie"]

        for reason in reasons:
            criteres_list.append(reason.strip())
    
    criteres_counts = pd.Series(criteres_list).value_counts()
    
    print(f"\nNombre total d'outliers : {len(outliers_df):,}")
    print(f"\nRépartition par critère (un outlier peut avoir plusieurs critères) :")
    print("-" * 80)
    for critere, count in criteres_counts.items():
        pct = count / len(outliers_df) * 100
        print(f"  {critere:35s} : {count:6,} ({pct:5.2f}%)")
    
    # Outliers avec critères multiples
    outliers_multi = outliers_df[outliers_df["OUTLIER_REASON"].str.contains("|", na=False)]
    pct_multi = len(outliers_multi) / len(outliers_df) * 100
    print(f"\nOutliers avec critères multiples : {len(outliers_multi):,} ({pct_multi:.2f}%)")
    print()
    
    return criteres_counts


