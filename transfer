        # Séparation du texte en ses trois parties
        full_text_label = row['Formatted_Label']
        formatted_parts = full_text_label.split('\n')
        
        ville = formatted_parts[0] 
        prix = formatted_parts[1]
        evolution_text = formatted_parts[2] if len(formatted_parts) > 2 else ""
        
        # Ancre de départ pour l'étiquette
        anchor_x = lon + x_offset_city
        anchor_y = lat + y_offset_city
        
        ha_align = 'right' if x_offset_city < 0 else 'left'
        
        # Pour que l'étiquette se déroule vers le bas depuis l'ancre
        va_align_box = 'top' 
        
        # Détermination de la couleur de la ligne d'évolution (en fonction de ti_12m)
        ti_12m_val = row['TAUX_INFL_12M']
        color_evolution_line = CL_BLACK # Couleur par défaut
        if pd.notna(ti_12m_val):
            color_evolution_line = CL_RED if ti_12m_val < 0 else CL_TURQUOISE
        
        # Paramètres pour la BBOX (fond blanc)
        bbox_props = dict(boxstyle="round,pad=0.2", fc="white", ec=CL_MEDIUM_GREY, lw=0.7, alpha=0.95)
        
        # 1. Dessiner le fond blanc (BBOX) en utilisant le texte complet invisible
        # Ceci permet à Matplotlib de calculer la zone de la bbox correctement pour englober les TROIS lignes
        ax.text(
            anchor_x, 
            anchor_y, 
            full_text_label, # Utilise le texte complet pour la taille de la bbox
            fontsize=10, 
            ha=ha_align, 
            va=va_align_box,
            color='none', # Rendre le texte invisible
            zorder=3,
            bbox=bbox_props
        )
        
        # 2. Dessiner le Nom de la Ville (Ligne 1, en gras)
        ax.text(
            anchor_x, 
            anchor_y, # Position initiale
            ville, 
            fontsize=10, 
            ha=ha_align, 
            va=va_align_box,
            color=CL_BLACK,
            weight='bold', 
            zorder=4 
        )
        
        # 3. Dessiner le Prix M2 (Ligne 2, en normal)
        prix_y = anchor_y + LINE_SPACING # Décalage vers le bas
        ax.text(
            anchor_x, 
            prix_y, 
            prix, 
            fontsize=10, 
            ha=ha_align, 
            va=va_align_box,
            color=CL_BLACK,
            weight='normal', 
            zorder=4
        )
        
        # 4. Dessiner la ligne d'évolution (Ligne 3, colorée)
        evolution_y = anchor_y + (2 * LINE_SPACING) # Deuxième décalage vers le bas
        ax.text(
            anchor_x, 
            evolution_y, 
            evolution_text, 
            fontsize=8, # Taille de police légèrement plus petite pour cette ligne
            ha=ha_align, 
            va=va_align_box,
            color=color_evolution_line, # Couleur dynamique
            weight='bold', # Mettre en gras pour que la couleur ressorte
            zorder=4
        )
        
