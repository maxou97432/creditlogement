import polars as pl

stats = (
    lra_prov_model3
    .group_by(["submodel_class", "year"])
    .agg(pl.col("lgd_obligor").mean().alias("m"))
    .group_by("submodel_class")
    .agg(pl.col("m").mean().alias("mean_lgd"))
    .with_columns(pl.col("submodel_class").str.split("_").list.first().alias("seg"))
    .sort(["seg", "mean_lgd"])
    .with_columns([
        pl.col("mean_lgd").shift(-1).over("seg").alias("next_lgd"),
        pl.col("submodel_class").shift(-1).over("seg").alias("next_class"),
    ])
    .filter(pl.col("next_class").is_not_null())
    .with_columns((pl.col("next_lgd") - pl.col("mean_lgd")).alias("gap"))
    .sort("gap")
    .collect()
)
print(stats.select("submodel_class","next_class","mean_lgd","gap").head(20))
