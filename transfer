# --- ÉTAPE 1 : Calcul de l'Indice Corrigé par HOLT (DES) ET Prévisions Futures ---

corrected_data = []
# Liste pour stocker les prévisions d'ajustement futur
future_adjustments = []

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("Calcul des modèles de Lissage de Holt par segment...")

for name, group in grouped:
    zone, type_bien = name
    group = group.sort_values("Periode").set_index("Periode")
    
    ts_ecart = group['Dif'].dropna()
    
    if len(ts_ecart) > 12: 
        try:
            # Modélisation Holt
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                seasonal=None, 
                damped_trend=True,
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # --- Partie A : Correction Historique ---
            ecart_modelise = model_fit.fittedvalues
            ecart_modelise = ecart_modelise.reindex(group.index)
            group['Indice de prix (CL) - Corrigé Holt'] = group['Indice de prix (CL)'] - ecart_modelise
            
            # --- Partie B : Prévision de l'Ajustement Futur (NOUVEAU) ---
            # On prédit le biais pour T+1 et T+2
            forecast = model_fit.forecast(2)
            
            future_adjustments.append({
                "VAL_MAILLE_GEO": zone,
                "CD_TYPE_BIEN": type_bien,
                "Ajustement_T+1": round(forecast.iloc[0], 2),
                "Ajustement_T+2": round(forecast.iloc[1], 2)
            })
            
        except Exception as e:
            print(f"Echec Holt pour {name}: {e}")
            group['Indice de prix (CL) - Corrigé Holt'] = np.nan
    else:
        group['Indice de prix (CL) - Corrigé Holt'] = np.nan
        
    corrected_data.append(group.reset_index())

# Reconstitution du DataFrame historique
merge_corrected = pd.concat(corrected_data, ignore_index=True)

# Création du DataFrame des prévisions futures
df_previsions = pd.DataFrame(future_adjustments)

# Affichage du tableau des ajustements (votre demande)
print("\n--- Tableau des Ajustements Futurs à Appliquer (Biais Prévu) ---")
