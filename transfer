def _diagnostiquer_absence_coupure(pdf: pd.DataFrame, col: str, min_leaf: int) -> dict:
    """
    Diagnostique pourquoi un CART n'a produit aucune coupure sur `col`, à
    partir des données déjà chargées (pdf). Retourne un dict avec un motif
    texte détaillé et quelques métriques associées (n_uniques, effectif de
    la modalité dominante, etc.) pour permettre un filtrage facile dans
    df_variables_ignorees, plutôt qu'un seul message générique à parser.
    """
    valeurs = pdf[col]
    n_obs = len(valeurs)
    n_uniques = valeurs.nunique()

    if n_uniques <= 1:
        valeur_unique = valeurs.iloc[0] if n_obs > 0 else None
        return {
            "motif": f"variable constante (valeur unique={valeur_unique}, n_obs={n_obs})",
            "sous_motif": "constante",
            "n_uniques": n_uniques,
            "effectif_modalite_dominante": n_obs,
            "pct_modalite_dominante": 100.0,
        }

    if n_uniques < 3:
        return {
            "motif": f"trop peu de valeurs distinctes pour couper (n_uniques={n_uniques}, n_obs={n_obs})",
            "sous_motif": "trop_peu_valeurs_distinctes",
            "n_uniques": n_uniques,
            "effectif_modalite_dominante": None,
            "pct_modalite_dominante": None,
        }

    variance = valeurs.var()
    if variance is not None and (pd.isna(variance) or variance == 0):
        return {
            "motif": f"variance nulle malgré {n_uniques} valeurs distinctes (n_obs={n_obs})",
            "sous_motif": "variance_nulle",
            "n_uniques": n_uniques,
            "effectif_modalite_dominante": None,
            "pct_modalite_dominante": None,
        }

    effectifs_valeurs = valeurs.value_counts()
    effectif_max_modalite = int(effectifs_valeurs.iloc[0])
    pct_modalite = 100 * effectif_max_modalite / n_obs

    if effectif_max_modalite > n_obs - min_leaf:
        return {
            "motif": (
                f"une modalité concentre {effectif_max_modalite} obs ({pct_modalite:.1f}% "
                f"de n_obs={n_obs}), incompatible avec min_samples_leaf={min_leaf}"
            ),
            "sous_motif": "modalite_dominante_trop_concentree",
            "n_uniques": n_uniques,
            "effectif_modalite_dominante": effectif_max_modalite,
            "pct_modalite_dominante": pct_modalite,
        }

    return {
        "motif": (
            f"aucune coupure valide sous contrainte min_samples_leaf={min_leaf} "
            f"(n_obs={n_obs}, n_uniques={n_uniques})"
        ),
        "sous_motif": "autre",
        "n_uniques": n_uniques,
        "effectif_modalite_dominante": effectif_max_modalite,
        "pct_modalite_dominante": pct_modalite,
    }


def optimiser_cart_variable(
    lf: pl.LazyFrame,
    feature: str,
    target: str,
    distribution: str = "continuous",
    max_depths: list = None,
    min_samples_leaf_pct: float = 0.05,
    cv: int = 5,
    max_classes: int = 8,
    random_state: int = 42,
):
    """
    Recherche le max_depth optimal pour `feature`, par validation croisée,
    à min_samples_leaf fixé (contrainte structurelle en % de la population,
    garantissant qu'aucune classe produite n'est anecdotique).

    Critère de sélection :
      - bernoulli  -> AUC moyenne en CV (maximisée)
      - continuous -> R² ajusté moyen en CV (maximisé) ; RMSE moyen calculé
        dans la même boucle CV (un seul passage fit/predict par fold).

    criterion fixé : "gini" (Classifier) / "squared_error" (Regressor).

    max_classes agit en garde-fou : les max_depth produisant plus de
    max_classes feuilles sont écartés avant le calcul CV.

    Garde-fous anti-crash, avec motif détaillé (chiffres réels, pas un
    message générique) : n_obs < cv*2, ou pour bernoulli classe minoritaire
    < cv individus (contrainte StratifiedKFold).

    Retourne toujours un dict (jamais None) avec au minimum les clés
    feature, best_max_depth (None en cas d'échec), motif_echec, historique,
    et pour les échecs liés aux données : n_obs, n_uniques (si calculable).
    """
    from sklearn.tree import DecisionTreeClassifier, DecisionTreeRegressor
    from sklearn.model_selection import StratifiedKFold, KFold
    from sklearn.metrics import roc_auc_score, mean_squared_error, r2_score

    max_depths = max_depths or [2, 3, 4, 5]

    pdf = (
        lf.filter(pl.col(feature).is_not_null() & pl.col(target).is_not_null())
          .select([feature, target])
          .collect()
          .to_pandas()
    )
    n_obs = len(pdf)

    if n_obs < cv * 2:
        return {
            "feature": feature, "best_max_depth": None, "historique": pd.DataFrame(),
            "motif_echec": f"n_obs={n_obs} insuffisant pour cv={cv} (minimum requis: {cv * 2})",
            "n_obs": n_obs, "pdf": pdf,
        }

    if distribution == "bernoulli":
        effectifs_classes = pdf[target].value_counts()
        if effectifs_classes.min() < cv:
            classe_minoritaire = effectifs_classes.idxmin()
            return {
                "feature": feature, "best_max_depth": None, "historique": pd.DataFrame(),
                "motif_echec": (
                    f"classe minoritaire (target={classe_minoritaire}) a "
                    f"{effectifs_classes.min()} obs < cv={cv} requis"
                ),
                "n_obs": n_obs, "pdf": pdf,
            }

    X = pdf[[feature]].values
    y = pdf[target].values
    min_leaf = max(int(n_obs * min_samples_leaf_pct), 5)

    if distribution == "bernoulli":
        Estimateur = DecisionTreeClassifier
        kwargs_fixes = {"criterion": "gini"}
        splitter = StratifiedKFold(n_splits=cv, shuffle=True, random_state=random_state)
    else:
        Estimateur = DecisionTreeRegressor
        kwargs_fixes = {"criterion": "squared_error"}
        splitter = KFold(n_splits=cv, shuffle=True, random_state=random_state)

    folds = list(splitter.split(X, y))

    historique = []
    for depth in max_depths:
        model_full = Estimateur(
            max_depth=depth, min_samples_leaf=min_leaf,
            random_state=random_state, **kwargs_fixes,
        )

        try:
            model_full.fit(X, y)
            nb_classes = int((model_full.tree_.feature != -2).sum()) + 1
            if nb_classes > max_classes:
                historique.append({
                    "max_depth": depth, "nb_classes": nb_classes,
                    "score_moyen": None, "rmse_moyen": None,
                    "motif_exclusion": f"> max_classes ({max_classes})",
                })
                continue

            scores_fold, rmses_fold = [], []
            for train_idx, test_idx in folds:
                m = Estimateur(max_depth=depth, min_samples_leaf=min_leaf,
                                random_state=random_state, **kwargs_fixes)
                m.fit(X[train_idx], y[train_idx])

                if distribution == "bernoulli":
                    proba = m.predict_proba(X[test_idx])[:, 1]
                    scores_fold.append(roc_auc_score(y[test_idx], proba))
                else:
                    pred = m.predict(X[test_idx])
                    scores_fold.append(r2_score(y[test_idx], pred))
                    rmses_fold.append(mean_squared_error(y[test_idx], pred) ** 0.5)

            if distribution == "bernoulli":
                historique.append({
                    "max_depth": depth, "nb_classes": nb_classes,
                    "score_moyen": np.mean(scores_fold), "score_std": np.std(scores_fold),
                    "rmse_moyen": None, "motif_exclusion": None,
                })
            else:
                r2_adj = _r2_ajuste(np.mean(scores_fold), n_obs, nb_classes)
                historique.append({
                    "max_depth": depth, "nb_classes": nb_classes,
                    "score_moyen": r2_adj, "score_std": np.std(scores_fold),
                    "rmse_moyen": np.mean(rmses_fold), "motif_exclusion": None,
                })
        except Exception as e:
            historique.append({
                "max_depth": depth, "nb_classes": None,
                "score_moyen": None, "rmse_moyen": None,
                "motif_exclusion": f"erreur: {e}",
            })
            continue

    df_hist = pd.DataFrame(historique)
    candidats = df_hist.dropna(subset=["score_moyen"]) if not df_hist.empty else df_hist

    if candidats.empty:
        diag = _diagnostiquer_absence_coupure(pdf, feature, min_leaf)
        return {
            "feature": feature, "best_max_depth": None, "historique": df_hist,
            "motif_echec": f"aucune profondeur valide — {diag['motif']}",
            "n_obs": n_obs, "n_uniques": diag["n_uniques"],
            "effectif_modalite_dominante": diag["effectif_modalite_dominante"],
            "pct_modalite_dominante": diag["pct_modalite_dominante"],
            "sous_motif": diag["sous_motif"],
        }

    ligne = candidats.sort_values("score_moyen", ascending=False).iloc[0]

    return {
        "feature": feature,
        "best_max_depth": int(ligne["max_depth"]),
        "best_min_samples_leaf": min_leaf,
        "best_min_samples_leaf_pct": min_samples_leaf_pct,
        "best_score": float(ligne["score_moyen"]),
        "best_rmse": None if pd.isna(ligne.get("rmse_moyen")) else float(ligne["rmse_moyen"]),
        "best_nb_classes": int(ligne["nb_classes"]),
        "historique": df_hist,
        "motif_echec": None,
        "n_obs": n_obs,
    }


def appliquer_decoupage_cart_optimise(
    lf: pl.LazyFrame,
    variables_quanti: list,
    target: str,
    distribution: str = "continuous",
    dossier_sortie: Path = None,
    suffixe: str = "_CART",
    max_depths: list = None,
    min_samples_leaf_pct: float = 0.05,
    cv: int = 5,
    max_classes: int = 8,
    checkpoint_tous_les: int = 20,
    n_jobs: int = -1,
):
    """
    Calcule, par variable quanti, un CART dont max_depth est choisi par grid
    search + validation croisée (optimiser_cart_variable), à
    min_samples_leaf_pct fixé, puis applique les bins via binner_lazy_generique.

    dict_seuils garde les vraies bornes -inf/+inf (np.inf), ainsi que
    l'effectif par tranche pour l'onglet Seuils_CART.

    L'étape d'optimisation (la plus coûteuse) est parallélisée par variable
    via joblib. Le fit final + extraction des seuils restent séquentiels.

    df_variables_ignorees inclut, pour les variables sans coupure trouvée,
    un motif détaillé (variable constante, modalité dominante trop
    concentrée, etc.) et des colonnes numériques associées (n_uniques,
    effectif/pct de la modalité dominante, sous_motif) pour permettre un
    tri/filtre facile plutôt que de parser le texte.

    Retourne (lf_binned, dict_seuils, variables_binees, df_historique_optim,
    df_variables_ignorees).
    """
    from sklearn.tree import DecisionTreeClassifier, DecisionTreeRegressor
    from joblib import Parallel, delayed

    colonnes_presentes = lf.collect_schema().names()
    variables_valides = [c for c in variables_quanti if c in colonnes_presentes]
    variables_absentes = [c for c in variables_quanti if c not in colonnes_presentes]

    dossier_cart = None
    if dossier_sortie is not None:
        dossier_cart = Path(dossier_sortie) / "decoupCART"
        dossier_cart.mkdir(parents=True, exist_ok=True)

    # --- Étape 1 : optimisation par variable, en parallèle ------------------
    def _optimiser_une_variable(col):
        try:
            return col, optimiser_cart_variable(
                lf, col, target, distribution=distribution,
                max_depths=max_depths, min_samples_leaf_pct=min_samples_leaf_pct,
                cv=cv, max_classes=max_classes,
            )
        except Exception as e:
            return col, {
                "best_max_depth": None,
                "motif_echec": f"erreur inattendue: {e}",
                "sous_motif": "erreur_inattendue",
            }

    resultats = Parallel(n_jobs=n_jobs, prefer="processes")(
        delayed(_optimiser_une_variable)(col)
        for col in tqdm(variables_valides, desc=f"CART optimisé ({distribution}) — grid search")
    )

    # --- Étape 2 : fit final + binning, séquentiel (rapide) ------------------
    dict_seuils, expressions, variables_binees = {}, [], []
    historique_optim = []
    variables_ignorees = [
        {"variable": c, "motif": "absente", "sous_motif": "absente",
         "n_obs": None, "n_uniques": None,
         "effectif_modalite_dominante": None, "pct_modalite_dominante": None}
        for c in variables_absentes
    ]

    Estimateur = DecisionTreeClassifier if distribution == "bernoulli" else DecisionTreeRegressor
    criterion = "gini" if distribution == "bernoulli" else "squared_error"

    for i, (col, resultat) in enumerate(tqdm(resultats, desc="Binning final")):
        if resultat.get("best_max_depth") is None:
            variables_ignorees.append({
                "variable": col,
                "motif": resultat.get("motif_echec", "optimisation échouée"),
                "sous_motif": resultat.get("sous_motif", "optimisation_echouee"),
                "n_obs": resultat.get("n_obs"),
                "n_uniques": resultat.get("n_uniques"),
                "effectif_modalite_dominante": resultat.get("effectif_modalite_dominante"),
                "pct_modalite_dominante": resultat.get("pct_modalite_dominante"),
            })
            continue

        pdf = (
            lf.filter(pl.col(col).is_not_null() & pl.col(target).is_not_null())
              .select([col, target]).collect().to_pandas()
        )
        X, y = pdf[[col]].values, pdf[target].values
        model = Estimateur(
            max_depth=resultat["best_max_depth"],
            min_samples_leaf=resultat["best_min_samples_leaf"],
            criterion=criterion,
            random_state=42,
        )
        model.fit(X, y)

        raw_thresh = model.tree_.threshold[model.tree_.feature != -2]
        thresholds = np.sort(np.unique(raw_thresh))
        finite_thresholds = thresholds[np.isfinite(thresholds)]
        if len(finite_thresholds) == 0:
            diag = _diagnostiquer_absence_coupure(pdf, col, resultat["best_min_samples_leaf"])
            variables_ignorees.append({
                "variable": col,
                "motif": diag["motif"],
                "sous_motif": diag["sous_motif"],
                "n_obs": len(pdf),
                "n_uniques": diag["n_uniques"],
                "effectif_modalite_dominante": diag["effectif_modalite_dominante"],
                "pct_modalite_dominante": diag["pct_modalite_dominante"],
            })
            continue

        min_val, max_val = pdf[col].min(), pdf[col].max() + 1
        bins_bruts = np.concatenate(([min_val], finite_thresholds, [max_val]))
        seuils_finis = list(bins_bruts[1:-1])
        bins = [-np.inf] + seuils_finis + [np.inf]

        # Effectif par tranche, sur la population utilisée pour le fit
        indices_tranche = np.digitize(pdf[col].values, bins[1:-1], right=True)
        effectifs_tranche = pd.Series(indices_tranche).value_counts().sort_index()
        nb_tranches = len(bins) - 1
        effectifs_par_tranche = [int(effectifs_tranche.get(k, 0)) for k in range(nb_tranches)]

        nom_bin = f"{col}{suffixe}"
        expressions.append(binner_lazy_generique(lf, col, bins).alias(nom_bin))
        dict_seuils[col] = {
            "bins": bins,
            "nb_classes": nb_tranches,
            "colonne_binee": nom_bin,
            "effectifs": effectifs_par_tranche,
        }
        variables_binees.append(nom_bin)

        historique_optim.append({
            "variable": col,
            "max_depth": resultat["best_max_depth"],
            "min_samples_leaf_pct": resultat["best_min_samples_leaf_pct"],
            "min_samples_leaf_abs": resultat["best_min_samples_leaf"],
            "score_cv": resultat["best_score"],
            "rmse_cv": resultat["best_rmse"],
            "nb_classes": resultat["best_nb_classes"],
        })

        if (dossier_cart is not None and checkpoint_tous_les
                and (i + 1) % checkpoint_tous_les == 0):
            pd.DataFrame(historique_optim).to_csv(
                dossier_cart / "hyperparametres_optimises_partiel.csv", index=False,
            )
            pd.DataFrame(variables_ignorees).to_csv(
                dossier_cart / "variables_ignorees_partiel.csv", index=False,
            )

    lf_binned = lf.with_columns(expressions) if expressions else lf

    df_historique_optim = pd.DataFrame(historique_optim)
    df_variables_ignorees = pd.DataFrame(variables_ignorees)

    print(f"CART optimisé ({distribution}) : {len(variables_binees)} variables découpées, "
          f"{len(df_variables_ignorees)} ignorées (min_samples_leaf_pct={min_samples_leaf_pct:.0%})")
    if not df_variables_ignorees.empty and "sous_motif" in df_variables_ignorees:
        print(df_variables_ignorees["sous_motif"].value_counts().to_string())

    if dossier_cart is not None:
        table_seuils = construire_table_seuils(dict_seuils)
        table_seuils.to_parquet(dossier_cart / "seuils_cart.parquet", index=False)
        table_seuils.to_csv(dossier_cart / "seuils_cart.csv", index=False)

        df_historique_optim.to_csv(dossier_cart / "hyperparametres_optimises.csv", index=False)
        df_variables_ignorees.to_csv(dossier_cart / "variables_ignorees.csv", index=False)
        for f_partiel in ["hyperparametres_optimises_partiel.csv", "variables_ignorees_partiel.csv"]:
            p = dossier_cart / f_partiel
            if p.exists():
                p.unlink()
        print(f"Seuils + hyperparamètres + variables ignorées sauvegardés : {dossier_cart}")

    return lf_binned, dict_seuils, variables_binees, df_historique_optim, df_variables_ignorees
