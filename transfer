# =============================================================================
# 1. FONCTIONS DE CHARGEMENT
# =============================================================================

def load_cl_results(base_path, version_label):
    """Charge et concatène les résultats CL pour une version donnée."""
    print(f"--- Chargement {version_label} depuis {base_path} ---")
    dfs = []
    # Ordre de priorité des fichiers : Hybride > Restreint > Standard
    suffixes = ["CITY", "DEPT", "REGION", "PROVINCE", "NATIONAL"]
    
    for suffix in suffixes:
        patterns = [
            f"prix_m2_univ_elem_MAJ_{suffix}_HYBRIDE.csv",   # Priorité 1
            f"prix_m2_univ_elem_MAJ_{suffix}_RESTREINT.csv", # Priorité 2
            f"prix_m2_univ_elem_MAJ_{suffix}.csv"            # Priorité 3
        ]
        
        found = False
        for p in patterns:
            fpath = os.path.join(base_path, p)
            if os.path.exists(fpath):
                print(f"   -> Trouvé : {p}")
                df = pd.read_csv(fpath)
                # Standardisation Colonne Géo
                if "VAL_MAILLE_GEO" not in df.columns:
                    col_geo = [c for c in df.columns if c in ["Ville", "DEPT", "REGION"]][0]
                    df = df.rename(columns={col_geo: "VAL_MAILLE_GEO"})
                
                df['MAILLE_TYPE'] = suffix
                dfs.append(df)
                found = True
                break
        if not found:
            print(f"   [INFO] Fichier manquant pour maille : {suffix}")

    if not dfs: return None
    full_df = pd.concat(dfs, ignore_index=True)
    full_df["Periode"] = pd.to_datetime(full_df["DT_MAJ_PM2"], errors='coerce')
    
    col_prix = "prix_mm_value"
    full_df = full_df.rename(columns={col_prix: f"Prix_M2_{version_label}"})
    return full_df

# =============================================================================
# 2. CHARGEMENT ET PRÉPARATION DES DONNÉES
# =============================================================================

# A. Chargement V1 et V2
df_v2 = load_cl_results(PATH_RESULTATS_V2, "V2") # C'est celle qui nous intéresse pour la carte

if df_v2 is None:
    print("Erreur critique : Impossible de charger les résultats V2.")
    sys.exit()

# B. Chargement Données Géo (GPS + Communes)
print("\n--- Chargement Données Géo ---")
df_gps = pd.read_csv(PATH_GPS, sep=';')
df_gps['label'] = df_gps['label'].str.strip().str.upper()

# Merge V2 avec GPS pour les villes
df_carte_data = df_v2[df_v2["MAILLE_TYPE"] == "CITY"].copy()
df_carte_data["VAL_MAILLE_GEO"] = df_carte_data["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
# Correction noms villes
df_carte_data["VAL_MAILLE_GEO"] = df_carte_data["VAL_MAILLE_GEO"].replace({
    "HAVRE": "LE HAVRE", "SAINT ETIENNE": "ST ETIENNE"
})

df_map_ready = pd.merge(df_carte_data, df_gps, left_on='VAL_MAILLE_GEO', right_on='label', how='inner')

# =============================================================================
# 3. GÉNÉRATION DES CARTES (Code Matplotlib)
# =============================================================================
print("\n--- Génération des Cartes ---")

# --- Paramètres Graphiques ---
CL_TURQUOISE = '#A8DADC'
CL_BLACK = '#1D3557'
CL_LIGHT_GREY = '#F5F5DC'
CL_BLUE_3M = '#000000'
CL_RED_12M = '#CB4735'
TARGET_CRS = "EPSG:2154"

# --- Chargement Fond de Carte ---
try:
    gdf_france = gpd.read_file(PATH_GEOJSON)
    dissolved_france = gdf_france.dissolve()
    france_geometry = dissolved_france.to_crs(TARGET_CRS).geometry.iloc[0]
    
    # Nettoyage Iles (garder le continent)
    geoms = list(france_geometry.geoms) if france_geometry.geom_type == 'MultiPolygon' else [france_geometry]
    geoms.sort(key=lambda x: x.area, reverse=True)
    france_outline = geoms[0]
    
except Exception as e:
    print(f"Erreur chargement GeoJSON: {e}")
    sys.exit()

# --- Offsets Manuels ---
CUSTOM_OFFSETS = {
    'MONTPELLIER': {'x': -5000, 'y': 60000}, 
    'MARSEILLE':   {'x': -5000,  'y': -5000},
    'TOULON':      {'x': 5000,  'y': -10000},
    'NICE':        {'x': 30000, 'y': 3000}, 
    'GRENOBLE':    {'x': 5000, 'y': -10000},   
    'ST ETIENNE':  {'x': -30000, 'y': 0},
    'LE HAVRE':    {'x': 10000, 'y': 0},
    'BORDEAUX':    {'x': 5000,  'y': 0},  
    'NANTES':      {'x': 5000,  'y': 0},  
    'RENNES':      {'x': 5000,  'y': 0},  
    'LILLE':       {'x': 0,   'y': -10000}, 
    'STRASBOURG':  {'x': -5000, 'y': 0},  
    'PARIS':       {'x': 5000, 'y': 3000},
    'LYON':        {'x': 6000, 'y': 60000}, 
    'TOULOUSE':    {'x': -5000, 'y': 3000}, 
}

types_bien = ['APT', 'MAI']
labels_bien = {"APT": "APPARTEMENTS", "MAI": "MAISONS"}

for type_bien in types_bien:
    print(f"   -> Carte : {type_bien}")
    
    # Filtre sur le type et la métrique 12 mois
    df_plot = df_map_ready[
        (df_map_ready["CD_TYPE_BIEN"] == type_bien) & 
        (df_map_ready["DIC_NAME"] == "prix_m2_12m")
    ].copy()
    
    if df_plot.empty: continue
    
    # Création GeoDataFrame
    geometry = [Point(xy) for xy in zip(df_plot['longitude'], df_plot['latitude'])]
    gdf_villes = gpd.GeoDataFrame(df_plot, geometry=geometry, crs="EPSG:4326").to_crs(TARGET_CRS)
    
    # --- PLOT ---
    fig, ax = plt.subplots(figsize=(14, 14), dpi=300)
    fig.set_facecolor(CL_TURQUOISE)
    ax.axis('off')
    
    # Fond de carte
    x, y = france_outline.exterior.xy
    ax.fill(x, y, color=CL_LIGHT_GREY, zorder=1)
    ax.plot(x, y, color=CL_BLACK, linewidth=1.0, zorder=2)
    
    # Zoom
    xmin, ymin, xmax, ymax = france_outline.bounds
    ax.set_xlim(xmin - 5000, xmax + 5000)
    ax.set_ylim(ymin - 5000, ymax + 5000)
    
    # --- ANNOTATIONS ---
    halo = [pe.withStroke(linewidth=2.5, foreground="white")]
    
    for idx, row in gdf_villes.iterrows():
        x_c, y_c = row.geometry.x, row.geometry.y
        ville = row['label']
        
        # Gestion Offset
        off = CUSTOM_OFFSETS.get(ville, {'x': 3000, 'y': 3000})
        ax_x = x_c + off['x']
        ax_y = y_c + off['y']
        align_h = 'right' if off['x'] < 0 else 'left'
        
        # Données
        prix_str = f"{row['Prix_M2_V2']:.0f} €".replace('.', ' ')
        evo_3m = row['TAUX_INFL_3M']
        evo_12m = row['TAUX_INFL_12M']
        
        txt_3m = f"{evo_3m:+.1%}" if pd.notna(evo_3m) else "N/A"
        txt_12m = f"{evo_12m:+.1%}" if pd.notna(evo_12m) else "N/A"
        
        # Dessin Lignes
        # 1. Ville
        ax.text(ax_x, ax_y, ville, fontsize=20, ha=align_h, va='top', color=CL_BLACK, path_effects=halo, zorder=4)
        
        # 2. Prix
        y_prix = ax_y - 15000
        ax.text(ax_x, y_prix, prix_str, fontsize=18, ha=align_h, va='top', weight='bold', color=CL_BLACK, path_effects=halo, zorder=4)
        
        # 3. Evolutions (Packer)
        y_evo = y_prix - 15000
        
        ta_3m = TextArea(txt_3m, textprops=dict(color=CL_BLUE_3M, size=11))
        ta_12m = TextArea(txt_12m, textprops=dict(color=CL_RED_12M, size=11))
        packer = HPacker(children=[ta_3m, ta_12m], align="center", pad=0, sep=5)
        
        ab = AnnotationBbox(packer, (ax_x, y_evo), xybox=(0,0), xycoords='data', boxcoords="offset points", frameon=False, box_alignment=(1.0 if align_h=='right' else 0.0, 0.5))
        ax.add_artist(ab)
        
        # Point
        ax.plot(x_c, y_c, marker='o', color=CL_BLACK, markersize=5, markeredgecolor='white', zorder=5)

    # Titre & Légende
    date_str = df_plot['Periode'].max().strftime('%B %Y').upper()
    locale.setlocale(locale.LC_TIME, 'French_France') # Essayer de passer en FR
    
    title = f"PRIX DES {labels_bien[type_bien]} DANS LES GRANDES VILLES\n(MÉTHODE HYBRIDE V2)"
    ax.set_title(title, fontsize=24, weight='bold', pad=20)
    
    fig.text(0.05, 0.05, f"Source : Crédit Logement - {date_str}\nNoir : Évo 3 mois | Rouge : Évo 12 mois", 
             fontsize=14, bbox=dict(facecolor='white', alpha=0.8, boxstyle='round,pad=0.5'))
    
    # Sauvegarde
    outfile = os.path.join(params.CONFIG['output_dir'], f"Carte_{type_bien}_V2_Hybride.png")
    plt.savefig(outfile, dpi=200, bbox_inches='tight')
    plt.close()
    print(f"   -> Sauvegardé : {outfile}")

print("\n=== VISUALISATION TERMINÉE ===")
