DT_ARRT_CAPRET = 24106  # 31/12/2025

# ════════════════════════════════════════════════════════════════
# TEST 1 : clip(NB_MATURITE_IRBA, 1, 5) vs NB_DURATION_IRBA
# (On part de la maturité déjà fournie, on applique juste le clip)
# ════════════════════════════════════════════════════════════════
result = result.with_columns(
    pl.col('NB_MATURITE_IRBA').clip(1.0, 5.0).alias('TEST1_duration')
)

n1 = result.filter(
    (pl.col('TEST1_duration') - pl.col('NB_DURATION_IRBA')).abs() < 0.001
).height
print(f"TEST 1 — clip(MATURITE, 1, 5) vs NB_DURATION_IRBA :")
print(f"  Match : {n1}/{result.height} ({n1/result.height:.1%})")

# ════════════════════════════════════════════════════════════════
# TEST 2 : Recréer MATURITE depuis les dates, PUIS clip, vs NB_DURATION_IRBA
# D = (DT_ECHEANCE_FEM - DT_ARRT) / 365.25
# ════════════════════════════════════════════════════════════════
result = result.with_columns(
    ((pl.col('DT_ECHEANCE_FEM') - DT_ARRT_CAPRET) / 365.25).alias('MATURITE_recalculee')
).with_columns(
    pl.col('MATURITE_recalculee').clip(1.0, 5.0).alias('TEST2_duration')
)

n2 = result.filter(
    (pl.col('TEST2_duration') - pl.col('NB_DURATION_IRBA')).abs() < 0.001
).height
print(f"\nTEST 2 — clip(dates→MATURITE, 1, 5) vs NB_DURATION_IRBA :")
print(f"  Match : {n2}/{result.height} ({n2/result.height:.1%})")

# ── Écarts résiduels du Test 2 ───────────────────────────────────
ecarts2 = result.filter(
    (pl.col('TEST2_duration') - pl.col('NB_DURATION_IRBA')).abs() > 0.001
)
print(f"\n  Aperçu des {ecarts2.height} non-matchs du Test 2 :")
print(ecarts2.select([
    'MATURITE_recalculee', 'NB_MATURITE_IRBA',
    'TEST2_duration', 'NB_DURATION_IRBA'
]).head(10))
