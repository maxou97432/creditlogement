    date_fin="date_fin",
    datdef="datdef_corr",
    marginal_fields=MARGINAL_FIELDS,
    stepwise_SR=True,
    weighted_facility=True,
)
filled_pl = filled_pl_lazy.collect()

# ======================================================================
# 3) Pipeline PANDAS (tolérant au crash)
# ======================================================================
pandas_ok = True
try:
    res_pd_all, filled_pd = extrapolate_all_categories(
        annee_courante=ANNEE_COURANTE,
        dtm_in=dtm_pd,
        category_column=CATEGORY_COLUMN,
        fields=FIELDS,
        final_suffix="_final",
        marginal_fields=MARGINAL_FIELDS,
        stepwise_SR=True,
        weighted_facility=True,
    )
except Exception as e:
    pandas_ok = False
    print(f"\n⚠️ PANDAS crashe sur HLC={CAT} : {type(e).__name__} — {e}")
    print("   -> pas de référence, on valide polars en STANDALONE.\n")

# ======================================================================
# 4A) Si pandas OK -> comparaison côte à côte
# ======================================================================
if pandas_ok:
    r = (filled_pd[filled_pd[CATEGORY_COLUMN] == CAT]
           .groupby("generation")[FINAL_COL].mean().rename("pandas"))
    n = (filled_pl.filter(pl.col(CATEGORY_COLUMN) == CAT)
           .group_by("generation").agg(pl.col(FINAL_COL).mean().alias("polars"))
           .sort("generation").to_pandas().set_index("generation")["polars"])
