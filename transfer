        (df_ville["Prix moyen glissant 12 mois - LPI/IAD"] >= df_ville["IC_inf_12m"]) &
        (df_ville["Prix moyen glissant 12 mois - LPI/IAD"] <= df_ville["IC_sup_12m"])
    )
