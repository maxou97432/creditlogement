import polars as pl, pandas as pd
from pathlib import Path
import jenks_calculator

lf = df.lazy() if isinstance(df, pl.DataFrame) else df

# --- Paramètres à adapter ---
LGD_COL    = "LGD_3ANS_finale"           # ta LGD finale
TIME_COL   = "year"                      # nom de ta colonne temporelle (à vérifier)
OUTPUT_DIR = "chemin/vers/sortie_jenks"  # ton dossier de sortie

# --- Variable de découpe : score = 100 - LGD (réplique du notebook 1) ---
scores = lf.with_columns(
    pl.col(LGD_COL).alias("score_brut"),
    (100 - pl.col(LGD_COL)).alias("score"),
)

# --- Vérif rapide avant calcul ---
print(scores.select(
    pl.col("score").n_unique().alias("score_distincts"),
    pl.col("score").min().alias("min"),
    pl.col("score").max().alias("max"),
    pl.len().alias("n"),
).collect())

# --- Calcul Jenks (pondération de base = effectif) ---
run = jenks_calculator.compute_jenks_run(scores, "score", LGD_COL, TIME_COL, OUTPUT_DIR, 0)
nb_class = run["nb_class"]
jenks_calculator.write_excel_jenks_from_run(run, OUTPUT_DIR)
print("nb_class :", nb_class)

# --- Récupérer le meilleur découpage et coller Jenks_class ---
out = Path(OUTPUT_DIR)
df_summary = pd.read_parquet(out / "jenks" / f"df_summary_tests_jenks_{nb_class}_class.parquet")
best_idx = jenks_calculator.index_with_max_green(df_summary) + 2
jenks_class = pl.scan_parquet(out / "jenks" / f"jenks_{best_idx}_class.parquet").select(pl.first())

df_jenks = scores.with_columns(
    jenks_class.collect()["Jenks_class"].cast(pl.Int8).alias("Jenks_class")
).collect()

print(df_jenks["Jenks_class"].value_counts().sort("Jenks_class"))
