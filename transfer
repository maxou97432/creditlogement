import numpy as np
import polars as pl
from typing import Tuple
from scipy.stats import wasserstein_distance, gaussian_kde

# Parametres
EPS_W1       = 1.5      # marge W1 en pts LGD (base 0-100)
EPS_ETA      = 0.85     # overlap minimal code 0
ETA_MODERE   = 0.70     # overlap minimal code 1
B_BOOT       = 500      # replications bootstrap
ALPHA_EQUIV  = 0.05     # niveau test unilateral
N_BOOT_CAP   = 50_000   # sous-echantillonnage par classe
KDE_GRID_PTS = 512
RNG_SEED     = 42
CODES_FUSIONNABLES = {0, 1}

_LAST_W1_DIAG = {}

def _overlap_eta(a: np.ndarray, b: np.ndarray) -> float:
    if a.std() == 0 or b.std() == 0:
        return 1.0 if (a.std() == 0 and b.std() == 0 and a[0] == b[0]) else 0.0
    kde_a, kde_b = gaussian_kde(a), gaussian_kde(b)
    lo, hi = min(a.min(), b.min()), max(a.max(), b.max())
    pad = 0.05 * (hi - lo) if hi > lo else 1.0
    grid = np.linspace(lo - pad, hi + pad, KDE_GRID_PTS)
    eta = float(np.trapz(np.minimum(kde_a(grid), kde_b(grid)), grid))
    return min(eta, 1.0)


def _w1_decompose(a: np.ndarray, b: np.ndarray, w1_obs: float) -> Tuple[float, float, float]:
    loc = abs(float(a.mean()) - float(b.mean()))
    shape = float(wasserstein_distance(a - a.mean(), b - b.mean()))
    pct_loc = 100.0 * loc / w1_obs if w1_obs > 0 else 0.0
    return loc, shape, min(pct_loc, 100.0)


def _w1_bootstrap_upper(a: np.ndarray, b: np.ndarray) -> Tuple[float, float]:
    rng = np.random.default_rng(RNG_SEED)
    w1_obs = float(wasserstein_distance(a, b))
    sa = rng.choice(a, size=min(len(a), N_BOOT_CAP), replace=False)
    sb = rng.choice(b, size=min(len(b), N_BOOT_CAP), replace=False)
    boot = np.empty(B_BOOT)
    for i in range(B_BOOT):
        ra = rng.choice(sa, size=len(sa), replace=True)
        rb = rng.choice(sb, size=len(sb), replace=True)
        boot[i] = wasserstein_distance(ra, rb)
    ic_upper = float(np.percentile(boot, 100.0 * (1.0 - ALPHA_EQUIV)))
    return w1_obs, ic_upper


def W1OverlapTest(a: np.ndarray, b: np.ndarray, mean_lgd: float) -> Tuple[int, str]:
    global _LAST_W1_DIAG
    mean_a, mean_b = float(a.mean()), float(b.mean())
    gap = abs(mean_b - mean_a)

    _LAST_W1_DIAG = {
        "w1_obs": None, "w1_ic95_sup": None, "eta": None,
        "w1_loc": None, "w1_shape": None, "w1_pct_loc": None,
        "eps_w1": EPS_W1, "eps_eta": EPS_ETA,
        "n_a_boot": min(len(a), N_BOOT_CAP), "n_b_boot": min(len(b), N_BOOT_CAP),
    }

    if gap >= EPS_W1:
        _LAST_W1_DIAG["w1_obs"] = gap
        return 99, f"[W1] gap={gap:.3f} >= eps={EPS_W1} (equivalence impossible)"

    w1_obs, ic_upper = _w1_bootstrap_upper(a, b)
    loc, shape, pct_loc = _w1_decompose(a, b, w1_obs)
    _LAST_W1_DIAG.update({
        "w1_obs": round(w1_obs, 4), "w1_ic95_sup": round(ic_upper, 4),
        "w1_loc": round(loc, 4), "w1_shape": round(shape, 4),
        "w1_pct_loc": round(pct_loc, 1),
    })

    if ic_upper >= EPS_W1:
        return 99, (f"[W1] IC95_sup={ic_upper:.3f} >= eps={EPS_W1} "
                    f"(W1obs={w1_obs:.3f}, non prouvee)")

    eta = _overlap_eta(a, b)
    _LAST_W1_DIAG["eta"] = round(eta, 4)

    if eta >= EPS_ETA:
        return 0, (f"[W1] IC95_sup={ic_upper:.3f}<eps={EPS_W1}, "
                   f"eta={eta:.3f}>={EPS_ETA} (equivalent)")
    elif eta >= ETA_MODERE:
        return 1, (f"[W1] IC95_sup={ic_upper:.3f}<eps={EPS_W1}, "
                   f"eta={eta:.3f} dans [{ETA_MODERE},{EPS_ETA}) (modere)")
    else:
        return 99, (f"[W1] IC95_sup={ic_upper:.3f}<eps={EPS_W1} MAIS "
                    f"eta={eta:.3f}<{ETA_MODERE} (formes differentes)")

