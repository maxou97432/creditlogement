import numpy as np

sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    has_171     = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
    seg_special = pl.col("segment_trg").is_in([44, 73, 74]),
)
sub_court = sub3.filter(
    (pl.col("R") > 1.0) & (pl.col("R") < 3.0)
    & (~pl.col("has_171")) & (~pl.col("seg_special"))
)

R_arr  = sub_court["R"].to_numpy()
NB_arr = sub_court["NB_MATURITE_IRBA"].to_numpy()

# Prédiction avec yield 4,95 %
def predict(R_arr, y=0.0495):
    r = y / 12
    n_arr = np.maximum(1, np.round(R_arr * 12).astype(int))
    preds = np.empty_like(R_arr)
    for n_unique in np.unique(n_arr):
        mask = n_arr == n_unique
        k = np.arange(1, n_unique + 1)
        w = (1 + r) ** (k - 1)
        preds[mask] = np.sum(k * w) / np.sum(w) / 12
    return preds

pred = predict(R_arr)
err = NB_arr - pred  # signe : positif si NB > pred, donc duration plus longue qu'attendu

print(f"=== Tranche [1, 3[, n = {len(R_arr)} ===")
print(f"Erreur moyenne   : {np.mean(err)*365.25:+.2f} jours")
print(f"Erreur médiane   : {np.median(err)*365.25:+.2f} jours")
print(f"Std erreur       : {np.std(err)*365.25:.2f} jours")
print(f"% erreur > 0     : {(err > 0).mean()*100:.1f}%")
print(f"% |err| < 0,01   : {(np.abs(err) < 0.01).mean()*100:.1f}%")
print(f"% |err| < 0,05   : {(np.abs(err) < 0.05).mean()*100:.1f}%")

# Histogramme des résidus
print(f"\nDistribution des erreurs (en jours) :")
bins = [-365, -180, -60, -30, -10, 0, 10, 30, 60, 180, 365, 1000]
err_jours = err * 365.25
for lo, hi in zip(bins[:-1], bins[1:]):
    mask = (err_jours >= lo) & (err_jours < hi)
    if mask.sum() > 0:
        print(f"  [{lo:>+5}, {hi:>+5}[ jours : {mask.sum():>6} ({mask.mean()*100:>5.1f}%)")

# Top 15 erreurs positives (NB > pred : SRS donne plus long)
print(f"\nTop 15 erreurs positives (NB > pred, NB plus long que prévu) :")
idx_pos = np.argsort(-err)[:15]
print(f"{'R':>8} {'NB':>8} {'pred':>8} {'err j':>10} {'NB/R':>8}")
for i in idx_pos:
    print(f"{R_arr[i]:>8.4f} {NB_arr[i]:>8.4f} {pred[i]:>8.4f} "
          f"{err[i]*365.25:>+10.2f} {NB_arr[i]/R_arr[i]:>8.4f}")

# Top 15 erreurs négatives (NB < pred : SRS donne plus court)
print(f"\nTop 15 erreurs négatives (NB < pred, NB plus court que prévu) :")
idx_neg = np.argsort(err)[:15]
for i in idx_neg:
    print(f"{R_arr[i]:>8.4f} {NB_arr[i]:>8.4f} {pred[i]:>8.4f} "
          f"{err[i]*365.25:>+10.2f} {NB_arr[i]/R_arr[i]:>8.4f}")
