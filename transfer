def get_notebook_io(config, nom_notebook):
    """
    Retourne (chemin_entree, chemin_sortie) pour un notebook donné.
    Ces valeurs sont déjà résolues en Path (ou dict de Path pour les
    notebooks à entrées/sorties multiples) par load_config().
    À appeler en tête de chaque notebook métier.
    """
    for nb in config["pipeline"]["notebooks"]:
        if nb["name"] == nom_notebook:
            return nb.get("input_path"), nb.get("output_path")

    connus = [nb["name"] for nb in config["pipeline"]["notebooks"]]
    raise KeyError(f"Notebook '{nom_notebook}' absent de config.yaml. Connus : {connus}")
