# ----------------------------------------------------------------------
# HeterogeneityTestSuite
# ----------------------------------------------------------------------

class HeterogeneityTestSuite:
    """Exécute une batterie de tests sur une paire de classes (A, B)."""

    def __init__(self, data_a, data_b, tests=None, label_a="A", label_b="B") -> None:
        self.a = HeterogeneityTest._clean(data_a)
        self.b = HeterogeneityTest._clean(data_b)
        self.label_a = label_a
        self.label_b = label_b
        self.tests = tests if tests is not None else _default_suite()
        self._fitted = False

    def fit_all(self) -> "HeterogeneityTestSuite":
        for t in self.tests:
            t.fit(self.a, self.b)
        self._fitted = True
        return self

    def _ensure_fitted(self) -> None:
        if not self._fitted:
            self.fit_all()

    def get_test(self, name: str) -> HeterogeneityTest:
        for t in self.tests:
            if t.name.lower().startswith(name.lower()):
                return t
        raise KeyError(name)

    def summary(self) -> pl.DataFrame:
        self._ensure_fitted()
        rows = []
        for t in self.tests:
            r = t.result
            rows.append({
                "test": r["test"],
                "statistic": float(r["statistic"]),
                "p_value": (None if r["p_value"] is None else float(r["p_value"])),
                "flag": r.get("flag"),
                "interpretation": r["interpretation"],
                "fusionnable": r["fusionnable"],
            })
        return pl.DataFrame(rows, schema_overrides={"p_value": pl.Float64,
                                                    "fusionnable": pl.Boolean})

    def get_verdict(self, strategy="ovl", lgd_gap_threshold=1.0) -> dict:
        self._ensure_fitted()

        if strategy == "ovl":
            try:
                ovl = self.get_test("OVL").result
            except KeyError:
                return {"strategy": "ovl", "fusionnable": None,
                        "raison": "test OVL absent de la suite utilisée"}
            return {"strategy": "ovl", "fusionnable": bool(ovl["fusionnable"]),
                    "ovl": ovl["statistic"], "code": ovl["code"],
                    "flag": ovl["flag"], "raison": ovl["interpretation"]}

        if strategy == "cohen":
            try:
                d = self.get_test("Cohen").result
            except KeyError:
                return {"strategy": "cohen", "fusionnable": None,
                        "raison": "test Cohen's d absent de la suite utilisée"}
            return {"strategy": "cohen", "fusionnable": bool(d["fusionnable"]),
                    "cohen_d": d["statistic"], "flag": d["flag"], "raison": d["interpretation"]}

        if strategy == "combined":
            try:
                d = self.get_test("Cohen").result
            except KeyError:
                return {"strategy": "combined", "fusionnable": None,
                        "raison": "test Cohen's d absent de la suite utilisée"}
            gap = abs(float(self.a.mean() - self.b.mean()))
            gap_ok = gap < lgd_gap_threshold
            d_ok = abs(d["statistic"]) < COHEN_NEGLIGEABLE
            return {"strategy": "combined", "fusionnable": bool(gap_ok and d_ok),
                    "lgd_gap": gap, "lgd_gap_threshold": lgd_gap_threshold,
                    "cohen_d": d["statistic"],
                    "raison": (f"écart LGD={gap:.3f} pts "
                               f"({'<' if gap_ok else '>='} {lgd_gap_threshold}) "
                               f"ET |d|={abs(d['statistic']):.3f} "
                               f"({'<' if d_ok else '>='} {COHEN_NEGLIGEABLE})")}

        raise ValueError("strategy doit être 'ovl', 'cohen' ou 'combined'.")

    def plot_all(self, figsize=(14, 9)):
        self._ensure_fitted()
        fig, axes = plt.subplots(2, 3, figsize=figsize)
        a, b = self.a, self.b
        la, lb = self.label_a, self.label_b
        lo, hi = min(a.min(), b.min()), max(a.max(), b.max())

        ax = axes[0, 0]
        bins = np.linspace(lo, hi, 60)
        ax.hist(a, bins=bins, density=True, alpha=0.35, label=f"{la} (n={a.size})")
        ax.hist(b, bins=bins, density=True, alpha=0.35, label=f"{lb} (n={b.size})")
        ax.set_title("Distributions"); ax.legend(fontsize=8)
        ax.set_xlabel("lgd_obligor"); ax.set_ylabel("densité")

        self.get_test("OVL").plot(ax=axes[0, 1])
        self.get_test("Kolmogorov").plot(ax=axes[0, 2])

        ax = axes[1, 0]
        d = self.get_test("Cohen").result["statistic"]
        g = self.get_test("Hedges").result["statistic"]
        ovl = self.get_test("OVL").result["statistic"]
        ax.bar(["|d|", "|g|", "OVL"], [abs(d), abs(g), ovl],
               color=["#4c72b0", "#4c72b0", "#55a868"])
        ax.axhline(COHEN_NEGLIGEABLE, ls=":", color="grey")
        ax.axhline(OVL_MODERE, ls="--", color="orange")
        ax.axhline(OVL_STRICT, ls="--", color="green")
        ax.set_title("Tailles d'effet / OVL")

        ax = axes[1, 1]
        ax.boxplot([a, b], tick_labels=[la, lb], showmeans=True)
        ax.set_title("Comparaison"); ax.set_ylabel("lgd_obligor")

        ax = axes[1, 2]; ax.axis("off")
        sm = self.summary()
        cell = [[r["test"], f"{r['statistic']:.3g}",
                 ("n/a" if r["p_value"] is None else f"{r['p_value']:.1e}"),
                 str(r.get("flag"))]
                for r in sm.iter_rows(named=True)]
        tbl = ax.table(cellText=cell, colLabels=["test", "stat", "p", "flag"],
                       loc="center", cellLoc="center")
        tbl.auto_set_font_size(False); tbl.set_fontsize(7); tbl.scale(1, 1.3)
        ax.set_title("Récapitulatif")

        v = self.get_verdict("ovl")
        fig.suptitle(f"{la} vs {lb}  |  OVL={v['ovl']:.3f}  flag {v['flag']}", fontsize=12)
        fig.tight_layout(rect=[0, 0, 1, 0.96])
        return fig

    def export_report(self, path: str) -> str:
        self._ensure_fitted()
        sm = self.summary()
        verdict = self.get_verdict("ovl")
        if path.lower().endswith((".xlsx", ".xls")):
            sm.write_excel(path)
            return path
        lines = [
            f"# Tests d'hétérogénéité : {self.label_a} vs {self.label_b}", "",
            f"- n({self.label_a}) = {self.a.size} ; n({self.label_b}) = {self.b.size}",
            (f"- moyenne {self.label_a} = {self.a.mean():.3f} ; "
             f"moyenne {self.label_b} = {self.b.mean():.3f} ; "
             f"écart = {abs(self.a.mean() - self.b.mean()):.3f} pts"),
            f"- **Flag OVL** : {verdict['flag']} (OVL={verdict['ovl']:.3f}, code {verdict['code']})",
            "", "| test | statistic | p_value | flag | interpretation |",
            "|-----|----------|--------|------|---------------|",
        ]
        for r in sm.iter_rows(named=True):
            p = "n/a" if r["p_value"] is None else f"{r['p_value']:.3e}"
            lines.append(f"| {r['test']} | {r['statistic']:.4g} | {p} | "
                         f"{r.get('flag')} | {r['interpretation']} |")
        with open(path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        return path


# ----------------------------------------------------------------------
# Comparateur de fusions sur l'ensemble des paires
# ----------------------------------------------------------------------

class FusionComparator:
    """Balaye les paires de classes et compare les fusions suggérées par test.

    pairs="all"      -> Phase A (sous-modèle) : diagnostic 2-à-2 (flags()/plot_flags()).
    pairs="adjacent" -> Phase B (modèle)      : fusion consécutive via solve().
    """

    def __init__(self, df, class_col, lgd_col="lgd_obligor", obligor_col=None,
                 pairs="adjacent", tests=None, lgd_gap_threshold=1.0) -> None:
        if pairs not in ("adjacent", "all"):
            raise ValueError("pairs doit être 'adjacent' ou 'all'.")
        self.class_col = class_col
        self.lgd_col = lgd_col
        self.pairs_mode = pairs
        self.lgd_gap_threshold = lgd_gap_threshold
        self._tests_factory = tests

        if isinstance(df, pl.LazyFrame):
            df = df.collect()
        self._df_base = df
        self._base_class_col = class_col

        work = df
        if obligor_col is not None:
            work = (df.group_by([class_col, obligor_col])
                    .agg(pl.col(lgd_col).mean().alias(lgd_col)))

        self.arrays: Dict[str, np.ndarray] = {}
        for cls, sub in work.group_by(class_col):
            key = cls[0] if isinstance(cls, tuple) else cls
            arr = sub.get_column(lgd_col).to_numpy()
            arr = arr[np.isfinite(arr)]
            if arr.size >= 2:
                self.arrays[str(key)] = arr
        if len(self.arrays) < 2:
            raise ValueError("Au moins 2 classes valides nécessaires.")

        self.order = sorted(self.arrays, key=lambda c: self.arrays[c].mean())
        if pairs == "adjacent":
            self.pair_list = list(zip(self.order, self.order[1:]))
        else:
            from itertools import combinations
            self.pair_list = list(combinations(self.order, 2))

        self._runs: list = []
        self.seuil_calibre: Optional[float] = None
        self.df_calibration: Optional[pl.DataFrame] = None
        # état transitoire de solve()
        self._ovl_modere_eff: Optional[float] = None
        self._ovl_strict_eff: Optional[float] = None
        self._orange_policy: str = "keep"

    # -- exécution -----------------------------------------------------------

    def run(self) -> "FusionComparator":
        self._runs = []
        for ca, cb in self.pair_list:
            a, b = self.arrays[ca], self.arrays[cb]
            tests = self._tests_factory if self._tests_factory is not None else _default_suite()
            suite = HeterogeneityTestSuite(a, b, tests=tests, label_a=ca, label_b=cb).fit_all()
            per_test = {t.name: t.result for t in suite.tests}
            v_ovl = suite.get_verdict("ovl")
            v_comb = suite.get_verdict("combined", lgd_gap_threshold=self.lgd_gap_threshold)
            meta = {
                "class_a": ca, "class_b": cb,
                "n_a": int(a.size), "n_b": int(b.size),
                "mean_a": float(a.mean()), "mean_b": float(b.mean()),
                "gap_lgd": float(abs(a.mean() - b.mean())),
                "verdict_ovl": v_ovl["fusionnable"],
                "flag_ovl": v_ovl.get("flag"),
                "verdict_combined": v_comb["fusionnable"],
            }
            self._runs.append((meta, per_test))
        return self

    def _ensure_run(self) -> None:
        if not self._runs:
            self.run()

    @property
    def test_names(self) -> List[str]:
        self._ensure_run()
        return list(self._runs[0][1].keys())

    # -- calibration du seuil OVL --------------------------------------------

    def calibrate(self, seuils=None, n_bootstrap=200, n_subsample=300,
                  method="kde", random_state=42, n_jobs=-1) -> "FusionComparator":
        if seuils is None:
            seuils = [round(s, 2) for s in np.arange(0.55, 0.76, 0.01)]
        seuils = list(seuils)
        if len(seuils) == 0:
            raise ValueError(
                "Grille `seuils` vide — vérifier np.arange(start, stop, step) "
                "(start doit être strictement < stop)."
            )
        self.df_calibration = calibrer_seuil_ovl_stabilite(
            cmp=self, seuils=seuils, n_bootstrap=n_bootstrap, n_subsample=n_subsample,
            method=method, random_state=random_state, n_jobs=n_jobs,
        )
        n_initial = len(self.order)
        df_valide = self.df_calibration.filter(
            (pl.col("n_classes_median") > 1) & (pl.col("n_classes_median") < n_initial)
        )
        if df_valide.is_empty():
            raise ValueError(
                "Aucune partition non-triviale trouvée sur les seuils testés. "
                "Élargir la grille `seuils` ou vérifier les données."
            )
        self.seuil_calibre = float(
            df_valide.filter(pl.col("ari_moyen") == pl.col("ari_moyen").max())["seuil_ovl"][0]
        )
        return self

    # -- sorties diagnostic --------------------------------------------------

    def detail(self) -> pl.DataFrame:
        self._ensure_run()
        rows = []
        for meta, per_test in self._runs:
            for tname, r in per_test.items():
                rows.append({
                    "class_a": meta["class_a"], "class_b": meta["class_b"],
                    "gap_lgd": meta["gap_lgd"], "test": tname,
                    "statistic": float(r["statistic"]),
                    "p_value": (None if r["p_value"] is None else float(r["p_value"])),
                    "flag": r.get("flag"),
                    "fusion_suggeree": r["fusion_suggeree"],
                })
        return pl.DataFrame(rows, schema_overrides={"p_value": pl.Float64,
                                                    "fusion_suggeree": pl.Boolean})

    def flags(self) -> pl.DataFrame:
        """Phase A : matrice de flags (GREEN/ORANGE/RED) par paire et par test.

        flag_consensus = RED uniquement si TOUS les tests concluent RED
        (consensus strict pour fusionner) ; sinon GREEN/ORANGE selon présence.
        """
        self._ensure_run()
        names = self.test_names
        rows = []
        for meta, per_test in self._runs:
            row = {
                "class_a": meta["class_a"], "class_b": meta["class_b"],
                "gap_lgd": round(meta["gap_lgd"], 3),
                "ovl": (round(per_test["OVL (Weitzman)"]["statistic"], 3)
                        if "OVL (Weitzman)" in per_test else None),
            }
            flags = []
            for n in names:
                f = per_test[n].get("flag")
                row[n] = f
                if f is not None:
                    flags.append(f)
            if flags and all(f == FLAG_RED for f in flags):
                cons = FLAG_RED
            elif FLAG_GREEN in flags:
                cons = FLAG_GREEN
            elif flags:
                cons = FLAG_ORANGE
            else:
                cons = None
            row["flag_ovl"] = per_test.get("OVL (Weitzman)", {}).get("flag")
            row["flag_consensus"] = cons
            rows.append(row)
        return pl.DataFrame(rows)

    def matrix(self, as_bool=False) -> pl.DataFrame:
        self._ensure_run()
        names = self.test_names

        def fmt(v):
            if as_bool:
                return v
            return "-" if v is None else ("oui" if v else "non")

        rows = []
        has_ovl = "OVL (Weitzman)" in self.test_names
        for meta, per_test in self._runs:
            row = {"class_a": meta["class_a"], "class_b": meta["class_b"],
                   "n_a": meta["n_a"], "n_b": meta["n_b"],
                   "gap_lgd": round(meta["gap_lgd"], 3),
                   "ovl": (round(per_test["OVL (Weitzman)"]["statistic"], 3)
                           if has_ovl else None),
                   "flag_ovl": meta.get("flag_ovl")}
            for n in names:
                row[n] = fmt(per_test[n]["fusion_suggeree"])
            n_pour_fusion = sum(1 for n in names if per_test[n]["fusion_suggeree"] is True)
            accord_total = len(set(fmt(per_test[n]["fusion_suggeree"]) for n in names
                                   if per_test[n]["fusion_suggeree"] is not None)) == 1
            row["n_pour_fusion"] = n_pour_fusion
            row["accord_total"] = accord_total
            row["verdict_ovl"] = fmt(meta["verdict_ovl"])
            row["verdict_combined"] = fmt(meta["verdict_combined"])
            rows.append(row)

        col_order = (["class_a", "class_b", "n_a", "n_b", "gap_lgd", "ovl", "flag_ovl"]
                     + names + ["n_pour_fusion", "accord_total",
                                "verdict_ovl", "verdict_combined"])
        return pl.DataFrame(rows).select(col_order)

    def consensus(self) -> pl.DataFrame:
        self._ensure_run()
        names = self.test_names
        has_ovl = "OVL (Weitzman)" in names
        ovl_decisions = ([per_test["OVL (Weitzman)"]["fusion_suggeree"]
                          for _, per_test in self._runs] if has_ovl
                         else [None] * len(self._runs))
        rows = []
        for n in names:
            decisions = [per_test[n]["fusion_suggeree"] for _, per_test in self._runs]
            valid = [(d, o) for d, o in zip(decisions, ovl_decisions) if d is not None]
            n_fusion = sum(1 for d in decisions if d)
            n_accord_ovl = sum(1 for d, o in valid if d == o)
            rows.append({"test": n, "n_paires": len(decisions),
                         "n_paires_fusionnables": int(n_fusion),
                         "taux_fusion": round(n_fusion / len(decisions), 3),
                         "accord_avec_ovl": (round(n_accord_ovl / len(valid), 3) if valid else None)})
        return pl.DataFrame(rows)

    def consensus_avec_solve(self, label_style="glouton", k_min=1,
                             lgd_gap_threshold=None, orange_policy="keep") -> pl.DataFrame:
        self._ensure_run()
        names = self.test_names
        n_initial = len(self.order)
        rows = []
        for name in names:
            n_paires = sum(1 for _, per_test in self._runs
                           if per_test[name]["fusion_suggeree"])
            try:
                sol = self.solve(criterion=name, label_style=label_style, k_min=k_min,
                                 lgd_gap_threshold=lgd_gap_threshold,
                                 orange_policy=orange_policy)
                n_final = sol["n_final"]
                composition = sol["composition"]
            except Exception as e:
                n_final = None
                composition = {"erreur": str(e)}
            rows.append({"test": name, "n_paires_fusionnables": int(n_paires),
                         "n_classes_finales": n_final, "n_initial": n_initial,
                         "composition": str(composition)})
        return pl.DataFrame(rows, schema_overrides={"n_classes_finales": pl.Int64,
                                                    "n_initial": pl.Int64})

    # -- résolution des fusions (transitive) ---------------------------------

    @staticmethod
    def _cohen_d(a, b) -> float:
        n_a, n_b = a.size, b.size
        s = np.sqrt(((n_a - 1) * a.var(ddof=1) + (n_b - 1) * b.var(ddof=1))
                    / (n_a + n_b - 2))
        return float((a.mean() - b.mean()) / s) if s > 0 else 0.0

    def _eval_pair(self, a, b, criterion, lgd_gap_threshold,
                   tests_override=None, ovl_precomputed=None):
        """Retourne (mergeable, score). Ne calcule QUE le critère demandé.

        OVL : RED (>= strict) toujours fusionnable ; ORANGE (modéré..strict)
        fusionnable seulement si orange_policy == 'merge' ; GREEN jamais.
        """
        c = criterion.lower()

        if "ovl" in c:
            if ovl_precomputed is None:
                try:
                    ovl_precomputed = OVLTest._ovl_kde(a, b)
                except Exception:
                    ovl_precomputed = OVLTest._ovl_hist(a, b)
            modere = self._ovl_modere_eff if self._ovl_modere_eff is not None else OVL_MODERE
            strict = self._ovl_strict_eff if self._ovl_strict_eff is not None else OVL_STRICT
            if ovl_precomputed >= strict:
                mergeable = True                                   # RED
            elif ovl_precomputed >= modere:
                mergeable = (self._orange_policy == "merge")       # ORANGE
            else:
                mergeable = False                                  # GREEN
            return bool(mergeable), float(ovl_precomputed)

        if c.startswith("cohen"):
            d = self._cohen_d(a, b)
            return bool(abs(d) < COHEN_NEGLIGEABLE), float(-abs(d))

        if c == "combined":
            d = self._cohen_d(a, b)
            gap = abs(float(a.mean() - b.mean()))
            ok = (gap < lgd_gap_threshold) and (abs(d) < COHEN_NEGLIGEABLE)
            return bool(ok), float(-gap)

        factory = (tests_override if tests_override is not None
                   else (self._tests_factory if self._tests_factory is not None
                         else _default_suite()))
        t = None
        for tt in factory:
            n = tt.name.lower()
            if n.startswith(c) or c in n:
                t = tt
                break
        if t is None:
            raise ValueError(f"criterion='{criterion}' introuvable parmi "
                             f"{[tt.name for tt in factory]}")
        t.fit(a, b)
        r = t.result
        mergeable = bool(r["fusion_suggeree"])
        if r["p_value"] is not None:
            score = r["p_value"]
        elif t.name.startswith("OVL"):
            score = r["statistic"]
        else:
            score = -abs(r["statistic"])
        return mergeable, float(score)

    def solve(self, criterion="ovl", label_style="ordinal", k_min=1,
              lgd_gap_threshold=None, ovl_threshold=None, orange_policy="keep") -> dict:
        """Fusion séquentielle transitive sur paires CONSÉCUTIVES (Phase B).

        orange_policy : 'keep' (défaut, ne fusionne que RED) | 'merge' (ORANGE+RED).
        Note : le seuil calibré / ovl_threshold est le seuil MODÉRÉ ; le seuil
        strict en découle (= modéré + 0.25). En 'keep' la fusion se fait au
        seuil strict ; en 'merge' au seuil modéré (= ancien comportement).
        """
        if orange_policy not in ("keep", "merge"):
            raise ValueError("orange_policy doit être 'keep' ou 'merge'.")
        if lgd_gap_threshold is None:
            lgd_gap_threshold = self.lgd_gap_threshold

        is_ovl = "ovl" in criterion.lower()
        modere_eff = (ovl_threshold if ovl_threshold is not None
                      else (self.seuil_calibre if self.seuil_calibre is not None else OVL_MODERE))
        self._ovl_modere_eff = modere_eff
        self._ovl_strict_eff = min(modere_eff + OVL_BANDE, 1.0)
        self._orange_policy = orange_policy

        cache_ovl = {}
        if self._runs and is_ovl:
            for meta, per_test in self._runs:
                if "OVL (Weitzman)" in per_test:
                    key = (frozenset({meta["class_a"]}), frozenset({meta["class_b"]}))
                    cache_ovl[key] = float(per_test["OVL (Weitzman)"]["statistic"])

        arrays = dict(self.arrays)
        groups: List[List[str]] = [[c] for c in self.order]
        glouton_label = {id(g): c for g, c in zip(groups, self.order)}

        _garr_cache = {}

        def garr(g):
            key = frozenset(g)
            v = _garr_cache.get(key)
            if v is None:
                v = np.concatenate([arrays[c] for c in g])
                _garr_cache[key] = v
            return v

        def get_ovl_cache(ga, gb):
            if len(ga) == 1 and len(gb) == 1:
                return cache_ovl.get((frozenset({ga[0]}), frozenset({gb[0]})))
            return None

        pair_cache = {}

        def eval_groups(ga, gb):
            key = (frozenset(ga), frozenset(gb))
            hit = pair_cache.get(key)
            if hit is not None:
                return hit
            ovl_c = get_ovl_cache(ga, gb) if is_ovl else None
            res = self._eval_pair(garr(ga), garr(gb), criterion,
                                  lgd_gap_threshold, ovl_precomputed=ovl_c)
            pair_cache[key] = res
            return res

        log = []
        it = 0
        while len(groups) > k_min:
            groups.sort(key=lambda g: garr(g).mean())
            best = None
            for i in range(len(groups) - 1):
                mergeable, score = eval_groups(groups[i], groups[i + 1])
                if mergeable and (best is None or score > best[0]):
                    best = (score, i)
            if best is None:
                break
            it += 1
            i = best[1]
            ga, gb = groups[i], groups[i + 1]
            new_group = ga + gb
            glouton_label[id(new_group)] = f"{glouton_label[id(ga)]}_{glouton_label[id(gb)]}"
            log.append({
                "iteration": it, "groupe_a": "+".join(ga), "groupe_b": "+".join(gb),
                "n_a": int(garr(ga).size), "n_b": int(garr(gb).size),
                "critere": criterion, "score": float(best[0]),
                "mean_a": round(float(garr(ga).mean()), 4),
                "mean_b": round(float(garr(gb).mean()), 4),
                "gap_lgd": round(float(abs(garr(ga).mean() - garr(gb).mean())), 4),
                "label_fusionne": glouton_label[id(new_group)],
            })
            groups = groups[:i] + [new_group] + groups[i + 2:]

        groups.sort(key=lambda g: garr(g).mean())
        mapping, composition = {}, {}
        for idx, g in enumerate(groups):
            if label_style == "ordinal":
                label = str(idx + 1)
            elif label_style == "concat":
                label = "+".join(sorted(g))
            elif label_style == "glouton":
                label = glouton_label[id(g)]
            elif label_style == "representative":
                label = max(g, key=lambda c: arrays[c].size)
            else:
                raise ValueError("label_style: 'ordinal' | 'concat' | 'glouton' | 'representative'")
            for c in g:
                mapping[str(c)] = label
            composition[label] = sorted(g)

        log_schema = {"iteration": pl.Int64, "groupe_a": pl.Utf8, "groupe_b": pl.Utf8,
                      "n_a": pl.Int64, "n_b": pl.Int64, "critere": pl.Utf8,
                      "score": pl.Float64, "mean_a": pl.Float64, "mean_b": pl.Float64,
                      "gap_lgd": pl.Float64, "label_fusionne": pl.Utf8}
        log_df = pl.DataFrame(log, schema=log_schema) if log else pl.DataFrame(schema=log_schema)

        # nettoyage état transitoire
        self._ovl_modere_eff = self._ovl_strict_eff = None
        self._orange_policy = "keep"

        return {"mapping": mapping, "composition": composition,
                "groups": [sorted(g) for g in groups], "log": log_df,
                "n_initial": len(self.order), "n_final": len(groups)}

    def apply_to_base(self, criterion="ovl", out_col="CHR_apres_fusion", df=None,
                      label_style="ordinal", k_min=1, lgd_gap_threshold=None,
                      ovl_threshold=None, orange_policy="keep", return_solution=False):
        sol = self.solve(criterion, label_style=label_style, k_min=k_min,
                         lgd_gap_threshold=lgd_gap_threshold, ovl_threshold=ovl_threshold,
                         orange_policy=orange_policy)
        target = self._df_base if df is None else (
            df.collect() if isinstance(df, pl.LazyFrame) else df)
        out = target.with_columns(
            pl.col(self._base_class_col).cast(pl.Utf8).replace(sol["mapping"]).alias(out_col)
        )
        if return_solution:
            return out, sol
        return out

    # -- visualisation -------------------------------------------------------

    def plot_flags(self, figsize=None):
        """Phase A : carte paires × tests colorée GREEN/ORANGE/RED."""
        self._ensure_run()
        names = self.test_names
        pairs_lbl = [f"{m['class_a']}|{m['class_b']}" for m, _ in self._runs]
        M = np.full((len(self._runs), len(names)), np.nan)
        for i, (_, per_test) in enumerate(self._runs):
            for j, n in enumerate(names):
                f = per_test[n].get("flag")
                M[i, j] = _FLAG_CODE.get(f, np.nan)

        from matplotlib.colors import ListedColormap
        cmap = ListedColormap(["#55a868", "#dd8452", "#c44e52"])  # GREEN, ORANGE, RED
        if figsize is None:
            figsize = (1.1 * len(names) + 3, 0.45 * len(self._runs) + 2)
        fig, ax = plt.subplots(figsize=figsize)
        ax.imshow(np.ma.masked_invalid(M), cmap=cmap, vmin=0, vmax=2, aspect="auto")
        ax.set_xticks(range(len(names)))
        ax.set_xticklabels(names, rotation=45, ha="right", fontsize=8)
        ax.set_yticks(range(len(pairs_lbl)))
        ax.set_yticklabels(pairs_lbl, fontsize=8)
        sym = {0: "G", 1: "O", 2: "R"}
        for i in range(M.shape[0]):
            for j in range(M.shape[1]):
                txt = "?" if np.isnan(M[i, j]) else sym[int(M[i, j])]
                ax.text(j, i, txt, ha="center", va="center", fontsize=8, color="white")
        ax.set_title("Flags d'hétérogénéité (G=GREEN garder, O=ORANGE, R=RED fusionner)")
        fig.tight_layout()
        return fig

    def plot_heatmap(self, figsize=None):
        self._ensure_run()
        names = self.test_names
        pairs_lbl = [f"{m['class_a']}|{m['class_b']}" for m, _ in self._runs]
        M = np.full((len(self._runs), len(names)), np.nan)
        for i, (_, per_test) in enumerate(self._runs):
            for j, n in enumerate(names):
                v = per_test[n]["fusion_suggeree"]
                M[i, j] = np.nan if v is None else (1.0 if v else 0.0)
        from matplotlib.colors import ListedColormap
        cmap = ListedColormap(["#c44e52", "#55a868"])
        if figsize is None:
            figsize = (1.1 * len(names) + 3, 0.5 * len(self._runs) + 2)
        fig, ax = plt.subplots(figsize=figsize)
        ax.imshow(np.ma.masked_invalid(M), cmap=cmap, vmin=0, vmax=1, aspect="auto")
        ax.set_xticks(range(len(names)))
        ax.set_xticklabels(names, rotation=45, ha="right", fontsize=8)
        ax.set_yticks(range(len(pairs_lbl)))
        ax.set_yticklabels(pairs_lbl, fontsize=8)
        for i in range(M.shape[0]):
            for j in range(M.shape[1]):
                txt = "?" if np.isnan(M[i, j]) else ("✓" if M[i, j] == 1 else "X")
                ax.text(j, i, txt, ha="center", va="center", fontsize=8, color="white")
        ax.set_title("Fusions suggérées par test (✓ = fusion, X = non, ? = n/a)")
        fig.tight_layout()
        return fig

    def plot_all_pairs(self, ncols=3, figsize_per=(5, 3.5)):
        self._ensure_run()
        seuil = self.seuil_calibre if self.seuil_calibre is not None else OVL_MODERE
        pairs = self.pair_list
        n = len(pairs)
        nrows = (n + ncols - 1) // ncols
        fig, axes = plt.subplots(nrows, ncols,
                                 figsize=(figsize_per[0] * ncols, figsize_per[1] * nrows))
        axes = np.atleast_1d(axes).flatten()
        ovl_par_paire = {(m["class_a"], m["class_b"]): per["OVL (Weitzman)"]["statistic"]
                         for m, per in self._runs if "OVL (Weitzman)" in per}
        for idx, (ca, cb) in enumerate(pairs):
            ax = axes[idx]
            a, b = self.arrays[ca], self.arrays[cb]
            lo, hi = min(a.min(), b.min()), max(a.max(), b.max())
            x = np.linspace(lo, hi, 300)
            try:
                fa, fb = gaussian_kde(a)(x), gaussian_kde(b)(x)
            except Exception:
                bins = np.linspace(lo, hi, 60)
                fa = np.histogram(a, bins=bins, density=True)[0]
                fb = np.histogram(b, bins=bins, density=True)[0]
                x = (bins[:-1] + bins[1:]) / 2
            ovl = ovl_par_paire.get((ca, cb))
            ax.plot(x, fa, "-", lw=1.3, label=ca)
            ax.plot(x, fb, "--", lw=1.3, label=cb)
            ax.fill_between(x, np.minimum(fa, fb), alpha=0.4, color="green")
            if ovl is not None:
                fusion = "✓" if ovl >= seuil else "X"
                ax.set_title(f"{ca} | {cb}    OVL={ovl:.2f} {fusion}", fontsize=9)
            else:
                ax.set_title(f"{ca} | {cb}", fontsize=9)
            ax.legend(fontsize=7)
            ax.set_xlabel("lgd_obligor"); ax.set_ylabel("densité")
        for j in range(n, len(axes)):
            axes[j].axis("off")
        fig.suptitle(f"Distributions LGD par paire adjacente (seuil OVL = {seuil:.2f})",
                     fontsize=12)
        fig.tight_layout(rect=[0, 0, 1, 0.98])
        return fig
