df = df.with_columns(
    # 1. Calcul du nombre de mois
    (pl.col("R") * 12).round(0).cast(pl.Int32).alias("n_mois")
).with_columns(
    # 2. Arbre de décision
    pl.when(
        pl.col("Type_Credit").is_in(["Crédits Revolving", "CAV & autres"]) | (pl.col("n_mois") <= 0)
    ).then(
        pl.col("R")  # Bascule brute
    ).otherwise(
        (pl.col("n_mois") + 1) / 24  # Formule progressive
    ).alias("NB_MATURITE_CALCULEE")
)

# 3. Le Clip réglementaire (à adapter selon tes exemptions Trade Finance)
df = df.with_columns(
    pl.col("NB_MATURITE_CALCULEE").clip(lower_bound=1.0, upper_bound=5.0).alias("NB_MATURITE_FINALE")
)
