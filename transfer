def select_pire_periode(
    sub: pl.DataFrame,
    df_seg: pl.DataFrame,      # données brutes du segment (pour le t-test de bloc)
    lgd_col: str,
    date_col: str,
    lra: float,
    alpha: float,
    ponderation: str = "simple",
    freq: str = FREQ,
) -> dict | None:
    """Sélectionne la pire période (significative si possible) parmi les candidats d'un downturn."""
    # 1. On ne garde que les LGD numériques réelles
    sub = sub.filter(pl.col("LGD_moyenne_DT").is_finite())
    if sub.is_empty():
        return None

    # 2. Périodes significatives
    sig = sub.filter(pl.col("significatif") == True)

    if not sig.is_empty():
        sig_sorted = sig.sort("annee")
        sig_years  = sig_sorted["annee"].to_list()

        # 2.1 Blocs d'années consécutives
        blocks: list[list] = []
        current_block = [sig_years[0]]
        for i in range(1, len(sig_years)):
            try:
                if int(sig_years[i]) - int(sig_years[i - 1]) == 1:
                    current_block.append(sig_years[i])
                else:
                    blocks.append(current_block)
                    current_block = [sig_years[i]]
            except Exception:
                blocks.append(current_block.copy())
                current_block = [sig_years[i]]
        blocks.append(current_block)

        # 2.2 LGD moyenne par bloc
        block_result = []
        for blk in blocks:
            df_blk = sig_sorted.filter(pl.col("annee").is_in(blk))
            if ponderation == "weighted":
                avg = float((df_blk["LGD_moyenne_DT"] * df_blk["nb_obs"]).sum()
                            / df_blk["nb_obs"].sum())
            else:
                avg = float(df_blk["LGD_moyenne_DT"].mean())
            block_result.append({"lgd_dt": avg, "annee_sig": blk})

        best_block = max(block_result, key=lambda x: x["lgd_dt"])

        # 2.3 Résultat au niveau du bloc + t-test sur les LGD brutes du bloc
        result = sig_sorted.filter(pl.col("annee").is_in(best_block["annee_sig"])).head(1).to_dicts()[0]
        result["LGD_moyenne_DT"] = best_block["lgd_dt"]
        result["annee_sig"]      = best_block["annee_sig"]
        result["annee"] = (
            f"{best_block['annee_sig'][0]}-{best_block['annee_sig'][-1]}"
            if len(best_block["annee_sig"]) > 1 else str(best_block["annee_sig"][0])
        )

        block_lgd = (
            df_seg.filter(pl.col(date_col).is_in(best_block["annee_sig"]))
                  .get_column(lgd_col).drop_nulls()
        )
        result["nb_obs"] = int(len(block_lgd))
        if len(block_lgd) >= 2:
            arr = block_lgd.to_numpy()
            t_stat, p_bil = ttest_1samp(arr, popmean=lra)
            p_uni = p_bil / 2 if t_stat > 0 else 1.0
            result["t_stat"]      = float(t_stat)
            result["p_value"]     = float(p_uni)
            result["significatif"] = bool((p_uni < alpha) and (t_stat > 0))
        else:
            result["t_stat"] = None
            result["p_value"] = None

    else:
        # Aucune période significative -> plus forte LGD disponible
        result = sub.sort("LGD_moyenne_DT", descending=True).head(1).to_dicts()[0]
        result["annee_sig"] = [result["annee"]]
        result["annee"]     = str(result["annee"])
        print("Pas de période significative")

    return result
