# 1. Distribution des écarts résiduels (pour les non-matchs)
srs_X_capret_test = srs_X_capret.with_columns(
    (pl.col('MATURITE') / 12.0).clip(1.0, 5.0).alias('Dur_calc')
).with_columns(
    (pl.col('Dur_calc') - pl.col('NB_DURATION_IRBA')).alias('Ecart_final')
)

non_matchs = srs_X_capret_test.filter(pl.col('Ecart_final').abs() >= 0.001)
print(f"Non-matchs : {non_matchs.height}")
print(non_matchs['Ecart_final'].describe())

# 2. Tester différentes précisions d'arrondi SAS
# SAS utilise parfois 365 (vs 365.25) et ROUND à 10 décimales
for diviseur in [12.0, 12, 365/30.0, 365.25/30.0]:
    test = srs_X_capret.with_columns(
        (pl.col('MATURITE') / diviseur).clip(1.0, 5.0).alias('test')
    )
    n = test.filter((pl.col('test') - pl.col('NB_DURATION_IRBA')).abs() < 0.001).height
    print(f"Diviseur {diviseur:.4f} → Match : {n/srs_X_capret.height:.1%}")

# 3. SAS arrondit souvent à 4 ou 8 décimales
# Test avec round() à différentes précisions
for decimales in [2, 3, 4, 6, 8]:
    test = srs_X_capret.with_columns(
        (pl.col('MATURITE') / 12.0).clip(1.0, 5.0).round(decimales).alias('test')
    )
    n = test.filter((pl.col('test') - pl.col('NB_DURATION_IRBA')).abs() < 0.001).height
    print(f"Round({decimales}) → Match : {n/srs_X_capret.height:.1%}")
