import polars as pl
import numpy as np
from scipy import stats as sp_stats

def diagnostics_welch_kruskal(
    df: pl.LazyFrame,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
) -> pl.DataFrame:
    """
    Pour chaque paire de classes ADJACENTES intra-segment (ordre LRA croissant) :
    test de Welch (égalité des moyennes) et Kruskal-Wallis (égalité des
    distributions par les rangs), avec leurs p-values.

    Objet : DÉMONTRER qu'à n élevé (2k-686k obligors/classe) ces tests rejettent
    l'égalité quasi systématiquement, et ne peuvent donc pas servir de critère
    de fusion. La décision se fera sur la MATÉRIALITÉ (gap_lgd).
    """
    ordre = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("m"))
        .group_by([jenks_col])
        .agg(pl.col("m").mean().alias("mean_LGD_global"))
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))
        .sort(["seg", "mean_LGD_global"])
        .collect()
    )

    obligors = {}
    base = df.select([jenks_col, lgd_col]).collect()
    for cls in base.select(jenks_col).unique().to_series():
        obligors[cls] = base.filter(pl.col(jenks_col) == cls).get_column(lgd_col).to_numpy()

    rows = []
    for i in range(len(ordre) - 1):
        cls_1 = ordre[jenks_col][i]
        seg_1 = cls_1.split("_")[0]
        cls_2 = None
        for j in range(i + 1, len(ordre)):
            if ordre[jenks_col][j].split("_")[0] == seg_1:
                cls_2 = ordre[jenks_col][j]
                break
        if cls_2 is None:
            continue

        a1, a2 = obligors[cls_1], obligors[cls_2]
        t_w, p_w = sp_stats.ttest_ind(a1, a2, equal_var=False)
        h_k, p_k = sp_stats.kruskal(a1, a2)

        rows.append({
            "segment": seg_1,
            "class_1": cls_1,
            "class_2": cls_2,
            "n_1": len(a1),
            "n_2": len(a2),
            "gap_lgd": float(a2.mean() - a1.mean()),
            "welch_p": float(p_w),
            "kruskal_p": float(p_k),
        })

    return pl.DataFrame(rows).sort(["segment", "class_1"])


