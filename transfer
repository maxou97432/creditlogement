import math
import polars as pl
from scipy.stats import t as t_dist


# ----------------------------------------------------------------------
# Stats annuelles : LGD realisee par generation, moyenne number-weighted, sigma inter-annees
# ----------------------------------------------------------------------
def stats_annuelles(df, lgd_col, date_col):
    yr = (df.group_by(date_col)
            .agg([pl.col(lgd_col).mean().alias("lgd_annee"),
                  pl.col(lgd_col).count().alias("n_i")])
            .sort(date_col))
    if yr.height == 0:
        return yr, None, None, 0
    lgd_bar = float((yr["lgd_annee"] * yr["n_i"]).sum() / yr["n_i"].sum())   # number-weighted (= poolee)
    sigma   = float(yr["lgd_annee"].std(ddof=1)) if yr.height > 1 else None
    return yr, lgd_bar, sigma, yr.height


def est_contigu(years):
    ys = sorted(int(y) for y in years)
    return all(ys[i] - ys[i - 1] == 1 for i in range(1, len(ys)))


# ----------------------------------------------------------------------
# 1. Identification GLOBALE des generations downturn (t-test poole sur tout le portefeuille)
# ----------------------------------------------------------------------
def identifie_generations(base, lgd_col, date_col, downturn, lag, alpha):
    yr, lgd_bar, sigma, N = stats_annuelles(base, lgd_col, date_col)
    tests, generations = [], {}
    crit = float(t_dist.ppf(1 - alpha, N - 1)) if N > 1 else None
    for dt in downturn:
        sig_years = []
        for annee in range(dt - lag, dt + lag + 1):
            row = yr.filter(pl.col(date_col) == annee)
            if row.height == 0 or sigma is None or sigma == 0:
                continue
            lgd_i = float(row["lgd_annee"][0]); n_i = int(row["n_i"][0])
            X = math.sqrt(N) * (lgd_i - lgd_bar) / sigma
            sig = bool(X > crit)
            tests.append({"downturn": dt, "annee": annee, "n_i": n_i, "LGD_annee": lgd_i,
                          "X_stat": X, "seuil": crit, "p_value": float(t_dist.sf(X, N - 1)),
                          "significatif": sig})
            if sig:
                sig_years.append(annee)
        generations[dt] = sig_years
    return generations, pl.DataFrame(tests), lgd_bar


# ----------------------------------------------------------------------
# 2. Orchestrateur REBOOT
# ----------------------------------------------------------------------
def execution(base, segment_col, lgd_col, freq, downturn, alpha, lag):
    if not isinstance(downturn, (list, tuple, set)):
        downturn = [downturn]
    date_col = "annee" if freq == "annee" else "year_quarter"

    # 1. Identification GLOBALE des generations downturn
    generations, tests_glob, lgd_bar_glob = identifie_generations(base, lgd_col, date_col,
                                                                  downturn, lag, alpha)

    # 2. Methode d'agregation par episode : contigu -> moyenne ; non contigu -> max (jugement expert)
    methodes = {}
    print("=== Generations downturn identifiees (niveau global) ===")
    for dt, gens in generations.items():
        if not gens:
            methodes[dt] = None
            print(f"  DT {dt} : aucune generation significative")
        elif est_contigu(gens):
            methodes[dt] = "moyenne"
            print(f"  DT {dt} : {gens} -> contigu/homogene -> moyenne number-weighted")
        else:
            methodes[dt] = "max"
            print(f"  DT {dt} : {gens} -> NON contigu -> max{{LGD(Yi)}} (a valider en jugement expert)")

    if segment_col is None or segment_col not in base.columns:
        segment_list = [None]
    else:
        segment_list = base.select(pl.col(segment_col).unique()).to_series().to_list()

    # 3. Quantification de l'impact par HLC
    results = []
    for seg in segment_list:
        seg_label = str(seg) if seg is not None else "Global"
        df_seg = base.filter(pl.col(segment_col) == seg) if seg is not None else base
        lra_hlc = float(df_seg.select(pl.col(lgd_col).mean()).item())   # LRA du HLC (number-weighted)

        best = None
        for dt, gens in generations.items():
            if not gens:
                continue
            sub = df_seg.filter(pl.col(date_col).is_in(gens))
            if sub.height == 0:
                continue
            if methodes[dt] == "moyenne":
                lgd_dt = float(sub.select(pl.col(lgd_col).mean()).item())            # number-weighted
            else:  # max
                yr_seg = sub.group_by(date_col).agg(pl.col(lgd_col).mean().alias("lgd_annee"))
                lgd_dt = float(yr_seg.select(pl.col("lgd_annee").max()).item())      # max{LGD(Yi)}
            impact = max((lgd_dt - lra_hlc) / lra_hlc, 0.0)
            cand = {"downturn": dt, "generations": gens, "methode": methodes[dt],
                    "LGD_DT": lgd_dt, "n_dt": int(sub.height), "impact": impact}
            if best is None or impact > best["impact"]:
                best = cand

        if best is None:                       # aucune generation downturn -> pas d'impact
            best = {"downturn": None, "generations": [], "methode": None,
                    "LGD_DT": lra_hlc, "n_dt": None, "impact": 0.0}

        lgd_downturn = lra_hlc * (1 + best["impact"])
        moc = lgd_downturn - lra_hlc           # = max(LGD_DT - LRA, 0)

        results.append({
            "segment": seg_label,
            "downturn": best["downturn"],
            "generations": str(best["generations"]),
            "methode": best["methode"],
            "expert_a_valider": best["methode"] == "max",
            "n_dt": best["n_dt"],
            "lra": lra_hlc,
            "LGD_DT": best["LGD_DT"],
            "impact": best["impact"],
            "lgd_downturn": lgd_downturn,
            "moc": moc,
        })
        print(f"Seg {seg_label:>6} : LRA={lra_hlc:.4f}  LGD_DT={best['LGD_DT']:.4f}  "
              f"({best['methode']})  impact={best['impact']*100:.2f}%  "
              f"LGD_downturn={lgd_downturn:.4f}  MoC={moc:.4f}")

    return pl.DataFrame(results), tests_glob


# ----------------------------------------------------------------------
# (optionnel) reformatage pour ta cellule df_dt
# ----------------------------------------------------------------------
def calcule_downturn(df):
    return pl.DataFrame({
        "Segment": df["segment"], "LRA": df["lra"], "LGD DT": df["LGD_DT"],
        "Methode": df["methode"], "Impact": df["impact"],
        "Downturn (LGD-LRA)": df["moc"], "LGD downturn": df["lgd_downturn"],
    })
