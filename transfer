import polars as pl
import numpy as np
from scipy.stats import ttest_ind_from_stats, kruskal

stats = (
    df_obligor
    .group_by("CHR_model")
    .agg(
        pl.len().alias("n"),
        pl.col("lgd_obligor").mean().alias("mean"),
        pl.col("lgd_obligor").std().alias("std"),
    )
    .sort("mean")
)
print(stats)

s = stats.to_numpy()
cols = stats.columns
i_c, i_n, i_m, i_s = (cols.index(x) for x in ["CHR_model", "n", "mean", "std"])

print("\npaire | ecart_moyenne | n1 | n2 | p_welch | p_kruskal")
for i in range(len(s) - 1):
    g1, g2 = s[i], s[i+1]
    ecart = abs(g2[i_m] - g1[i_m])
    _, p_w = ttest_ind_from_stats(
        mean1=g1[i_m], std1=g1[i_s], nobs1=int(g1[i_n]),
        mean2=g2[i_m], std2=g2[i_s], nobs2=int(g2[i_n]),
        equal_var=False,
    )
    v1 = df_obligor.filter(pl.col("CHR_model") == g1[i_c])["lgd_obligor"].to_numpy()
    v2 = df_obligor.filter(pl.col("CHR_model") == g2[i_c])["lgd_obligor"].to_numpy()
    _, p_k = kruskal(v1, v2)
    print(f"{g1[i_c]}-{g2[i_c]} | {ecart:.3f} | {int(g1[i_n])} | {int(g2[i_n])} | {p_w:.2e} | {p_k:.2e}")
