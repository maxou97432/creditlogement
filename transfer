classes   = class_stats["CHR_model"].to_list()
means     = class_stats["mean_lgd"].to_list()
effectifs = class_stats["n"].to_list()

print(f"{len(classes)} classes | LGD [{min(means):.2f} – {max(means):.2f}]\n")

# Boucle sur les 64 paires adjacentes
rows = []
for i in range(len(classes) - 1):
    ca, cb = classes[i], classes[i + 1]
    a = df_base.filter(pl.col("CHR_model") == ca)["lgd_obligor"].to_numpy()
    b = df_base.filter(pl.col("CHR_model") == cb)["lgd_obligor"].to_numpy()
    mean_lgd = float((a.sum() + b.sum()) / (len(a) + len(b)))

    code, raison = W1OverlapTest(a, b, mean_lgd)
    diag = _LAST_W1_DIAG.copy()

    rows.append({
        "class_a"     : ca,
        "class_b"     : cb,
        "mean_a"      : round(means[i],     3),
        "mean_b"      : round(means[i + 1], 3),
        "gap"         : round(abs(means[i + 1] - means[i]), 3),
        "n_a"         : effectifs[i],
        "n_b"         : effectifs[i + 1],
        "code"        : code,
        "fusionnable" : code in CODES_FUSIONNABLES,
        "w1_obs"      : diag.get("w1_obs"),
        "w1_ic95_sup" : diag.get("w1_ic95_sup"),
        "eta"         : diag.get("eta"),
        "w1_pct_loc"  : diag.get("w1_pct_loc"),
        "raison"      : raison,
    })

    symbole = "✅" if code == 0 else "🟡" if code == 1 else "❌"
