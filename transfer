### 7.2 Python Implementation (Minimal Example)

```python
import polars as pl
import numpy as np
from scipy.stats import ttest_1samp
from pathlib import Path

# ─── Configuration ───────────────────────────────────────────
BASE_PATH = "/path/to/reference_data.parquet"
DOWNTURN = [2009, 2020]
LAG = 2
ALPHA = 0.05
PONDERATION = "simple"
FREQ = "annee"
SEGMENT_COL = None

# ─── Load & Prepare ──────────────────────────────────────────
df = pl.read_parquet(BASE_PATH)
df = df.with_columns(
    pl.col("REFERENCE_DATE").dt.year().alias("annee"),
    pl.col("REFERENCE_DATE").dt.quarter().alias("quarter"),
)

# ─── LRA ──────────────────────────────────────────────────────
lra = float(df["lgd_obligor"].mean())
print(f"LRA: {lra:.4f}")

# ─── Candidates & t-tests ─────────────────────────────────────
results = []
for dt_year in DOWNTURN:
    for year in range(dt_year - LAG, dt_year + LAG + 1):
        subset = df.filter(pl.col("annee") == year)["lgd_obligor"].drop_nulls()
        
        if len(subset) >= 2:
            t_stat, p_bilateral = ttest_1samp(subset.to_numpy(), popmean=lra)
            p_uni = (p_bilateral / 2) if t_stat > 0 else 1.0
            lgd_mean = float(subset.mean())
            sig = (p_uni < ALPHA) and (t_stat > 0)
            
            results.append({
                "downturn": dt_year,
                "year": year,
                "lgd_mean": lgd_mean,
                "n_obs": len(subset),
                "t_stat": t_stat,
                "p_value": p_uni,
                "significant": sig,
                "moc": lgd_mean - lra,
            })

df_results = pl.DataFrame(results)

# ─── Select worst per downturn year ──────────────────────────
for dt_year in DOWNTURN:
    sub = df_results.filter(pl.col("downturn") == dt_year)
    sig = sub.filter(pl.col("significant") == True)
    
    if not sig.is_empty():
        worst = sig.sort("lgd_mean", descending=True).head(1)
        print(f"DT {dt_year}: Year {worst['year'][0]}, LGD={worst['lgd_mean'][0]:.4f}, MoC={worst['moc'][0]:.4f}")
    else:
        worst = sub.sort("lgd_mean", descending=True).head(1)
        print(f"DT {dt_year}: Year {worst['year'][0]} (not sig), LGD={worst['lgd_mean'][0]:.4f}")

# ─── Export ───────────────────────────────────────────────────
output_file = Path(BASE_PATH).parent / "moc_results.xlsx"
df_results.write_excel(str(output_file), sheet_name="Tests")
print(f"Results exported to {output_file}")
```

