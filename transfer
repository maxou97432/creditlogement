# A) Vrai max de lgd_obligor — ma logique prédit <= 144. À falsifier.
diag_obligor = (
    lf_LGD
    .group_by([config['Obligor'], config['Date_defaut']])
    .agg(
        (pl.col('LGD') * pl.col(config['EAD'])).sum().alias("num"),
        pl.col(config['EAD']).sum().alias("denom"),
    )
    .with_columns((pl.col("num") / pl.col("denom")).alias("lgd_obligor"))
    .collect()
)

diag_obligor.select(
    pl.col("lgd_obligor").min().alias("min"),
    pl.col("lgd_obligor").max().alias("max"),
    pl.col("lgd_obligor").is_infinite().sum().alias("nb_inf"),
    pl.col("lgd_obligor").is_nan().sum().alias("nb_nan"),
    pl.col("lgd_obligor").is_null().sum().alias("nb_null"),
    (pl.col("denom").abs() < 1).sum().alias("nb_denom_quasi_nul"),
)
