# Pour chaque sous-modèle : tests 2-à-2 + flags + détection d'inversions
diagnostics = {}
for sm in df_brut[SUBMODEL_COL].unique().sort().to_list():
    df_sm = df_brut.filter(pl.col(SUBMODEL_COL) == sm)
    cmp_A = FusionComparator(
        df_sm, class_col=CLASS_COL, lgd_col=LGD_COL,
        obligor_col=OBLIGOR_COL, pairs="all",
    ).run()
    diagnostics[sm] = cmp_A

    print(f"\n========== Sous-modèle {sm} : flags d'hétérogénéité ==========")
    with pl.Config(fmt_str_lengths=100, tbl_rows=-1):
        print(cmp_A.flags())                       # tableau emoji 🟢🟠🔴

    inv = cmp_A.inversions()
    if inv.height:
        print(f"  ⚠️  {inv.height} inversion(s) détectée(s) :")
        print(inv)
    else:
        print("  ✅ aucune inversion — grille saine.")
