pop = df.filter(
    (pl.col("IND_CREDIT_CONFIRME") == 0) &
    (pl.col("Flag_Revolving") == 0) &
    (pl.col("PORTEFEUILLE") == "Corporate")
)

# 1) Distribution jointe des deux CCF par segment
print(">>> Crosstab TX_CCF_PNU × SEGMENT")
print(
    pop.group_by(["SEGMENT", "TX_CCF_IRBA_PNU"])
    .agg(pl.count().alias("N"))
    .sort(["SEGMENT", "TX_CCF_IRBA_PNU"])
)

print("\n>>> Crosstab TX_CCF_UTIL × SEGMENT")
print(
    pop.group_by(["SEGMENT", "TX_CCF_IRBA_UTIL"])
    .agg(pl.count().alias("N"))
    .sort(["SEGMENT", "TX_CCF_IRBA_UTIL"])
)

# 2) Si tu as MT_UTIL / MT_PNU dans le schéma :
for col in ["MT_UTIL", "MT_PNU", "MT_BILAN", "MT_HORS_BILAN"]:
    if col in pop.columns:
        print(f"\n>>> {col} par segment")
        print(
            pop.group_by("SEGMENT").agg(
                pl.col(col).mean().alias("mean"),
                (pl.col(col) == 0.0).sum().alias("n_zero"),
                pl.count().alias("N"),
            )
        )

# 3) Test de discrimination parfaite
for candidate in [
    (pl.col("TX_CCF_IRBA_PNU") == 0),
    (pl.col("TX_CCF_IRBA_PNU") == 0) & (pl.col("TX_CCF_IRBA_UTIL") > 0),
    # ajoute MT_PNU == 0 si tu as la colonne
]:
    pop_tmp = pop.with_columns(candidate.alias("COND"))
    crosstab = (
        pop_tmp.group_by(["SEGMENT", "COND"])
        .agg(pl.count().alias("N"))
        .sort(["SEGMENT", "COND"])
    )
    print(f"\n>>> Test condition :\n{crosstab}")
