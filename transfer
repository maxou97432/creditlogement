srs_reconstruit = srs_X_capret.with_columns(
    pl.when(pl.col('CD_TYPE_AMORT') == '1').then(pl.col('MATURITE') / 12.0 * 0.5120)
    .when(pl.col('CD_TYPE_AMORT') == '3').then(pl.col('MATURITE') / 12.0 * 0.5398)
    .otherwise(pl.col('MATURITE') / 12.0)
    .alias('MATURITE_IRBA_approx')
).with_columns(
    pl.col('MATURITE_IRBA_approx').clip(1.0, 5.0).alias('Duration_Reconstituee')
)

# Test de l'approximation (tolérance écart à 0.1 an pour juger de la qualité)
n = srs_reconstruit.filter(
    (pl.col('Duration_Reconstituee') - pl.col('NB_DURATION_IRBA')).abs() < 0.1
).height

print(f"Match avec tolérance 0.1 an : {n}/{srs_reconstruit.height} ({n/srs_reconstruit.height:.1%})")
