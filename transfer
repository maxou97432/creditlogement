def calibrate(
        self,
        seuils: Optional[list] = None,
        n_bootstrap: int = 200,
        n_subsample: int = 300,
        method: str = "kde",
        random_state: Optional[int] = 42,
    ) -> "FusionComparator":
        """Calibre le seuil OVL par stabilité bootstrap (ARI, Hubert & Arabie 1985).

        Lance calibrer_seuil_ovl_stabilite() sur les arrays de ce comparateur,
        stocke le seuil optimal dans self.seuil_calibre et le DataFrame de
        calibration dans self.df_calibration.

        Retourne self pour permettre le chaînage :
            cmp = FusionComparator(...).run().calibrate()

        Le seuil calibré est automatiquement utilisé par solve() si aucun
        ovl_threshold n'est passé explicitement.
        """
        if seuils is None:
            seuils = [round(s, 2) for s in np.arange(0.50, 0.76, 0.05)]

        self.df_calibration = calibrer_seuil_ovl_stabilite(
            cmp=self,
            seuils=seuils,
            n_bootstrap=n_bootstrap,
            n_subsample=n_subsample,
            method=method,
            random_state=random_state,
        )

        n_initial = len(self.order)
        df_valide = self.df_calibration.filter(
            (pl.col("n_classes_median") > 1) &
            (pl.col("n_classes_median") < n_initial)
        )
        if df_valide.is_empty():
            raise ValueError(
                "Aucune partition non-triviale trouvée. "
                "Vérifier les seuils candidats ou les données."
            )
        self.seuil_calibre = float(
            df_valide
            .filter(pl.col("ari_moyen") == pl.col("ari_moyen").max())
            ["seuil_ovl"][0]
        )
        return self
