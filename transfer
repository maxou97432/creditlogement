# Vérifie si duration capret ≈ NB_MATURITE_IRBA srs (pour les non-nulls)
test_dur = srs_X_capret.filter(pl.col('duration').is_not_null())
n = test_dur.filter(
    (pl.col('duration') - pl.col('NB_MATURITE_IRBA')).abs() < 0.01
).height
print(f"duration capret ≈ NB_MATURITE_IRBA srs : {n}/{test_dur.height} ({n/test_dur.height:.1%})")

