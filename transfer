def compare_to_srs(df: pl.DataFrame) -> dict:
    """
    Compare recomputed values against original SRS values.
    Prints global metrics, breakdown by CD_TYPE_AMORT, and error distributions.
    """
    df = df.with_columns(
        err_maturite = pl.col("NB_MATURITE_RECALCULE") - pl.col("NB_MATURITE_IRBA"),
        err_duration = pl.col("NB_DURATION_RECALCULE") - pl.col("NB_DURATION_IRBA"),
    ).with_columns(
        abs_err_maturite = pl.col("err_maturite").abs(),
        abs_err_duration = pl.col("err_duration").abs(),
    )

    err_m = df["err_maturite"].drop_nulls().to_numpy()
    err_d = df["err_duration"].drop_nulls().to_numpy()

    # ============================================================
    # 1. Global metrics
    # ============================================================
    rmse_m = float(np.sqrt(np.mean(err_m**2)))
    rmse_d = float(np.sqrt(np.mean(err_d**2)))
    mae_m  = float(np.mean(np.abs(err_m)))
    mae_d  = float(np.mean(np.abs(err_d)))
    p_m_005 = float((np.abs(err_m) < 0.05).mean() * 100)
    p_d_005 = float((np.abs(err_d) < 0.05).mean() * 100)
    p_m_01  = float((np.abs(err_m) < 0.10).mean() * 100)
    p_d_01  = float((np.abs(err_d) < 0.10).mean() * 100)

    print("\n=== 1. Global metrics ===")
    print(f"  n_observations              = {len(err_m):>10,}")
    print(f"  RMSE maturite (days)        = {rmse_m*365.25:>10.2f}")
    print(f"  RMSE duration (days)        = {rmse_d*365.25:>10.2f}")
    print(f"  MAE maturite (days)         = {mae_m*365.25:>10.2f}")
    print(f"  MAE duration (days)         = {mae_d*365.25:>10.2f}")
    print(f"  % match maturite |err|<0.05 = {p_m_005:>10.2f}%")
    print(f"  % match duration |err|<0.05 = {p_d_005:>10.2f}%")
    print(f"  % match maturite |err|<0.1  = {p_m_01:>10.2f}%")
    print(f"  % match duration |err|<0.1  = {p_d_01:>10.2f}%")

    # ============================================================
    # 2. Performance by CD_TYPE_AMORT (manual loop, no .to_dicts pitfalls)
    # ============================================================
    print("\n=== 2. Performance by CD_TYPE_AMORT ===")
    print(f"  {'type':<6} {'n':>10} {'RMSE_mat_d':>12} {'RMSE_dur_d':>12} "
          f"{'%mat<0.05':>10} {'%dur<0.05':>10} {'%mat<0.1':>10} {'%dur<0.1':>10}")
    print("  " + "-" * 92)

    for type_val in sorted(df["CD_TYPE_AMORT"].drop_nulls().unique().to_list()):
        sub = df.filter(pl.col("CD_TYPE_AMORT") == type_val)
        em = sub["err_maturite"].drop_nulls().to_numpy()
        ed = sub["err_duration"].drop_nulls().to_numpy()
        if len(em) == 0:
            continue
        n_t   = len(em)
        rms_m = float(np.sqrt(np.mean(em**2)) * 365.25)
        rms_d = float(np.sqrt(np.mean(ed**2)) * 365.25)
        pm05  = float((np.abs(em) < 0.05).mean() * 100)
        pd05  = float((np.abs(ed) < 0.05).mean() * 100)
        pm01  = float((np.abs(em) < 0.10).mean() * 100)
        pd01  = float((np.abs(ed) < 0.10).mean() * 100)
        print(f"  {type_val:<6} {n_t:>10,} {rms_m:>12.2f} {rms_d:>12.2f} "
              f"{pm05:>9.2f}% {pd05:>9.2f}% {pm01:>9.2f}% {pd01:>9.2f}%")

    # ============================================================
    # 3. Distribution of errors (in days) — maturity
    # ============================================================
    print("\n=== 3. Distribution of maturity errors (in days) ===")
    err_m_days = err_m * 365.25
    bins = [-365, -180, -60, -30, -10, -1, 1, 10, 30, 60, 180, 365, 10000]
    for lo, hi in zip(bins[:-1], bins[1:]):
        mask = (err_m_days >= lo) & (err_m_days < hi)
        cnt = int(mask.sum())
        if cnt > 0:
            pct = float(mask.mean() * 100)
            bar = "#" * int(pct / 2) if pct > 1 else ""
            print(f"  [{lo:>+5}, {hi:>+5}[ days : {cnt:>8,} ({pct:>5.2f}%) {bar}")

    # ============================================================
    # 4. Distribution of errors (in days) — duration
    # ============================================================
    print("\n=== 4. Distribution of duration errors (in days) ===")
    err_d_days = err_d * 365.25
    for lo, hi in zip(bins[:-1], bins[1:]):
        mask = (err_d_days >= lo) & (err_d_days < hi)
        cnt = int(mask.sum())
        if cnt > 0:
            pct = float(mask.mean() * 100)
            bar = "#" * int(pct / 2) if pct > 1 else ""
            print(f"  [{lo:>+5}, {hi:>+5}[ days : {cnt:>8,} ({pct:>5.2f}%) {bar}")

    return {
        "n_observations"         : len(err_m),
        "rmse_maturite_days"     : rmse_m * 365.25,
        "rmse_duration_days"     : rmse_d * 365.25,
        "mae_maturite_days"      : mae_m * 365.25,
        "mae_duration_days"      : mae_d * 365.25,
        "pct_match_maturite_005" : p_m_005,
        "pct_match_duration_005" : p_d_005,
        "pct_match_maturite_01"  : p_m_01,
        "pct_match_duration_01"  : p_d_01,
    }
