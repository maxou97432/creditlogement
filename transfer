print(f"  {'mae_pred':<18} {scores_ref['mae_pred']:>12.6f} {scores_final['mae_pred']:>12.6f} "
      f"{(scores_final['mae_pred']-scores_ref['mae_pred'])/scores_ref['mae_pred']*100:>+9.3f}%")
