# Les lignes où SRS n'applique PAS le plancher (NB_DURATION_IRBA < 1.0)
# → ce sont les vraies exceptions

exceptions_srs = srs_X_capret.filter(pl.col('NB_DURATION_IRBA') < 1.0)
print(f"Lignes avec durée < 1 an dans srs : {exceptions_srs.height}")

# Leur répartition par Type_Credit
print(exceptions_srs.group_by('Type_Credit').len().sort('len', descending=True))

# Ligne NON-exception avec durée < 1 an dans capret mais floored à 1 par srs
non_exception = srs_X_capret.filter(
    (pl.col('duration') < 1.0) & 
    (pl.col('NB_DURATION_IRBA') == 1.0)
)
print(f"\nLignes où SRS APPLIQUE le floor (duration capret < 1 mais srs = 1) :")
print(non_exception.group_by('Type_Credit').len().sort('len', descending=True))
