import sys
import os
import time
import logging
import pandas as pd
import numpy as np
import plotly.express as px
import plotly.io as pio

# Configuration de l'environnement
current_dir = os.getcwd()
parent_dir = os.path.abspath(os.path.join(current_dir, '..'))

# Ajout des chemins personnalisés (à adapter selon votre structure)
sys.path.append(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\correction base_demande")

# Imports de vos modules personnalisés
from fonctions import Connector
from fonctions import detect_ano_ml as detect_ano_ml_fct
import param_general as params

# Configuration Plotly
pio.renderers.default = "browser"  # 'png' nécessite Kaleido, 'browser' ou 'notebook' est plus sûr pour dev

# Configuration des dossiers
OUTPUT_DIR = os.path.join(os.path.dirname(__file__), "correction base_demande")
os.makedirs(OUTPUT_DIR, exist_ok=True)

DATA_PATH = r"Z:\data\cl_estim\cleaned_data"

# =============================================================================
# 1. IMPORTATION ET CONCATÉNATION
# =============================================================================
print("--- 1. Importation des données ---")
start_time = time.time()

co = Connector()

# Chargement Base Transactions
base_clean = pd.read_parquet(os.path.join(DATA_PATH, "df_transac_clean.parquet"))
base_clean["DEMANDE"] = 0

# Chargement Base Demandes
demandes = pd.read_parquet(os.path.join(DATA_PATH, "df_demandes_clean.parquet"))
demandes["DEMANDE"] = 1

# Fusion
df = pd.concat([base_clean, demandes], axis=0)

end_time = time.time()
print(f"✓ Données chargées en {end_time - start_time:.2f} s. Total lignes : {len(df):,}")

# =============================================================================
# 2. ENRICHISSEMENT GÉOGRAPHIQUE (BAN)
# =============================================================================
print("\n--- 2. Enrichissement BAN (Codes IRIS) ---")
# Récupération SQL
df_ban = co.read_sql(f"SELECT CLE_INTEROP_ADR, code_iris FROM {params.BAN_ENRICHIE}")

# Fusion (Left join pour garder toutes les transactions)
cl_data = pd.merge(df, df_ban, how='left', on='CLE_INTEROP_ADR')

# =============================================================================
# 3. FILTRAGE PRÉALABLE (CRITIQUE : AVANT ML)
# =============================================================================
print("\n--- 3. Restrictions du périmètre d'étude ---")
# On filtre AVANT le ML pour :
# 1. Ne pas fausser le ML avec des prix de travaux (TVX) ou des rachats (RAC)
# 2. Gagner du temps de calcul

# A. Restriction Source CL
cl_data = cl_data[cl_data["SOURCE"] == "CL"]

# B. Restriction Métropole (01-95 + 2A/2B)
dept = cl_data["DEPT_Corse_2A_2B"].astype(str).str.upper().str.strip()
metropole_set = {f"{i:02d}" for i in range(1, 96)} | {"2A", "2B"}
mask_metro = dept.isin(metropole_set)
cl_data = cl_data[mask_metro]

# C. Restriction Nature Opération (Exclusion TVX, RAC)
cl_data["CD_NATUR_OP"] = cl_data["CD_NATUR_OP"].fillna("Non renseigné")
mask_valid_op = (~cl_data["CD_NATUR_OP"].isin(["TVX", "RAC"]))
cl_data = cl_data[mask_valid_op]

print(f"✓ Périmètre restreint (CL + Métropole + Hors Tx). Lignes restantes : {len(cl_data):,}")

# =============================================================================
# 4. DÉTECTION D'ANOMALIES (ML)
# =============================================================================
print("\n--- 4. Détection d'anomalies (Algorithme ML) ---")
start_time = time.time()

# L'algo ne tourne maintenant que sur les données pertinentes
base_ml_filtered, outliers = detect_ano_ml_fct(input_df=cl_data, n_years=12)

end_time = time.time()
print(f"✓ ML terminé en {end_time - start_time:.2f} s")
print(f"  - Biens valides : {len(base_ml_filtered):,}")
print(f"  - Outliers rejetés : {len(outliers):,}")

# =============================================================================
# 5. FILTRE TEMPOREL & ENRICHISSEMENT BÂTIMENT (BAT)
# =============================================================================
print("\n--- 5. Enrichissement Bâtiment & Filtre Date ---")

# A. Filtre Date
base_ml_filtered["DATE"] = pd.to_datetime(base_ml_filtered["DATE"], errors="coerce")
DATE_MIN = pd.Timestamp("2014-01-01")
DATE_MAX = base_ml_filtered["DATE"].max() # Ou définir une date fixe

base_ml = base_ml_filtered[(base_ml_filtered["DATE"] >= DATE_MIN) & (base_ml_filtered["DATE"] < DATE_MAX)].copy()

# B. Fusion BAT (Année construction)
start_time = time.time()
df_bat = co.read_sql(f"SELECT CLE_INTEROP_ADR, annee_construction FROM {params.BAT_ENRICHIE}")
base_ml = pd.merge(base_ml, df_bat, how="left", on="CLE_INTEROP_ADR", suffixes=("", "_bat"))

end_time = time.time()
print(f"✓ Fusion BAT terminée en {end_time - start_time:.2f} s")

# =============================================================================
# 6. CRÉATION DE VARIABLES (Neuf/Ancien & Typologie)
# =============================================================================
print("\n--- 6. Feature Engineering ---")

# A. Correction Année Construction pour VEFA
mask_vefa = base_ml["NATURE_MUTATION"] == "Vente en l'état futur d'achèvement"
base_ml.loc[mask_vefa, "annee_construction"] = base_ml.loc[mask_vefa, "DATE"].dt.year

# B. Variable BIEN_NEUF
base_ml["BIEN_NEUF"] = np.where(
    (base_ml["NATURE_MUTATION"] == "Vente en l'état futur d'achèvement") |
    (base_ml["CD_NATUR_OP"] == "AQN") |
    (abs(base_ml["YEAR"].astype(float) - base_ml["annee_construction"]) <= 2),
    "NEUF",
    "ANCIEN"
)
base_ml = base_ml.drop(columns=["NATURE_MUTATION"])

# C. Variable NB_PIECES_RANGE
base_ml["NB_PIECES"] = pd.to_numeric(base_ml["NB_PIECES"], errors="coerce")

# Définition des bins
bins_apt = [0, 2, 4, np.inf]
labels_apt = ["APT: 1-2 pièces", "APT : 3-4 pièces", "APT: 5 pièces et plus"]

bins_mai = [0, 4, np.inf]
labels_mai = ["MAI: 4 pièces et moins", "MAI: 5 pièces et plus"]

# Application vectorisée
base_ml["NB_PIECES_RANGE"] = np.nan # Init
mask_apt = base_ml["TYPE_BIEN"] == "APT"
mask_mai = base_ml["TYPE_BIEN"] == "MAI"

base_ml.loc[mask_apt, "NB_PIECES_RANGE"] = pd.cut(
    base_ml.loc[mask_apt, "NB_PIECES"], bins=bins_apt, labels=labels_apt, include_lowest=True
).astype(str)

base_ml.loc[mask_mai, "NB_PIECES_RANGE"] = pd.cut(
    base_ml.loc[mask_mai, "NB_PIECES"], bins=bins_mai, labels=labels_mai, include_lowest=True
).astype(str)

# Gestion des NaN convertis en string "nan" par astype(str) ou restés NaN
base_ml["NB_PIECES_RANGE"] = base_ml["NB_PIECES_RANGE"].replace("nan", np.nan)
base_ml.loc[mask_apt & base_ml["NB_PIECES_RANGE"].isna(), "NB_PIECES_RANGE"] = "APT: Non renseigné"
base_ml.loc[mask_mai & base_ml["NB_PIECES_RANGE"].isna(), "NB_PIECES_RANGE"] = "MAI: Non renseigné"

# =============================================================================
# 7. EXPORT
# =============================================================================
output_path = os.path.join(OUTPUT_DIR, "transac+demandes_filtree2.parquet")
base_ml.to_parquet(output_path, index=False)
print(f"\n✓ Fichier sauvegardé : {output_path}")

# =============================================================================
# 8. ANALYSE DES OUTLIERS & STATS
# =============================================================================
# Fonctions d'analyse (Regroupées pour clarté)

def run_full_analysis(df_outliers, df_valid):
    print("\n" + "="*80)
    print(" RAPPORT D'ANOMALIES")
    print("="*80)
    
    total = len(df_outliers) + len(df_valid)
    print(f"Total Transactions analysées : {total:,}")
    print(f"Taux de rejet : {len(df_outliers)/total:.2%}")
    
    # Classification simplifiée des outliers
    # On compare le prix outlier à la médiane de l'année/ville/type du dataset valide
    medianes = df_valid.groupby(['YEAR', 'ville_', 'TYPE_BIEN'])['Prix_m2'].median().reset_index()
    medianes = medianes.rename(columns={'Prix_m2': 'mediane_ref'})
    
    df_outliers = df_outliers.merge(medianes, on=['YEAR', 'ville_', 'TYPE_BIEN'], how='left')
    
    conditions = [
        (df_outliers['Prix_m2'] < 200),
        (df_outliers['Prix_m2'] > 20000),
        (df_outliers['Prix_m2'] < df_outliers['mediane_ref'] / 4),
        (df_outliers['Prix_m2'] > df_outliers['mediane_ref'] * 4)
    ]
    choices = ['Prix < 200€', 'Prix > 20k€', 'Prix < Mediane/4', 'Prix > Mediane*4']
    
    df_outliers['Type_Anomalie'] = np.select(conditions, choices, default='Autre écart stat')
    
    print("\nRépartition des anomalies :")
    print(df_outliers['Type_Anomalie'].value_counts())
    
    print("\nTop 5 Villes avec anomalies :")
    print(df_outliers['ville_'].value_counts().head(5))

# Lancement de l'analyse
run_full_analysis(outliers, base_ml)

# =============================================================================
# 9. GRAPHIQUE FINAL (Evolution Transactions)
# =============================================================================
by_year = base_ml.groupby("YEAR")["ID"].count().reset_index(name="Nombre de transactions")
total_tx = by_year["Nombre de transactions"].sum()

fig = px.bar(
    by_year.sort_values("YEAR"),
    x="YEAR", y="Nombre de transactions",
    text="Nombre de transactions",
    color="Nombre de transactions", color_continuous_scale="Viridis",
    title=f"Évolution annuelle des transactions valides (Total : {total_tx:,})"
)
fig.update_traces(textposition="outside")
fig.update_layout(height=600, template="plotly_white")
fig.show()

print("\n--- Fin du traitement ---")
