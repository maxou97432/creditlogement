# ============================================================
#  CRITERE DE PARSIMONIE — pouvoir discriminant
#  Cellule 1 : scores de reference sur les 65 classes
# ============================================================

from sklearn.metrics import roc_auc_score
import polars as pl
import numpy as np

def compute_scores(df: pl.DataFrame, class_col: str, target_col: str) -> dict:
    """
    Calcule les 3 criteres de pouvoir discriminant sur un partitionnement donne.
    
    R2        : variance inter / variance totale (eta-squared)
    Gini/AUC  : AUC one-vs-rest moyenne ponderee entre classes
    MAE_pred  : erreur de prediction si on predit la moyenne de classe
    """
    # Stats globales
    y = df[target_col].to_numpy()
    grand_mean = y.mean()
    ss_total   = ((y - grand_mean) ** 2).sum()

    # Stats par classe
    class_stats = (
        df.group_by(class_col)
        .agg([
            pl.col(target_col).mean().alias("mean_cls"),
            pl.col(target_col).count().alias("n_cls"),
        ])
    )
    classes  = class_stats[class_col].to_list()
    means    = class_stats["mean_cls"].to_numpy()
    ns       = class_stats["n_cls"].to_numpy()

    # R2 : variance expliquee par les classes
    ss_inter = float(((means - grand_mean) ** 2 * ns).sum())
    r2 = ss_inter / ss_total if ss_total > 0 else 0.0

    # MAE_pred : erreur moyenne si on predit mean_cls pour chaque observation
    df_joined = df.join(class_stats, on=class_col, how="left")
    y_pred    = df_joined["mean_cls"].to_numpy()
    mae_pred  = float(np.abs(y - y_pred).mean())

    # Gini : AUC one-vs-rest, pondere par effectif
    # Pour chaque classe : AUC(classe_i vs reste)
    labels = df[class_col].to_numpy()
    aucs, weights = [], []
    for cls, n_cls in zip(classes, ns):
        binary = (labels == cls).astype(int)
        if binary.sum() == 0 or binary.sum() == len(binary):
            continue
        try:
            auc = roc_auc_score(binary, y)
            aucs.append(auc)
            weights.append(n_cls)
        except Exception:
            continue
    gini = float(2 * np.average(aucs, weights=weights) - 1) if aucs else 0.0

    return {
        "n_classes": len(classes),
        "r2"       : round(r2,       6),
        "gini"     : round(gini,     6),
        "mae_pred" : round(mae_pred, 6),
    }


