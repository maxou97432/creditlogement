# On isole strictement la sous-population concernée par la Règle 1
lignes_conservatives = srs_fusion.filter(
    (pl.col('Conservative_Residual_Maturity') - pl.col('NB_MATURITE_IRBA')).abs() < 0.001
)

print(f"▶ INVESTIGATION sur les {lignes_conservatives.height} contrats à choix conservateur :")

print("\n1. Analyse de la donnée d'amortissement (CD_TYPE_AMORT) :")
# On compte la répartition pour vérifier si la donnée était vraiment "non disponible"
repartition_amort = lignes_conservatives.group_by('CD_TYPE_AMORT').agg(
    pl.len().alias('Nombre_de_Contrats')
).with_columns(
    (pl.col('Nombre_de_Contrats') / lignes_conservatives.height * 100).round(1).alias('Proportion_%')
).sort('Nombre_de_Contrats', descending=True)
print(repartition_amort)

