# Le chemin est conservé tel quel
geojson_path = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\metropole.geojson" 

# Chemins des données (vérifiez l'accessibilité)
prix_m2_univ_elem_MAJ_CITY = pd.read_csv(r"N:\uflumth\indicateur_marche\univers_elementaire\TI\prix_m2_univ_elem_MAJ_CITY.csv")
df_communes = pd.read_excel(r"N:\uflujek\Commune_france.xlsx", sheet_name="Figure 1")
df_geo_gps = pd.read_csv(r'N:\uflujek\commune_france_gps.csv', sep=';')

# =============================================================================
# --- PALETTE DE COULEURS CRÉDIT LOGEMENT & POLICE ---
# =============================================================================
CL_TURQUOISE = '#00A79E' 
CL_BLACK = '#000000' 
CL_LIGHT_GREY = '#F0F0F0' 
CL_MEDIUM_GREY = '#CCCCCC' 
CL_RED = '#E4002B' # Rouge pour les baisses (maintenant couleur fixe pour TI 12M)

# --- CONFIGURATION DE POLICE ---
NOM_POLICE_CL = 'Century Gothic' 
plt.rcParams['font.family'] = 'sans-serif' 
plt.rcParams['font.sans-serif'] = [NOM_POLICE_CL, 'Arial', 'Verdana', 'sans-serif'] 
plt.rcParams['font.weight'] = 'medium' 

TITRE_FONT_WEIGHT = 'heavy' 

# =============================================================================
# --- PRÉPARATION DES DONNÉES ---
# =============================================================================

# 1. Nettoyage et Fusion
prix_m2_univ_elem_MAJ_CITY = prix_m2_univ_elem_MAJ_CITY[prix_m2_univ_elem_MAJ_CITY["TYPE_MAILLE"] == "CITY"]

df_communes['Commune'] = df_communes['Commune'].astype(str).str.upper()
df_prix_m2 = df_communes.merge(prix_m2_univ_elem_MAJ_CITY, left_on='Commune', right_on='VAL_MAILLE_GEO', how='right')

# 2. Fonction de formatage du texte (non utilisée pour le tracé, mais pour les données)
def format_text_label(row):
    ville = str(row['label']).upper() 
    prix_val = row['prix_mm_value']
    prix = f"{round(prix_val):,} €".replace(',', ' ') if pd.notna(prix_val) else "N/A"
    return ville, prix


# =============================================================================
# --- PRÉPARATION DU CONTOUR GÉOGRAPHIQUE ---
# =============================================================================

try:
    france_gdf = gpd.read_file(geojson_path)
    dissolved_france = france_gdf.dissolve(by=None)
    france_outline_geometry = dissolved_france.geometry.iloc[0] 
    print("Contour de la France chargé et dissous avec succès.")
except Exception as e:
    print(f"!!! Échec critique du chargement du GeoJSON: {e}")
    sys.exit(1)


# =============================================================================
# --- CRÉATION DE LA CARTE MATPLOTLIB ---
# =============================================================================

print("Configuration de police 'Century Gothic' appliquée.")


types_bien = ['APT', 'MAI']

# --- DEFINITION DES OFFSETS SPÉCIFIQUES ---
CUSTOM_LABEL_OFFSETS = {
    'TOULON': {'x': 0.1, 'y': -0.05} ,
    'PARIS': {'x': 0.08, 'y': 0.08},
    'REIMS': {'x': 0.08, 'y': 0.08},
    'LILLE': {'x': 0.08, 'y': 0.08},
    # Ajoutez d'autres villes ici si elles se chevauchent
}


for type_bien in types_bien:
    print(f"\n--- Génération de la carte pour le type de bien : {type_bien} ---")
    
    df_prix_filtre = df_prix_m2[(df_prix_m2["CD_TYPE_BIEN"] == type_bien) & (df_prix_m2["DIC_NAME"] == "prix_m2_12m")].copy()
    df_geo_gps['label'] = df_geo_gps['label'].astype(str).str.upper()
    df_map = df_geo_gps.merge(df_prix_filtre, left_on='label', right_on='VAL_MAILLE_GEO', how='inner')
    
    df_map = df_map[['label', 'latitude', 'longitude', 'prix_mm_value', "TAUX_INFL_3M", 'TAUX_INFL_12M']].copy()
    df_map = df_map.dropna(subset=['latitude', 'longitude'])
    df_map = df_map.drop_duplicates(subset='label', keep='first')
    
    if df_map.empty:
        print("Aucune donnée géographique valide trouvée pour ce type de bien.")
        continue
        
    df_map['ville_str'], df_map['prix_str'] = zip(*df_map.apply(format_text_label, axis=1))
    geometry = [Point(xy) for xy in zip(df_map['longitude'], df_map['latitude'])]
    gdf = gpd.GeoDataFrame(df_map, geometry=geometry, crs="EPSG:4326")
    
    # --- DESSIN ---
    fig, ax = plt.subplots(1, 1, figsize=(14, 14), dpi=300) 
    fig.set_facecolor(CL_TURQUOISE) 
    
    # ... (Code de dessin du contour de la France inchangé) ...
    # --- DESSIN DU CONTOUR DE LA FRANCE ---
    geometries_to_plot = [france_outline_geometry]
    if france_outline_geometry.geom_type == 'MultiPolygon':
        geometries_to_plot = list(france_outline_geometry.geoms)

    for geom in geometries_to_plot:
        # Remplissage de la France
        ax.fill(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_LIGHT_GREY, 
                zorder=1) 
                
        # Contour noir
        ax.plot(geom.exterior.xy[0], geom.exterior.xy[1], 
                color=CL_BLACK, 
                linewidth=1.0, 
                zorder=2)
    
    # Définir les limites de la vue (zoom sur la France)
    xmin, ymin, xmax, ymax = france_outline_geometry.bounds
    ax.set_xlim(xmin - 0.7, xmax + 0.7) 
    ax.set_ylim(ymin - 0.7, ymax + 0.7)


    # --- AJOUT DES ÉTIQUETTES (SANS CADRE) ---
    
    # Variables d'Offset par DÉFAUT des Étiquettes
    DEFAULT_X_OFFSET = 0.08 
    DEFAULT_Y_OFFSET = 0.08 
    
    # Espacement vertical entre les lignes
    LINE_SPACING = 0.06 
    
    # Taille de police
    FONT_SIZE = 10
    FONT_SIZE_EVOL = 8
    
    # Approximation de la largeur d'un caractère (pour l'alignement horizontal des taux)
    CHAR_WIDTH_APPROX = 0.012 # Légèrement réduit pour améliorer l'alignement
    
    # Couleur fixe pour TI 3M
    COLOR_TI_3M = CL_TURQUOISE 
    # Couleur fixe pour TI 12M
    COLOR_TI_12M = CL_RED 
    
    
    for idx, row in gdf.iterrows():
        lon = row['longitude']
        lat = row['latitude']
        city_label = row['label'] 
        
        # --- LOGIQUE D'OFFSET SPÉCIFIQUE ---
        if city_label in CUSTOM_LABEL_OFFSETS:
            x_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['x']
            y_offset_city = CUSTOM_LABEL_OFFSETS[city_label]['y']
        else:
            x_offset_city = DEFAULT_X_OFFSET
            y_offset_city = DEFAULT_Y_OFFSET
        
        # Si l'offset Y est négatif (ex: Toulon), l'étiquette doit se développer vers le haut
        if y_offset_city < 0:
            va_align_lines = 'bottom'
        else:
            va_align_lines = 'top'
        # ---------------------------------------------

        # Données du texte
        ville = row['ville_str']
        prix = row['prix_str']
        
        ti_3m_val = row["TAUX_INFL_3M"]
        ti_12m_val = row["TAUX_INFL_12M"]
        
        # Ancre de départ pour l'étiquette
        anchor_x = lon + x_offset_city
        anchor_y = lat + y_offset_city
        
        ha_align = 'right' if x_offset_city < 0 else 'left'
        
        # 1. Dessiner le Nom de la Ville (Ligne 1, en gras)
        ax.text(
            anchor_x, 
            anchor_y, 
            ville, 
            fontsize=FONT_SIZE, 
            ha=ha_align, 
            va=va_align_lines,
            color=CL_BLACK,
            weight='bold', 
            zorder=4 
        )
        
        # 2. Dessiner le Prix M2 (Ligne 2, en normal)
        # Ajustement vertical en fonction de l'alignement
        if va_align_lines == 'top':
            prix_y = anchor_y + LINE_SPACING # Vers le bas
        else: # 'bottom'
            prix_y = anchor_y - LINE_SPACING # Vers le haut

        ax.text(
            anchor_x, 
            prix_y, 
            prix, 
            fontsize=FONT_SIZE, 
            ha=ha_align, 
            va=va_align_lines,
            color=CL_BLACK,
            weight='normal', 
            zorder=4
        )
        
        # 3. Dessiner la ligne d'évolution (Ligne 3, double couleur)
        if va_align_lines == 'top':
            evolution_y = anchor_y + (2 * LINE_SPACING)
        else: # 'bottom'
            evolution_y = anchor_y - (2 * LINE_SPACING)
            
        ti_3m_str = f"{ti_3m_val:+.1%}".replace('.', ',') if pd.notna(ti_3m_val) else ""
        ti_12m_str = f"{ti_12m_val:+.1%}".replace('.', ',') if pd.notna(ti_12m_val) else ""
        
        
        if ti_3m_str and ti_12m_str:
            
            part0_open = "("
            part1_3m = ti_3m_str
            part2_sep = " / "
            part3_12m = ti_12m_str
            part4_close = ")"
            
            # --- TRACÉ HORIZONTAL SÉPARÉ (Approximation) ---
            if ha_align == 'left':
                current_x = anchor_x
                
                # Draw (
                ax.text(current_x, evolution_y, part0_open, fontsize=FONT_SIZE_EVOL, ha='left', va=va_align_lines, color=CL_BLACK, weight='bold', zorder=4)
                current_x += 0.5 * CHAR_WIDTH_APPROX 
                
                # Draw TI_3M (Couleur fixe: Turquoise)
                ax.text(current_x, evolution_y, part1_3m, fontsize=FONT_SIZE_EVOL, ha='left', va=va_align_lines, color=COLOR_TI_3M, weight='bold', zorder=4)
                current_x += len(part1_3m) * CHAR_WIDTH_APPROX
                
                # Draw / (Noir)
                ax.text(current_x, evolution_y, part2_sep, fontsize=FONT_SIZE_EVOL, ha='left', va=va_align_lines, color=CL_BLACK, weight='bold', zorder=4)
                current_x += len(part2_sep) * CHAR_WIDTH_APPROX
                
                # Draw TI_12M (Couleur fixe: Rouge)
                ax.text(current_x, evolution_y, part3_12m, fontsize=FONT_SIZE_EVOL, ha='left', va=va_align_lines, color=COLOR_TI_12M, weight='bold', zorder=4)
                current_x += len(part3_12m) * CHAR_WIDTH_APPROX
                
                # Draw )
                ax.text(current_x, evolution_y, part4_close, fontsize=FONT_SIZE_EVOL, ha='left', va=va_align_lines, color=CL_BLACK, weight='bold', zorder=4)
                
            elif ha_align == 'right':
                current_x = anchor_x
                
                # Draw ) (Right-aligned)
                ax.text(current_x, evolution_y, part4_close, fontsize=FONT_SIZE_EVOL, ha='right', va=va_align_lines, color=CL_BLACK, weight='bold', zorder=4)
                current_x -= 0.5 * CHAR_WIDTH_APPROX 
                
                # Draw TI_12M (Couleur fixe: Rouge)
                ax.text(current_x, evolution_y, part3_12m, fontsize=FONT_SIZE_EVOL, ha='right', va=va_align_lines, color=COLOR_TI_12M, weight='bold', zorder=4)
                current_x -= len(part3_12m) * CHAR_WIDTH_APPROX
                
                # Draw / (Noir)
                ax.text(current_x, evolution_y, part2_sep, fontsize=FONT_SIZE_EVOL, ha='right', va=va_align_lines, color=CL_BLACK, weight='bold', zorder=4)
                current_x -= len(part2_sep) * CHAR_WIDTH_APPROX
                
                # Draw TI_3M (Couleur fixe: Turquoise)
                ax.text(current_x, evolution_y, part1_3m, fontsize=FONT_SIZE_EVOL, ha='right', va=va_align_lines, color=COLOR_TI_3M, weight='bold', zorder=4)
                current_x -= len(part1_3m) * CHAR_WIDTH_APPROX
                
                # Draw (
                ax.text(current_x, evolution_y, part0_open, fontsize=FONT_SIZE_EVOL, ha='right', va=va_align_lines, color=CL_BLACK, weight='bold', zorder=4)
                
        # Gère le cas où un seul des taux est disponible
        elif ti_3m_str or ti_12m_str:
            if ti_3m_str:
                evolution_text = f"({ti_3m_str})"
                color = COLOR_TI_3M
            else:
                evolution_text = f"({ti_12m_str})"
                color = COLOR_TI_12M
                
            ax.text(anchor_x, evolution_y, evolution_text, fontsize=FONT_SIZE_EVOL, ha=ha_align, va=va_align_lines, color=color, weight='bold', zorder=4)
        
        
        # 4. Ajout du point de ville d'origine (petit cercle noir)
        ax.plot(lon, lat, marker='o', color=CL_BLACK, markersize=5, zorder=4)

    # --- FINALISATION DE L'IMAGE ---
    ax.axis('off') 
    
    # Titre principal (noir sur turquoise)
    title_text = f"LES PRIX DES {type_bien} DANS L'ANCIEN"
    ax.set_title(title_text, fontsize=20, loc='center', pad=20, color=CL_BLACK, ha='center', weight=TITRE_FONT_WEIGHT) 
    
    # Sous-titre et sources (noir sur turquoise)
    subtitle_text = "SUR 1 AN DANS LES PRINCIPALES VILLES"
    fig.text(0.5, 0.94, subtitle_text, ha='center', va='top', fontsize=12, color=CL_BLACK, weight='bold') 

    # Ajout de la source et de la légende
    fig.text(0.05, 0.03, "Source: Crédit Logement, MM 12M", ha='left', va='bottom', fontsize=9, color=CL_BLACK)
    
    fig.text(0.05, 0.1, "LÉGENDE ÉVOLUTION:", ha='left', va='bottom', fontsize=9, color=CL_BLACK, weight='bold')
    fig.text(0.05, 0.08, "Turquoise: Taux d'évolution sur 3 mois", ha='left', va='bottom', fontsize=8, color=COLOR_TI_3M)
    fig.text(0.05, 0.06, "Rouge: Taux d'évolution sur 12 mois", ha='left', va='bottom', fontsize=8, color=COLOR_TI_12M)

    # --- AFFICHAGE SEUL ---
    plt.show() 
    plt.close(fig) 

    print(f"Génération de la carte pour le type de bien : {type_bien} terminée.")
