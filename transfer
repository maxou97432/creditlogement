import time
from pynput.keyboard import Controller  # nécessite : pip install pynput

keyboard = Controller()

print("Appuyez sur Ctrl+C pour arrêter le script.")
print("Démarrage dans 3 secondes...")
time.sleep(3)

try:
    while True:
        keyboard.press(' ')  # Barre d'espace
        keyboard.release(' ')
        print(f"Touche appuyée à {time.strftime('%H:%M:%S')}")
        time.sleep(30)
except KeyboardInterrupt:
    print("\nScript arrêté par l'utilisateur.")
