df_ecm['Delta_INSEE'] = df_ecm['Indice de prix (INSEE) - Base 2020'].diff()
df_ecm['Delta_CL'] = df_ecm['Indice de prix (CL)'].diff()

# 2. Récupérer l'écart (Residual) du trimestre précédent (t-1)
# Note : 'Dif' est (CL - INSEE), l'ECM utilise souvent (Y - aX). 
# Utilisons ton écart déjà calculé, décalé d'un cran.
df_ecm['Ecart_Lag1'] = df_ecm['Dif'].shift(1)

# 3. Nettoyer les NaN créés par diff() et shift()
df_ecm = df_ecm.dropna()

# 4. Définir Y (Variable cible) et X (Explicatives)
# On veut expliquer les variations de l'INSEE par celles du CL + le rappel à l'ordre
Y = df_ecm['Delta_INSEE']
X = df_ecm[['Delta_CL', 'Ecart_Lag1']]
X = sm.add_constant(X) # Ajouter une constante

# 5. Lancer la régression
model = sm.OLS(Y, X).fit()

print(model.summary())
