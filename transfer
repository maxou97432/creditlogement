# EAD_FIN est négatif quasi partout (cf. diagnostics). Pondérer une LGD par un encours
# de FIN négatif n'est pas la default-weighted LGD attendue, même si le résultat reste borné.
df_obligor.select(
    (pl.col("_den") <  0).sum().alias("obligors_EAD_negatif"),
    (pl.col("_den") == 0).sum().alias("obligors_EAD_nul_exclus"),
    (pl.col("_den") >  0).sum().alias("obligors_EAD_positif"),
).collect()
