# ============================================================
#  FOREST PLOT — moyennes LGD par classe
#  4 classes par figure, distinction fusionnées / originales
#  Requiert : class_stats_base, groups_state, df_base
# ============================================================

import numpy as np
import polars as pl
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches

# ================================================================
#  PREPARATION DES DONNEES
# ================================================================

# Mapping CHR_model_orig -> classe_finale
mapping_rows = []
for label, grp in groups_state.items():
    for membre in grp["members"]:
        mapping_rows.append({
            "CHR_model"     : int(membre),
            "classe_finale" : label,
            "n_membres"     : len(grp["members"]),
        })
mapping_df = pl.DataFrame(mapping_rows)

# Stats par classe originale avec info fusion
stats_plot = (
    class_stats_base
    .join(mapping_df, on="CHR_model", how="left")
    .with_columns([
        (pl.col("n_membres") > 1).alias("est_fusionne"),
        # IC95% : mean ± 1.96 * std / sqrt(n)
        (pl.col("mean_lgd") - 1.96 * (pl.col("var_lgd").sqrt() / pl.col("n").sqrt()))
        .alias("ic_low"),
        (pl.col("mean_lgd") + 1.96 * (pl.col("var_lgd").sqrt() / pl.col("n").sqrt()))
        .alias("ic_high"),
    ])
    .sort("mean_lgd")
)

classes_plot  = stats_plot["CHR_model"].to_list()
means_plot    = stats_plot["mean_lgd"].to_list()
ic_low_plot   = stats_plot["ic_low"].to_list()
ic_high_plot  = stats_plot["ic_high"].to_list()
fusionne_plot = stats_plot["est_fusionne"].to_list()
n_plot        = stats_plot["n"].to_list()
cls_finale    = stats_plot["classe_finale"].to_list()

N_CLASSES   = len(classes_plot)
PAR_PAGE    = 4
N_PAGES     = int(np.ceil(N_CLASSES / PAR_PAGE))

print(f"{N_CLASSES} classes | {N_PAGES} pages de {PAR_PAGE} classes\n")

# ================================================================
#  FOREST PLOTS
# ================================================================

for page in range(N_PAGES):
    debut = page * PAR_PAGE
    fin   = min(debut + PAR_PAGE, N_CLASSES)
    batch = list(range(debut, fin))
    n_plots = len(batch)

    fig, axes = plt.subplots(
        1, n_plots,
        figsize=(4.5 * n_plots, 5),
        sharey=False,
    )
    if n_plots == 1:
        axes = [axes]

    fig.suptitle(
        f"Forest plot — LGD par classe  |  page {page+1}/{N_PAGES}",
        fontsize=11, fontweight="bold"
    )

    for col, idx in enumerate(batch):
        ax  = axes[col]
        cls = classes_plot[idx]
        mu  = means_plot[idx]
        lo  = ic_low_plot[idx]
        hi  = ic_high_plot[idx]
        fus = fusionne_plot[idx]
        n   = n_plot[idx]
        cf  = cls_finale[idx]

        couleur = "#E05A2B" if fus else "#2B7BB9"   # orange=fusionné, bleu=intact

        # Point estimate
        ax.scatter(0, mu, s=80, color=couleur, zorder=5)

        # IC95% — barre verticale
        ax.plot([0, 0], [lo, hi], color=couleur, lw=2.5, zorder=4)

        # Caps horizontaux
        cap_w = 0.06
        ax.plot([-cap_w, cap_w], [lo, lo], color=couleur, lw=1.5)
        ax.plot([-cap_w, cap_w], [hi, hi], color=couleur, lw=1.5)

        # Ligne de référence verticale (moyenne globale)
        grand_mean = float(
            (np.array(means_plot) * np.array(n_plot)).sum() /
            np.sum(n_plot)
        )
        ax.axhline(grand_mean, color="gray", linestyle="--",
                   lw=0.8, alpha=0.6, label="moy. globale")

        # Annotations
        ax.set_title(
            f"CHR {cls}\n{'🔴 fusionné' if fus else '🔵 intact'}",
            fontsize=9, pad=4
        )
        ax.set_ylabel("LGD (%)" if col == 0 else "")
        ax.set_xticks([])
        ax.set_xlim(-0.3, 0.3)

        # Texte : moyenne + IC + n
        ax.text(
            0.97, 0.97,
            f"μ = {mu:.2f}\nIC = [{lo:.2f}, {hi:.2f}]\nn = {n:,}",
            transform=ax.transAxes,
            ha="right", va="top", fontsize=7.5,
            bbox=dict(boxstyle="round,pad=0.3", fc="white",
                      ec=couleur, alpha=0.85)
        )

        # Classe finale (si fusionné)
        if fus:
            membres = cf.replace("|", ", ")
            ax.text(
                0.03, 0.03,
                f"Groupe:\n{membres[:30]}{'…' if len(membres)>30 else ''}",
                transform=ax.transAxes,
                ha="left", va="bottom", fontsize=6.5,
                color="#E05A2B",
                bbox=dict(boxstyle="round,pad=0.2", fc="white",
                          ec="#E05A2B", alpha=0.7)
            )

    # Legende commune
    patch_fus   = mpatches.Patch(color="#E05A2B", label="Classe fusionnée")
    patch_intact= mpatches.Patch(color="#2B7BB9", label="Classe intacte")
    fig.legend(
        handles=[patch_intact, patch_fus],
        loc="lower center", ncol=2,
        fontsize=8, framealpha=0.9,
        bbox_to_anchor=(0.5, -0.02)
    )

    plt.tight_layout(rect=[0, 0.05, 1, 1])
    plt.show()
    print(f"  — page {page+1}/{N_PAGES} —\n")
