def load_and_prep_insee():
    """Charge les fichiers CSV INSEE et crée une base consolidée."""
    print("\n--- Chargement des données INSEE ---")
    
    perimetre_insee = ['92', '93', '94', '95', '91', '75', '78', '77', 
                       "MARSEILLE", "LYON", "LILLE", 'NORD-PAS-DE-CALAIS', 
                       'PACA', 'RHONE-ALPES', 'PROVINCE', 'AUVERGNE', 'IDF']
    types_biens = ['APT', 'MAI']
    
    dfs = []
    
    for perimetre in perimetre_insee:
        for tb in types_biens:
            try:
                path = os.path.join(PATH_INSEE_FOLDER, f"valeurs_trimestrielles_{perimetre}_{tb}.csv")
                if not os.path.exists(path): continue
                
                # Lecture brute avec skip headers
                temp = pd.read_csv(path, sep=';', header=3) 
                # Le fichier INSEE commence souvent ligne 4 (index 3) après le header inutile
                
                # Identification colonne indice (souvent la 2ème colonne)
                col_val = temp.columns[1] 
                temp = temp.rename(columns={col_val: "Indice INSEE"})
                temp["Indice INSEE"] = pd.to_numeric(temp["Indice INSEE"], errors='coerce')
                
                # Parsing Date (Format attendu: "2024-T1")
                temp["Libellé"] = temp["Libellé"].astype(str)
                temp['Year'] = temp["Libellé"].apply(lambda x: x.split('-')[0] if '-' in x else np.nan)
                temp['Quarter'] = temp["Libellé"].apply(lambda x: x.split('T')[-1] if 'T' in x else np.nan)
                
                temp = temp.dropna(subset=['Year', 'Quarter'])
                temp["Periode"] = pd.PeriodIndex(temp['Year'] + 'Q' + temp['Quarter'], freq='Q').to_timestamp()
                
                temp["Ville"] = perimetre
                # Mapping noms INSEE -> Noms CL
                temp["Ville"] = temp["Ville"].replace({
                    "RHONE-ALPES": "RHÔNE-ALPES",
                    "PACA": "PROVENCE-ALPES-CÔTE D'AZUR",
                    "IDF": "ÎLE-DE-FRANCE"
                })
                # On ne garde que les colonnes utiles
                dfs.append(temp[["Ville", "Periode", "Indice INSEE"]])
                
            except Exception as e:
                # print(f"  Info: Échec lecture {perimetre} {tb}")
                pass
    
    if not dfs:
        return None
    
    insee_final = pd.concat(dfs, ignore_index=True)
    
    # Agrégation par Ville/Période (Moyenne APT/MAI si les deux existent pour simplifier la comparaison globale)
    insee_final = insee_final.groupby(["Ville", "Periode"])["Indice INSEE"].mean().reset_index()
    
    # Conversion en Base 2020
    mask_2020 = insee_final["Periode"].dt.year == 2020
    pivots = insee_final[mask_2020].groupby("Ville")["Indice INSEE"].mean()
    
    insee_final["Indice INSEE (Base 2020)"] = (
        insee_final["Indice INSEE"] / insee_final["Ville"].map(pivots) * 100
    ).round(2)
    
    return insee_final

# =============================================================================
# 4. FONCTION DE CALCUL STATISTIQUE
# =============================================================================

def calculate_comparison_stats(df_merged, col_model, col_ref, label_ref="Ref"):
    """Calcule RMSE et Corrélation sur données appariées."""
    clean = df_merged.dropna(subset=[col_model, col_ref])
    
    if clean.empty:
        return pd.Series({'RMSE': np.nan, 'Correlation': np.nan})
    
    diff = clean[col_model] - clean[col_ref]
    rmse = np.sqrt(np.mean(diff**2))
    corr = clean[col_model].corr(clean[col_ref])
    
    return pd.Series({f'RMSE_{label_ref}': rmse, f'Corr_{label_ref}': corr})

