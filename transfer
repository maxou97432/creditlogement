from scipy import stats
from statsmodels.stats.diagnostic import acorr_ljungbox, het_arch
import pandas as pd
import numpy as np
import warnings
warnings.filterwarnings("ignore")

resultats_hyp = []

for (zone, type_bien), group in merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]):
    serie = group.sort_values("Periode")["Dif"].dropna()
    n = len(serie)
    
    if n < 12:
        continue  # Série trop courte

    row = {"Zone": zone, "Type": type_bien, "N": n}

    # ── 1. Stationnarité – ADF ─────────────────────────────────────────
    from statsmodels.tsa.stattools import adfuller
    adf_p = adfuller(serie)[1]
    row["ADF_p"] = round(adf_p, 4)
    row["Stationnaire"] = adf_p < 0.05

    # ── 2. Normalité – Shapiro-Wilk ────────────────────────────────────
    sample = serie.values if n <= 5000 else serie.values[-200:]
    _, p_shapiro = stats.shapiro(sample)
    row["Shapiro_p"] = round(p_shapiro, 4)
    row["Normale"] = p_shapiro >= 0.05

    # ── 3. Homoscédasticité – ARCH-LM ──────────────────────────────────
    try:
        _, p_arch, _, _ = het_arch(serie.values, nlags=4)
        row["ARCH_p"] = round(p_arch, 4)
        row["Homoscédastique"] = p_arch >= 0.05
    except Exception:
        row["ARCH_p"] = np.nan
        row["Homoscédastique"] = np.nan

    # ── 4. Autocorrélation – Ljung-Box (lags 4 et 8) ───────────────────
    try:
        lb = acorr_ljungbox(serie, lags=[4, 8], return_df=True)
        p_lb4 = round(lb["lb_pvalue"].iloc[0], 4)
        p_lb8 = round(lb["lb_pvalue"].iloc[1], 4)
        row["LB_lag4_p"] = p_lb4
        row["LB_lag8_p"] = p_lb8
        row["Pas_autocorr"] = (p_lb4 >= 0.05) and (p_lb8 >= 0.05)
    except Exception:
        row["LB_lag4_p"] = np.nan
        row["LB_lag8_p"] = np.nan
        row["Pas_autocorr"] = np.nan

    resultats_hyp.append(row)

df_hyp = pd.DataFrame(resultats_hyp)

# ── Synthèse globale ────────────────────────────────────────────────────
print("=" * 65)
print("VÉRIFICATION DES HYPOTHÈSES SÉRIES TEMPORELLES (par segment)")
print("=" * 65)
print(f"Segments analysés : {len(df_hyp)}\n")

for col, label in [
    ("Stationnaire",    "1. Stationnarité     (ADF p<0.05)"),
    ("Normale",         "2. Normalité          (Shapiro p≥0.05)"),
    ("Homoscédastique", "3. Homoscédasticité   (ARCH p≥0.05)"),
    ("Pas_autocorr",    "4. Pas autocorrélation(Ljung-Box p≥0.05)"),
]:
    pct = df_hyp[col].mean() * 100
    print(f"  {label} : {pct:.0f}% ✅")

