# Les lignes normales (floor appliqué correctement)
normales = base.filter(
    pl.col("NB_DURATION_IRBA").round(3) == pl.col("NB_MATURITE_IRBA").clip(1.0, 5.0).round(3)
)

# Parmi les normales, combien ont les mêmes caractéristiques que les anomalies ?
normales_meme_profil = normales.filter(
    (pl.col("Flag_Revolving") == 0.0) &
    (pl.col("IND_CREDIT_CONFIRME") == 0.0) &
    (pl.col("NB_MATURITE_IRBA") < 1.0)
)

print(f"Lignes normales totales                          : {normales.height}")
print(f"Lignes normales avec même profil (FlagRev=0, ICC=0, Mat<1) : {normales_meme_profil.height}")
print(f"% des normales avec ce profil                    : {normales_meme_profil.height/normales.height*100:.1f}%")
