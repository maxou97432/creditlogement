# =====================================================================
# PROPAGATION DES FUSIONS DANS df_base
# =====================================================================

# 1. Construire le mapping : ancienne classe -> nouvelle classe fusionnée
mapping_fusion = {}
for h in history:
    # A chaque fusion, la new_class remplace class_a et class_b
    # mais il faut suivre la chaine : si class_a était déjà une fusion,
    # son label a déjà changé dans reduced_lf
    mapping_fusion[h["class_a"]] = h["new_class"]
    mapping_fusion[h["class_b"]] = h["new_class"]

# 2. Fonction pour résoudre la chaine de fusions
# (ex: 18->18_19->18_19_20 : il faut pointer vers la classe finale)
def resolve_final(cls, mapping):
    visited = set()
    while cls in mapping and cls not in visited:
        visited.add(cls)
        cls = mapping[cls]
    return cls

mapping_final_resolved = {
    cls: resolve_final(cls, mapping_fusion)
    for cls in mapping_fusion
}

# 3. Appliquer le mapping sur df_base via un join
mapping_df = pl.DataFrame({
    CLASS_COL:          list(mapping_final_resolved.keys()),
    "CHR_apres_fusion": list(mapping_final_resolved.values()),
})

# Ajouter les classes qui n'ont pas fusionné (elles gardent leur label)
classes_initiales = df_base.select(CLASS_COL).unique()
classes_non_fusionnees = (
    classes_initiales
    .filter(~pl.col(CLASS_COL).is_in(mapping_df[CLASS_COL]))
    .with_columns(pl.col(CLASS_COL).alias("CHR_apres_fusion"))
)

mapping_complet = pl.concat([mapping_df, classes_non_fusionnees])

# 4. Joindre sur df_base
df_base = df_base.join(mapping_complet, on=CLASS_COL, how="left")

print(f"Classes avant fusion : {df_base[CLASS_COL].n_unique()}")
print(f"Classes après fusion : {df_base['CHR_apres_fusion'].n_unique()}")
print("\nAperçu du mapping :")
print(mapping_complet.sort(CLASS_COL).head(20))
