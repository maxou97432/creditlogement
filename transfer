# -- ARI moyen pairwise par seuil --------------------------------------
    from sklearn.metrics import adjusted_rand_score

    n_initial = len(classes)
    resultats = []
    for s in seuils:
        labs = mappings[s]
        n_rep = len(labs)
        aris = []
        for i in range(n_rep):
            for j in range(i + 1, n_rep):
                aris.append(adjusted_rand_score(labs[i], labs[j]))
        n_classes_rep = [len(np.unique(l)) for l in labs]
        n_cl_med = int(np.median(n_classes_rep))
        # exclusion structurelle des partitions dégénérées :
        # n_classes=1 (tout fusionné) et n_classes=n_initial (rien fusionné)
        # rendent l'ARI mathématiquement non-informatif (sature à 1.0 par
        # construction). Ce n'est pas un hyperparamètre mais une borne du
        # domaine de validité de l'ARI.
        valide = bool(1 < n_cl_med < n_initial)
        resultats.append({
            "seuil_ovl": float(s),
            "ari_moyen": float(np.mean(aris)) if aris else 1.0,
            "ari_std": float(np.std(aris)) if aris else 0.0,
            "n_classes_median": n_cl_med,
            "valide": valide,
        })

    return pl.DataFrame(resultats).sort("seuil_ovl")
