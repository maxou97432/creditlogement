        m = Prophet(yearly_seasonality=True, weekly_seasonality=False, daily_seasonality=False, **params)
        m.fit(df_prophet)
        
        future = m.make_future_dataframe(periods=n_test, freq='Q')
        forecast = m.predict(future)
        pred_values = forecast['yhat'].iloc[-n_test:].values
        
        rmse = np.sqrt(mean_squared_error(test, pred_values))
        
        if rmse < best_rmse:
