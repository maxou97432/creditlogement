import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
import numpy as np
from scipy.stats import gaussian_kde

def plot_adjacent_pairs(df, class_col="CHR_model", target_col="lgd_obligor", 
                        pairs_per_page=4):
    """
    Affiche les distributions KDE de chaque paire adjacente.
    Navigation par page (pairs_per_page paires par figure).
    """
    # Classes triees par LGD moyenne croissante
    stats = (
        df.group_by(class_col)
        .agg([
            pl.col(target_col).mean().alias("mean_lgd"),
            pl.col(target_col).count().alias("n"),
        ])
        .sort("mean_lgd")
    )
    classes   = stats[class_col].to_list()
    means_map = dict(zip(stats[class_col].to_list(), stats["mean_lgd"].to_list()))
    ns_map    = dict(zip(stats[class_col].to_list(), stats["n"].to_list()))
    
    pairs = [(classes[i], classes[i+1]) for i in range(len(classes)-1)]
    n_pages = int(np.ceil(len(pairs) / pairs_per_page))

    for page in range(n_pages):
        batch = pairs[page * pairs_per_page : (page+1) * pairs_per_page]
        n_plots = len(batch)

        fig, axes = plt.subplots(n_plots, 2, figsize=(14, 3.5 * n_plots))
        if n_plots == 1:
            axes = [axes]  # normalise en liste de lignes

        fig.suptitle(
            f"Distributions paires adjacentes — page {page+1}/{n_pages}",
            fontsize=13, fontweight="bold", y=1.01
        )

        for row, (ca, cb) in enumerate(batch):
            ax_kde  = axes[row][0]
            ax_cdf  = axes[row][1]

            a = df.filter(pl.col(class_col) == ca)[target_col].to_numpy()
            b = df.filter(pl.col(class_col) == cb)[target_col].to_numpy()

            # Calcul W1 et eta pour annotation
            w1  = float(wasserstein_distance(a, b))
            eta = _overlap_eta(a, b)

            # Grille commune
            lo  = min(a.min(), b.min())
            hi  = max(a.max(), b.max())
            pad = 0.05 * (hi - lo) if hi > lo else 1.0
            grid = np.linspace(lo - pad, hi + pad, 512)

            # KDE
            kde_a = gaussian_kde(a)
            kde_b = gaussian_kde(b)
            fa    = kde_a(grid)
            fb    = kde_b(grid)

            # --- Panneau gauche : KDE + zone de recouvrement ---
            ax_kde.fill_between(grid, np.minimum(fa, fb),
                                alpha=0.35, color="purple", label=f"overlap η={eta:.3f}")
            ax_kde.plot(grid, fa, color="steelblue",  lw=1.8,
                        label=f"{ca}  μ={means_map[ca]:.2f}  n={ns_map[ca]:,}")
            ax_kde.plot(grid, fb, color="darkorange",  lw=1.8,
                        label=f"{cb}  μ={means_map[cb]:.2f}  n={ns_map[cb]:,}")
            ax_kde.axvline(means_map[ca], color="steelblue",  lw=1, linestyle="--", alpha=0.7)
            ax_kde.axvline(means_map[cb], color="darkorange",  lw=1, linestyle="--", alpha=0.7)
            ax_kde.set_title(f"{ca}  vs  {cb} — KDE", fontsize=10)
            ax_kde.set_xlabel("lgd_obligor")
            ax_kde.set_ylabel("densité")
            ax_kde.legend(fontsize=8)

            # Annotation W1 + eta
            ax_kde.text(0.97, 0.95,
                        f"W₁ = {w1:.4f}\nη  = {eta:.4f}\ngap = {abs(means_map[cb]-means_map[ca]):.4f}",
                        transform=ax_kde.transAxes,
                        ha="right", va="top", fontsize=8,
                        bbox=dict(boxstyle="round,pad=0.3", fc="white", ec="gray", alpha=0.8))

            # --- Panneau droit : CDF empiriques ---
            a_sorted = np.sort(a)
            b_sorted = np.sort(b)
            cdf_a    = np.arange(1, len(a)+1) / len(a)
            cdf_b    = np.arange(1, len(b)+1) / len(b)

            ax_cdf.plot(a_sorted, cdf_a, color="steelblue",  lw=1.5, label=str(ca))
            ax_cdf.plot(b_sorted, cdf_b, color="darkorange",  lw=1.5, label=str(cb))

            # Zone W1 = aire entre les deux CDF (ombrage vertical)
            # On interpole sur grille commune pour l'ombrage
            cdf_a_interp = np.interp(grid, a_sorted, cdf_a, left=0, right=1)
            cdf_b_interp = np.interp(grid, b_sorted, cdf_b, left=0, right=1)
            ax_cdf.fill_betweenx(
                np.linspace(0, 1, len(grid)),
                np.interp(np.linspace(0, 1, len(grid)), cdf_a_interp, grid),
                np.interp(np.linspace(0, 1, len(grid)), cdf_b_interp, grid),
                alpha=0.15, color="purple", label=f"aire = W₁"
            )
            ax_cdf.set_title(f"{ca}  vs  {cb} — CDF empirique", fontsize=10)
            ax_cdf.set_xlabel("lgd_obligor")
            ax_cdf.set_ylabel("F(x)")
            ax_cdf.legend(fontsize=8)

        plt.tight_layout()
        plt.show()
        print(f"  — page {page+1}/{n_pages} —\n")


