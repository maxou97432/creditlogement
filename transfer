print("▶ VÉRIFICATION DE LA TROUVAILLE : Type d'amortissement vs Formule Résiduelle\n")

# Variable d'arrêté
DT_ARRT = 23922 

# 1. Calcul de la Maturité Résiduelle Théorique en années
srs_test = srs_fusion.with_columns(
    ((pl.col('DT_ECHEANCE_FEM') - DT_ARRT) / 365.25).alias('Test_Maturite_Residuelle')
)

# 2. Séparation de la base en deux silos distincts
groupe_autres   = srs_test.filter(~pl.col('CD_TYPE_AMORT').is_in(['1', '3']))
groupe_standard = srs_test.filter( pl.col('CD_TYPE_AMORT').is_in(['1', '3']))

# 3. Comptage des lignes qui matchent strictement la Résiduelle
match_autres   = groupe_autres.filter((pl.col('Test_Maturite_Residuelle') - pl.col('NB_MATURITE_IRBA')).abs() <= 0.05).height
match_standard = groupe_standard.filter((pl.col('Test_Maturite_Residuelle') - pl.col('NB_MATURITE_IRBA')).abs() <= 0.05).height

# VERDICT
if groupe_autres.height > 0:
    print(f"🔹 Pour les types AUTRES ou VIDES, sur {groupe_autres.height} contrats :")
    print(f"  └─> {match_autres} utilisent PUREMENT la Maturité Résiduelle (Taux : {(match_autres/groupe_autres.height)*100:.1f}%)")

