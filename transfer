# Relancer la décomposition saisonnière par segment (cell 22)
# en séparant APT et MAI
from statsmodels.tsa.seasonal import seasonal_decompose

for (zone, type_bien), group in merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]):
    ts = group.sort_values("Periode").set_index("Periode")["Dif"].dropna()
    ts.index = pd.PeriodIndex(ts.index, freq="Q")
    if len(ts) < 12:
        continue
    try:
        res = seasonal_decompose(ts, model="additive", period=4)
        amp_saison  = res.seasonal.max() - res.seasonal.min()
        amp_tendance = res.trend.dropna().max() - res.trend.dropna().min()
        ratio = amp_saison / amp_tendance if amp_tendance > 0 else 0
        if ratio > 0.2:
            print(f"[SAISONNALITÉ] {zone} - {type_bien} : ratio={ratio:.2f}")
    except Exception:
        pass
