def format_summary_table(summary: pl.DataFrame):
    """
    Convertit la table de synthèse (petite : ~n_segments+1 lignes) en pandas
    et applique la coloration conditionnelle.
    """
    pdf = summary.to_pandas()
    score_cols = [c for c in pdf.columns if c.startswith("Somer's D")]
    pct_cols = ["LGD estimée moy.", "LGD observée moy.", "Écart (est. - obs.)"]

    def _bold_global_row(row):
        if row["Segment"] == GLOBAL_LABEL:
            return ["font-weight: bold; border-top: 2px solid #333333;"] * len(row)
        return [""] * len(row)

    return (
        pdf.style
        .apply(_bold_global_row, axis=1)
        .map(_color_somers_d, subset=score_cols)
        .format({c: "{:.2%}" for c in score_cols}, na_rep="n/a")
        .format({c: "{:.2f}" for c in pct_cols}, na_rep="n/a")
        .format({"N": "{:,.0f}"})
        .hide(axis="index")
        .set_caption("Tableau 42 — Capacité de discrimination du modèle (Somer's D)")
        .set_properties(**{"color": "#111111", "background-color": "#FFFFFF"})
        .set_table_styles([
            {"selector": "caption",
             "props": [("font-size", "13px"), ("font-weight", "bold"),
                       ("text-align", "left"), ("padding-bottom", "8px"),
                       ("color", "#111111")]},
            {"selector": "th",
             "props": [("background-color", "#F2F2F2"), ("color", "#111111"),
                       ("text-align", "center"), ("border", "1px solid #CCCCCC")]},
            {"selector": "td",
             "props": [("border", "1px solid #CCCCCC")]},
        ])
    )
