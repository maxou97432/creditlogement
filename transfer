cs = cmp_doc.consensus_avec_solve(label_style="glouton")

for row in cs.iter_rows(named=True):
    if row["n_classes_finales"] is not None and row["n_classes_finales"] < row["n_initial"]:
        compo = eval(row["composition"])  # str -> dict
        fusions = {k: v for k, v in compo.items() if len(v) > 1}
        print(f"\n[{row['test']}] {row['n_initial']} → {row['n_classes_finales']} classes")
        for label, composantes in fusions.items():
            print(f"  {' + '.join(composantes)} → {label}")
