diag_obligor = (
    lf_LGD
    .group_by([config['Obligor'], config['Date_defaut']])
    .agg(
        (pl.col('LGD') * pl.col(config['EAD'])).sum().alias("num"),
        pl.col(config['EAD']).sum().alias("denom_ead"),
        pl.len().alias("nb_facilites"),
        pl.col(config['EAD']).min().alias("ead_min"),
        pl.col(config['EAD']).max().alias("ead_max"),
        pl.col('LGD').min().alias("lgd_min"),
        pl.col('LGD').max().alias("lgd_max"),
    )
    .with_columns((pl.col("num") / pl.col("denom_ead")).alias("lgd_obligor"))
    .collect()
)

# Tri par LGD obligor décroissant pour voir les pires cas
diag_obligor.sort("lgd_obligor", descending=True).head(20)

# Combien d'obligors dans chaque pathologie ?
diag_obligor.select(
    (pl.col("denom_ead") <= 0).sum().alias("ead_negatif_ou_nul"),
    ((pl.col("denom_ead") > 0) & (pl.col("denom_ead") < 1)).sum().alias("ead_quasi_nul"),
    (pl.col("ead_min") < 0).sum().alias("a_une_facilite_ead_negatif"),
    (pl.col("lgd_max") > 1).sum().alias("a_une_LGD_brute_sup_1"),
    (pl.col("lgd_min") < 0).sum().alias("a_une_LGD_brute_negative"),
    (pl.col("lgd_obligor") > 1).sum().alias("lgd_obligor_sup_1_total"),
)

# Liste des obligors avec LGD aberrante
obligors_ko = (
    diag_obligor
    .filter(pl.col("lgd_obligor") > 1)
    .select([config['Obligor'], config['Date_defaut']])
)

# Toutes les facilités brutes de ces obligors
detail_ko = (
    lf_LGD
    .join(obligors_ko.lazy(), on=[config['Obligor'], config['Date_defaut']], how="inner")
    .select([
        config['Obligor'], config['Date_defaut'],
        'LGD', config['EAD'],
    ])
    .sort([config['Obligor'], config['Date_defaut']])
    .collect()
)
detail_ko
