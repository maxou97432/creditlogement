from scipy import stats

def test_t_significatif(group):
    # Teste si la moyenne de l'écart (Dif) est significativement différente de 0
    # On utilise le test t pour un échantillon (one-sample t-test)
    # Règle générale : p-value < 0.05 signifie que l'écart est significatif
    
    # stats.ttest_1samp renvoie la statistique t et la p-value
    t_stat, p_value = stats.ttest_1samp(group['Dif'].dropna(), popmean=0)
    
    # On retourne la p-value et la conclusion
    return pd.Series({
        't_statistic': t_stat,
        'p_value': p_value,
        'Significatif (p<0.05)': p_value < 0.05
    })

# Appliquer le test t par groupe
test_t_results = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]).apply(test_t_significatif).reset_index()

from statsmodels.tsa.stattools import adfuller

def test_adf_stationnarite(group):
    # Le test ADF est sensible aux NaN, donc on doit les retirer
    ecart_series = group['Dif'].dropna()
    
    # Nécessite un minimum de données (souvent 10-20 observations)
    if len(ecart_series) < 20: 
        return pd.Series({'Stationnaire (ADF)': np.nan})

    # Effectuer le test ADF
    adf_result = adfuller(ecart_series)
    p_value = adf_result[1]
    
    # Si p-value < 0.05, on rejette H0, donc l'écart est stationnaire
    return pd.Series({
        'Stationnaire (ADF)': p_value < 0.05
    })

# Appliquer le test ADF par groupe
adf_results = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]).apply(test_adf_stationnarite).reset_index()
