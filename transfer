# 1. On inverse la formule pour trouver la date de maturité exacte en jours SAS
reverse_eng = srs_X_capret.with_columns(
    (pl.lit(23922) + pl.col('NB_MATURITE_IRBA') * 365.25).alias('Expected_Duration_Date_Jours')
)

# 2. On la compare à TOUTES les colonnes numériques entières (format SAS) ou format YYYYMMDD
print("Recherche de la colonne 'Duration Date' par reverse-engineering :")

for col in srs_X_capret.columns:
    if srs_X_capret[col].dtype in [pl.Int64, pl.Int32, pl.Float64, pl.Float32]:
        
        # Test 1 : Format SAS jours (ex: 24500)
        matches_sas = reverse_eng.filter(
            (pl.col(col) - pl.col('Expected_Duration_Date_Jours')).abs() <= 1.0 # Tolérance de 1 jour d'arrondi
        ).height
        
        # Test 2 : Format YYYYMMDD (convertir notre date attendue en format int YYYYMMDD)
        # (Seulement si la colonne ressemble à un YYYYMMDD > 20000000)
        matches_yyyymmdd = 0
        if reverse_eng[col].drop_nulls().max() is not None and reverse_eng[col].drop_nulls().max() > 20000000:
            test_fmt = reverse_eng.with_columns(
                (pl.lit(date(1960,1,1)) + pl.duration(days=pl.col('Expected_Duration_Date_Jours').cast(pl.Int64)))
                .dt.strftime('%Y%m%d').cast(pl.Int64).alias('Expected_YYYYMMDD')
            )
            matches_yyyymmdd = test_fmt.filter(pl.col(col) == pl.col('Expected_YYYYMMDD')).height
        
        # Affichage si un pattern est trouvé
        if matches_sas > 0 or matches_yyyymmdd > 0:
            print(f"-> {col} : Match Format SAS = {matches_sas} lignes | Match Format YYYYMMDD = {matches_yyyymmdd} lignes")

print("\nTerminé.")
