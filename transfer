# On exclut les identifiants, les dates et les montants
cols_a_ignorer = ["R", "NB_MATURITE_IRBA", "is_bascule", "pred_prog_5pct", "I_AUTRS_UNIQ", "CD_CONTRAT", "DT_ARRETE"]

# On filtre intelligemment : uniquement les colonnes avec moins de 100 modalités (pour éviter les ID)
cols_a_tester = []
for c in sub_mixte.columns:
    if c not in cols_a_ignorer and sub_mixte[c].dtype in (pl.Utf8, pl.Int64, pl.Int32, pl.Boolean, pl.Categorical):
        # Ne garder que si c'est une vraie catégorie (moins de 100 valeurs uniques)
        if sub_mixte[c].n_unique() < 100:
            cols_a_tester.append(c)

print(f"Variables à tester : {cols_a_tester}\n")

for col in cols_a_tester:
    try:
        tab = (
            sub_mixte
            .group_by(col)
            .agg([
                pl.len().alias("n"),
                pl.col("is_bascule").mean().alias("pct_bascule"),
            ])
            .sort("pct_bascule", descending=True)
        )
        # N'afficher que si ça discrimine (écart > 10% entre le max et le min)
        pcts = tab["pct_bascule"].drop_nulls().to_list()
        if pcts and (max(pcts) - min(pcts) > 0.10):
            print(f"\n--- {col} ---")
            print(tab)
    except Exception as e:
        pass
