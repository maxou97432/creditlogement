print(f"Welch   p>={ALPHA} (non sig. diff.)   : {n_welch_eq}/{n_tot}   p-value max : {diag['welch_p'].max():.2e}")
print(f"Kruskal p>={ALPHA} (non sig. diff.)   : {n_krusk_eq}/{n_tot}   p-value max : {diag['kruskal_p'].max():.2e}")
