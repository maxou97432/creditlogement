mu, sigma = stats["mean"][0], stats["std"][0]

    # garde-fou : donnees insuffisantes -> pas de detection d'outliers
    if mu is None or sigma is None or trimmed_mean is None:
        return False

    # outlier detection
    return (trimmed_mean < mu - 2 * sigma * tailsize) or (
        trimmed_mean > mu + 2 * sigma * tailsize
    )
