        pl.col("datdef_corr").alias("datdef_ap_mdef"),
        pl.col("HLC").alias("categories"),
    ])
    .collect()
    .to_pandas()
)
gens = sorted(dtm_pd["generation"].unique())
print(f"{dtm_pd.shape[0]:,} lignes | HLC={CAT} | {len(gens)} générations {gens}")

# ======================================================================
# 2) Pipeline POLARS (toujours exécuté)
# ======================================================================
res_pl_all, filled_pl_lazy = SR_mod.extrapolate_all_categories_lazy(
