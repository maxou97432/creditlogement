import pandas as pd
import numpy as np
import plotly.graph_objects as go # On passe à graph_objects pour plus de flexibilité (zones grisées)
from statsmodels.tsa.holtwinters import ExponentialSmoothing
import warnings

# Configuration
warnings.filterwarnings("ignore")
n_forecast = 2 # Nombre de trimestres à prédire

grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("Génération des analyses complètes (Correction + Prévision)...")

for name, group in grouped:
    zone, type_bien = name
    group = group.sort_values("Periode").set_index("Periode")
    
    ts_ecart = group['Dif'].dropna()
    last_cl_value = group['Indice de prix (CL)'].iloc[-1]
    
    if len(ts_ecart) > 12:
        try:
            # 1. Modélisation Holt
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                damped_trend=True, 
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # --- PARTIE 1 : CORRECTION DU PASSÉ (Backtest) ---
            ecart_modelise = model_fit.fittedvalues
            # On aligne sur l'index du groupe pour pouvoir soustraire
            ecart_modelise = ecart_modelise.reindex(group.index)
            
            # Calcul de la courbe corrigée historique
            # CL Corrigé = CL Brut - Biais Estimé
            cl_corrected_history = group['Indice de prix (CL)'] - ecart_modelise
            
            # --- PARTIE 2 : PRÉVISION DU FUTUR ---
            forecast_bias = model_fit.forecast(n_forecast)
            
            # Calcul de l'intervalle de confiance (basé sur le sigma des résidus)
            sigma = np.std(model_fit.resid)
            confidence_interval = []
            for step in range(1, n_forecast + 1):
                confidence_interval.append(1.96 * sigma * np.sqrt(step))
            
            # Estimation de l'INSEE futur (CL constant - Biais futur)
            # Note: Idéalement, remplacez last_cl_value par votre propre prévision de l'indice CL si vous l'avez
            pred_values = last_cl_value - forecast_bias
            
            upper_bound = pred_values + confidence_interval
            lower_bound = pred_values - confidence_interval
            
            # Dates futures
            last_date = group.index[-1]
            future_dates = [last_date + pd.DateOffset(months=3*i) for i in range(1, n_forecast+1)]
            
            # --- VISUALISATION (Plotly Graph Objects) ---
            
            fig = go.Figure()

            # 1. Historique INSEE (Référence)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (INSEE) - Base 2020'],
                mode='lines', name='INSEE (Réalité)',
                line=dict(color='black', width=2)
            ))

            # 2. Historique CL Original (Pour montrer la dérive)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (CL)'],
                mode='lines', name='CL (Brut)',
                line=dict(color='red', width=1, dash='dot')
            ))

            # 3. Historique CL Corrigé (Notre modèle)
            fig.add_trace(go.Scatter(
                x=group.index, y=cl_corrected_history,
                mode='lines', name='CL Corrigé (Holt)',
                line=dict(color='blue', width=2)
            ))

            # 4. Prévision Future (Pointillé ou Marqueurs)
            fig.add_trace(go.Scatter(
                x=future_dates, y=pred_values,
                mode='lines+markers', name=f'Prévision T+{n_forecast}',
                line=dict(color='green', width=3)
            ))

            # 5. Zone de Confiance
            fig.add_trace(go.Scatter(
                x=future_dates + future_dates[::-1],
                y=list(upper_bound) + list(lower_bound)[::-1],
                fill='toself',
                fillcolor='rgba(0, 255, 0, 0.2)', # Vert transparent
                line=dict(color='rgba(255,255,255,0)'),
                hoverinfo="skip",
                showlegend=True,
                name='Intervalle de Confiance (95%)'
            ))

            # Mise en page
            fig.update_layout(
                title=f"Correction Dynamique & Prévision : {zone} - {type_bien}",
                yaxis_title="Indice (Base 2020 = 100)",
                template="plotly_white",
                height=600,
                legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1)
            )
            
            # Ligne de séparation Passé/Futur
            fig.add_vline(x=last_date, line_width=1, line_dash="dash", line_color="gray")
            
            fig.show()

        except Exception as e:
            print(f"Erreur sur {name}: {e}")
