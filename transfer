import polars as pl
from typing import Tuple, List, Dict, Optional


def meilleur_candidat_fusion(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Retourne :
        - la paire de classes à fusionner sous la forme [c1, c2],
        - le DataFrame de débogage contenant les scores de chaque paire (ou None si aucune paire).
    Si aucune paire ne respecte les contraintes, renvoie (None, None).
    L'argument `log` active les messages `print` détaillés.

    L'adjacence est cloisonnée PAR SEGMENT (préfixe du nom de classe, ex. "A_8" -> "A") :
    une classe ne peut être appariée qu'avec une classe du même segment.
    """

    # LRA par classe : moyenne des moyennes annuelles (ordre global, segment-agnostique)
    ordre_global = (
        df
        .group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(pl.col("mean_LGD_year").mean().alias("mean_LGD_global"))
    )

    stats_annuelles = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .join(ordre_global, on=jenks_col)
        .with_columns(
            pl.col(jenks_col).str.split("_").list.first().alias("seg")   # <<< AJOUT : segment = préfixe
        )
        .sort(["seg", "year", "mean_LGD_global"])                        # <<< MODIF : tri partitionné par segment
    )

    df_shift = stats_annuelles.with_columns([
        pl.col(jenks_col).shift(-1).over(["seg", "year"]).alias("next_class"),       # <<< MODIF : voisin intra-segment
        pl.col("mean_LGD_year").shift(-1).over(["seg", "year"]).alias("next_lgd"),   # <<< MODIF : idem
    ])

    # Calcul des inversions (la classe la plus haute de chaque segment n'a pas de voisin -> next_class null -> filtrée)
    inversions = (
        df_shift.with_columns([
            (pl.col("mean_LGD_year") - pl.col("next_lgd")).clip(lower_bound=0).alias("score_de_violation"),
            (pl.col("mean_LGD_year") > pl.col("next_lgd")).alias("is_inverted"),
        ])
        .filter(pl.col("next_class").is_not_null())
    )

    annee_max = df.select(pl.col("year").max()).collect().item()
    seuil_annee_strict = annee_max - ans_strict

    paires = (
        inversions.group_by([jenks_col, "next_class"])
        .agg([
            pl.col("score_de_violation").sum().alias("severite_totale"),
            pl.col("is_inverted").sum().alias("nb_croisements"),
            pl.col("year")
                .filter(pl.col("is_inverted"))
                .max()
                .fill_null(0)
                .alias("derniere_annee_inversion"),
        ])
        .filter(
            (pl.col("severite_totale") > 0)
            & (
                (pl.col("nb_croisements") > nb_croisements_max)
                | (pl.col("derniere_annee_inversion") > seuil_annee_strict)
            )
        )
        .sort("severite_totale", descending=True)
        .collect()
    )

    # affichage détaillé si demandé
    if log:
        print("=== Tableau des paires candidates à fusionner ===")
        if paires.height == 0:
            print("Aucune paire ne viole les contraintes.")
        else:
            print(paires)

    if paires.height == 0:
        return None, None

    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires
