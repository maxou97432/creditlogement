def meilleur_candidat_fusion_v4_tost_wasserstein(
    df: pl.LazyFrame,
    nb_croisements_max: int = 0,
    ans_strict: int = 0,
    lgd_col: str = "lgd_obligor",
    jenks_col: str = "submodel_class",
    log: bool = False,
) -> Tuple[Optional[List[str]], Optional[pl.DataFrame]]:
    """
    Approche hybrid : fusion si TOST + Wasserstein TOUS deux passent
    
    TOST : l'IC 90% de (mean_B - mean_A) est ENTIÈREMENT dans (-delta, +delta)
           → équivalence statistique de moyennes, pas juste détection de différence
    
    Wasserstein : W_1(A,B) < threshold
                → les distributions elles-mêmes sont proches, pas seulement les moyennes
    
    Les DEUX critères doivent passer (AND logic) → très conservateur, défend vraiment
    l'homogénéité.
    """
    from scipy import stats as sp_stats
    
    ordre_global = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .group_by([jenks_col])
        .agg(
            pl.col("mean_LGD_year").mean().alias("mean_LGD_global"),
            pl.col("mean_LGD_year").std(ddof=1).alias("std_LGD_global"),
            pl.len().alias("n_years"),
        )
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))
        .sort(["seg", "mean_LGD_global"])
        .collect()
    )

    # Récupérer obligors
    obligors_per_class = {}
    df_collected = df.select([jenks_col, lgd_col]).collect()
    for cls_name in df_collected.select(jenks_col).unique().to_series():
        obligors_per_class[cls_name] = (
            df_collected.filter(pl.col(jenks_col) == cls_name)
            .select(lgd_col)
            .to_numpy()
            .flatten()
        )

    paires_list = []
    
    for i in range(len(ordre_global) - 1):
        row_i = ordre_global[i]
        seg_i = row_i[jenks_col].str.split("_").list.first().item()
        cls_1 = row_i[jenks_col].item()
        mean_1 = row_i["mean_LGD_global"].item()
        std_1 = row_i["std_LGD_global"].item() or 0.001

        # Chercher voisin intra-segment
        cls_2 = None
        mean_2 = None
        std_2 = None
        
        for j in range(i + 1, len(ordre_global)):
            row_j = ordre_global[j]
            seg_j = row_j[jenks_col].str.split("_").list.first().item()
            
            if seg_j == seg_i:
                cls_2 = row_j[jenks_col].item()
                mean_2 = row_j["mean_LGD_global"].item()
                std_2 = row_j["std_LGD_global"].item() or 0.001
                break
        
        if cls_2 is None:
            continue

        arr1 = obligors_per_class[cls_1]
        arr2 = obligors_per_class[cls_2]
        
        # --- CRITÈRE 1 : TOST (équivalence de moyennes) ---
        n1, n2 = len(arr1), len(arr2)
        gap = mean_2 - mean_1
        se = np.sqrt(std_1**2 / n1 + std_2**2 / n2)
        df_welch = (std_1**2 / n1 + std_2**2 / n2)**2 / (
            (std_1**2 / n1)**2 / (n1 - 1) + (std_2**2 / n2)**2 / (n2 - 1)
        )
        tcrit = sp_stats.t.ppf(1 - ALPHA_TOST, df_welch)
        ci_low = gap - tcrit * se
        ci_high = gap + tcrit * se
        
        # Équivalent si l'IC 90% est entièrement dans (-delta, +delta)
        tost_passes = (ci_low > -DELTA_LGD) and (ci_high < DELTA_LGD)
        
        if not tost_passes:
            continue
        
        # --- CRITÈRE 2 : Wasserstein (forme) ---
        w = wasserstein_distance(arr1, arr2)
        w_passes = w < W_MAX
        
        if not w_passes:
            continue
        
        # Si les DEUX passent, c'est bon
        paires_list.append({
            jenks_col: cls_1,
            "next_class": cls_2,
            "gap": gap,
            "ci_low": ci_low,
            "ci_high": ci_high,
            "tost_pass": tost_passes,
            "wasserstein": w,
            "w_pass": w_passes,
            "severite_totale": -abs(gap),  # plus proche = priorité
        })

    paires = pl.DataFrame(paires_list) if paires_list else pl.DataFrame()

    if log:
        print("=== V4: TOST + Wasserstein (hybrid) ===")
        print("Aucune paire." if paires.height == 0 else paires)

    if paires.height == 0:
        return None, None

    paires = paires.sort("severite_totale", descending=True)
    meilleur = paires.head(1)
    return [meilleur[jenks_col][0], meilleur["next_class"][0]], paires


