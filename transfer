stats_annuelles = (
        df.group_by([jenks_col, "year"])
        .agg(pl.col(lgd_col).mean().alias("mean_LGD_year"))
        .join(ordre_global, on=jenks_col)
        .with_columns(pl.col(jenks_col).str.split("_").list.first().alias("seg"))  # + AJOUT
        .sort(["seg", "year", "mean_LGD_global"])                                  # ~ MODIF (ajout "seg")
    )

    df_shift = stats_annuelles.with_columns([
        pl.col(jenks_col).shift(-1).over(["seg", "year"]).alias("next_class"),     # ~ MODIF
        pl.col("mean_LGD_year").shift(-1).over(["seg", "year"]).alias("next_lgd"), # ~ MODIF
    ])
