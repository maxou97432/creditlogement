# ============================================================
#  CRITERE DE PARSIMONIE v2 — fusion gloutonne
#  Cellule 2 : boucle de fusion
# ============================================================

def get_adjacent_pairs(df: pl.DataFrame, class_col: str, target_col: str):
    stats = (
        df.group_by(class_col)
        .agg(pl.col(target_col).mean().alias("mean_lgd"))
        .sort("mean_lgd")
    )
    classes = stats[class_col].to_list()
    return [(classes[i], classes[i+1]) for i in range(len(classes)-1)]


def merge_classes_df(df: pl.DataFrame, ca, cb, class_col: str) -> pl.DataFrame:
    new_name = f"{ca}|{cb}"
    return df.with_columns(
        pl.when(pl.col(class_col).is_in([ca, cb]))
        .then(pl.lit(new_name))
        .otherwise(pl.col(class_col))
        .alias(class_col)
    )


# Valeurs de reference
r2_ref        = scores_ref["r2"]
std_intra_ref = scores_ref["std_intra"]
mae_ref       = scores_ref["mae_pred"]

print(f"Reference : R2={r2_ref:.6f}  std_intra={std_intra_ref:.6f}  MAE={mae_ref:.6f}")
print(f"Tolerances: R2<-{TOL_R2*100}%  std_intra<+{TOL_STD_INTRA*100}%  MAE<+{TOL_MAE*100}%\n")

df_current  = df_base.clone()
history_par = []

for it in range(MAX_ITER_PARS):
    pairs = get_adjacent_pairs(df_current, "CHR_model", "lgd_obligor")
    if not pairs:
        print("Plus de paires adjacentes.")
        break

    # Tester toutes les paires, garder celle qui minimise la perte R2
    best          = None
    best_loss_r2  = np.inf

    for ca, cb in pairs:
        df_merged  = merge_classes_df(df_current, ca, cb, "CHR_model")
        sc         = compute_scores(df_merged, "CHR_model", "lgd_obligor")

        loss_r2        = (r2_ref        - sc["r2"])        / r2_ref        if r2_ref        > 0 else 0
        delta_std      = (sc["std_intra"] - std_intra_ref) / std_intra_ref if std_intra_ref > 0 else 0
        delta_mae      = (sc["mae_pred"]  - mae_ref)       / mae_ref       if mae_ref       > 0 else 0

        if loss_r2 < best_loss_r2:
            best_loss_r2 = loss_r2
            best = {
                "ca": ca, "cb": cb,
                "scores"    : sc,
                "loss_r2"   : round(loss_r2,   6),
                "delta_std" : round(delta_std,  6),
                "delta_mae" : round(delta_mae,  6),
            }

    stop_r2  = best["loss_r2"]   > TOL_R2
    stop_std = best["delta_std"] > TOL_STD_INTRA
    stop_mae = best["delta_mae"] > TOL_MAE

    # Symbole selon gravite
    n_stops  = sum([stop_r2, stop_std, stop_mae])
    symbole  = "✅" if n_stops == 0 else "⚠️" if n_stops == 1 else "🛑"

    print(f"{symbole} it={it+1:3d} | "
          f"{str(best['ca']):<20} + {str(best['cb']):<20} | "
          f"n={best['scores']['n_classes']:3d} | "
          f"R2={best['scores']['r2']:.6f} ({best['loss_r2']*100:+.3f}%)  "
          f"std={best['scores']['std_intra']:.4f} ({best['delta_std']*100:+.2f}%)  "
          f"MAE={best['scores']['mae_pred']:.4f} ({best['delta_mae']*100:+.2f}%)")

    history_par.append({
        "iteration"  : it + 1,
        "class_a"    : best["ca"],
        "class_b"    : best["cb"],
        "n_classes"  : best["scores"]["n_classes"],
        "r2"         : best["scores"]["r2"],
        "std_intra"  : best["scores"]["std_intra"],
        "mae_pred"   : best["scores"]["mae_pred"],
        "loss_r2"    : best["loss_r2"],
        "delta_std"  : best["delta_std"],
        "delta_mae"  : best["delta_mae"],
        "stop_r2"    : stop_r2,
        "stop_std"   : stop_std,
        "stop_mae"   : stop_mae,
    })

    if stop_r2 or stop_std or stop_mae:
        raisons = []
        if stop_r2:  raisons.append(f"R2 -{best['loss_r2']*100:.3f}% > {TOL_R2*100}%")
        if stop_std: raisons.append(f"std_intra +{best['delta_std']*100:.2f}% > {TOL_STD_INTRA*100}%")
        if stop_mae: raisons.append(f"MAE +{best['delta_mae']*100:.2f}% > {TOL_MAE*100}%")
        print(f"\n🛑 Arret it={it+1} — {' | '.join(raisons)}")
        break

    df_current = merge_classes_df(df_current, best["ca"], best["cb"], "CHR_model")

print(f"\nClasses finales : {df_current['CHR_model'].n_unique()}")

