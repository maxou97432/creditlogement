def cramers_v_matrix_optimise(
    lf_binned: pl.LazyFrame,
    features_used: list,
    threshold_corr: float = 0.6,
    round_digits: int = 2,
    n_jobs: int = -1,
):
    """
    Version optimisée pour un grand nombre de variables et de lignes.

    Principe : les variables étant déjà binées (peu de modalités), on
    pré-encode une seule fois en Int32 compact, puis on calcule chaque
    table de contingence par bincount sur les codes — sans jamais
    recopier ou masquer les données.
    """
    import itertools
    import numpy as np
    from joblib import Parallel, delayed
    from utils.shared import _cramers_v_from_contingency

    cols = features_used
    n_cols = len(cols)

    # --- Encodage compact, une seule passe sur les données ---
    df = lf_binned.select(cols).collect()

    arrays, levels = [], []
    for c in cols:
        s = df.get_column(c)
        codes = s.rank("dense").cast(pl.Int32) - 1   # Int32 suffit, 2x moins de RAM
        arrays.append(codes.fill_null(-1).to_numpy())
        levels.append(int(codes.max()) + 1 if codes.max() is not None else 0)

    del df   # libère la mémoire du DataFrame source

    def _paire(i, j):
        x, y = arrays[i], arrays[j]
        r, k = levels[i], levels[j]
        if r < 2 or k < 2:
            return i, j, 0.0
        mask = (x >= 0) & (y >= 0)
        if not mask.any():
            return i, j, 0.0
        cont = np.bincount(x[mask] * k + y[mask], minlength=r * k).reshape(r, k)
        return i, j, _cramers_v_from_contingency(cont)

    resultats = Parallel(n_jobs=n_jobs, backend="threading", verbose=1)(
        delayed(_paire)(i, j) for i, j in itertools.combinations(range(n_cols), 2)
    )

    corrM = np.full((n_cols, n_cols), np.nan)
    np.fill_diagonal(corrM, 1.0)
    for i, j, v in resultats:
        corrM[i, j] = corrM[j, i] = v

    if round_digits is not None:
        corrM = np.round(corrM, round_digits)
        np.fill_diagonal(corrM, 1.0)

    return pd.DataFrame(corrM, index=cols, columns=cols)
