# Pour les lignes "impossibles", NB_DURATION_IRBA doit venir de quelque part
# → quelle colonne de la base est EGALE à NB_DURATION_IRBA sur ces lignes ?

imp = impossibles.copy()
num_cols = imp.select_dtypes(include=[np.number]).columns.tolist()

for col in num_cols:
    if col in ["NB_DURATION_IRBA", "NB_MATURITE_IRBA"]:
        continue
    match = ((imp[col] - imp["NB_DURATION_IRBA"]).abs() < 1e-3).sum()
    if match > 0.5 * len(imp):
        print(f"  {col:40s} match sur {match:,} / {len(imp):,} lignes ({100*match/len(imp):.1f}%)")

# Variante : NB_DURATION = clip(col, 1, 5)
for col in num_cols:
    if col in ["NB_DURATION_IRBA", "NB_MATURITE_IRBA"]:
        continue
    try:
        match = ((imp[col].clip(1.0, 5.0) - imp["NB_DURATION_IRBA"]).abs() < 1e-3).sum()
        if match > 0.5 * len(imp):
            print(f"  clip({col}, 1, 5) match sur {match:,} / {len(imp):,} lignes")
    except Exception:
        pass
