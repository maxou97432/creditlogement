import numpy as np

sub3 = df_avec_pred.filter(pl.col("CD_TYPE_AMORT") == 3).with_columns(
    has_171     = pl.col("FACTOR").str.contains(r"\[1\.71\]"),
    seg_special = pl.col("segment_trg").is_in([44, 73, 74]),
)
sub_court = sub3.filter(
    (pl.col("R") > 1.0) & (pl.col("R") < 3.0)
    & (~pl.col("has_171")) & (~pl.col("seg_special"))
)

R_arr  = sub_court["R"].to_numpy()
NB_arr = sub_court["NB_MATURITE_IRBA"].to_numpy()

def predict(R_arr, y=0.0495):
    r = y / 12
    n_arr = np.maximum(1, np.round(R_arr * 12).astype(int))
    preds = np.empty_like(R_arr)
    for n_unique in np.unique(n_arr):
        mask = n_arr == n_unique
        k = np.arange(1, n_unique + 1)
        w = (1 + r) ** (k - 1)
        preds[mask] = np.sum(k * w) / np.sum(w) / 12
    return preds

pred = predict(R_arr)
err_jours = (NB_arr - pred) * 365.25

# Isoler le cluster +173 jours
sub_court = sub_court.with_columns(
    err_jours = pl.Series(err_jours)
)
cluster_173 = sub_court.filter(
    (pl.col("err_jours") > 160) & (pl.col("err_jours") < 185)
)
print(f"Cluster +173 jours : n = {cluster_173.height}")

# Population de référence : erreur "normale" (|err| < 10 jours)
normal = sub_court.filter(pl.col("err_jours").abs() < 10)
print(f"Population normale (<10j) : n = {normal.height}\n")

# Comparer toutes les colonnes catégorielles entre cluster et normal
print("=== Comparaison cluster +173j vs normale ===")
print(f"{'Colonne':<25} {'cluster top mod.':<25} {'normale top mod.':<25}")
print("=" * 75)
for c in sub_court.columns:
    if c in ["R", "NB_MATURITE_IRBA", "err_jours", "T0",
             "DT_DEBUT_AUTO", "DT_ECHEANCE_FEM", "DT_ARRT",
             "pred_R", "pred_lineaire", "pred_prog_origine",
             "pred_prog_residuel", "pred_prog_5pct"]:
        continue
    dt = sub_court.schema[c]
    if dt in (pl.Utf8, pl.Categorical, pl.Int64, pl.Int32):
        nu = sub_court[c].n_unique()
        if nu > 30 or nu < 2: continue
        top_c = cluster_173[c].mode()[0] if cluster_173.height > 0 else "—"
        top_n = normal[c].mode()[0] if normal.height > 0 else "—"
        # Pct dans le cluster
        if cluster_173.height > 0:
            pct_c = (cluster_173[c] == top_c).mean() * 100
        else:
            pct_c = 0
        if normal.height > 0:
            pct_n = (normal[c] == top_c).mean() * 100
        else:
            pct_n = 0
        if pct_c > 80 and pct_c - pct_n > 30:
            flag = " <<<"
        else:
            flag = ""
        print(f"{c:<25} {str(top_c):<10} ({pct_c:>5.1f}%)  "
              f"{str(top_n):<10} ({pct_n:>5.1f}%){flag}")
    elif dt in (pl.Float64, pl.Float32):
        moy_c = cluster_173[c].mean() if cluster_173.height > 0 else float('nan')
        moy_n = normal[c].mean() if normal.height > 0 else float('nan')
        std_n = normal[c].std() if normal.height > 0 else 1
        if std_n is None or std_n == 0: continue
        ecart_norm = abs(moy_c - moy_n) / std_n if std_n > 0 else 0
        flag = " <<<" if ecart_norm > 1 else ""
        print(f"{c:<25} moy={moy_c:>7.4f}        moy={moy_n:>7.4f}{flag}")

# Et regarder DT_DEBUT_AUTO en différentiel
print(f"\n--- T0 (maturité d'origine) ---")
if "T0" in sub_court.columns:
    print(f"  cluster +173j : T0 médian = {cluster_173['T0'].median():.4f}")
    print(f"  normale       : T0 médian = {normal['T0'].median():.4f}")
