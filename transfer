
import pandas as pd
import numpy as np
import sys
import os

# --- 1. Chargement des données CL ---
try:
    # Utilisation de raw strings (r"...") pour les chemins Windows

    base_path = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\bdd_univ_elem_zone_insee"
    
    prix_m2_univ_elem_complet_CITY = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_CITY.csv"))
    prix_m2_univ_elem_complet_DEPT = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_DEPT.csv"))
    prix_m2_univ_elem_complet_REGION = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_REGION.csv"))
    prix_m2_univ_elem_complet_PROVINCE = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_PROVINCE.csv"))
    
    dfs_to_concat = [
        prix_m2_univ_elem_complet_CITY,
        prix_m2_univ_elem_complet_DEPT,
        prix_m2_univ_elem_complet_REGION,
        prix_m2_univ_elem_complet_PROVINCE
    ]
    
    df_final = pd.concat(dfs_to_concat, ignore_index=True)

    base_path2 = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\correction base_demande"
    
    prix_m2_univ_elem_complet_CITY2 = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_CITY.csv"))
    prix_m2_univ_elem_complet_DEPT2 = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_DEPT.csv"))
    prix_m2_univ_elem_complet_REGION2 = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_REGION.csv"))
    prix_m2_univ_elem_complet_PROVINCE2 = pd.read_csv(os.path.join(base_path, "prix_m2_univ_elem_complet_PROVINCE.csv"))
    
    dfs_to_concat2 = [
