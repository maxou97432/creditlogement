# Isoler la tranche mixte [0.10, 1.0[ et chercher ce qui sépare
# les lignes "bascule" des lignes "formule"
sub_mixte = df_avec_pred.filter(
    (pl.col("CD_TYPE_AMORT") == 3) &
    (pl.col("R") >= 0.10) &
    (pl.col("R") < 1.0)
)

R_m  = sub_mixte["R"].to_numpy()
NB_m = sub_mixte["NB_MATURITE_IRBA"].to_numpy()
mask_b = np.abs(NB_m - R_m) < 0.01   # True = bascule

# Ajouter le flag à la DataFrame
sub_mixte = sub_mixte.with_columns(
    pl.Series("is_bascule", mask_b)
)

print(f"Tranche [0.10, 1.0[ : {len(R_m)} lignes, dont {mask_b.sum()} bascule ({mask_b.mean()*100:.1f}%)")
print()

# Chercher toutes les colonnes catégorielles/entières qui discriminent
cols_a_tester = [c for c in sub_mixte.columns
                 if c not in ("R", "NB_MATURITE_IRBA", "is_bascule", "pred_prog_5pct")
                 and sub_mixte[c].dtype in (pl.Utf8, pl.Int64, pl.Int32, pl.Boolean, pl.Categorical)]

for col in cols_a_tester[:20]:   # limiter à 20 cols
    try:
        tab = (
            sub_mixte
            .group_by(col)
            .agg([
                pl.len().alias("n"),
                pl.col("is_bascule").mean().alias("pct_bascule"),
            ])
            .sort("pct_bascule", descending=True)
        )
        # N'afficher que si variance utile (pas 0% ou 100% partout)
        pcts = tab["pct_bascule"].to_list()
        if max(pcts) - min(pcts) > 0.05:
            print(f"\n--- {col} ---")
            print(tab)
    except Exception as e:
        pass
