def process_maille_wrapper(df, maille_col, maille_name, df_structure=None):
    """
    Wrapper pour utiliser process_dataset_restreint avec n'importe quelle maille géographique.
    
    Convertit la colonne maille_col en "Ville" pour compatibilité avec process_dataset_restreint,
    puis reconvertit le résultat au format attendu.
    """
    print(f"\n--- Traitement de la maille : {maille_name} ---")
    start_time = datetime.now()
    
    # Préparation : renommer la colonne maille en "Ville"
    df_work = df.copy()
    
    # Si la colonne n'est pas déjà "Ville", on la renomme temporairement
    if maille_col != "Ville":
        if "Ville" in df_work.columns:
            df_work = df_work.drop(columns=["Ville"])
        df_work = df_work.rename(columns={maille_col: "Ville"})
    
    # Nettoyage standard
    df_work["Ville"] = df_work["Ville"].astype(str).str.strip().str.upper()
    df_work = df_work.dropna(subset=["Ville", "TYPE_BIEN", "NB_PIECES_RANGE"])
    
    # Si on a une structure de référence, on doit aussi renommer sa colonne
    structure_adapted = None
    if df_structure is not None:
        structure_adapted = df_structure.copy()
        if maille_col in structure_adapted.columns and maille_col != "Ville":
            structure_adapted = structure_adapted.rename(columns={maille_col: "Ville"})
    
    # Appel de la fonction unifiée
    result = process_dataset_restreint(
        df_work, 
        label=maille_name,
        df_structure=structure_adapted,
        df_arr=None  # Pas de gestion d'arrondissements pour les mailles génériques
    )
    
    if result is None or result.empty:
        print(f"Aucune donnée pour la maille {maille_name}")
        return None
    
    # Conversion du format de sortie
    # process_dataset_restreint retourne : Ville, Periode, prix_mm_3m, prix_mm_12m, surface_mm_3m, surface_mm_12m, VF_mm_3m, VF_mm_12m
    # On veut : VAL_MAILLE_GEO, TYPE_MAILLE, CD_TYPE_BIEN, Periode, DIC_NAME, value
    
    # Mapping des colonnes source → DIC_NAME
    variables_mapping = [
        (f"prix_mm_3m ({maille_name})", "prix_m2_3m"),
        (f"prix_mm_12m ({maille_name})", "prix_m2_12m"),
        (f"surface_mm_3m ({maille_name})", "surface_3m"),
        (f"surface_mm_12m ({maille_name})", "surface_12m"),
        (f"VF_mm_3m ({maille_name})", "valeur_3m"),
        (f"VF_mm_12m ({maille_name})", "valeur_12m")
    ]
    
    # DEBUG: Afficher les colonnes disponibles
    print(f"\n  DEBUG - Colonnes dans result:")
    print(f"    {sorted(result.columns.tolist())}")
    print(f"  DEBUG - Colonnes attendues:")
    for col_source, dic_name in variables_mapping:
        exists = col_source in result.columns
        print(f"    {col_source}: {'✓' if exists else '✗'}")
    
    final_rows = []
    
    for _, row in result.iterrows():
        ville = row["Ville"]
        periode = row["Periode"]
        
        # Boucle sur toutes les variables
        for col_source, dic_name in variables_mapping:
            if col_source in result.columns and pd.notna(row[col_source]):
                final_rows.append({
                    "VAL_MAILLE_GEO": ville,
                    "TYPE_MAILLE": maille_col,
                    "CD_TYPE_BIEN": "APT",  # process_dataset_restreint agrège tous les types
                    "Periode": periode,
                    "DIC_NAME": dic_name,
                    "value": row[col_source],  # Renommé de prix_mm_value → value
                    "nb_observations": 0,  # Non disponible dans ce format
                    "nb_univers": 0
                })
    
    if not final_rows:
        print(f"Aucune donnée après conversion pour {maille_name}")
        return None
    
    final_result = pd.DataFrame(final_rows)
    
    # Calcul des taux d'inflation
    final_result = final_result.sort_values(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "DIC_NAME"])
    final_result["TAUX_INFL_12M"] = final_result.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "DIC_NAME"])["value"].pct_change(periods=4)
    final_result["TAUX_INFL_3M"] = final_result.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "DIC_NAME"])["value"].pct_change(periods=1)
    
    print(f"Traitement {maille_name} terminé en {datetime.now() - start_time}")
    print(f"  → {len(final_result)} lignes générées")
    return final_result



def extract_and_save_structure(df, maille_col, maille_name, resultats_dir):
    """Extrait et sauvegarde la structure de marché pour une maille donnée."""
    print(f"\n   Extraction structure {maille_name}...")
    
    # Calcul de la structure (volume par univers élémentaire)
    dims = [maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
    structure = df.groupby(dims, dropna=False).size().reset_index(name="volume_ref")
    
    # Nettoyage
    structure["TYPE_BIEN"] = structure["TYPE_BIEN"].astype(str).str.upper().str.strip()
    structure["PB"] = structure["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
    mask_coherence = structure["TYPE_BIEN"] == structure["PB"]
    structure = structure[mask_coherence].drop(columns=["PB"])
    
    # Calcul des poids relatifs
    structure["poids_ref"] = structure.groupby(maille_col)["volume_ref"].transform(lambda x: x / x.sum())
    
    # Sauvegarde
    filename = f"structure_poids_{maille_name}.csv"
    path = os.path.join(resultats_dir, filename)
    structure.to_csv(path, index=False, encoding='utf-8-sig')
    
    print(f"      -> {filename}")
    print(f"         {len(structure)} univers, {structure[maille_col].nunique()} {maille_name}")
    
    return structure


