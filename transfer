def build_base(cap_pret_lf: pl.LazyFrame, *, DURATION_MODE=None) -> pl.LazyFrame:
    base = cap_pret_lf
    if DURATION_MODE == 'NEW':
        base = compute_maturite_irba(
            base,
            dt_arrt_col='DT_ARRT',
            dt_echn_col='DT_ECHEANCE',
            cd_type_amort='CD_TYPE_AMORT',     # ← string en dur, nom canonique
        )
        duration_expr = _clip_duration('NB_DURATION_RECALCULE').alias("__tmp_maturity")
    else:
        duration_expr = _clip_duration('duration').alias("__tmp_maturity")

    base = base.with_columns(
        [
            duration_expr,
            pl.col('MT_EAD_FLOOR').cast(pl.Float64).alias("__tmp_ead"),  # ← canonique
            pl.col('cd_portfolio').alias("cd_port_prudentiel"),          # ← canonique
            
            pl.when(pl.col('cd_portfolio').is_in(["CORP", "SME_CORP"]))
            .then(pl.lit("0"))
            .otherwise(pl.lit("1"))
            .alias("perim"),
            
            pl.when(pl.col('cd_portfolio') == "SME_CORP")
            .then(pl.lit("1"))
            .otherwise(None)
            .alias("IND_FACTEUR_REDUCT"),     # ← string en dur aussi
        ]
    )
    return base
