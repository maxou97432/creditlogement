# ============================================================
#  CRITERE DE PARSIMONIE v2 — R2 + STD_INTRA + MAE
#  Cellule 1 : fonction de scores (remplace la precedente)
# ============================================================

import polars as pl
import numpy as np
import matplotlib.pyplot as plt

# Tolerances
TOL_R2        = 0.005   # perte relative R2 max acceptee      : 0.5%
TOL_STD_INTRA = 0.05    # hausse relative std intra max        : 5%
TOL_MAE       = 0.02    # hausse relative MAE pred max         : 2%

MAX_ITER_PARS = 200


def compute_scores(df: pl.DataFrame, class_col: str, target_col: str) -> dict:
    """
    3 criteres de pouvoir discriminant — sans Gini.

    R2        : variance inter / variance totale (eta-squared)
    std_intra : ecart-type intra-classe moyen pondere (homogeneite)
    mae_pred  : MAE si on predit la moyenne de classe pour chaque obs
    """
    y          = df[target_col].to_numpy()
    grand_mean = y.mean()
    ss_total   = ((y - grand_mean) ** 2).sum()

    class_stats = (
        df.group_by(class_col)
        .agg([
            pl.col(target_col).mean().alias("mean_cls"),
            pl.col(target_col).std().alias("std_cls"),
            pl.col(target_col).count().alias("n_cls"),
        ])
    )

    means = class_stats["mean_cls"].to_numpy()
    stds  = class_stats["std_cls"].to_numpy()
    ns    = class_stats["n_cls"].to_numpy()

    # R2
    ss_inter = float(((means - grand_mean) ** 2 * ns).sum())
    r2       = ss_inter / ss_total if ss_total > 0 else 0.0

    # Std intra ponderee
    std_intra = float((stds * ns).sum() / ns.sum())

    # MAE prediction
    df_joined = df.join(class_stats.select([class_col, "mean_cls"]),
                        on=class_col, how="left")
    y_pred    = df_joined["mean_cls"].to_numpy()
    mae_pred  = float(np.abs(y - y_pred).mean())

    return {
        "n_classes" : int(class_stats.height),
        "r2"        : round(r2,        6),
        "std_intra" : round(std_intra, 6),
        "mae_pred"  : round(mae_pred,  6),
    }


