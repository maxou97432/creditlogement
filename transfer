def calcule_downturn(df: pl.DataFrame) -> pl.DataFrame:
    """Restitue le calcul downturn au format du standard (p29) :
       Delta^LGD = (LGD_DT - LRA)/LRA (plancher 0), Downturn = LRA x Delta^LGD,
       LGD downturn = LRA x (1 + Delta^LGD)."""
    return pl.DataFrame({
        "Segment":                  df["segment"],
        "LRA":                      df["lra"],
        "LGD DT":                   df["LGD_DT"],
        "Coefficient Downturn":     df["impact"],                  # Delta^LGD
        "Downturn (marge)":         df["moc"],                     # = LRA x Delta^LGD
        "LGD downturn":             df["lgd_downturn"],            # = LRA x (1 + Delta^LGD)
        "Methode":                  df["methode_agregation"],
        "Heterogeneite a verifier": df["heterogene_a_verifier"],
    })
