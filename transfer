def diagnostic_ovl(lf, n_graphs=None, graphs_per_row=2, graphs_per_fig=4):
    """
    Tableau OVL (hist + kde) pour toutes les paires adjacentes + graphiques.
    
    n_graphs       : nombre de paires à tracer (None = toutes)
    graphs_per_row : nombre de colonnes par figure
    graphs_per_fig : nombre de graphiques par figure (avant nouvelle figure)
    """
    diag_pairs = build_adjacent_pairs(lf).sort("severite_totale")

    rows = []
    for ca, cb, sev in diag_pairs.iter_rows():
        a = get_lgd_vectors(lf, ca)
        b = get_lgd_vectors(lf, cb)
        ovl_h = overlap_empirique_hist(a, b)
        ovl_k = overlap_empirique_kde(a, b)
        rows.append({
            "class_a": ca, "class_b": cb,
            "gap": round(sev, 4),
            "OVL_hist": round(ovl_h, 4), "OVL_kde": round(ovl_k, 4),
            "ecart_hist_kde": round(abs(ovl_h - ovl_k), 4),
            "n_a": len(a), "n_b": len(b),
            "fusionnable_hist": "OUI" if ovl_h > OVL_MODERE else "NON",
            "fusionnable_kde":  "OUI" if ovl_k > OVL_MODERE else "NON",
        })

    df_ovl = pl.DataFrame(rows)
    with pl.Config(tbl_rows=100, tbl_cols=-1):
        print(df_ovl)

    desac = df_ovl.filter(pl.col("fusionnable_hist") != pl.col("fusionnable_kde"))
    if desac.height > 0:
        print(f"\n{desac.height} paire(s) ou hist et kde sont en desaccord :")
        print(desac)
    else:
        print("\nHist et KDE sont d'accord sur toutes les paires.")

    # === Graphiques ===
    pairs_to_plot = diag_pairs if n_graphs is None else diag_pairs.head(n_graphs)
    n_total = pairs_to_plot.height
    n_rows_per_fig = -(-graphs_per_fig // graphs_per_row)  # ceil

    pairs_list = list(pairs_to_plot.iter_rows())

    for fig_start in range(0, n_total, graphs_per_fig):
        chunk = pairs_list[fig_start:fig_start + graphs_per_fig]
        n_chunk = len(chunk)
        n_rows = -(-n_chunk // graphs_per_row)  # ceil

        fig, axes = plt.subplots(n_rows, graphs_per_row, figsize=(8 * graphs_per_row, 4 * n_rows))
        axes = np.array(axes).reshape(-1)  # flatten, gere 1D ou 2D

        for i, (ca, cb, sev) in enumerate(chunk):
            a = get_lgd_vectors(lf, ca)
            b = get_lgd_vectors(lf, cb)
            ovl_h = overlap_empirique_hist(a, b)
            ovl_k = overlap_empirique_kde(a, b)
            plot_overlap(a, b, ca, cb, ovl_h, ovl_k, ax=axes[i])

        # cache les axes vides si le dernier chunk est incomplet
        for j in range(n_chunk, len(axes)):
            axes[j].axis("off")

        plt.tight_layout()
        plt.show()

    return df_ovl
