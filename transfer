# 3. Performance de la règle complète
import numpy as np
def m_bale_progressif(R, y, freq=12):
    n = max(1, int(round(R * freq)))
    if abs(y) < 1e-12:
        return (n + 1) / 2 / freq
    r = y / freq
    k = np.arange(1, n + 1)
    w = (1 + r) ** (k - 1)
    return float(np.sum(k * w) / np.sum(w)) / freq

def m_srs_type3_v2(R, has_171, seg_special, y=0.0497):
    if has_171 or seg_special:
        return R
    if R <= 1.0:
        return R
    return m_bale_progressif(R, y)

R_arr  = sub3["R"].to_numpy()
