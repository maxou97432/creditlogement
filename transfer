# 1) Distribution de la LGD BRUTE (la colonne d'entrée)
lf_LGD.select(
    pl.col('LGD').min().alias("min"),
    pl.col('LGD').quantile(0.5).alias("med"),
    pl.col('LGD').quantile(0.95).alias("p95"),
    pl.col('LGD').quantile(0.99).alias("p99"),
    pl.col('LGD').max().alias("max"),
    (pl.col('LGD') > 100).sum().alias("nb_sup_100"),
    (pl.col('LGD') > 200).sum().alias("nb_sup_200"),
    pl.len().alias("n"),
).collect()

