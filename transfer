# --- Initialisation ---
n_forecast = 2 
corrected_data = [] 
future_adjustments = [] 
grouped = merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"])

print("🚀 Démarrage de la modélisation TES (Holt-Winters)...")

for name, group in grouped:
    zone, type_bien = name
    
    # 1. Préparation des données
    group = group.sort_values("Periode").set_index("Periode")
    group['Indice de prix (CL) - Corrigé TES'] = np.nan # Nom de la colonne corrigée
    
    ts_ecart = group['Dif'].dropna()
    last_cl_value = group['Indice de prix (CL)'].iloc[-1]
    last_date = group.index[-1]
    
    # On force la fréquence pour statsmodels (QS = Quarter Start)
    if not ts_ecart.empty:
        try:
            ts_ecart.index = ts_ecart.index.asfreq('QS') # Assure la fréquence pour le modèle
        except:
            pass
    
    if len(ts_ecart) > 12:
        try:
            # 2. Modélisation TES (Holt-Winters Saisonnier)
            # seasonal='add' : Utilise l'addition (formule de TES)
            # seasonal_periods=4 : Cycle trimestriel
            model = ExponentialSmoothing(
                ts_ecart, 
                trend='add', 
                seasonal='add', 
                seasonal_periods=4, 
                damped_trend=True, 
                initialization_method="estimated"
            )
            model_fit = model.fit()
            
            # 3. Calcul de la Correction Historique
            ecart_modelise = model_fit.fittedvalues
            ecart_modelise = ecart_modelise.reindex(group.index)
            
            cl_corrected_history = group['Indice de prix (CL)'] - ecart_modelise
            group['Indice de prix (CL) - Corrigé TES'] = cl_corrected_history # Stockage de la courbe bleue
            
            # 4. Visualisation (Historique + Forecast Table Prep)
            
            fig = go.Figure()

            # Historique INSEE (Noir)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (INSEE) - Base 2020'],
                mode='lines', name='INSEE (Réalité)', line=dict(color='black', width=3)
            ))

            # Historique CL Brut (Rouge Pointillé)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (CL)'],
                mode='lines', name='CL (Brut)', line=dict(color='red', width=1, dash='dot')
            ))

            # Historique CL Corrigé TES (Bleu)
            fig.add_trace(go.Scatter(
                x=group.index, y=group['Indice de prix (CL) - Corrigé TES'],
                mode='lines', name='CL Corrigé (TES)', line=dict(color='blue', width=2)
            ))
            
            fig.add_vline(x=last_date, line_width=1, line_dash="dash", line_color="gray")
            
            fig.update_layout(
                title=f"<b>{zone} - {type_bien}</b> : Validation Historique TES",
                yaxis_title="Indice (Base 2020 = 100)", template="plotly_white", height=500
            )
            
            fig.show()
            
        except Exception as e:
            print(f"⚠️ Echec TES pour {name}: {e}")
            
    corrected_data.append(group.reset_index())

# Reconstitution
merge_corrected = pd.concat(corrected_data, ignore_index=True)
