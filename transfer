def check_sr_monotonic(sr: pd.DataFrame, TTW: int) -> pd.DataFrame:
    """Controle OPEN-01 : un SR cumule doit etre non croissant en horizon."""
    cols = [f"Horizon {h}" for h in range(1, TTW + 1)]
    m = sr[cols]
    viol = (m.diff(axis=1) > 1e-12).sum(axis=1)
    return pd.DataFrame({"nb_remontees": viol})


def check_no_duplication(dtm_in, dtm_filled) -> dict:
    """Controle FIX-03 : la table de sortie doit avoir le meme nombre de lignes."""
    n_in = dtm_in.height if pl is not None and isinstance(dtm_in, (pl.DataFrame,)) else len(dtm_in)
    n_out = dtm_filled.height if pl is not None and isinstance(dtm_filled, (pl.DataFrame,)) else len(dtm_filled)
    return {"n_entree": n_in, "n_sortie": n_out, "ok": n_in == n_out}


def check_coverage(dtm_filled, final_col: str, gen_col: str = "generation"):
    """Controle FIX-02 : part de valeurs manquantes par generation."""
    if pl is not None and isinstance(dtm_filled, pl.DataFrame):
        return (dtm_filled.lazy()
                .group_by(gen_col)
                .agg(pl.col(final_col).is_null().mean().alias("part_null"))
                .sort(gen_col).collect())
    return dtm_filled.groupby(gen_col)[final_col].apply(lambda s: s.isna().mean())
