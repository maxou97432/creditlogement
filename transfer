from statsmodels.tsa.api import SimpleExpSmoothing
from sklearn.metrics import mean_squared_error

# Supposons que 'merge' contient vos données et la colonne 'Dif' (Ecart)
ts_ecart = merge.set_index('Periode')['Dif'].dropna()

# 1. Modèle Naïf (Moyenne constante)
mean_bias = ts_ecart.mean()
rmse_naif = np.sqrt(((ts_ecart - mean_bias) ** 2).mean())

# 2. Modèle SES (Lissage Exponentiel)
# On entraine le modèle
ses_model = SimpleExpSmoothing(ts_ecart).fit(smoothing_level=0.5, optimized=False)
# fittedvalues donne la prédiction faite pour T sachant les données jusqu'à T-1
rmse_ses = np.sqrt(mean_squared_error(ts_ecart, ses_model.fittedvalues))

print(f"RMSE avec correction fixe (Moyenne) : {rmse_naif:.4f}")
print(f"RMSE avec correction dynamique (SES) : {rmse_ses:.4f}")
