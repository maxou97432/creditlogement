        # Tableau comparatif
        res_lpi = pd.merge(stats_v1_lpi, stats_v2_lpi, on="Ville", suffixes=("_V1", "_V2"))
        res_lpi["Gain_RMSE"] = res_lpi["RMSE_LPI_V1"] - res_lpi["RMSE_LPI_V2"]
        
