import polars as pl
import numpy as np
from scipy import stats as sp_stats

# ---- CONFIG (ajustez si vos noms diffèrent) ----
CLASS_COL = "CHR_model"        # colonne de classe dans le fichier rassemblé
LGD_COL   = "lgd_obligor"
df_base   = base               # votre fichier rassemblé (65 classes), grain obligor
