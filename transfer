from scipy.stats import wasserstein_distance
import numpy as np
import polars as pl

def cohen_d(arr1, arr2):
    n1, n2 = len(arr1), len(arr2)
    s1, s2 = arr1.std(ddof=1), arr2.std(ddof=1)
    sp = np.sqrt(((n1-1)*s1**2 + (n2-1)*s2**2) / (n1+n2-2))
    return (arr2.mean() - arr1.mean()) / sp if sp > 0 else 0

def overlap(arr1, arr2, n_bins=50):
    lo = min(arr1.min(), arr2.min()); hi = max(arr1.max(), arr2.max())
    bins = np.linspace(lo, hi, n_bins)
    p, _ = np.histogram(arr1, bins=bins); q, _ = np.histogram(arr2, bins=bins)
    p, q = p / p.sum(), q / q.sum()
    return float(np.minimum(p, q).sum())

# LRA + segment pour l'adjacence
ordre = (
    lra_prov_model3
    .group_by(["submodel_class", "year"]).agg(pl.col("lgd_obligor").mean().alias("m"))
    .group_by(["submodel_class"]).agg(pl.col("m").mean().alias("mean_LGD"))
    .with_columns(pl.col("submodel_class").str.split("_").list.first().alias("seg"))
    .sort(["seg", "mean_LGD"])
    .collect()
)

obligors = {}
base = lra_prov_model3.select(["submodel_class", "lgd_obligor"]).collect()
for cls in base.select("submodel_class").unique().to_series():
    obligors[cls] = base.filter(pl.col("submodel_class") == cls).get_column("lgd_obligor").to_numpy()

rows = []
for i in range(len(ordre) - 1):
    cls_1 = ordre["submodel_class"][i]; seg_1 = cls_1.split("_")[0]
    cls_2 = None
    for j in range(i + 1, len(ordre)):
        if ordre["submodel_class"][j].split("_")[0] == seg_1:
            cls_2 = ordre["submodel_class"][j]; break
    if cls_2 is None:
        continue
    a1, a2 = obligors[cls_1], obligors[cls_2]
    rows.append({
        "class_1": cls_1, "class_2": cls_2,
        "gap": float(abs(a2.mean() - a1.mean())),
        "cohen_d": float(abs(cohen_d(a1, a2))),
        "ovl": overlap(a1, a2),
        "wasserstein": float(wasserstein_distance(a1, a2)),
    })

eff = pl.DataFrame(rows)

# Distribution réelle de chaque métrique
print("Distribution des tailles d'effet sur les", eff.height, "paires adjacentes :\n")
for col in ["gap", "cohen_d", "ovl", "wasserstein"]:
    s = eff.get_column(col)
    print(f"{col:12s}  min={s.min():.3f}  q25={s.quantile(.25):.3f}  med={s.median():.3f}  "
          f"q75={s.quantile(.75):.3f}  max={s.max():.3f}")

print("\nLes 10 paires les plus PROCHES (Wasserstein croissant) :")
with pl.Config(tbl_rows=10, float_precision=4):
    print(eff.sort("wasserstein").head(10))
