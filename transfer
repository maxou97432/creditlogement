def build_pipeline(
    cap_pret_lf: pl.LazyFrame,
    drop_tmp: bool = True,
    DURATION_MODE = None,
    duration            = 'DURATION',
    ead                 = 'EAD',
    cd_portfolio        = 'cd_portfolio',
    cd_type_amort       = 'C_TYPE_AMORT',
    ind_facteur_reduct  = 'IND_FACTEUR_REDUCT',
    tx_edf              = 'TX_EDF',
    tx_lgd              = 'TX_LGD',
    dt_arrt_col         = 'DT_ARRT',
    dt_echn_col         = 'DT_ECHEANCE',
) -> pl.LazyFrame:
    """Pipeline complet pour le calcul RWA avec tous les paramètres configurables."""

    # ── 1) Normaliser les colonnes utilisateur vers les noms par défaut ──
    rename = {
        duration:           'DURATION',
        ead:                'EAD',
        cd_portfolio:       'cd_portfolio',
        cd_type_amort:      'C_TYPE_AMORT',
        ind_facteur_reduct: 'IND_FACTEUR_REDUCT',
        tx_edf:             'TX_EDF',
        tx_lgd:             'TX_LGD',
        dt_arrt_col:        'DT_ARRT',
        dt_echn_col:        'DT_ECHEANCE',
    }
    rename = {k: v for k, v in rename.items() if k != v}
    lf = cap_pret_lf.rename(rename) if rename else cap_pret_lf

    # ── 2) Construction de la base avec les noms canoniques ──
    lf = build_base(
        lf,
        DURATION_MODE=DURATION_MODE,
        duration='DURATION',
        ead='EAD',
        cd_portfolio='cd_portfolio',
        cd_type_amort='C_TYPE_AMORT',
        ind_facteur_reduct='IND_FACTEUR_REDUCT',
        dt_arrt_col='DT_ARRT',
        dt_echn_col='DT_ECHEANCE',
    )

    # ── 3) Calcul des scénarios RWA ──
    lf = add_all_rwa_scenarios(lf, tx_edf='TX_EDF', tx_lgd='TX_LGD')

    # ── 4) Nettoyage des colonnes temporaires si demandé ──
    if drop_tmp:
        lf = drop_tmp_cols(lf)

    return lf
