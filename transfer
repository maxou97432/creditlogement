
for (zone, type_bien), group in merge_corrected.groupby(['VAL_MAILLE_GEO', 'CD_TYPE_BIEN']):
    
    insee = group['Indice de prix (INSEE) - Base 2020']
    cl_brut = group['Indice de prix (CL)']
    cl_corrige_exact = group['Indice de prix (CL) - Corrigé Holt']
    cl_corrige_approx = group['Indice CL - Corrigé PROV/IDF']
    
    # RMSE
    rmse_brut = calc_rmse(insee, cl_brut)
    rmse_exact = calc_rmse(insee, cl_corrige_exact)
    rmse_approx = calc_rmse(insee, cl_corrige_approx)
    
    # Gain (amélioration par rapport au brut)
    gain_exact = rmse_brut - rmse_exact
    gain_approx = rmse_brut - rmse_approx
    
    # Perte de précision (Approx vs Exact)
    perte = rmse_approx - rmse_exact
    
    resultats.append({
        'Zone': zone,
        'Type': type_bien,
        'RMSE_Brut': round(rmse_brut, 2),
        'RMSE_Exact': round(rmse_exact, 2),
        'RMSE_Approx_PROV_IDF': round(rmse_approx, 2),
        'Gain_Exact': round(gain_exact, 2),
        'Gain_Approx': round(gain_approx, 2),
        'Perte_Precision': round(perte, 2),
        'N_periodes': len(group)
    })

df_validation = pd.DataFrame(resultats)

