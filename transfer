LABEL_MANQUANT = "Manquant"


def col_lettre(col_idx_0based: int) -> str:
    """Index de colonne 0-based -> lettre Excel (0 -> A, 1 -> B, ...)."""
    lettre = ""
    col_idx_0based += 1
    while col_idx_0based > 0:
        col_idx_0based, reste = divmod(col_idx_0based - 1, 26)
        lettre = chr(65 + reste) + lettre
    return lettre


# --------------------------------------------------------------------------- #
# 1. Détection de la distribution de la target
# --------------------------------------------------------------------------- #
def detecter_distribution(lf: pl.LazyFrame, target: str) -> str:
    """
    Détecte automatiquement la distribution de la target à partir de ses
    valeurs observées. Retourne "bernoulli" si la target ne prend que des
    valeurs dans {0, 1}, "continuous" sinon.
    """
    valeurs_uniques = (
        lf.select(pl.col(target).drop_nulls().unique())
          .collect()
          .to_series()
    )
    est_binaire = valeurs_uniques.is_in([0, 1]).all() and valeurs_uniques.len() <= 2
    distribution = "bernoulli" if est_binaire else "continuous"
    print(f"Distribution détectée pour '{target}' : {distribution} "
          f"({valeurs_uniques.len()} valeur(s) unique(s))")
    return distribution


# --------------------------------------------------------------------------- #
# 2. Découpage CART générique
# --------------------------------------------------------------------------- #
def binner_lazy_generique(lf: pl.LazyFrame, column: str, bins: list) -> pl.Expr:
    """
    Découpe `column` selon `bins` (bornes croissantes, encadrées par -inf/+inf)
    et retourne le numéro de tranche (0, 1, 2, ...) correspondant à chaque
    valeur.
    """
    expr = pl.lit(None).cast(pl.Int64)
    for i in range(len(bins) - 1):
        lower, upper = bins[i], bins[i + 1]
        if lower == -np.inf:
            condition = pl.col(column) <= upper
        elif upper == np.inf:
            condition = pl.col(column) > lower
        else:
            condition = (pl.col(column) > lower) & (pl.col(column) <= upper)
        expr = pl.when(condition).then(pl.lit(i)).otherwise(expr)
    return expr


def _r2_ajuste(r2: float, n: int, p: int) -> float:
    """
    R² ajusté = 1 - (1-R²)*(n-1)/(n-p-1).
    p = nombre de classes (feuilles) produites par l'arbre, utilisé comme proxy
    du nombre de paramètres effectifs — un découpage plus fin doit démontrer un
    vrai gain de R² pour compenser la pénalité de complexité. Ce n'est pas le
    R² ajusté au sens strict d'une régression linéaire, mais une approximation
    raisonnable pour comparer des profondeurs entre elles.
    """
    if n - p - 1 <= 0:
        return float("nan")
    return 1 - (1 - r2) * (n - 1) / (n - p - 1)


def optimiser_cart_variable(
    lf: pl.LazyFrame,
    feature: str,
    target: str,
    distribution: str = "continuous",
    max_depths: list = None,
    min_samples_leaf_pct: float = 0.05,
    cv: int = 5,
    max_classes: int = 8,
    random_state: int = 42,
):
    """
    Recherche le max_depth optimal pour `feature`, par validation croisée,
    à min_samples_leaf fixé (contrainte structurelle en % de la population,
    garantissant qu'aucune classe produite n'est anecdotique).

    Critère de sélection :
      - bernoulli  -> AUC moyenne en CV (maximisée)
      - continuous -> R² ajusté moyen en CV (maximisé) ; RMSE moyen également
        calculé et reporté (non utilisé pour la sélection, mais plus lisible
        pour un rapport LGD que le R²).

    criterion fixé : "gini" (Classifier) / "squared_error" (Regressor).

    max_classes agit en garde-fou : les max_depth produisant plus de
    max_classes feuilles sont écartés avant le calcul CV.

    Garde-fous anti-crash : la variable est ignorée si n_obs < cv*2, ou pour
    bernoulli si la classe minoritaire a moins de `cv` individus (contrainte
    StratifiedKFold) — signale une variable trop creuse/déséquilibrée plutôt
    qu'un bug.

    Retourne toujours un dict (jamais None) avec au minimum les clés
    feature, best_max_depth (None en cas d'échec), motif_echec, historique.
    """
    from sklearn.tree import DecisionTreeClassifier, DecisionTreeRegressor
    from sklearn.model_selection import cross_val_score, StratifiedKFold, KFold
    from sklearn.metrics import mean_squared_error

    max_depths = max_depths or [2, 3, 4, 5]

    pdf = (
        lf.filter(pl.col(feature).is_not_null() & pl.col(target).is_not_null())
          .select([feature, target])
          .collect()
          .to_pandas()
    )
    n_obs = len(pdf)

    if n_obs < cv * 2:
        return {
            "feature": feature, "best_max_depth": None, "historique": pd.DataFrame(),
            "motif_echec": f"n_obs={n_obs} insuffisant pour cv={cv}",
        }

    if distribution == "bernoulli":
        effectifs_classes = pdf[target].value_counts()
        if effectifs_classes.min() < cv:
            return {
                "feature": feature, "best_max_depth": None, "historique": pd.DataFrame(),
                "motif_echec": f"classe minoritaire={effectifs_classes.min()} < cv={cv}",
            }

    X = pdf[[feature]].values
    y = pdf[target].values
    min_leaf = max(int(n_obs * min_samples_leaf_pct), 5)

    if distribution == "bernoulli":
        Estimateur = DecisionTreeClassifier
        kwargs_fixes = {"criterion": "gini"}
        splitter = StratifiedKFold(n_splits=cv, shuffle=True, random_state=random_state)
    else:
        Estimateur = DecisionTreeRegressor
        kwargs_fixes = {"criterion": "squared_error"}
        splitter = KFold(n_splits=cv, shuffle=True, random_state=random_state)

    historique = []
    for depth in max_depths:
        model = Estimateur(
            max_depth=depth, min_samples_leaf=min_leaf,
            random_state=random_state, **kwargs_fixes,
        )

        try:
            model.fit(X, y)
            nb_classes = int((model.tree_.feature != -2).sum()) + 1
            if nb_classes > max_classes:
                historique.append({
                    "max_depth": depth, "nb_classes": nb_classes,
                    "score_moyen": None, "rmse_moyen": None,
                    "motif_exclusion": f"> max_classes ({max_classes})",
                })
                continue

            if distribution == "bernoulli":
                scores = cross_val_score(model, X, y, cv=splitter, scoring="roc_auc")
                historique.append({
                    "max_depth": depth, "nb_classes": nb_classes,
                    "score_moyen": scores.mean(), "score_std": scores.std(),
                    "rmse_moyen": None, "motif_exclusion": None,
                })
            else:
                scores_r2 = cross_val_score(model, X, y, cv=splitter, scoring="r2")
                rmses = []
                for train_idx, test_idx in splitter.split(X, y):
                    m = Estimateur(max_depth=depth, min_samples_leaf=min_leaf,
                                    random_state=random_state, **kwargs_fixes)
                    m.fit(X[train_idx], y[train_idx])
                    pred = m.predict(X[test_idx])
                    rmses.append(mean_squared_error(y[test_idx], pred) ** 0.5)

                r2_adj = _r2_ajuste(scores_r2.mean(), n_obs, nb_classes)
                historique.append({
                    "max_depth": depth, "nb_classes": nb_classes,
                    "score_moyen": r2_adj, "score_std": scores_r2.std(),
                    "rmse_moyen": np.mean(rmses), "motif_exclusion": None,
                })
        except Exception as e:
            historique.append({
                "max_depth": depth, "nb_classes": None,
                "score_moyen": None, "rmse_moyen": None,
                "motif_exclusion": f"erreur: {e}",
            })
            continue

    df_hist = pd.DataFrame(historique)
    candidats = df_hist.dropna(subset=["score_moyen"]) if not df_hist.empty else df_hist

    if candidats.empty:
        return {
            "feature": feature, "best_max_depth": None, "historique": df_hist,
            "motif_echec": "aucune profondeur valide (voir historique)",
        }

    ligne = candidats.sort_values("score_moyen", ascending=False).iloc[0]

    return {
        "feature": feature,
        "best_max_depth": int(ligne["max_depth"]),
        "best_min_samples_leaf": min_leaf,
        "best_min_samples_leaf_pct": min_samples_leaf_pct,
        "best_score": float(ligne["score_moyen"]),
        "best_rmse": None if pd.isna(ligne.get("rmse_moyen")) else float(ligne["rmse_moyen"]),
        "best_nb_classes": int(ligne["nb_classes"]),
        "historique": df_hist,
        "motif_echec": None,
    }


def appliquer_decoupage_cart_optimise(
    lf: pl.LazyFrame,
    variables_quanti: list,
    target: str,
    distribution: str = "continuous",
    dossier_sortie: Path = None,
    suffixe: str = "_CART",
    max_depths: list = None,
    min_samples_leaf_pct: float = 0.05,
    cv: int = 5,
    max_classes: int = 8,
    checkpoint_tous_les: int = 20,
):
    """
    Calcule, par variable quanti, un CART dont max_depth est choisi par grid
    search + validation croisée (optimiser_cart_variable), à
    min_samples_leaf_pct fixé, puis applique les bins via binner_lazy_generique.

    dict_seuils garde les vraies bornes -inf/+inf (np.inf), pas de conversion
    en None : l'export sur disque se fait en parquet/CSV, qui gèrent nativement
    les infinis, donc plus besoin du hack JSON.

    Progression affichée via tqdm. Checkpoints CSV réguliers (tous les
    `checkpoint_tous_les` variables) si dossier_sortie est fourni, pour ne
    pas perdre le travail déjà fait en cas de crash tardif.

    Retourne (lf_binned, dict_seuils, variables_binees, df_historique_optim,
    df_variables_ignorees).
    """
    from sklearn.tree import DecisionTreeClassifier, DecisionTreeRegressor

    dict_seuils, expressions, variables_binees = {}, [], []
    historique_optim, variables_ignorees = [], []
    colonnes_presentes = lf.collect_schema().names()

    dossier_cart = None
    if dossier_sortie is not None:
        dossier_cart = Path(dossier_sortie) / "decoupCART"
        dossier_cart.mkdir(parents=True, exist_ok=True)

    for i, col in enumerate(tqdm(variables_quanti, desc=f"CART optimisé ({distribution})")):
        if col not in colonnes_presentes:
            variables_ignorees.append({"variable": col, "motif": "absente"})
            continue

        try:
            resultat = optimiser_cart_variable(
                lf, col, target, distribution=distribution,
                max_depths=max_depths, min_samples_leaf_pct=min_samples_leaf_pct,
                cv=cv, max_classes=max_classes,
            )
        except Exception as e:
            variables_ignorees.append({"variable": col, "motif": f"erreur inattendue: {e}"})
            continue

        if resultat.get("best_max_depth") is None:
            variables_ignorees.append({
                "variable": col,
                "motif": resultat.get("motif_echec", "optimisation échouée"),
            })
            continue

        pdf = (
            lf.filter(pl.col(col).is_not_null() & pl.col(target).is_not_null())
              .select([col, target]).collect().to_pandas()
        )
        X, y = pdf[[col]].values, pdf[target].values
        Estimateur = DecisionTreeClassifier if distribution == "bernoulli" else DecisionTreeRegressor
        criterion = "gini" if distribution == "bernoulli" else "squared_error"
        model = Estimateur(
            max_depth=resultat["best_max_depth"],
            min_samples_leaf=resultat["best_min_samples_leaf"],
            criterion=criterion,
            random_state=42,
        )
        model.fit(X, y)

        raw_thresh = model.tree_.threshold[model.tree_.feature != -2]
        thresholds = np.sort(np.unique(raw_thresh))
        finite_thresholds = thresholds[np.isfinite(thresholds)]
        if len(finite_thresholds) == 0:
            variables_ignorees.append({"variable": col, "motif": "pas de coupure trouvée"})
            continue

        min_val, max_val = pdf[col].min(), pdf[col].max() + 1
        bins_bruts = np.concatenate(([min_val], finite_thresholds, [max_val]))
        seuils_finis = list(bins_bruts[1:-1])
        bins = [-np.inf] + seuils_finis + [np.inf]

        nom_bin = f"{col}{suffixe}"
        expressions.append(binner_lazy_generique(lf, col, bins).alias(nom_bin))
        dict_seuils[col] = {
            "bins": bins,  # vraies valeurs -inf/+inf, pas de None
            "nb_classes": len(bins) - 1,
            "colonne_binee": nom_bin,
        }
        variables_binees.append(nom_bin)

        historique_optim.append({
            "variable": col,
            "max_depth": resultat["best_max_depth"],
            "min_samples_leaf_pct": resultat["best_min_samples_leaf_pct"],
            "min_samples_leaf_abs": resultat["best_min_samples_leaf"],
            "score_cv": resultat["best_score"],
            "rmse_cv": resultat["best_rmse"],
            "nb_classes": resultat["best_nb_classes"],
        })

        if (dossier_cart is not None and checkpoint_tous_les
                and (i + 1) % checkpoint_tous_les == 0):
            pd.DataFrame(historique_optim).to_csv(
                dossier_cart / "hyperparametres_optimises_partiel.csv", index=False,
            )
            pd.DataFrame(variables_ignorees).to_csv(
                dossier_cart / "variables_ignorees_partiel.csv", index=False,
            )

    lf_binned = lf.with_columns(expressions) if expressions else lf

    df_historique_optim = pd.DataFrame(historique_optim)
    df_variables_ignorees = pd.DataFrame(variables_ignorees)

    print(f"CART optimisé ({distribution}) : {len(variables_binees)} variables découpées, "
          f"{len(df_variables_ignorees)} ignorées (min_samples_leaf_pct={min_samples_leaf_pct:.0%})")
    if not df_variables_ignorees.empty:
        print(df_variables_ignorees["motif"].value_counts().to_string())

    if dossier_cart is not None:
        table_seuils = construire_table_seuils(dict_seuils)
        table_seuils.to_parquet(dossier_cart / "seuils_cart.parquet", index=False)
        table_seuils.to_csv(dossier_cart / "seuils_cart.csv", index=False)

        df_historique_optim.to_csv(dossier_cart / "hyperparametres_optimises.csv", index=False)
        df_variables_ignorees.to_csv(dossier_cart / "variables_ignorees.csv", index=False)
        for f_partiel in ["hyperparametres_optimises_partiel.csv", "variables_ignorees_partiel.csv"]:
            p = dossier_cart / f_partiel
            if p.exists():
                p.unlink()
        print(f"Seuils + hyperparamètres + variables ignorées sauvegardés : {dossier_cart}")

    return lf_binned, dict_seuils, variables_binees, df_historique_optim, df_variables_ignorees


# --------------------------------------------------------------------------- #
# 3. Formatage / labels des bornes
# --------------------------------------------------------------------------- #
def label_intervalle(lower: float, upper: float, decimales: int = 2) -> str:
    """Formatte une borne d'intervalle : [-inf;33.00] ou [33.00;+inf]."""
    l = "-inf" if np.isneginf(lower) else f"{lower:.{decimales}f}"
    u = "+inf" if np.isposinf(upper) else f"{upper:.{decimales}f}"
    return f"[{l};{u}]"


def construire_table_seuils(dict_seuils: dict, decimales: int = 2) -> pd.DataFrame:
    """
    Table plate, une ligne par tranche CART : variable, colonne_binee,
    indice_tranche, borne_inf, borne_sup, label. Sert à l'onglet Seuils_CART
    de exporter_stat_desc_excel et à l'export parquet/CSV — remplace l'ancien
    export JSON (bins avec None pour les infinis).
    """
    rows = []
    for var, info in dict_seuils.items():
        bins = info["bins"]
        for i in range(len(bins) - 1):
            lower, upper = bins[i], bins[i + 1]
            rows.append({
                "variable": var,
                "colonne_binee": info["colonne_binee"],
                "indice_tranche": i,
                "borne_inf": lower,
                "borne_sup": upper,
                "label": label_intervalle(lower, upper, decimales),
            })
    return pd.DataFrame(rows)


def construire_labels_bornes(dict_seuils: dict, decimales: int = 2) -> dict:
    """
    {colonne_binee: {indice_tranche: label}} pour remapper les indices CART
    bruts en intervalles lisibles dans stats_par_modalite / prepare_trend_data.
    """
    labels = {}
    for info in dict_seuils.values():
        bins = info["bins"]
        labels[info["colonne_binee"]] = {
            i: label_intervalle(bins[i], bins[i + 1], decimales)
            for i in range(len(bins) - 1)
        }
    return labels


# --------------------------------------------------------------------------- #
# 4. Statistiques descriptives
# --------------------------------------------------------------------------- #
def stats_par_modalite(
    lf: pl.LazyFrame,
    variables: list,
    target: str,
    id_col: str,
    colonne_annee: str = None,
    type_variable: str = "quali",
    labels_bornes: dict = None,
):
    """
    Pour chaque variable et chaque modalité : effectif, % effectif, target
    moyenne. Si colonne_annee est fourni, ventile également par année.

    labels_bornes : dict optionnel {colonne_binee: {indice: label}} (voir
    construire_labels_bornes). Pour les variables quanti binées présentes
    dans ce dict, la modalité affichée est la borne d'intervalle plutôt que
    l'indice de tranche CART brut. Le tri final utilise l'indice numérique
    d'origine (pas le label) pour préserver l'ordre croissant des tranches.
    """
    labels_bornes = labels_bornes or {}
    cles_groupe_base = [] if colonne_annee is None else [colonne_annee]
    resultats = []

    for var in variables:
        cles = cles_groupe_base + [var]

        agg = (
            lf.group_by(cles)
              .agg([
                  pl.col(id_col).n_unique().alias("effectif"),
                  pl.col(target).mean().alias("target_moyenne"),
                  pl.col(target).std().alias("target_ecart_type"),
                  pl.col(target).min().alias("target_min"),
                  pl.col(target).max().alias("target_max"),
              ])
        )

        fenetre = cles_groupe_base if cles_groupe_base else None
        if fenetre:
            agg = agg.with_columns(
                (pl.col("effectif") / pl.col("effectif").sum().over(fenetre) * 100)
                .alias("pct_effectif")
            )
        else:
            agg = agg.with_columns(
                (pl.col("effectif") / pl.col("effectif").sum() * 100).alias("pct_effectif")
            )

        if var in labels_bornes:
            expr_ordre = pl.col(var).fill_null(-1).cast(pl.Int64).alias("modalite_ordre")
            expr_modalite = (
                pl.col(var).cast(pl.Int64).replace(labels_bornes[var], default=None)
                  .fill_null(LABEL_MANQUANT)
            )
        else:
            expr_ordre = pl.lit(None).cast(pl.Int64).alias("modalite_ordre")
            expr_modalite = pl.col(var).cast(pl.Utf8).fill_null(LABEL_MANQUANT)

        agg = (
            agg.with_columns([
                pl.lit(var).alias("variable"),
                pl.lit(type_variable).alias("type_variable"),
                expr_modalite.alias("modalite"),
                expr_ordre,
            ])
            .drop(var)
        )
        resultats.append(agg)

    if not resultats:
        return pl.DataFrame()

    colonnes_finales = (
        ["variable", "type_variable", "modalite"]
        + ([colonne_annee] if colonne_annee else [])
        + ["effectif", "pct_effectif", "target_moyenne",
           "target_ecart_type", "target_min", "target_max"]
    )

    return (
        pl.concat(resultats, how="vertical")
          .collect()
          .sort(["variable"] + ([colonne_annee] if colonne_annee else [])
                + ["modalite_ordre", "modalite"])
          .select(colonnes_finales)
    )


def export_brut_comptages(lf, variables, id_col, colonne_annee=None, labels_bornes: dict = None):
    """
    Export à plat, une ligne par variable x modalité [x année], avec
    count(ID). Destiné à être croisé via TCD Excel côté utilisateur.
    """
    return stats_par_modalite(
        lf, variables, target=id_col, id_col=id_col,
        colonne_annee=colonne_annee, type_variable="brut",
        labels_bornes=labels_bornes,
    ).select(
        ["variable", "modalite"]
        + ([colonne_annee] if colonne_annee else [])
        + ["effectif", "pct_effectif"]
    )


# --------------------------------------------------------------------------- #
# 5. Préparation des tendances par modalité (onglet Trend_Modalities)
# --------------------------------------------------------------------------- #
def prepare_trend_data(lf_decoup, features_used, target, top_n=15,
                        colonne_annee="annee", labels_bornes: dict = None):
    """
    Prépare le DataFrame de l'onglet Trend_Modalities.

    features_used : noms de variables réels (drivers_quali + drivers_quanti_bines).
    labels_bornes : dict optionnel {colonne_binee: {indice: label_borne}}
    (voir construire_labels_bornes). Pour les colonnes quanti binées présentes
    dans ce dict, la modalité affichée est la borne d'intervalle plutôt que
    l'indice de tranche CART. Le tri reste basé sur l'indice numérique
    d'origine pour préserver l'ordre croissant des tranches.

    Les valeurs nulles sont matérialisées en modalité "Manquant".

    Retourne : annee | modality | target_moyenne | effectif | variable |
    total_modalities | has_more, limité au top_n modalités par variable.
    """
    colonnes_dispo = lf_decoup.collect_schema().names()
    labels_bornes = labels_bornes or {}
    all_trends, ignorees = [], []

    for feat in features_used:
        if feat not in colonnes_dispo:
            ignorees.append(feat)
            continue

        if feat in labels_bornes:
            expr_order = pl.col(feat).fill_null(-1).cast(pl.Int64).alias("modality_order")
            expr_modality = (
                pl.col(feat).cast(pl.Int64).replace(labels_bornes[feat], default=None)
                  .fill_null(LABEL_MANQUANT).alias("modality")
            )
        else:
            expr_order = pl.lit(None).cast(pl.Int64).alias("modality_order")
            expr_modality = pl.col(feat).cast(pl.Utf8).fill_null(LABEL_MANQUANT).alias("modality")

        agg = (
            lf_decoup
            .select([colonne_annee, feat, target])
            .with_columns([expr_modality, expr_order])
            .group_by([colonne_annee, "modality", "modality_order"])
            .agg([
                pl.col(target).mean().alias("target_moyenne"),
                pl.len().alias("effectif"),
            ])
            .with_columns(pl.lit(feat).alias("variable"))
            .sort([colonne_annee, "modality_order", "modality"])
            .collect()
        )
        all_trends.append(agg.to_pandas())

    if ignorees:
        print(f"Trend : {len(ignorees)} variable(s) absente(s) ignorée(s) : {ignorees[:5]}")

    if not all_trends:
        return pd.DataFrame()

    full_df = pd.concat(all_trends, ignore_index=True)

    total_par_var = (
        full_df.groupby("variable")["modality"].nunique()
        .reset_index(name="total_modalities")
    )

    effectif_par_modalite = (
        full_df.groupby(["variable", "modality"])["effectif"].sum()
        .reset_index(name="effectif_total")
    )
    top_modalites = (
        effectif_par_modalite
        .sort_values(["variable", "effectif_total"], ascending=[True, False])
        .groupby("variable")
        .head(top_n)[["variable", "modality"]]
    )

    trend_df = (
        full_df.merge(top_modalites, on=["variable", "modality"], how="inner")
               .merge(total_par_var, on="variable", how="left")
    )
    trend_df["has_more"] = trend_df["total_modalities"] > top_n

    colonnes = [colonne_annee, "modality", "modality_order", "target_moyenne",
                "effectif", "variable", "total_modalities", "has_more"]
    trend_df = (
        trend_df[colonnes]
        .sort_values(["variable", colonne_annee, "modality_order", "modality"])
        .drop(columns="modality_order")
    )

    print(f"Trend : {trend_df['variable'].nunique()} variable(s), "
          f"{len(trend_df)} ligne(s), top {top_n} modalités par variable")
    return trend_df.reset_index(drop=True)


# --------------------------------------------------------------------------- #
# 6. Écriture Excel (factorisation du pattern de create_excel_scorecard)
# --------------------------------------------------------------------------- #
def write_formatted_sheet(writer, df, sheet_name, tab_color="#006C44",
                          startcol=1, index=False, largeur=20):
    """
    Écrit un DataFrame dans un onglet avec le formatage standard du pack.
    Le format de corps ne définit PAS de bg_color, pour ne pas écraser un
    éventuel dégradé de couleur appliqué par-dessus.
    """
    if isinstance(df, pl.DataFrame):
        df = df.to_pandas()

    df.to_excel(writer, sheet_name=sheet_name, startcol=startcol, index=index)

    workbook = writer.book
    worksheet = writer.sheets[sheet_name]
    worksheet.hide_gridlines(2)
    worksheet.set_tab_color(tab_color)

    header_format = workbook.add_format({
        "bold": True, "text_wrap": True, "align": "center", "valign": "vcenter",
        "bg_color": "#00915A", "font_color": "#FFFFFF",
        "border": 1, "border_color": "#999999",
    })
    cell_border_format = workbook.add_format({
        "border": 1, "border_color": "#999999", "text_wrap": True,
    })

    max_row, max_col = df.shape
    col_offset = 1 if index else 0
    derniere_col = startcol + max_col + col_offset - 1

    worksheet.conditional_format(
        0, startcol, 0, derniere_col,
        {"type": "formula", "criteria": "=ROW()=1", "format": header_format},
    )
    worksheet.conditional_format(
        1, startcol, max_row, derniere_col,
        {"type": "formula",
         "criteria": f'={col_lettre(startcol)}2<>""',
         "format": cell_border_format},
    )
    worksheet.set_column(0, derniere_col, largeur)
    return worksheet


def colorer_matrice_correlation(worksheet, df, startcol=1, startrow=1):
    """Dégradé 3 couleurs sur la matrice V de Cramér (valeurs 0 -> 1)."""
    nb_lignes, nb_cols = df.shape
    worksheet.conditional_format(
        startrow, startcol, startrow + nb_lignes - 1, startcol + nb_cols - 1,
        {
            "type": "3_color_scale",
            "min_type": "num", "min_value": 0, "min_color": "#FFFFFF",
            "mid_type": "num", "mid_value": 0.5, "mid_color": "#FDBE85",
            "max_type": "num", "max_value": 1, "max_color": "#D7301F",
        },
    )


