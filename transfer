def load_and_prep_cl_data(base_path, label_version):
    """Charge, nettoie et calcule l'indice CL pour un dossier donné."""
    print(f"Chargement de {label_version} depuis : {base_path} ...")
    try:
        dfs = []
        for suffix in ["CITY", "DEPT", "REGION", "PROVINCE"]:
            file_path = os.path.join(base_path, f"prix_m2_univ_elem_complet_{suffix}.csv")
            if os.path.exists(file_path):
                dfs.append(pd.read_csv(file_path))
            else:
                pass
        
        if not dfs:
            print(f"  ERREUR : Aucun fichier trouvé pour {label_version}")
            return None
            
        df = pd.concat(dfs, ignore_index=True)
        
        # Nettoyage
        df = df[df['DIC_NAME'] != "prix_m2_3m"]
        df = df.drop(columns=["TYPE_MAILLE","TAUX_INFL_12M","TAUX_INFL_3M", "DIC_NAME"], errors='ignore')
        
        # Calcul Indice Base 2020
        df["Periode"] = pd.to_datetime(df["Periode"], dayfirst=False) # Important: dayfirst
        mask_2020 = df["Periode"].dt.year == 2020
        
        col_name = f"Indice CL ({label_version})"
        
        if not df.loc[mask_2020].empty:
            pivot_2020 = df.loc[mask_2020].groupby(["CD_TYPE_BIEN","VAL_MAILLE_GEO"])["prix_mm_value"].mean()
            df[col_name] = (
                (df["prix_mm_value"] / 
                 df.set_index(["CD_TYPE_BIEN","VAL_MAILLE_GEO"]).index.map(pivot_2020)
                ) * 100 
            ).round(2)
        else:
            df[col_name] = np.nan
            
        # Nettoyage Clés pour la fusion
        df["VAL_MAILLE_GEO"] = df["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
        df["CD_TYPE_BIEN"] = df["CD_TYPE_BIEN"].astype(str).str.strip().str.upper()
        df['Periode_Key'] = df["Periode"].dt.to_period('Q').astype(str)
        
        return df[[ 'VAL_MAILLE_GEO', 'CD_TYPE_BIEN', 'Periode_Key', col_name ]]
        
    except Exception as e:
        print(f"  Erreur chargement {label_version}: {e}")
        return None

