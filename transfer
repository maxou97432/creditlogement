scores_by_submodel = []

# Résout un nom de colonne quelle que soit sa casse / ses underscores
def resolve_col(candidates, available):
    norm = {c.lower().replace("_", ""): c for c in available}
    for cand in candidates:
        key = cand.lower().replace("_", "")
        if key in norm:
            return norm[key]          # renvoie le nom RÉEL du parquet
    return None

available_cols = lf_lgd.collect_schema().names()

for seg in [s for s in segments if s["Type"] == "NONCURE"]:
    submodel_label = seg["Nom"].split("_NC")[0] if "_NC" in seg["Nom"] else seg["Nom"]
    seg_path = Path(jenks_path, submodel_label)
    seg_path.mkdir(parents=True, exist_ok=True)

    # 1. Trouver la vraie colonne (TypeContrat ou TypeContrat2), insensible à la casse
    column_to_use = resolve_col(["TypeContrat", "TypeContrat2"], available_cols)
    if column_to_use is None:
        raise ValueError(
            f"[{submodel_label}] Ni 'TypeContrat' ni 'TypeContrat2' trouvés. "
            f"Colonnes dispo contenant 'contrat': "
            f"{[c for c in available_cols if 'contrat' in c.lower()]}"
        )

    # 2. Adapter le filtre Excel : remplacer le placeholder par le vrai nom.
    #    On gère les variantes de casse du placeholder dans le filtre.
    raw_filter = seg["Filtre"]
    modified_filter = (
        raw_filter
        .replace("TypeContrat2", column_to_use)   # le plus long d'abord
        .replace("TypeContrat",  column_to_use)
        .replace("TYPECONTRAT",  column_to_use)
    )

    # 3. Garde-fou : vérifier que toutes les colonnes citées dans le filtre existent
    #    (sinon on saute le segment avec un message clair plutôt que de crasher)
    try:
        filtered_lf_lgd = lf_lgd.filter(eval(modified_filter))
        _ = filtered_lf_lgd.select(pl.len()).collect()  # force l'évaluation pour valider
    except Exception as e:
        print(f"[{submodel_label}] Filtre invalide -> {modified_filter}")
        print(f"   colonne résolue: {column_to_use} | erreur: {e}")
        raise

    # 4. Calcul des classes de Jenks
    run = jenks_calculator.compute_jenks_run(
        filtered_lf_lgd,
        "score",
        "LGD",
        "year",
        seg_path,
    )

    nb_class = run["nb_class"]
    run["suffixe"] = submodel_label
    jenks_calculator.write_excel_jenks_from_run(run, str(seg_path))

    # 5. Application des classes de Jenks
    df_summary = pd.read_parquet(
        seg_path / f"jenks/df_summary_tests_jenks_{nb_class}_class.parquet"
    )
    best_class_idx = jenks_calculator.index_with_max_green(df_summary) + 2
    jenks_class = (
        pl.scan_parquet(seg_path / f"jenks/jenks_{best_class_idx}_class.parquet")
        .select(pl.first())
    )

    scores = filtered_lf_lgd.with_columns(
        jenks_class.collect()["Jenks_class"].cast(pl.Int8).alias("Jenks_class")
    )

    scores.sink_parquet(seg_path / f"jenks/scores_best_number_class_{seg['Nom']}.parquet")

    scores = scores.with_columns(pl.lit(submodel_label).alias("Submodel"))
    scores = scores.with_columns(
        pl.concat_str(["Jenks_class", "Submodel"], separator="_").alias("Jenks_Submodel")
    )

    Rules_classes = find_classes_threshold(scores, "score_brut", "Jenks_class", seg)
    Rules_classes.write_parquet(f"{output_path}/Rules_LGD_{submodel_label}.parquet")

    scores_by_submodel.append(scores)

# Concat of the Submodels
lf_lgd_reunion = pl.concat(scores_by_submodel)

# Sauvegarde
lf_lgd_reunion.collect().write_parquet(f"{output_path}/all_concatenated_with_classes.parquet")
