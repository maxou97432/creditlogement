def apply_nice_correction(df):
    """Corrige le nom de ville pour Nice basé sur les codes IRIS."""
    col_ref = None
    if "code_iris" in df.columns: col_ref = "code_iris"
    elif "IRIS" in df.columns: col_ref = "IRIS"
    
    if col_ref:
        mask_nice = df[col_ref].astype(str).str[:5].isin(CONFIG['codes_insee_nice'])
        if mask_nice.sum() > 0:
            df.loc[mask_nice, "CITY"] = "NICE"
    return df

def load_and_preprocess_data():
    """Charge et prétraite les données initiales."""
    print(f"Chargement des données depuis {CONFIG['input_file']}...")
    try:
        df = pd.read_parquet(CONFIG['input_file'])
    except Exception as e:
        sys.exit(f"Erreur critique chargement fichier : {e}")

    # Renommage et nettoyage initial
    df = df.rename(columns={"DEPT_Corse_2A_2B": "DEPT", "ville_": "CITY", "code_iris": "IRIS", "CODE_POSTAL": "CP"})
    df = df.dropna(subset=["CITY", "CP", "DEPT"])
    
    # Conversion des dates
    df["DATE"] = pd.to_datetime(df["DATE"], errors='coerce')
    df = df.dropna(subset=["DATE"])
    df["Periode"] = df["DATE"].dt.to_period("M").dt.to_timestamp()
    
    # Ajout colonne REGION
    df['DEPT'] = df['DEPT'].astype(str).str.zfill(2)
    # Mapping partiel sécurisé
    df['REGION'] = df['DEPT'].map(CONFIG['dep_to_region']).fillna("Autre")
    
    return df

def complete_months(g, col):
    """Complète les mois manquants."""
    g = g.sort_values("Periode").set_index("Periode")
    if g.empty: return g.reset_index()
    
    idx = pd.date_range(g.index.min(), g.index.max(), freq="MS")
    g = g.reindex(idx)
    
    for i in [col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]:
        g[i] = g[i].ffill().bfill()
    
    g["nb_transac"] = g["nb_transac"].fillna(0)
    return g.reset_index().rename(columns={"index": "Periode"})

def calcule_moyenne_mobile_ponderee(g, window, col_prix, col_indicatrice, typokeys):
    """Calcule la moyenne mobile pondérée."""
    result = []
    g = g.sort_values("Periode")
    periodes = g["Periode"].unique()
    
    for i, periode in enumerate(periodes):
        # Optimisation: ne traiter que les mois trimestriels
        if pd.Timestamp(periode).month % 3 != 0: continue
            
        start_idx = max(0, i - window + 1)
        periodes_fenetre = periodes[start_idx:i+1]
        
        df_fenetre = g[g["Periode"].isin(periodes_fenetre)]
        mask_actif = (df_fenetre[col_prix].notna()) & (df_fenetre[col_indicatrice] == 1)
        df_actif = df_fenetre[mask_actif]
        
        if len(df_actif) == 0:
            result.append({"Periode": periode, "prix_mm": np.nan, "nb_observations": 0, "nb_univers": 0})
            continue
        
        total_poids = df_actif["poids_relatif"].sum()
        if total_poids > 0:
            prix_mm = np.average(df_actif[col_prix], weights=df_actif["poids_relatif"])
        else:
            prix_mm = np.nan
            
        result.append({
            "Periode": periode,
            "prix_mm": prix_mm,
            "nb_observations": len(df_actif),
            "nb_univers": df_actif.groupby(typokeys).ngroups
        })
    
    return pd.DataFrame(result)

def process_maille(df, maille_col, maille_name, filter_func=None):
    """Fonction générique pour traiter une maille géographique."""
    print(f"\n--- Traitement de la maille : {maille_name} ---")
    start_time = datetime.now()
    
    # Filtrage spécifique
    df_work = df.copy()
    if "DEMANDE" in df_work.columns:
        df_work = df_work[df_work["DEMANDE"] == 0] # On ne garde pas les demandes pour le prix
        
    if filter_func:
        df_work = filter_func(df_work)
        
    if df_work.empty:
        print(f"Aucune donnée pour la maille {maille_name}.")
        return None

    if df_work[maille_col].dtype == 'object':
        df_work[maille_col] = df_work[maille_col].astype(str).str.strip().str.upper()

    dims = [maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE", "Periode"]
    
    # 1. Agrégation mensuelle
    univers_mensuel = (
        df_work.groupby(dims, dropna=False)
        .agg(nb_transac=("ID", "size"), prix_median=("Prix_m2", "median"), prix_moyen=("Prix_m2", "mean"))
        .reset_index()
    )
    
    univers_mensuel["nb_transac"] = univers_mensuel["nb_transac"].fillna(0).astype(int)
    univers_mensuel["TYPE_BIEN"] = univers_mensuel["TYPE_BIEN"].astype(str).str.strip().str.upper()
    
    # Filtre cohérence
    univers_mensuel["PB"] = univers_mensuel["NB_PIECES_RANGE"].astype(str).str.strip().str[:3].str.upper()
    univers_mensuel = univers_mensuel[univers_mensuel["TYPE_BIEN"] == univers_mensuel["PB"]].drop(columns=["PB"])

    # 2. Complétion
    univers_complet = univers_mensuel.groupby([maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], group_keys=False).apply(lambda g: complete_months(g, maille_col))
    
    # 3. Poids
    poids = univers_mensuel.groupby([maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], as_index=False)["nb_transac"].sum().rename(columns={"nb_transac": "poids_total"})
    poids["poids_relatif"] = poids.groupby(maille_col)["poids_total"].transform(lambda x: x / x.sum())
    univers_complet = univers_complet.merge(poids, on=[maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"], how="left")
    
    # 4. Indicateurs
    typokeys = [maille_col, "BIEN_NEUF", "TYPE_BIEN", "NB_PIECES_RANGE"]
    univers_complet = univers_complet.sort_values(typokeys + ["Periode"])
    univers_complet["I_3m"] = univers_complet.groupby(typokeys)["nb_transac"].transform(lambda s: (s.rolling(3, min_periods=3).sum() > 0).astype(int))
    univers_complet["I_12m"] = univers_complet.groupby(typokeys)["nb_transac"].transform(lambda s: (s.rolling(12, min_periods=12).sum() > 0).astype(int))
    
    # 5. Moyennes Mobiles
    resultats_mm = []
    for (maille_val, type_bien), df_groupe in univers_complet.groupby([maille_col, 'TYPE_BIEN']):
        # MM 3 mois
        mm_3m = calcule_moyenne_mobile_ponderee(df_groupe, 3, 'prix_moyen', 'I_3m', typokeys)
        mm_3m["DIC_NAME"] = "prix_m2_3m"
        
        # MM 12 mois
        mm_12m = calcule_moyenne_mobile_ponderee(df_groupe, 12, 'prix_moyen', 'I_12m', typokeys)
        mm_12m["DIC_NAME"] = "prix_m2_12m"
        
        # Consolidation
        mm_type = pd.concat([mm_3m, mm_12m], ignore_index=True)
        mm_type = mm_type.rename(columns={"prix_mm": "prix_mm_value", "nb_observations": "NB_BIENS"})
        mm_type["VAL_MAILLE_GEO"] = maille_val
        mm_type["TYPE_MAILLE"] = maille_col 
        mm_type["CD_TYPE_BIEN"] = type_bien
        resultats_mm.append(mm_type)
    
    if not resultats_mm: return None
        
    final_df = pd.concat(resultats_mm, ignore_index=True)
    final_df = final_df.sort_values(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "DIC_NAME"])
    
    # Calcul inflation
    final_df["TAUX_INFL_12M"] = final_df.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "DIC_NAME"])["prix_mm_value"].pct_change(periods=4) 
    final_df["TAUX_INFL_3M"] = final_df.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "DIC_NAME"])["prix_mm_value"].pct_change(periods=1)

    print(f"Traitement {maille_name} terminé en {datetime.now() - start_time}")
    return final_df

def save_results(df, suffixe_fichier):
    """Sauvegarde les résultats."""
    if df is None or df.empty: return

    # 1. Base complète
    df_complet = df[(df["Periode"].max() > df["Periode"]) & (df["Periode"] >= "2015-03-01")]
    df_complet.to_csv(os.path.join(CONFIG['output_dir'], f"prix_m2_univ_elem_complet_{suffixe_fichier}.csv"), index=False)

    # 2. MAJ (Dernière période)
    df_maj = df_complet[df_complet["Periode"] == df_complet["Periode"].max()].copy()
    df_maj = df_maj.rename(columns={"Periode": "DT_MAJ_PM2"})
    cols_export = ["DIC_NAME", "CD_TYPE_BIEN", "TYPE_MAILLE", "VAL_MAILLE_GEO", "DT_MAJ_PM2", "NB_BIENS", "prix_mm_value", "TAUX_INFL_3M", "TAUX_INFL_12M"]
    cols_export = [c for c in cols_export if c in df_maj.columns]
    
    df_maj[cols_export].to_csv(os.path.join(CONFIG['output_dir'], f"prix_m2_univ_elem_MAJ_{suffixe_fichier}.csv"), index=False)
    print(f"  -> Sauvegarde MAJ effectuée : prix_m2_univ_elem_MAJ_{suffixe_fichier}.csv")

