import pandas as pd
import numpy as np
import itertools
import warnings
import logging
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_squared_error
from statsmodels.tsa.arima.model import ARIMA
from statsmodels.tsa.holtwinters import ExponentialSmoothing

warnings.filterwarnings("ignore")
logging.getLogger('cmdstanpy').setLevel(logging.WARNING)

# Dict pour stocker le vainqueur par segment → utilisé dans la cellule backtest
winners = {}  # {(zone, type_bien): {"modele": str, "seasonal": "add"|None, "sarima_order": (...), "sarima_seasonal": (...)}}

for segment_name, segment_data in merge.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]):
    zone, type_bien = segment_name
    print(f"\n{'='*60}")
    print(f"SEGMENT : {zone} - {type_bien}")
    print(f"{'='*60}")

    ts_ecart = (
        segment_data.sort_values("Periode")
        .set_index("Periode")["Dif"]
        .dropna()
    )
    ts_ecart.index = pd.PeriodIndex(ts_ecart.index, freq="Q")

    if len(ts_ecart) < 16:
        print("   ⚠️ Série trop courte — segment ignoré.")
        continue

    print(f"   {len(ts_ecart)} trimestres ({ts_ecart.index[0]} → {ts_ecart.index[-1]})")

    # ══════════════════════════════════════════════════════════════════
    # 1. SARIMAX – Grid Search AIC (calibration sur 75% de la série)
    # ══════════════════════════════════════════════════════════════════
    print("   1. Grid Search SARIMA...")
    train_calib = ts_ecart.iloc[:int(len(ts_ecart) * 0.75)]

    pdq          = list(itertools.product(range(0, 3), [0, 1], range(0, 3)))
    seasonal_pdq = list(itertools.product(range(0, 2), [0, 1], range(0, 2), [4]))

    best_aic             = float("inf")
    best_order           = (1, 1, 0)
    best_seasonal_order  = (0, 0, 0, 4)

    for order in pdq:
        for s_order in seasonal_pdq:
            try:
                fit = ARIMA(
                    train_calib, order=order, seasonal_order=s_order,
                    enforce_stationarity=False, enforce_invertibility=False
                ).fit()
                if fit.aic < best_aic:
                    best_aic            = fit.aic
                    best_order          = order
                    best_seasonal_order = s_order
            except Exception:
                continue

    print(f"      → SARIMA{best_order}×{best_seasonal_order} (AIC={best_aic:.1f})")

    # ══════════════════════════════════════════════════════════════════
    # 2. CROSS-VALIDATION (5 splits, horizon 4 trimestres)
    # ══════════════════════════════════════════════════════════════════
    print("   2. Cross-Validation (5 splits, horizon T+4)...")

    tscv = TimeSeriesSplit(n_splits=5, test_size=4)
    results_cv = {
        "SARIMA":          [],
        "TES (avec saison)": [],
        "TES (sans saison)": [],
    }

    for train_idx, test_idx in tscv.split(ts_ecart):
        cv_train = ts_ecart.iloc[train_idx]
        cv_test  = ts_ecart.iloc[test_idx]

        # A. SARIMA
        try:
            pred = ARIMA(
                cv_train, order=best_order, seasonal_order=best_seasonal_order,
                enforce_stationarity=False, enforce_invertibility=False
            ).fit().forecast(steps=4)
            results_cv["SARIMA"].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except Exception:
            results_cv["SARIMA"].append(np.nan)

        # B. TES avec saisonnalité
        try:
            pred = ExponentialSmoothing(
                cv_train, trend="add", seasonal="add",
                seasonal_periods=4, damped_trend=True,
                initialization_method="estimated"
            ).fit().forecast(steps=4)
            results_cv["TES (avec saison)"].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except Exception:
            results_cv["TES (avec saison)"].append(np.nan)

        # C. TES sans saisonnalité
        try:
            pred = ExponentialSmoothing(
                cv_train, trend="add", seasonal=None,
                damped_trend=True, initialization_method="estimated"
            ).fit().forecast(steps=4)
            results_cv["TES (sans saison)"].append(np.sqrt(mean_squared_error(cv_test, pred)))
        except Exception:
            results_cv["TES (sans saison)"].append(np.nan)

    # ══════════════════════════════════════════════════════════════════
    # 3. RÉSULTATS & VAINQUEUR
    # ══════════════════════════════════════════════════════════════════
    summary = (
        pd.DataFrame(results_cv)
        .apply(lambda s: pd.to_numeric(s, errors="coerce"))
        .agg(["mean", "std"])
        .T
        .rename(columns={"mean": "RMSE Moyen", "std": "Stabilité (Std)"})
        .sort_values("RMSE Moyen")
    )
    print("\n   🏆 CLASSEMENT :")
    print(summary.round(3))

    winner_name = summary.index[0]
    print(f"   ✅ Vainqueur : {winner_name}")

    # Stocker pour la cellule backtest
    winners[(zone, type_bien)] = {
        "modele":          winner_name,
        "seasonal":        "add" if "avec saison" in winner_name else None,
        "sarima_order":    best_order,
        "sarima_seasonal": best_seasonal_order,
    }

print(f"\n{'='*60}")
print(f"Compétition terminée : {len(winners)} segments analysés")
print(pd.DataFrame(winners).T[["modele", "seasonal"]].value_counts().to_string())
