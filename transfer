
import pandas as pd
import numpy as np
import sys
import os

# =============================================================================
# 1. FONCTIONS UTILITAIRES
# =============================================================================

def load_and_prep_cl_data(base_path, label_version):
    """Charge, nettoie et calcule l'indice CL pour un dossier donné."""
    print(f"Chargement de {label_version} depuis : {base_path} ...")
    try:
        dfs = []
        for suffix in ["CITY", "DEPT", "REGION", "PROVINCE"]:
            file_path = os.path.join(base_path, f"prix_m2_univ_elem_complet_{suffix}.csv")
            if os.path.exists(file_path):
                dfs.append(pd.read_csv(file_path))
            else:
                pass
        
        if not dfs:
            print(f"  ERREUR : Aucun fichier trouvé pour {label_version}")
            return None
            
        df = pd.concat(dfs, ignore_index=True)
        
        # Nettoyage
        df = df[df['DIC_NAME'] != "prix_m2_3m"]
        df = df.drop(columns=["TYPE_MAILLE","TAUX_INFL_12M","TAUX_INFL_3M", "DIC_NAME"], errors='ignore')
        
        # Calcul Indice Base 2020
        df["Periode"] = pd.to_datetime(df["Periode"], dayfirst=True) # Important: dayfirst
        mask_2020 = df["Periode"].dt.year == 2020
        
        col_name = f"Indice CL ({label_version})"
        
        if not df.loc[mask_2020].empty:
            pivot_2020 = df.loc[mask_2020].groupby(["CD_TYPE_BIEN","VAL_MAILLE_GEO"])["prix_mm_value"].mean()
            df[col_name] = (
                (df["prix_mm_value"] / 
                 df.set_index(["CD_TYPE_BIEN","VAL_MAILLE_GEO"]).index.map(pivot_2020)
                ) * 100 
            ).round(2)
        else:
            df[col_name] = np.nan
            
        # Nettoyage Clés pour la fusion
        df["VAL_MAILLE_GEO"] = df["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
        df["CD_TYPE_BIEN"] = df["CD_TYPE_BIEN"].astype(str).str.strip().str.upper()
        df['Periode_Key'] = df["Periode"].dt.to_period('Q').astype(str)
        
        return df[[ 'VAL_MAILLE_GEO', 'CD_TYPE_BIEN', 'Periode_Key', col_name ]]
        
    except Exception as e:
        print(f"  Erreur chargement {label_version}: {e}")
        return None

# =============================================================================
# 2. CHARGEMENT DES BASES CL (V1 et V2)
# =============================================================================

path_v1 = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\bdd_univ_elem_zone_insee"
path_v2 = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\correction base_demande"

df_v1 = load_and_prep_cl_data(path_v1, "V1")
df_v2 = load_and_prep_cl_data(path_v2, "V2")

if df_v1 is None or df_v2 is None:
    sys.exit("Arrêt critique : Une des bases CL n'a pas pu être chargée.")

# =============================================================================
# 3. CHARGEMENT ET PRÉPARATION INSEE (Le bloc manquant)
# =============================================================================

print("Chargement des données INSEE...")
types_biens = ['APT', 'MAI']
perimetre_insee = ['92', '93', '94', '95', '91','75', '78', '77', "MARSEILLE", "LYON", "LILLE",'NORD-PAS-DE-CALAIS','PACA','RHONE-ALPES','PROVINCE','AUVERGNE','IDF']
insee_path = r"N:\uflumth\indicateur_marche\univers_elementaire\TI\table_rapport (2025)"
insee_to_concat = []

for perimetre in perimetre_insee:
    for type_b in types_biens:
        try:
            file_p = os.path.join(insee_path, f"valeurs_trimestrielles_{perimetre}_{type_b}.csv")
            # Lecture
            valeurs_trimestrielles = pd.read_csv(file_p, sep=';')
            
            # Nettoyage (Slicing des premières lignes)
            valeurs_trimestrielles = valeurs_trimestrielles[3:].copy()
            
            # Renommage colonne indice
            col_indice = valeurs_trimestrielles.columns[1]
            valeurs_trimestrielles = valeurs_trimestrielles.rename(columns={col_indice: 'Indice de prix (INSEE)'})
            
            # Conversion numérique
            valeurs_trimestrielles['Indice de prix (INSEE)'] = pd.to_numeric(
                valeurs_trimestrielles['Indice de prix (INSEE)'], errors='coerce'
            )
            
            # Parsing Date
            valeurs_trimestrielles['Year'] = valeurs_trimestrielles['Libellé'].astype(str).apply(lambda x: x.split('-')[0])
            valeurs_trimestrielles['Quarter'] = valeurs_trimestrielles['Libellé'].astype(str).apply(lambda x: x.split('T')[-1])
            
            valeurs_trimestrielles["Date code"] = valeurs_trimestrielles['Year'] + 'Q' + valeurs_trimestrielles["Quarter"]
            valeurs_trimestrielles["Periode"] = pd.PeriodIndex(valeurs_trimestrielles["Date code"], freq="Q").to_timestamp()
            
            valeurs_trimestrielles["VAL_MAILLE_GEO"] = perimetre
            valeurs_trimestrielles["CD_TYPE_BIEN"] = type_b
            
            insee_to_concat.append(valeurs_trimestrielles[["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode", "Indice de prix (INSEE)"]])
            
        except Exception as e:
            continue

if insee_to_concat:
    insee_final = pd.concat(insee_to_concat, ignore_index=True)
    # Harmonisation Noms
    insee_final["VAL_MAILLE_GEO"] = insee_final["VAL_MAILLE_GEO"].replace({
        "RHONE-ALPES": "RHÔNE-ALPES",
        "PACA": "PROVENCE-ALPES-CÔTE D'AZUR",
        "IDF": "ÎLE-DE-FRANCE"
    })
else:
    sys.exit("Erreur : Aucun fichier INSEE chargé.")

# Calcul Base 2020 INSEE
mask_2020_insee = insee_final["Periode"].dt.year == 2020
pivot_2020_insee = insee_final.loc[mask_2020_insee].groupby(["CD_TYPE_BIEN","VAL_MAILLE_GEO"])["Indice de prix (INSEE)"].mean()
insee_final["Indice INSEE (Base 2020)"] = (
    (insee_final["Indice de prix (INSEE)"] / 
     insee_final.set_index(["CD_TYPE_BIEN","VAL_MAILLE_GEO"]).index.map(pivot_2020_insee)
    ) * 100 
).round(2)

# Nettoyage INSEE
insee_final["VAL_MAILLE_GEO"] = insee_final["VAL_MAILLE_GEO"].astype(str).str.strip().str.upper()
insee_final["CD_TYPE_BIEN"] = insee_final["CD_TYPE_BIEN"].astype(str).str.strip().str.upper()
insee_final['Periode_Key'] = insee_final["Periode"].dt.to_period('Q').astype(str)

# =============================================================================
# 4. FUSIONS ET CALCULS COMPARATIFS
# =============================================================================

print("Fusion des données...")

# Fusion V1
merge_v1 = pd.merge(
    df_v1, 
    insee_final[['VAL_MAILLE_GEO', 'CD_TYPE_BIEN', 'Periode_Key', 'Indice INSEE (Base 2020)']], 
    how="inner",
    on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode_Key"]
)

# Fusion V2
merge_v2 = pd.merge(
    df_v2, 
    insee_final[['VAL_MAILLE_GEO', 'CD_TYPE_BIEN', 'Periode_Key', 'Indice INSEE (Base 2020)']], 
    how="inner",
    on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN", "Periode_Key"]
)

def get_stats(df, col_cl):
    df['Dif'] = df[col_cl] - df['Indice INSEE (Base 2020)']
    rmse = np.sqrt(np.mean(df['Dif']**2))
    corr = df[col_cl].corr(df['Indice INSEE (Base 2020)'])
    return pd.Series({'RMSE': rmse, 'Correlation': corr})

# Calcul des stats par groupe
stats_v1 = merge_v1.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]).apply(lambda x: get_stats(x, 'Indice CL (V1)')).reset_index()
stats_v2 = merge_v2.groupby(["VAL_MAILLE_GEO", "CD_TYPE_BIEN"]).apply(lambda x: get_stats(x, 'Indice CL (V2)')).reset_index()

# Comparaison finale
comparaison = pd.merge(stats_v1, stats_v2, on=["VAL_MAILLE_GEO", "CD_TYPE_BIEN"], suffixes=('_V1', '_V2'))

# Calcul du Gain (Positif = V2 est meilleure)
comparaison['Gain_RMSE'] = comparaison['RMSE_V1'] - comparaison['RMSE_V2'] 
comparaison['Gain_Corr'] = comparaison['Correlation_V2'] - comparaison['Correlation_V1']

print("\n" + "="*80)
print(" RÉSULTATS COMPARATIFS : Base Standard (V1) vs Base + Demande (V2)")
print("="*80)
print(f"Gain Moyen RMSE global : {comparaison['Gain_RMSE'].mean():.4f} (V2 réduit l'erreur)")
print(f"Gain Moyen Corrélation : {comparaison['Gain_Corr'].mean():.4f} (V2 suit moins bien la tendance)")
print("-" * 80)
print("Détail des améliorations (Top 10 Gains RMSE) :")
print(comparaison.sort_values("Gain_RMSE", ascending=False).head(10))

