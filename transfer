import matplotlib.font_manager as fm
import os

# 1. Obtenir la liste de tous les fichiers de police trouvés par Matplotlib
all_font_files = fm.findSystemFonts(fontpaths=None, fontext='ttf')

# 2. Extraire les noms de famille de police lisibles (en éliminant les doublons)
available_fonts = set()
for font_file in all_font_files:
    try:
        # Tenter d'obtenir les propriétés de la police
        prop = fm.FontProperties(fname=font_file)
        # Ajouter le nom de la famille de police
        available_fonts.add(prop.get_name())
    except Exception:
        # Ignorer les fichiers qui ne sont pas des polices valides pour Matplotlib
        continue

# 3. Afficher les noms des polices triées
print("--- POLICES DISPONIBLES SUR VOTRE SYSTÈME POUR MATPLOTLIB ---")
for font_name in sorted(list(available_fonts)):
    print(font_name)
print("-------------------------------------------------------------")

