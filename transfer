import numpy as np

# Etape 1 : moyenne par (HLC, year)
mean_by_year = (
    base
    .group_by(['HLC', 'year'])
    .agg(pl.col('lgd_obligor').mean().alias('mean_lgd_year'))
)

# Etape 2 : moyenne des moyennes annuelles + IC par HLC
lra_stats = (
    mean_by_year
    .group_by('HLC')
    .agg([
        pl.col('mean_lgd_year').mean().alias('lgd_obligor_hlc_weighted_year'),
        pl.col('mean_lgd_year').std().alias('std_lgd_year'),
        pl.col('mean_lgd_year').min().alias('min_lgd_year'),
        pl.col('mean_lgd_year').max().alias('max_lgd_year'),
        pl.len().alias('nb_years_couvert'),
    ])
    .with_columns([
        # IC 95% sur la LRA (IC de la moyenne des moyennes annuelles)
        (pl.col('lgd_obligor_hlc_weighted_year')
         - 1.96 * pl.col('std_lgd_year') / pl.col('nb_years_couvert').sqrt()
        ).alias('borne_inf_95'),
        (pl.col('lgd_obligor_hlc_weighted_year')
         + 1.96 * pl.col('std_lgd_year') / pl.col('nb_years_couvert').sqrt()
        ).alias('borne_sup_95'),
    ])
    .with_columns(
        pl.struct(['borne_inf_95', 'borne_sup_95'])
        .map_elements(
            lambda x: f"[{x['borne_inf_95']:.3f}, {x['borne_sup_95']:.3f}]",
            return_dtype=pl.String
        )
        .alias('IC_95')
    )
    .drop(['borne_inf_95', 'borne_sup_95'])
)

# Etape 3 : join avec les stats au grain obligor
stats_hlc = (
    lra_stats
    .join(
        base.group_by('HLC').agg([
            pl.col('lgd_obligor').mean().alias('lgd_hlc_obligor'),
            pl.col('lgd_obligor').median().alias('median_lgd'),
            pl.col('lgd_obligor').std().alias('std_lgd'),
            pl.col('lgd_obligor').min().alias('min_lgd'),
            pl.col('lgd_obligor').max().alias('max_lgd'),
            pl.col('n_obligor').sum().alias('total_obligors'),
            pl.col('MoC_C').mean().alias('MoC_C'),
            pl.col('Downturn').mean().alias('MoC_Downturn'),
            pl.col('Somme MoC').mean().alias('mean_somme_moc'),
            pl.col('Somme MoC').median().alias('median_somme_moc'),
            pl.col('Significatif').mean().alias('Significatif'),
        ]),
        on='HLC',
        how='left'
    )
    .sort('lgd_obligor_hlc_weighted_year')
)

print(stats_hlc)
