# 8. Export Excel complet (option B — fichier autonome)
# --------------------------------------------------------------------------- #
def exporter_stat_desc_excel(chemin, correlation=None, stats_quali=None,
                             stats_quanti=None, seuils_cart=None,
                             export_brut=None, trend_df=None,
                             target_name="Target"):
    """
    Fichier Excel autonome du notebook stat desc.

    seuils_cart attend désormais un DataFrame (voir construire_table_seuils),
    plus un dict — colonnes : variable, colonne_binee, indice_tranche,
    borne_inf, borne_sup, label.
    """
    chemin = Path(chemin)
    chemin.parent.mkdir(parents=True, exist_ok=True)
    STARTCOL = 1

    with pd.ExcelWriter(
        chemin, engine="xlsxwriter",
        engine_kwargs={'options': {'strings_to_numbers': True}}
    ) as writer:
        onglets = [
            ("Full_correlation", correlation,  "#8E44AD", True),
            ("Trend_Modalities", trend_df,     "#3498DB", False),
            ("Stats_quali",      stats_quali,  "#006C44", False),
            ("Stats_quanti",     stats_quanti, "#006C44", False),
            ("Seuils_CART",      seuils_cart,  "#B7950B", False),
            ("Export_brut",      export_brut,  "#5D6D7E", False),
        ]

        ecrits = []
        for nom, df, couleur, index in onglets:
            if df is None or len(df) == 0:
                continue

            if nom == "Full_correlation":
                df = df.to_pandas() if isinstance(df, pl.DataFrame) else df.copy()
                df[df.columns] = df[df.columns].apply(pd.to_numeric, errors="coerce")

            ws = write_formatted_sheet(writer, df, nom, tab_color=couleur,
                                       startcol=STARTCOL, index=index)

            if nom == "Full_correlation":
                colorer_matrice_correlation(ws, df, startcol=STARTCOL + 1, startrow=1)

            ecrits.append(nom)

    print(f"Fichier stat desc écrit : {chemin}")
    print(f"   Onglets : {', '.join(ecrits)}")

    if "Trend_Modalities" in ecrits:
        injecter_dashboard_trend(chemin, trend_df, target_name=target_name,
                                 startcol=STARTCOL)

    return chemin
