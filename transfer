import pandas as pd

def process_dummies_imbriquee(df_binned_dummies, feature_):
    # 1. Récupérer les modalités uniques en ignorant les valeurs manquantes (NaN)
    raw_groups = df_binned_dummies[feature_].dropna().unique()
    
    # 2. Trier de manière sécurisée (gère les mélanges de types str / float / int)
    try:
        groups = sorted(raw_groups)
    except TypeError:
        # Si la colonne contient un mélange de types (ex: str et float), on trie par leur représentation texte
        groups = sorted(raw_groups, key=lambda x: str(x))
    
    # 3. Création des variables dummies imbriquées pour chaque modalité (à partir de la 2ème)
    for g in groups[1:]:
        col_name = f'{feature_}_{g}'
        df_binned_dummies[col_name] = (df_binned_dummies[feature_] >= g).astype(int)
    
    # 4. Suppression de la colonne initiale
    df_binned_dummies = df_binned_dummies.drop(columns=[feature_])
    
    return df_binned_dummies


def dummies_imbriquee(data, columns=None):
    df_binned_dummies = data.copy()
    
    # Si aucune colonne n'est spécifiée, on traite toutes les colonnes
    if columns is None:
        columns = list(data.columns)
    elif isinstance(columns, str):
        columns = [columns]
        
    for feature_ in columns:
        print(feature_)
        df_binned_dummies = process_dummies_imbriquee(df_binned_dummies, feature_)
        
    return df_binned_dummies
