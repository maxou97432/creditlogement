# ============================================================
#  CALIBRATION AUTOMATIQUE DE EPS_W1 ET EPS_ETA
#  A lancer AVANT la cellule d'exploration
#  Principe : variabilite intra-classe = bruit de reference
# ============================================================

N_SPLITS     = 100   # nb de decoupages aleatoires par classe
N_CAP_CALIB  = 20_000  # sous-echantillonnage par demi-classe (perf)
RNG_CALIB    = np.random.default_rng(123)

w1_intra  = []
eta_intra = []

classes_calib = (
    df_base
    .group_by("CHR_model")
    .agg(pl.col("lgd_obligor").count().alias("n"))
    .filter(pl.col("n") >= 100)   # ignorer classes trop petites pour splitter
    ["CHR_model"].to_list()
)

print(f"Classes utilisees pour calibration : {len(classes_calib)}\n")

for cls in classes_calib:
    vec = df_base.filter(pl.col("CHR_model") == cls)["lgd_obligor"].to_numpy()

    # Sous-echantillonnage global si classe enorme
    if len(vec) > 2 * N_CAP_CALIB:
        vec = RNG_CALIB.choice(vec, size=2 * N_CAP_CALIB, replace=False)

    for _ in range(N_SPLITS):
        # Split aleatoire 50/50
        idx = RNG_CALIB.permutation(len(vec))
        half = len(vec) // 2
        a_intra = vec[idx[:half]]
        b_intra = vec[idx[half:2*half]]

        w1_intra.append(wasserstein_distance(a_intra, b_intra))
        eta_intra.append(_overlap_eta(a_intra, b_intra))

    print(f"  {cls} (n={len(vec)}) OK")

w1_intra  = np.array(w1_intra)
eta_intra = np.array(eta_intra)

# Statistiques de reference
w1_p50  = float(np.percentile(w1_intra,  50))
w1_p75  = float(np.percentile(w1_intra,  75))
w1_p90  = float(np.percentile(w1_intra,  90))
eta_p50 = float(np.percentile(eta_intra, 50))
eta_p25 = float(np.percentile(eta_intra, 25))
eta_p10 = float(np.percentile(eta_intra, 10))

print(f"\n{'='*55}")
print(f"  W1 intra-classe  — p50={w1_p50:.4f}  p75={w1_p75:.4f}  p90={w1_p90:.4f}")
print(f"  eta intra-classe — p50={eta_p50:.4f}  p25={eta_p25:.4f}  p10={eta_p10:.4f}")
print(f"{'='*55}")
print(f"\nRecommandations :")
print(f"  EPS_W1    = p75 intra  -> {w1_p75:.4f}  (conservateur)")
print(f"  EPS_W1    = p90 intra  -> {w1_p90:.4f}  (liberal)")
print(f"  EPS_ETA   = p25 intra  -> {eta_p25:.4f}  (conservateur)")
print(f"  ETA_MODERE= p10 intra  -> {eta_p10:.4f}")
print(f"\n>>> Copiez dans la cellule parametres :")
print(f"EPS_W1     = {w1_p75:.4f}")
print(f"EPS_ETA    = {eta_p25:.4f}")
print(f"ETA_MODERE = {eta_p10:.4f}")
