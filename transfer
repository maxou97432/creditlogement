# 3-4. décision (option A) : OVL observé (médiane) >= seuil H0.
        # "l'overlap A vs B est au moins aussi bon que ce qu'on verrait 95% du
        #  temps si A et B étaient une seule population" -- symétrique, non biaisé.
        decision = bool(ovl_obs >= seuil_h0)
        if self.min_ovl is not None:
            decision = bool(decision and ovl_obs >= self.min_ovl)

        floor_txt = "" if self.min_ovl is None else f" et >= plancher {self.min_ovl:.2f}"
        return {
            "statistic": ovl_obs,                # OVL-2 observé (médiane bootstrap)
            "p_value": p_perm,                   # documentaire (sature à grand n)
            "ovl_obs": ovl_obs,
            "ovl_lower": ovl_lower,              # borne basse, conservée pour info
            "seuil_h0": seuil_h0,                # seuil calibré par permutation
            "percentile": self.percentile,
            "n_a_eff": int(na_eff),
            "n_b_eff": int(nb_eff),
            "interpretation": (
                f"OVL-2={ovl_obs:.3f} vs seuil H0={seuil_h0:.3f} -> "
                + ("FUSION" if decision else "PAS DE FUSION")
                + f" (observé {'>=' if ovl_obs >= seuil_h0 else '<'} seuil{floor_txt})"
                + f" ; borne basse={ovl_lower:.3f} ; p_perm={p_perm:.2e} (documentaire)"
            ),
            "fusionnable": decision,
            "fusion_suggeree": decision,
        }
