def print_estimation(self, result: Dict):
        """
        Affiche le résultat d'une estimation de manière formatée.
        
        Args:
            result: Dict retourné par estimate()
        """
        print("\n" + "="*80)
        print("ESTIMATION DE VALEUR FONCIÈRE")
        print("="*80)
        
        if not result['success']:
            print(f"❌ Échec: {result['message']}")
            return
        
        print(f"\n📅 Période:")
        print(f"   Date d'achat      : {result['annee_achat']}")
        print(f"   Année de référence: {result['annee_reference']}")
        print(f"   Écart             : {result['periode']} ans")
        
        print(f"\n💰 Valeurs:")
        print(f"   Valeur initiale : {result['valeur_initiale']:,.2f} €")
        print(f"   Valeur estimée  : {result['valeur_estimee']:,.2f} €")
        print(f"   Variation       : {result['valeur_estimee'] - result['valeur_initiale']:+,.2f} €")
        
        print(f"\n📊 Taux d'inflation:")
        print(f"   Taux appliqué   : {result['taux_pourcent']:+.2f}%")
        print(f"   Niveau géo      : {result['niveau_geo']} ({result['maille']})")
        print(f"   Effectif        : {result['effectif']} transactions")
        
        print(f"\n✅ {result['message']}")


