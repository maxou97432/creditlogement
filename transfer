print("▶ INVESTIGATION : Que fait Optima quand le type d'amortissement est vide ?")

# 1. On renomme proprement les vides pour l'affichage
srs_fusion = srs_fusion.with_columns(
    pl.when(pl.col('CD_TYPE_AMORT').is_null() | (pl.col('CD_TYPE_AMORT') == ''))
    .then(pl.lit('NON RENSEIGNE'))
    .otherwise(pl.col('CD_TYPE_AMORT'))
    .alias('CD_TYPE_AMORT_CLEAN')
)

# 2. On isole ces ~50 000 lignes fantômes
anomalies_types = srs_fusion.filter(pl.col('CD_TYPE_AMORT_CLEAN') == 'NON RENSEIGNE')

print(f"Total des lignes sans type d'amortissement : {anomalies_types.height}")
print("Top 10 des valeurs réglementaires (NB_MATURITE_IRBA) que le moteur leur a assignées :")

# 3. On compte les occurrences de chaque valeur de duration
distribution = anomalies_types.group_by('NB_MATURITE_IRBA').agg(
    pl.len().alias('Nombre_de_Contrats')
).with_columns(
    (pl.col('Nombre_de_Contrats') / anomalies_types.height * 100).round(1).alias('Pourcentage_%')
).sort('Nombre_de_Contrats', descending=True)

print(distribution.head(10))
