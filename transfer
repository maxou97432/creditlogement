def stabilite_temporelle(
    df: pl.DataFrame, mapping: dict, class_col: str, lgd_col: str,
    year_col: str = "year", obligor_col: Optional[str] = None,
) -> float:
    df_mapped = df.with_columns(
        pl.col(class_col).cast(pl.Utf8).replace(mapping).alias("_classe_finale")
    )
    if obligor_col is not None:
        df_mapped = (df_mapped.group_by(["_classe_finale", year_col, obligor_col])
                     .agg(pl.col(lgd_col).mean()))
    lgd_annuelle = (df_mapped.group_by(["_classe_finale", year_col])
                    .agg(pl.col(lgd_col).mean().alias("lgd_mean")))
    variance_par_classe = (lgd_annuelle.group_by("_classe_finale")
                           .agg(pl.col("lgd_mean").std(ddof=1).alias("std_interannuelle"))
                           .filter(pl.col("std_interannuelle").is_not_null()))
    return float(variance_par_classe["std_interannuelle"].mean())


def homogeneite_intersegment(
    df: pl.DataFrame, mapping: dict, class_col: str, lgd_col: str,
    seg_col: str = "Seg", obligor_col: Optional[str] = None,
) -> float:
    df_mapped = df.with_columns(
        pl.col(class_col).cast(pl.Utf8).replace(mapping).alias("_classe_finale")
    )
    if obligor_col is not None:
        df_mapped = (df_mapped.group_by(["_classe_finale", seg_col, obligor_col])
                     .agg(pl.col(lgd_col).mean()))
    lgd_par_segment = (df_mapped.group_by(["_classe_finale", seg_col])
                       .agg(pl.col(lgd_col).mean().alias("lgd_mean")))
    dispersion_par_classe = (lgd_par_segment.group_by("_classe_finale")
                             .agg(pl.col("lgd_mean").std(ddof=1).alias("std_intersegment"))
                             .filter(pl.col("std_intersegment").is_not_null()))
    return float(dispersion_par_classe["std_intersegment"].mean())


def comparer_criteres_fusion(
    cmp: "FusionComparator", df: pl.DataFrame, criteres: dict,
    class_col: str, lgd_col: str, year_col: str = "year",
    obligor_col: Optional[str] = None,
) -> dict:
    """Compare les partitionnements finaux de plusieurs critères de fusion."""
    from sklearn.metrics import adjusted_rand_score

    classes = list(cmp.order)

    solutions = {}
    for label, (criterion, ovl_threshold) in criteres.items():
        try:
            solutions[label] = cmp.solve(
                criterion=criterion, label_style="glouton", ovl_threshold=ovl_threshold,
            )
        except Exception as e:
            solutions[label] = None
            print(f"[WARN] {label} : {e}")

    labels_valides = [l for l, s in solutions.items() if s is not None]

    def metriques_lgd(sol, df, class_col, lgd_col, year_col, obligor_col):
        df_m = df.with_columns(
            pl.col(class_col).cast(pl.Utf8).replace(sol["mapping"]).alias("_classe_finale")
        )
        if obligor_col is not None:
            df_m = df_m.group_by(["_classe_finale", obligor_col]).agg(pl.col(lgd_col).mean())
        intra = (df_m.group_by("_classe_finale")
                 .agg(pl.col(lgd_col).std(ddof=1).alias("std_intra"),
                      pl.col(lgd_col).mean().alias("lgd_mean"),
                      pl.len().alias("n"))
                 .filter(pl.col("std_intra").is_not_null()))
        homog = float((intra["std_intra"] * intra["n"]).sum() / intra["n"].sum())
        sep = float(intra["lgd_mean"].std(ddof=1))
        ratio = round(sep / homog, 3) if homog > 0 else None
        stab = stabilite_temporelle(df, sol["mapping"], class_col, lgd_col, year_col, obligor_col)
        return {"n_classes": sol["n_final"], "homog_intra": round(homog, 3),
                "sep_inter": round(sep, 3), "ratio_sep_homog": ratio,
                "stab_temporelle": round(stab, 3)}

    rows_metriques = []
    for label in labels_valides:
        m = metriques_lgd(solutions[label], df, class_col, lgd_col, year_col, obligor_col)
        rows_metriques.append({"critere": label, **m})
    df_metriques = pl.DataFrame(rows_metriques)

    def to_label_vector(sol):
        mapping = sol["mapping"]
        groups = sorted(set(mapping.values()))
        g2i = {g: i for i, g in enumerate(groups)}
        return np.array([g2i[mapping[str(c)]] for c in classes])

    vectors = {l: to_label_vector(solutions[l]) for l in labels_valides}
    ari_rows = []
    for l1 in labels_valides:
        row = {"critere": l1}
        for l2 in labels_valides:
            row[l2] = round(adjusted_rand_score(vectors[l1], vectors[l2]), 3)
        ari_rows.append(row)
    df_ari = pl.DataFrame(ari_rows)

    diff_rows = []
    for ca, cb in cmp.pair_list:
        row = {"class_a": ca, "class_b": cb}
        for label in labels_valides:
            m = solutions[label]["mapping"]
            ensemble = str(m[str(ca)]) == str(m[str(cb)])
            row[label] = "✓ ensemble" if ensemble else "X séparées"
        verdicts = [row[l] for l in labels_valides]
        row["divergence"] = len(set(verdicts)) > 1
        diff_rows.append(row)
    df_diff = pl.DataFrame(diff_rows)

    return {"metriques": df_metriques, "ari_matrix": df_ari,
            "diff_paires": df_diff, "solutions": solutions}


def calibrer_seuil_ovl_stabilite(
    cmp: "FusionComparator", seuils: Optional[list] = None,
    n_bootstrap: int = 100, n_subsample: int = 300, method: str = "kde",
    random_state: Optional[int] = 42, n_jobs: int = -1,
) -> pl.DataFrame:
    """Calibration du seuil OVL par stabilité bootstrap (ARI). Réplicats parallélisés."""
    if seuils is None:
        seuils = [round(s, 2) for s in np.arange(0.50, 0.6, 0.01)]
    seuils = list(seuils)
    if len(seuils) == 0:
        raise ValueError(
            "Grille `seuils` vide — vérifier np.arange(start, stop, step) "
            "(start doit être strictement < stop). "
            "Ex. np.arange(0.53, 0.63, 0.01)."
        )
    if method not in ("hist", "kde"):
        raise ValueError("method doit être 'hist' ou 'kde'.")

    classes = list(cmp.order)
    arrays = {c: cmp.arrays[c] for c in classes}

    def _ovl(a, b) -> float:
        if method == "kde":
            try:
                return OVLTest._ovl_kde(a, b)
            except Exception:
                return OVLTest._ovl_hist(a, b)
        return OVLTest._ovl_hist(a, b)

    def _fusion_labels(ovl_par_paire: dict, seuil: float) -> np.ndarray:
        groups: list = [[i] for i in range(len(classes))]
        means = {i: arrays[classes[i]].mean() for i in range(len(classes))}
        sizes = {i: arrays[classes[i]].size for i in range(len(classes))}

        def gmean(g):
            return sum(means[i] * sizes[i] for i in g) / sum(sizes[i] for i in g)

        def get_ovl(ga, gb) -> float:
            for i in ga:
                for j in gb:
                    key = (min(i, j), max(i, j))
                    if key in ovl_par_paire:
                        return ovl_par_paire[key]
            return 0.0

        while len(groups) > 1:
            groups.sort(key=gmean)
            best = None
            for k in range(len(groups) - 1):
                o = get_ovl(groups[k], groups[k + 1])
                if o >= seuil and (best is None or o > best[0]):
                    best = (o, k)
            if best is None:
                break
            k = best[1]
            groups = groups[:k] + [groups[k] + groups[k + 1]] + groups[k + 2:]

        labels = np.empty(len(classes), dtype=int)
        for gid, g in enumerate(groups):
            for i in g:
                labels[i] = gid
        return labels

    child_seeds = np.random.SeedSequence(random_state).spawn(n_bootstrap)

    def _un_replicat(seed) -> dict:
        rng = np.random.default_rng(seed)
        boot = {}
        for c in classes:
            src = arrays[c]
            n_eff = min(src.size, n_subsample)
            boot[c] = src[rng.integers(0, src.size, n_eff)]
        order_idx = sorted(range(len(classes)), key=lambda i: boot[classes[i]].mean())
        ovl_pp = {}
        for pos in range(len(order_idx) - 1):
            i, j = order_idx[pos], order_idx[pos + 1]
            ovl_pp[(min(i, j), max(i, j))] = _ovl(boot[classes[i]], boot[classes[j]])
        return {s: _fusion_labels(ovl_pp, s) for s in seuils}

    try:
        from joblib import Parallel, delayed
        reps = Parallel(n_jobs=n_jobs)(delayed(_un_replicat)(s) for s in child_seeds)
    except Exception:
        reps = [_un_replicat(s) for s in child_seeds]

    mappings = {s: [r[s] for r in reps] for s in seuils}

    from sklearn.metrics import adjusted_rand_score
    n_initial = len(classes)
    resultats = []
    for s in seuils:
        labs = mappings[s]
        aris = []
        for i in range(len(labs)):
            for j in range(i + 1, len(labs)):
                aris.append(adjusted_rand_score(labs[i], labs[j]))
        n_cl_med = int(np.median([len(np.unique(l)) for l in labs]))
        resultats.append({
            "seuil_ovl": float(s),
            "ari_moyen": float(np.mean(aris)) if aris else 1.0,
            "ari_std": float(np.std(aris)) if aris else 0.0,
            "n_classes_median": n_cl_med,
            "valide": bool(1 < n_cl_med < n_initial),
        })

    return pl.DataFrame(resultats).sort("seuil_ovl")


def diagnostic_normalite(x: Sequence[float]) -> dict:
    arr = np.asarray(x, dtype=float).ravel()
    arr = arr[np.isfinite(arr)]
    n = arr.size
    if n < N_SHAPIRO_MAX:
        w, p = stats.shapiro(arr)
        return {"methode": "shapiro", "n": n, "statistic": float(w),
                "p_value": float(p), "gaussien": bool(p >= ALPHA)}
    sk = float(stats.skew(arr))
    ku = float(stats.kurtosis(arr, fisher=True))
    return {"methode": "moments", "n": n, "skewness": sk, "kurtosis": ku,
            "gaussien": bool((abs(sk) <= SKEW_MAX) and (abs(ku) <= KURT_MAX))}


