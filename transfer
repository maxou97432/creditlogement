import re
from pathlib import Path

def synchroniser_noms_fichiers(catalogue, dossier_notebooks):
    """
    Renomme les .ipynb sur disque pour que leur préfixe reflète l'ordre
    du catalogue. Ne touche que les fichiers dont le préfixe a changé.
    Retourne le catalogue mis à jour avec les noms de fichiers réels.
    """
    dossier = Path(dossier_notebooks)
    pattern_prefixe = re.compile(r"^\d+[A-Z]?\s*-\s*")

    for position, nb in enumerate(catalogue):
        prefixe_attendu = f"{position} - "
        nom_attendu = f"{prefixe_attendu}{nb['nom_metier']}.ipynb"
        chemin_attendu = dossier / nom_attendu

        if chemin_attendu.exists():
            nb["name"] = nom_attendu
            continue

        # Chercher un fichier existant portant le même nom métier,
        # peu importe son préfixe actuel
        candidats = [
            f for f in dossier.glob("*.ipynb")
            if pattern_prefixe.sub("", f.stem).strip() == nb["nom_metier"]
        ]

        if len(candidats) == 0:
            raise FileNotFoundError(
                f"Aucun fichier trouvé pour le notebook '{nb['nom_metier']}' "
                f"dans {dossier}. Vérifie le nom métier dans CATALOGUE_NOTEBOOKS."
            )
        if len(candidats) > 1:
            raise ValueError(
                f"Plusieurs fichiers correspondent à '{nb['nom_metier']}' : "
                f"{[c.name for c in candidats]}. Renomme-les pour lever l'ambiguïté."
            )

        ancien_chemin = candidats[0]
        ancien_chemin.rename(chemin_attendu)
        print(f"[renommé] {ancien_chemin.name}  →  {nom_attendu}")
        nb["name"] = nom_attendu

    return catalogue


CATALOGUE_NOTEBOOKS = synchroniser_noms_fichiers(CATALOGUE_NOTEBOOKS, dossier_notebooks=".")
