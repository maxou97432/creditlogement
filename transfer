# 4. Évaluation détaillée par Type d'Amortissement
dataset_valide = srs_fusion.drop_nulls('T_INTRT')

# Création des drapeaux de réussite (Tolérance de 0.1 an)
evaluation = dataset_valide.with_columns(
    (pl.col('ANALYTIQUE_MATURITE_IRBA') - pl.col('NB_MATURITE_IRBA')).abs().le(0.1).alias('Match_Brute'),
    (pl.col('ANALYTIQUE_DURATION_IRBA') - pl.col('NB_DURATION_IRBA')).abs().le(0.1).alias('Match_Clippe')
)

# Agrégation par type d'amortissement
resultats_par_type = evaluation.group_by('CD_TYPE_AMORT').agg([
    pl.len().alias('Total_Lignes'),
    pl.col('Match_Brute').sum().alias('Succes_Brut'),
    pl.col('Match_Clippe').sum().alias('Succes_Clippe')
]).with_columns(
    (pl.col('Succes_Brut') / pl.col('Total_Lignes') * 100).round(1).alias('Reussite_Brute_%'),
    (pl.col('Succes_Clippe') / pl.col('Total_Lignes') * 100).round(1).alias('Reussite_Clippee_%')
).sort('Total_Lignes', descending=True)

print("\n--- Bilan de la Modélisation Théorique vs Réalité SAS ---")
print(resultats_par_type.select([
    'CD_TYPE_AMORT', 'Total_Lignes', 'Reussite_Brute_%', 'Reussite_Clippee_%'
]))

# On tire quelques cas extrêmes pour le type où le modèle théorique souffre le plus
type_problematique = resultats_par_type.sort('Reussite_Brute_%').row(0)[0]

print(f"\n--- Zoom sur les échecs du Type = '{type_problematique}' ---")
print(evaluation.filter(
    (pl.col('CD_TYPE_AMORT') == type_problematique) & (~pl.col('Match_Brute'))
).select([
    'ID_FEM', 'MATURITE', 'T_INTRT', 
    'ANALYTIQUE_MATURITE_IRBA', 'NB_MATURITE_IRBA'
]).head(5))
